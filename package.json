{
  "name": "mrandmrs-outdoor-living",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev --port 4325",
    "build": "npm run estimador && npm run seo:ficheros && astro build",
    "check": "npm run build && npm run check:assets && npm run check:rutas && npm run check:enlaces && npm run check:seo && npm run check:texto && npm run check:ix2 && npm run check:visual",
    "vivo": "node scripts/fetch-vivo.mjs",
    "assets": "node scripts/download-assets.mjs",
    "fuentes": "node scripts/fetch-fuentes.mjs",
    "css": "node scripts/build-css.mjs",
    "shell": "node scripts/build-shell.mjs",
    "paginas": "node scripts/build-paginas.mjs",
    "estimador": "node scripts/build-estimador.mjs",
    "reveals": "node scripts/build-reveals.mjs",
    "youtube": "node scripts/extract-youtube.mjs",
    "seo:ficheros": "node scripts/build-seo-ficheros.mjs",
    "schemas": "node scripts/gen-schemas.mjs",
    "import:dry": "node scripts/import.mjs --dry-run",
    "import": "node scripts/import.mjs",
    "baseline": "node scripts/capture-baseline.mjs",
    "baseline:cascaron": "node scripts/capture-cascaron.mjs",
    "check:assets": "node scripts/check-assets.mjs",
    "check:baseline": "node scripts/check-baseline.mjs",
    "check:cascaron": "MM_FIXTURES=1 npm run build && node scripts/check-cascaron.mjs",
    "check:rutas": "node scripts/check-rutas.mjs",
    "check:enlaces": "node scripts/check-enlaces.mjs",
    "check:seo": "node scripts/check-seo.mjs",
    "check:texto": "node scripts/check-texto.mjs",
    "check:ix2": "node scripts/check-ix2.mjs",
    "check:visual": "node scripts/check-visual.mjs"
  },
  "dependencies": {
    "@astrojs/vercel": "^11.0.8",
    "@portabletext/block-tools": "^6.0.0",
    "@sanity/client": "^8.4.0",
    "@sanity/schema": "^6.11.0",
    "astro": "^7.2.9",
    "jsdom": "^30.0.1",
    "nodemailer": "^9.0.6"
  },
  "devDependencies": {
    "pixelmatch": "^7.2.0",
    "playwright": "^1.62.1",
    "pngjs": "^7.0.0",
    "sharp": "^0.35.4"
  }
}
