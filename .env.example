# Copia esto a .env.local y rellena. .env.local esta en .gitignore.

# ── Reseñas de Google ──────────────────────────────────────────────────────
# Places API (New). Tope de 5 reseñas, las elige Google. Es la ruta que corre
# HOY porque no hay acceso al Perfil de Empresa del cliente.
GOOGLE_PLACES_API_KEY=
# Opcional: por defecto ChIJo8zESQOC4k0RKexwLEPDFx0 (la ficha del cliente).
GOOGLE_PLACE_ID=

# Business Profile API v4: TODAS las reseñas. En cuanto estas tres existan, el
# script cambia solo de adaptador — no hay que tocar codigo.
# Requiere que la cuenta autorizada sea propietaria o administradora del perfil
# de Mr & Mrs, y que el proyecto de GCP tenga aprobada la Google My Business API.
GBP_CLIENT_ID=
GBP_CLIENT_SECRET=
GBP_REFRESH_TOKEN=
# Obligatoria si la cuenta administra MAS DE UN negocio: sin ella el script
# falla listando candidatas antes que arriesgarse a publicar las de otro.
GBP_LOCATION=

# ── Sanity ─────────────────────────────────────────────────────────────────
SANITY_PROJECT_ID=
SANITY_DATASET=
SANITY_WRITE_TOKEN=

# ─────────────────────────────────────────────────────────────────────────────
# CAPTACION DE LEADS  (src/pages/api/formulario.ts)
# Todas se leen con process.env, NUNCA con import.meta.env: Vite sustituye
# import.meta.env en BUILD y, sin valores al construir, da por muerta la rama del
# envio y la BORRA del bundle. Ponerlas despues en Vercel ya no lo arregla.
# En Vercel van con scope Production.

# Cuenta SMTP que ENVIA el aviso. Ojo: es tambien el From: del correo.
# Tiene que ser la cuenta de Gmail real. Si se pone una direccion del propio
# dominio autenticando contra Gmail, el SPF del dominio (GoDaddy -> Outlook, no
# Google) falla, DKIM no alinea y con _dmarc p=quarantine cada aviso se va a spam.
SMTP_USER=
SMTP_PASS=
# Opcionales. Sin definir: smtp.gmail.com:465 (secure).
SMTP_HOST=
SMTP_PORT=

# Destinatario(s) del aviso de lead. Acepta VARIOS separados por coma y conviene
# usarlo: con un solo buzon, si ese buzon filtra o se llena, los leads
# desaparecen sin que nadie se entere. Sin definir: info@mrandmrsoutdoorliving.com
LEAD_TO=

# Secreta de Turnstile. TIENE que ser la del widget cuya site key es
# 0x4AAAAAAEnkUHbX6ap29qsu (la de Formularios.astro). La vieja de Webflow
# 0x4AAAAAAAQTptj2So4dx43e ya NO se usa; cruzarlas da invalid-input-secret y 403
# en TODOS los leads, que es peor que dejar esto vacio (sin secreta falla abierto).
TURNSTILE_SECRET=

# ─────────────────────────────────────────────────────────────────────────────
# SEO. Vale "1" y SOLO "1". Con cualquier otro valor (o sin definir) el sitio se
# construye en modo preview: robots.txt con Disallow: /, sitemap vacio y noindex
# en las 122 paginas. Falla cerrado a proposito. En local se deja SIN definir.
PUBLIC_ES_PRODUCCION=
