# Copia esto a .env.local y rellena. .env.local esta en .gitignore.

# ── Reseñas de Google ──────────────────────────────────────────────────────
# Places API (New). Tope de 5 reseñas, las elige Google. Es la ruta que corre
# HOY porque no hay acceso al Perfil de Empresa del cliente.
GOOGLE_PLACES_API_KEY=
# Opcional: por defecto ChIJo8zESQOC4k0RKexwLEPDFx0 (la ficha del cliente).
GOOGLE_PLACE_ID=

# Business Profile API v4: TODAS las reseñas. En cuanto estas tres existan, el
# script cambia solo de adaptador — no hay que tocar codigo.
# Requiere que la cuenta autorizada sea propietaria o administradora del perfil
# de Mr & Mrs, y que el proyecto de GCP tenga aprobada la Google My Business API.
GBP_CLIENT_ID=
GBP_CLIENT_SECRET=
GBP_REFRESH_TOKEN=
# Obligatoria si la cuenta administra MAS DE UN negocio: sin ella el script
# falla listando candidatas antes que arriesgarse a publicar las de otro.
GBP_LOCATION=

# ── Sanity ─────────────────────────────────────────────────────────────────
SANITY_PROJECT_ID=
SANITY_DATASET=
SANITY_WRITE_TOKEN=
