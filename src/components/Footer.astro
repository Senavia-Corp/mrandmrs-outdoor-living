// SEO-REMEDIACION (4-oct-2026): `pieRemediado()` corrige zonas, orden de servicios y año sobre
// el marcado derivado, con guardas (ver `src/lib/pie.mjs`). Sobrevive a un `npm run shell`.
// DERIVADO — no editar a mano. Lo genera scripts/build-shell.mjs desde el HTML que sirve
// https://mrandmrsoutdoorliving.com/ . Regenerar: npm run shell
//
// El marcado es el del origen, byte a byte, salvo tres cosas:
//   · las imágenes apuntan a public/ en vez de al CDN de Webflow
//   · `w--current`/`aria-current` se quitan y los repone `ruta` al renderizar, que es
//     lo único que Webflow cambiaba entre páginas (comprobado en 7 páginas de 6 tipos)
//   · el logo iba a `href="#"` y ahora va a `/`. Editado A MANO el 3-sep-2026 y declarado
//     en `build-shell.mjs` (ANCLAS_MUERTAS), como se hizo con el enlace de financing: la
//     regeneración hace `fetch` al sitio vivo y traería cualquier deriva que haya tenido
//     desde la migración, así que no se regenera sólo por esto. La declaración está para
//     que el día que alguien SÍ regenere, el arreglo siga puesto.
//   · las dos legales del pie iban a `mrandmrsoutdoorsliving.com` (con «s», OTRO dominio)
//     teniendo nosotros `/articles/terms-conditions` y `/articles/privacy-policy`, a las que
//     no apuntaba NADIE — 0 enlaces internos en las 116 páginas. Ahora apuntan a las nuestras.
//     Y se añade una tercera, `/articles/accessibility`, que el origen no tenía. Editado A
//     MANO el 3-sep-2026 y declarado en `build-shell.mjs` (CON_PAGINA_PROPIA y
//     ENLACES_ANADIDOS), por el mismo motivo que el logo. Ver D6 en MIGRACION-LOG.md.
//   · los nueve enlaces de solo icono (2 logos, el `tel:` y los 6 sociales) llevan
//     `aria-label`: Webflow los saca sin nombre accesible. Declarado en `build-shell.mjs`
//     (NOMBRES_ACCESIBLES) para que una regeneración lo reproduzca.
//
interface Props { ruta?: string }
const { ruta = '' } = Astro.props;

import { AREAS_PIE, ORDEN_SERVICIOS_PIE, COPYRIGHT_ORIGEN, copyright } from '../lib/pie.mjs';

/**
 * SEO-REMEDIACION (4-oct-2026): zonas, orden de servicios y año del pie (`src/lib/pie.mjs`).
 * Cirugia con GUARDA sobre el marcado derivado: si el origen cambia de forma, revienta el build
 * en vez de publicar un pie a medias.
 */
function pieRemediado(html) {
  const ini = html.indexOf('<div class="label">Areas We Serve</div>');
  const lista = '<div role="list" class="collection-list-2 w-dyn-items">';
  const a = html.indexOf(lista, ini);
  const b = html.indexOf('</div></div></div></div></div>', a);
  if (ini < 0 || a < 0 || b < 0) throw new Error('Footer: no encuentro la lista de «Areas We Serve»');
  const viejas = html.slice(a + lista.length, b).match(/class="footer-link"/g)?.length ?? 0;
  if (viejas !== 53) throw new Error(`Footer: «Areas We Serve» traia ${viejas} ciudades y se esperaban 53`);
  const zonas = AREAS_PIE.map((z) => `<div role="listitem" class="w-dyn-item"><a href="${z.href}" class="footer-link">${z.texto}</a></div>`).join('');
  let out = html.slice(0, a + lista.length) + zonas + html.slice(b);

  // Servicios: los mismos catorce items, reordenados por `href`.
  const re = /<div role="listitem" class="w-dyn-item"><a href="(\/services\/[a-z-]+)" class="footer-link">[^<]*<\/a><\/div>/g;
  const items = [...out.matchAll(re)];
  if (items.length !== ORDEN_SERVICIOS_PIE.length) throw new Error(`Footer: ${items.length} servicios, se esperaban ${ORDEN_SERVICIOS_PIE.length}`);
  const porHref = new Map(items.map((m) => [m[1], m[0]]));
  const nuevos = ORDEN_SERVICIOS_PIE.map(({ href: h }) => {
    const x = porHref.get(h);
    if (!x) throw new Error(`Footer: falta el servicio ${h}`);
    return x.replace('>Pool  Construction<', '>Pool Construction<');
  }).join('');
  const desde = items[0].index;
  const hasta = items.at(-1).index + items.at(-1)[0].length;
  if (out.slice(desde, hasta).replace(re, '') !== '') throw new Error('Footer: los servicios no estan seguidos');
  out = out.slice(0, desde) + nuevos + out.slice(hasta);

  if (!out.includes(COPYRIGHT_ORIGEN)) throw new Error('Footer: no encuentro el copyright del origen');
  return out.replace(COPYRIGHT_ORIGEN, copyright());
}

