---
// EL PIE (G5) — REDISEÑO STITCH, ASTRO-1 (12-oct-2026).
//
// Componente PROPIO: ya no es DERIVADO de Webflow. Mismos enlaces y mismos destinos que el pie
// anterior; las zonas, el orden de servicios y el año siguen saliendo de `src/lib/pie.mjs`
// (SEO-REMEDIACION, 4-oct-2026), que también lee `check-texto.mjs`.
//
// Cambios de texto, declarados en STITCH-TEXTO.md: T-23 (queda el rótulo «Licensed & Insured»,
// sin el nombre delante: lo da el logo) y los dos teléfonos con su zona como rótulo.
import { AREAS_PIE, ORDEN_SERVICIOS_PIE, copyright } from '../lib/pie.mjs';
import TELEFONOS from '../data/telefonos.json';
import ICO from '../data/iconos-cascaron.json';

interface Props { ruta?: string }
const { ruta = '' } = Astro.props;
const aqui = (href: string) => (href === ruta ? 'page' : undefined);
const RAPIDOS = [
  { texto: 'Home', href: '/' }, { texto: 'About Us', href: '/about' }, { texto: 'Our Feature Projects', href: '/projects' },
  { texto: 'Customer Reviews', href: '/testimonials' }, { texto: 'Blog & Tips', href: '/blogs-tips' }, { texto: 'Contact Us', href: '/contact-us' },
];
const REDES = [
  { nombre: 'Facebook', href: 'https://www.facebook.com/mrandmrsoutdoorliving/', icono: ICO.facebook },
  { nombre: 'Instagram', href: 'https://www.instagram.com/mrandmrsoutdoorliving/', icono: ICO.instagram },
  { nombre: 'YouTube', href: 'https://www.youtube.com/channel/UC3VGkVUUC1FmXhtn2CUofsA', icono: ICO.youtube },
];
---
<footer class="mm-zocalo">
  <div class="mm-zocalo-caja">
    <div class="mm-zocalo-marca">
      <div>
        <a class="mm-zocalo-logo" href="/" aria-label="Mr & Mrs Outdoor Living — home"><img src="/images/site/logo-mr-mr.svg" width="190" height="60" alt="" loading="lazy" /></a>
        <p class="mm-zocalo-lema">Proudly building custom pools and outdoor living spaces across North &amp; South Florida.</p>
      </div>
      <div class="mm-datos mm-zocalo-datos">
        {TELEFONOS.items.map((t) => <a class="mm-dato" href={`tel:${t.tel}`}><span class="mm-dato-rot">{t.zona}</span><span class="mm-dato-val">{t.visible}</span></a>)}
        <div class="mm-dato"><span class="mm-dato-rot">Licensed &amp; Insured</span><span class="mm-dato-val">CPC1461119 · CPC1460562 · SCC131153553</span></div>
      </div>
    </div>
    <div class="mm-zocalo-cols">
      <nav aria-label="Residential Services">
        <h2 class="mm-etiqueta">Residential Services</h2>
        <ul class="mm-zocalo-lista mm-zocalo-lista--num">
          {ORDEN_SERVICIOS_PIE.map((s) => <li><a class="mm-zocalo-a" href={s.href} aria-current={aqui(s.href)}>{s.texto}</a></li>)}
        </ul>
      </nav>
      <nav aria-label="Quick Links">
        <h2 class="mm-etiqueta">Quick Links</h2>
        <ul class="mm-zocalo-lista">
          {RAPIDOS.map((s) => <li><a class="mm-zocalo-a" href={s.href} aria-current={aqui(s.href)}>{s.texto}</a></li>)}
        </ul>
      </nav>
      <nav aria-label="Areas We Serve">
        <h2 class="mm-etiqueta">Areas We Serve</h2>
        <ul class="mm-zocalo-lista">
          {AREAS_PIE.map((s) => <li><a class="mm-zocalo-a" href={s.href} aria-current={aqui(s.href)}>{s.texto}</a></li>)}
        </ul>
        <div class="mm-zocalo-redes">
          {REDES.map((r) => <a class="mm-zocalo-red" href={r.href} aria-label={`Mr & Mrs Outdoor Living on ${r.nombre}`} set:html={r.icono} />)}
        </div>
      </nav>
    </div>
    <div class="mm-zocalo-legal">
      <span class="mm-zocalo-l mm-zocalo-l--suave">{copyright()}</span>
      <a class="mm-zocalo-l" href="/articles/terms-conditions" aria-current={aqui('/articles/terms-conditions')}>Terms of Service</a>
      <a class="mm-zocalo-l" href="/articles/privacy-policy" aria-current={aqui('/articles/privacy-policy')}>Privacy Policy</a>
      <a class="mm-zocalo-l" href="/articles/accessibility" aria-current={aqui('/articles/accessibility')}>Accessibility</a>
      <span class="mm-zocalo-l mm-zocalo-l--texto mm-zocalo-l--suave">Developed by&nbsp;<a class="mm-zocalo-firma" href="https://www.senaviacorp.com/">Senavia Corp.</a></span>
    </div>
  </div>
</footer>
