---
/**
 * FASE 7 (2.ª parte) — los componentes que quedaban de Webflow y de Finsweet.
 *
 *   1. `w-lightbox` — 137 referencias solo en `/gallery`. Se rehace con `<dialog>`, que trae
 *      gratis el modal, el foco atrapado y el cierre con Esc.
 *   2. El **marquee de logos** de Finsweet (`fs-marquee-*`), en `/`, `/about` y
 *      `/request-estimated`.
 *   3. El **slider** de Finsweet (`fs-slider-*`): 2 instancias en la home, proyectos y blog.
 *
 * Los tres van juntos porque comparten la misma regla: **si el JS no corre, se ve el primer
 * estado y nada se rompe**. El lightbox degrada a un enlace, el marquee a una fila de logos
 * quieta y el slider a una lista con scroll. Ninguno esconde nada.
 */
/**
 * DOS CAPAS, y el orden importa.
 *
 * `sliders.json` es DERIVADO del config de Finsweet (`npm run sliders`): es lo que el sitio
 * de Webflow servia. `sliders-diseno.json` NO es derivado: es lo que el rediseno decide.
 * Poner el segundo despues significa que regenerar el primero es seguro — el override vive
 * en otro fichero y el generador no lo alcanza. Es la misma forma del `NO_REGENERAR` de
 * `build-paginas.mjs`, pero sin tener que congelar el derivado.
 *
 * La fusion es SUPERFICIAL a proposito: una instancia declarada en la capa de diseno
 * sustituye a la de Finsweet entera. Fusionar breakpoint a breakpoint dejaria mezclas que
 * nadie ha mirado nunca -el 1920 del diseno con el 991 de Finsweet-, y el ancho de las
 * diapositivas es justo el numero que ya rompio `check:visual` una vez por inventarselo.
 *
 * Las claves `_*` son documentacion del repo y no se serializan: el motivo de un override
 * son ~900 bytes de prosa que no tienen por que viajar a las 115 paginas.
 */
import sliders from '../data/sliders.json';
import diseno from '../data/sliders-diseno.json';
const SLIDERS = JSON.stringify(
  { ...sliders.sliders, ...diseno.sliders },
  (k, v) => (k.startsWith('_') ? undefined : v),
);
---

<dialog class="mm-lb" aria-label="Image gallery">
  <button class="mm-lb__x" type="button" aria-label="Close">
    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" fill="none"/></svg>
  </button>
  <button class="mm-lb__nav mm-lb__nav--prev" type="button" aria-label="Previous image">
    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M15 5l-7 7 7 7" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" fill="none"/></svg>
  </button>
  <img class="mm-lb__img" alt="" />
  <button class="mm-lb__nav mm-lb__nav--next" type="button" aria-label="Next image">
    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M9 5l7 7-7 7" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" fill="none"/></svg>
  </button>
  <p class="mm-lb__cuenta" aria-live="polite"></p>
</dialog>

<style is:global>
  /* ── lightbox ─────────────────────────────────────────────────────────── */
  .mm-lb { border: 0; padding: 0; background: transparent; max-width: 100vw; max-height: 100vh; width: 100%; height: 100% }
  /* Velo del modal. ERA `#000000e6`: e6 = 230/255 = 90,196 % -> 90 %. Compuesto a 8 bits el
     pixel no se mueve: sobre pagina blanca rgb(25,25,25) antes y despues, sobre navy
     rgb(0,3,10) en los dos casos. Blanco encima del velo = 17,49:1 sobre pagina blanca y
     20,66:1 sobre navy (luminancia relativa WCAG 2.x, no estimado). */
  .mm-lb::backdrop { background-color: color-mix(in srgb, var(--mm-tinta-cuerpo) 90%, transparent) }
  .mm-lb[open] { display: grid; grid-template-columns: auto 1fr auto; align-items: center; gap: 1rem; padding: 1rem }
  .mm-lb__img { grid-column: 2; max-width: 100%; max-height: 88vh; margin: 0 auto; display: block; object-fit: contain }
  /* Pildora de los botones: blanco al 12 % sobre el velo. ERA `#ffffff1f`: 1f = 31/255 =
     12,157 % -> 12 %; compuesta a 8 bits da rgb(53,53,53) antes y despues sobre pagina
     blanca. El icono blanco encima = 12,26:1 (sobre navy, 16,09:1). */
  .mm-lb__nav, .mm-lb__x {
    background-color: color-mix(in srgb, var(--mm-blanco) 12%, transparent); border: 0; color: var(--mm-blanco); cursor: pointer;
    width: 48px; height: 48px; border-radius: 100%;
    display: grid; place-items: center;
  }
  /* Hover: blanco al 20 %. ERA `#ffffff33`: 33 = 51/255 = 20 % EXACTO, sin redondeo.
     Blanco encima = 9,23:1 sobre pagina blanca. */
  .mm-lb__nav:hover, .mm-lb__x:hover { background-color: color-mix(in srgb, var(--mm-blanco) 20%, transparent) }
  /* ERA `var(--yellow-1, #f4b248)`. El fallback estaba MUERTO: `disenio/puente.css` declara
     `--yellow-1: var(--mm-oro)`, asi que nunca se usaba. Se sustituye la expresion entera, no
     solo el literal. Mismo valor (#f4b248), o sea que el aro no cambia: oro contra la pildora
     6,60:1 y contra el velo 9,42:1, los dos muy por encima de los 3:1 de WCAG 1.4.11. Es oro
     y no `--mm-foco` porque aqui el fondo es el velo negro: el navy del foco claro no se
     veria. */
  .mm-lb__nav:focus-visible, .mm-lb__x:focus-visible { outline: var(--mm-foco-grosor) solid var(--mm-foco); outline-offset: var(--mm-foco-aire); box-shadow: var(--mm-foco-halo) }
  .mm-lb__nav svg, .mm-lb__x svg { width: 26px; height: 26px }
  .mm-lb__x { position: fixed; top: 1rem; right: 1rem }
  .mm-lb__cuenta { position: fixed; bottom: 1rem; left: 0; right: 0; text-align: center; color: var(--mm-blanco); margin: 0; font-size: 14px }
  @media (max-width: 767px) {
    /* 44, NO 40. Aqui ponia 40x40 y el suelo tactil son 44 (WCAG 2.2 AA, 2.5.8): medido en
       produccion a 360, 390 y 479, los tres por debajo. El de Cerrar ya cumplia con sus 48.
       Encoger los OTROS dos era justo al reves de lo que pide un movil, que es donde el dedo
       tapa el control. Los 8 px que se le devuelven a cada flecha salen del ancho de la foto:
       a 390 px pasa de ~299 a ~291, un 2,7 % menos de imagen a cambio de dos controles que se
       pueden acertar. */
    .mm-lb__nav { width: 44px; height: 44px }
    .mm-lb[open] { gap: .35rem; padding: .35rem }
  }

  /* ── marquee ──────────────────────────────────────────────────────────── */
  /* La duracion la calcula el JS con el ancho real, para que la VELOCIDAD sea la misma
     tenga 14 logos o 40. Un tiempo fijo hace que mas items = mas rapido. */
  /* La lista se queda EN FLUJO. Finsweet la saca con `position:absolute` y le da al wrapper
     una altura explicita; replicar eso obligaba a calcular esa altura, y calcularla mal
     encogia la seccion 20 px. En flujo, la altura la sigue poniendo el CSS del sitio y no hay
     nada que calcular. Lo que si se replica es el ancho fijo por elemento y el triplicado. */
  [fs-marquee-element="list"][data-mm-marquee] {
    display: flex; flex-wrap: nowrap; width: max-content;
    animation: mm-marquee var(--mm-dur, 30s) linear infinite;
  }
  [fs-marquee-element="wrapper"][data-mm-marquee] { overflow: hidden }
  /* EL ANCHO DEL LOGO LO PONE LA RAZON DE ASPECTO, NUNCA EL ATRIBUTO `width`.
     `webflow.css` solo le da altura (`.fs-marquee-logoscms_logo{height:35px}`) y confiaba en
     que el <img> no trajera `width`. El pase de CLS de R15-SEO se lo anadio en 27 ficheros
     -las 9 de country, las 14 de services, las 2 de estado, /about y /request-estimated- y
     ese atributo es una PISTA DE PRESENTACION que, sin un `width` en CSS que la gane, pasa a
     ser el ancho usado: el logo salia a 700px en vez de 111 y la lista media 43011px en vez de
     6009. Con `--mm-dur` calculado sobre ese ancho, la vuelta pasaba de 33s a 239s: el
     carrusel parecia parado, que es justo como se reporto.
     `width:auto` devuelve el ancho a la razon de aspecto y NO renuncia al CLS: el par
     width/height del atributo sigue dando la proporcion con la que el navegador reserva sitio
     antes de cargar. Medido: 700px -> 111px de logo y 732 -> 143 de item, clavado en los
     valores de las paginas que nunca se rompieron. Donde no habia atributo, no cambia nada. */
  .fs-marquee-logoscms_logo { width: auto }
  /* Un TERCIO, no la mitad: se triplica el contenido como hace Finsweet, asi que el bucle
     cierra cuando la primera copia ha salido entera. */
  @keyframes mm-marquee { to { transform: translateX(-33.3333%) } }
  [fs-marquee-element="marquee"]:hover [data-mm-marquee] { animation-play-state: paused }

  /* ── slider ───────────────────────────────────────────────────────────── */
  /* Sin `display:flex` ni `flex:none`: el CSS del sitio ya los pone. Aqui solo se anade el
     desplazamiento, que es lo que hacia el JS de Finsweet. */
  [fs-slider-element="list"][data-mm-slider] {
    overflow-x: auto; scroll-snap-type: x mandatory;
    scrollbar-width: none; -ms-overflow-style: none;
  }
  [fs-slider-element="list"][data-mm-slider]::-webkit-scrollbar { display: none }
  [fs-slider-element="list"][data-mm-slider] > * { scroll-snap-align: start }
  [fs-slider-element="previous"], [fs-slider-element="next"] { cursor: pointer }
  [fs-slider-element="previous"][aria-disabled="true"],
  [fs-slider-element="next"][aria-disabled="true"] { opacity: .35; pointer-events: none }

  /* ── antes/despues ────────────────────────────────────────────────────── */
  /* El sitio ya trae `.bas-image-after-h{width:50%;margin-left:auto}` y
     `.bas-line-h{left:50%}`. Arrastrar solo mueve ese 50%: se replica el mecanismo del
     original en vez de inventarse otro. */
  /* Se replica el mecanismo de Flowbase, leido del baseline:
       wrapper  --fb-thumb-position: 50%
       after    width:100%; height:100%; clip-path: inset(0 0 0 50%)
       handle   left:50%; top:50%; transform: translate(-50%,-50%)
       linea    left: var(--fb-thumb-position)
     Lo hacia con `width: calc(100% - X)`, y eso NO es lo mismo: con `object-fit: cover` una
     caja mas estrecha REESCALA la imagen en vez de recortarla. Se veia distinta. */
  [fb-before-after][data-mm-ba] { cursor: ew-resize; touch-action: none; user-select: none }
  [fb-before-after][data-mm-ba] .bas-image-after-h {
    width: 100%; height: 100%;
    clip-path: inset(0px 0px 0px var(--fb-thumb-position, 50%));
  }
  [fb-before-after][data-mm-ba] .bas-handle-h { left: var(--fb-thumb-position, 50%); top: 50%; transform: translate(-50%, -50%) }
  [fb-before-after][data-mm-ba] .bas-line-h { left: var(--fb-thumb-position, 50%); transform: translateX(-50%) }

  /* ── tabs ─────────────────────────────────────────────────────────────── */
  /* El CSS del sitio ya hace `.w-tab-pane{display:none}` y muestra `.w--tab-active`. */
  .w-tab-pane.w--tab-active { display: block }

  @media (prefers-reduced-motion: reduce) {
    [fs-marquee-element="list"][data-mm-marquee] { animation: none }
    /**
     * `!important`, Y NO ES ESTILO: sin el, esta regla no hacia NADA. MEDIDO con
     * `reducedMotion:'reduce'` en Playwright: `matchMedia(...).matches` daba `true` pero
     * `getComputedStyle(lista).scrollBehavior` seguia devolviendo `smooth` — la regla perdia
     * SIEMPRE contra el `lista.style.scrollBehavior = 'smooth'` que pone el script de mas
     * abajo, porque un estilo en linea solo lo gana otro estilo en linea o un `!important`.
     * Es la MISMA lección que ya dejo escrita `scripts/lib/captura.mjs` sobre el marquee -"el
     * congelado le gana por !important, por eso los pixeles salen identicos"- aplicada aqui
     * donde todavia faltaba: un visitante con "reducir movimiento" seguia viendo el slider
     * deslizarse suave en cada clic, que es exactamente lo que esa preferencia pide evitar.
     */
    [fs-slider-element="list"][data-mm-slider] { scroll-behavior: auto !important }
  }
  @media print { .mm-lb { display: none } }
</style>

<script define:vars={{ SLIDERS }}>
  (function () {
    'use strict';
    const CONF_SLIDERS = JSON.parse(SLIDERS);

    // ── 1 · lightbox ────────────────────────────────────────────────────
    const dlg = document.querySelector('.mm-lb');
    const img = dlg?.querySelector('.mm-lb__img');
    const cuenta = dlg?.querySelector('.mm-lb__cuenta');
    if (dlg && img) {
      /** Los grupos salen del JSON que Webflow deja en cada enlace. */
      const grupos = new Map();
      const enlaces = [...document.querySelectorAll('a.w-lightbox')];
      for (const a of enlaces) {
        if (a.closest('.gallery-page')) continue;   // split-panel lightbox (GalleryLeadLightbox.astro) owns these
        let datos;
        try { datos = JSON.parse(a.querySelector('script.w-json')?.textContent ?? '{}'); } catch { continue; }
        const items = (datos.items ?? []).filter((i) => i.type === 'image' && i.url);
        if (!items.length) continue;
        const g = datos.group || '__sin-grupo__';
        if (!grupos.has(g)) grupos.set(g, []);
        const lista = grupos.get(g);
        a.dataset.mmLbGrupo = g;
        a.dataset.mmLbIndice = String(lista.length);
        lista.push({ url: items[0].url, alt: a.querySelector('img')?.alt ?? '' });
      }

      /**
       * EL NOMBRE ACCESIBLE, para las que se quedaban mudas.
       *
       * 59 de las 433 anclas -las de `/project/*`- envuelven una imagen con `alt=""`. Y el
       * `alt` de una imagen que es el UNICO contenido de un enlace ES el nombre de ese enlace:
       * con el vacio, el lector de pantalla anuncia el `href`, que aqui es «#». WCAG 2.4.4 y
       * 4.1.2. Las otras 374 traen `alt` con texto y no se tocan: ese nombre ya es mejor que
       * cualquiera que pongamos aqui.
       *
       * SE ETIQUETA POR PROPOSITO, NO DESCRIBIENDO LA FOTO. El propósito del enlace es abrir
       * el visor, y ese es su nombre correcto; inventar texto alternativo para 59 fotos que
       * nadie ha mirado seria peor que el defecto, porque un `alt` falso no se distingue de
       * uno bueno. La descripcion, si algun dia se escribe, va en el origen.
       *
       * Va en una segunda pasada y no en el bucle de arriba porque `lista.length` -el «de N»-
       * no es definitivo hasta que el grupo esta entero.
       */
      for (const a of enlaces) {
        if (!a.dataset.mmLbGrupo || a.getAttribute('aria-label')) continue;
        if ((a.querySelector('img')?.alt ?? '').trim()) continue;
        const n = grupos.get(a.dataset.mmLbGrupo)?.length ?? 0;
        const i = Number(a.dataset.mmLbIndice) + 1;
        a.setAttribute('aria-label', n > 1 ? `Open image ${i} of ${n}` : 'Open image');
      }

      let actual = { grupo: null, i: 0 };
      const pinta = () => {
        const lista = grupos.get(actual.grupo) ?? [];
        const it = lista[actual.i];
        if (!it) return;
        img.src = it.url;
        img.alt = it.alt;
        cuenta.textContent = lista.length > 1 ? `${actual.i + 1} / ${lista.length}` : '';
        for (const b of dlg.querySelectorAll('.mm-lb__nav')) b.hidden = lista.length < 2;
      };
      const mueve = (d) => {
        const lista = grupos.get(actual.grupo) ?? [];
        if (lista.length < 2) return;
        actual.i = (actual.i + d + lista.length) % lista.length;
        pinta();
      };

      for (const a of enlaces) {
        if (!a.dataset.mmLbGrupo) continue;
        a.addEventListener('click', (ev) => {
          ev.preventDefault();
          // `stopPropagation` ademas del `preventDefault`: webflow.js traia un manejador de
          // anclas DELEGADO en `document` que hacia su propio history.pushState y dejaba DOS
          // entradas en el historial. No lo cargamos, pero la costumbre se queda por si algun
          // embed de la pagina hace lo mismo.
          ev.stopPropagation();
          actual = { grupo: a.dataset.mmLbGrupo, i: Number(a.dataset.mmLbIndice) };
          pinta();
          dlg.showModal();
        });
      }
      dlg.querySelector('.mm-lb__x')?.addEventListener('click', () => dlg.close());
      dlg.querySelector('.mm-lb__nav--prev')?.addEventListener('click', () => mueve(-1));
      dlg.querySelector('.mm-lb__nav--next')?.addEventListener('click', () => mueve(1));
      dlg.addEventListener('click', (ev) => { if (ev.target === dlg) dlg.close(); });
      dlg.addEventListener('keydown', (ev) => {
        if (ev.key === 'ArrowLeft') mueve(-1);
        if (ev.key === 'ArrowRight') mueve(1);
      });
    }

    // ── 2 · marquee ─────────────────────────────────────────────────────
    const montaMarquee = async (inst) => {
      const wrapper = inst.querySelector('[fs-marquee-element="wrapper"]');
      const lista = inst.querySelector('[fs-marquee-element="list"]');
      if (!wrapper || !lista || !lista.children.length) return;

      // MEDIR DESPUES DE QUE CARGUEN LAS IMAGENES. Los logos no llevan width/height, asi que
      // antes de cargar ocupan 0 y los anchos que se fijan salen mal. El sintoma no es un
      // error: es una fila de logos con los tamaños cambiados, que solo se ve comparando.
      const imgs = [...lista.querySelectorAll('img')].filter((i) => !i.complete);
      if (imgs.length) {
        await Promise.race([
          Promise.all(imgs.map((i) => new Promise((r) => {
            i.addEventListener('load', r, { once: true });
            i.addEventListener('error', r, { once: true });
          }))),
          new Promise((r) => setTimeout(r, 3000)),   // techo: una imagen que no llega no bloquea
        ]);
      }
      // Se duplica el contenido para que el bucle no de un salto al reiniciar: la animacion
      // llega a -50% justo cuando la copia esta donde estaba el original.
      // Se replica lo que hace Finsweet, leido del baseline: cada elemento con su ancho
      // natural y una altura comun, la lista absoluta con el ancho total, y el wrapper con
      // altura explicita.
      const originales = [...lista.children];
      // La altura se toma de la LISTA EN FLUJO, antes de sacarla con position:absolute. Si se
      // toma del elemento mas alto sale mas baja -medido: 20 px menos, y la seccion entera
      // encogia-. Finsweet hace lo mismo: fija `height: 67px` en el wrapper y en cada item,
      // que es lo que medía la caja original.
      // NO se fijan anchos por elemento. Se probo -Finsweet lo hace- y result que el ancho
      // medido depende de CUANDO hayan cargado los logos: la misma pagina daba 99,27 % en una
      // corrida y 98,48 % en la siguiente. Un numero que cambia entre corridas no sirve para
      // una puerta. `flex: 0 0 auto` basta para que no se encojan, y el ancho lo pone el CSS
      // del sitio a partir de la imagen, que es lo mismo cada vez.
      const anchoUno = lista.scrollWidth;
      for (const h of originales) h.style.flex = '0 0 auto';
      // Triplicado, como Finsweet: con solo dos copias el bucle se nota en pantallas anchas.
      for (let c = 0; c < 2; c++) {
        for (const h of originales) lista.appendChild(h.cloneNode(true));
      }
      lista.style.width = `${anchoUno * 3}px`;
      // 60 px/s: con el ancho real, la velocidad no depende de cuantos logos haya.
      lista.style.setProperty('--mm-dur', `${Math.max(12, Math.round(anchoUno / 60))}s`);
      lista.setAttribute('data-mm-marquee', '');
      wrapper.setAttribute('data-mm-marquee', '');
    };
    for (const inst of document.querySelectorAll('[fs-marquee-element="marquee"]')) montaMarquee(inst);

    // ── 3 · slider ──────────────────────────────────────────────────────
    for (const lista of document.querySelectorAll('[fs-slider-element="list"]')) {
      const inst = lista.closest('[fs-slider-instance]') ?? lista.parentElement?.parentElement;
      if (!inst || !lista.children.length) continue;
      lista.setAttribute('data-mm-slider', '');
      lista.style.scrollBehavior = 'smooth';

      /**
       * TECLADO — WCAG 2.1.1. La lista es un contenedor con `overflow-x:auto`, o sea que se
       * desplaza con rueda y con dedo pero NO con teclado: un contenedor scrollable solo
       * responde a las flechas si puede recibir el foco. Las dos flechas ya eran <button> y
       * ya se podian tabular, pero llevan al mismo sitio por saltos; esto da el recorrido
       * fino y, sobre todo, hace que el contenido se pueda leer sin raton.
       *
       * Nombre para el contenedor enfocable, porque uno sin nombre no dice al llegar que es.
       * El nombre sale del encabezado de la seccion: `aria-label` NO es `innerText`, asi que
       * `check:texto` no lo ve y sigue midiendo al 100 %.
       *
       * Alcanza a los 8 sliders del sitio, no solo al del blog. Es deliberado: el defecto
       * era del mecanismo, no de una instancia.
       *
       * EL ROL DEL TRACK NO SE PISA — MEDIDO. Hasta aqui esta linea ponia `role="group"`, y
       * el track ya venia del marcado con `role="list"` (o es un <ul>, como el de reseñas).
       * Pisarlo dejaba HUERFANOS a todos los `role="listitem"` de dentro: axe-core exige que
       * el padre de un `listitem` exponga `list` (`aria-required-parent`), y Lighthouse mide
       * el DOM despues de ejecutar JS. Coste medido: 2699 nodos en 84 paginas, 33 solo en la
       * home, y los 10 puntos enteros del audit. Un contenedor con `role="list"` admite
       * `aria-label` y `tabindex` igual de bien que uno con `group`, asi que no se perdia
       * nada a cambio. Se garantiza el rol en vez de imponerlo: si el marcado no trae ninguno
       * -y sus hijos si son `listitem`-, se pone `list`; si ya trae uno, manda el marcado.
       */
      lista.tabIndex = 0;
      if (!lista.hasAttribute('role') && !lista.matches('ul, ol, menu')) {
        lista.setAttribute('role', 'list');
      }
      if (!lista.hasAttribute('aria-label')) {
        const titulo = inst.closest('section')?.querySelector('h1, h2')?.textContent?.trim();
        lista.setAttribute('aria-label', titulo ? `${titulo} — carousel` : 'Carousel');
      }
      /**
       * HOME/END SE QUEDABAN FUERA DEL WCAG 2.1.1 DE ARRIBA.
       *
       * `←`/`→` ya funcionan solos -Chromium enruta las flechas al contenedor scrollable con
       * foco, y de paso respetan `scroll-snap-type`, medido: un `ArrowRight` mueve exactamente
       * un `paso()`, no un scroll de linea-. Home/End NO: son un atajo de PAGINA en Chromium
       * (saltar arriba/abajo del documento) que no se redirige al elemento enfocado solo por
       * tener foco y overflow horizontal. MEDIDO en /country/…-marion-…: con el foco en la
       * lista, `End` dejaba `track.scrollLeft` en 0 -sin moverse- y `scrollY` de la PAGINA
       * saltaba de 2347 a 6656 (el fondo del documento). Un usuario de teclado que llega al
       * carrusel y pulsa End para ir a la ultima tarjeta se encontraria la pagina entera
       * saltando al pie, no el carrusel avanzando.
       */
      lista.addEventListener('keydown', (ev) => {
        if (ev.key === 'Home') { ev.preventDefault(); lista.scrollLeft = 0; }
        else if (ev.key === 'End') { ev.preventDefault(); lista.scrollLeft = lista.scrollWidth; }
      });

      /**
       * EL ANCHO DE LAS DIAPOSITIVAS NO ES UNA DECISION MIA.
       * Sale de la configuracion del propio sitio (`slidesPerView` y `spaceBetween` por
       * breakpoint). Dejarlo al CSS daba `width:33.333%` -3 por vista- donde el sitio muestra
       * 4: la home salia 64 px mas corta y check:visual se quedaba en 98,x % en 100 paginas.
       */
      const conf = CONF_SLIDERS[inst.getAttribute('fs-slider-instance')];
      const dimensiona = () => {
        if (!conf) return;
        const puntos = Object.keys(conf.breakpoints).map(Number).sort((a, b) => a - b);
        const bp = puntos.filter((p) => innerWidth >= p).pop() ?? puntos[0];
        const { slidesPerView: n, spaceBetween: gap } = conf.breakpoints[bp];
        const ancho = lista.clientWidth;
        const w = (ancho - gap * (n - 1)) / n;
        for (const [i, s] of [...lista.children].entries()) {
          s.style.width = `${w}px`;
          s.style.marginRight = i === lista.children.length - 1 ? '' : `${gap}px`;
        }
      };
      dimensiona();
      addEventListener('resize', dimensiona, { passive: true });

      const prev = inst.querySelector('[fs-slider-element="previous"]');
      const next = inst.querySelector('[fs-slider-element="next"]');
      const drag = inst.querySelector('[fs-slider-element="scrollbar-drag"]');
      /**
       * EL PASO TIENE DOS FUENTES DE SEPARACION POSIBLES, Y SOLO SE MEDIA UNA.
       *
       * `dimensiona()` escribe `marginRight` en linea SOLO cuando la instancia tiene entrada en
       * sliders.json/sliders-diseno.json (`conf`). `fs-slider-resenas` no la tiene -no es un
       * slider heredado de Finsweet, es el widget nativo de reseñas- y separa sus tarjetas con
       * `gap` en `.mm-resenas__lista` (CSS, no JS). Con la formula vieja, `paso()` devolvia solo
       * 380 (el ancho) y el clic pedia `scrollLeft += 380`; MEDIDO en /country/…-marion-…: el
       * salto real que se veia en pantalla era 400 (380 + los 20px de gap), no por que esto
       * funcionara, sino porque `scroll-snap-type:x mandatory` reencarrilaba el destino al punto
       * de snap mas cercano -aqui, uno por delante, porque 380 cae mas cerca de 400 que de 0-.
       * Funcionaba DE CASUALIDAD: con una tarjeta mas ancha o un gap mayor, esos mismos 380
       * habrian caido mas cerca de 0 que de 400 y el clic en «next» no habria movido nada.
       * Se suma el `column-gap` del propio contenedor: 0 en los sliders que ya vienen de
       * `dimensiona()` (su gap vive en el marginRight en linea, no en CSS), y el de verdad en
       * los que no tienen `conf` y separan por CSS. Ninguna instancia usa las dos vias a la vez.
       */
      const paso = () => {
        const p = lista.firstElementChild;
        if (!p) return lista.clientWidth;
        const r = p.getBoundingClientRect();
        const gapCss = parseFloat(getComputedStyle(lista).columnGap) || 0;
        return r.width + parseFloat(getComputedStyle(p).marginRight || 0) + gapCss;
      };

      const refresca = () => {
        const max = lista.scrollWidth - lista.clientWidth;
        prev?.setAttribute('aria-disabled', String(lista.scrollLeft <= 1));
        next?.setAttribute('aria-disabled', String(lista.scrollLeft >= max - 1));
        if (drag && max > 0) {
          const visible = lista.clientWidth / lista.scrollWidth;
          drag.style.width = `${Math.max(10, visible * 100)}%`;
          drag.style.transform = `translateX(${(lista.scrollLeft / max) * (100 / visible - 100)}%)`;
        }
      };
      /**
       * NOMBRE ACCESIBLE DE LAS FLECHAS — `button-name`, 10 puntos de A11y.
       *
       * Las flechas son <button> con un icono de fondo y CERO texto dentro, o sea sin nombre
       * accesible. Cuatro de ellas fallaban en la home (proyectos y blog) y el defecto es del
       * MECANISMO: alcanza a proyectos (66 rutas), galeria (24), blog de la home (1) e
       * industries (1). Ponerlo aqui las cubre todas de una vez, en vez de en los 24 strings
       * derivados donde tambien vive ese marcado.
       *
       * `hasAttribute` manda: `CarruselBlog.astro` y `ResenasGoogle.astro` ya traen el suyo
       * del marcado («Previous posts», «Previous reviews») y no se pisan.
       *
       * El nombre se cuelga del que ya tiene la lista -el encabezado de la seccion-, asi que
       * dos carruseles de la misma pagina no acaban con flechas homonimas. `aria-label` no es
       * `innerText`: `check:texto` no lo ve.
       */
      const nombreLista = (lista.getAttribute('aria-label') ?? '').replace(/\s+—\s+carousel$/, '');
      for (const [b, d] of [[prev, -1], [next, 1]]) {
        if (!b) continue;
        b.setAttribute('role', 'button');
        b.setAttribute('tabindex', '0');
        if (!b.hasAttribute('aria-label') && !b.textContent.trim()) {
          const sentido = d < 0 ? 'Previous' : 'Next';
          b.setAttribute('aria-label', nombreLista ? `${sentido} — ${nombreLista}` : sentido);
        }
        b.addEventListener('click', () => { lista.scrollLeft += d * paso(); });
        b.addEventListener('keydown', (ev) => {
          if (ev.key === 'Enter' || ev.key === ' ') { ev.preventDefault(); b.click(); }
        });
      }

      /**
       * LA BARRA ERA UN INDICADOR, NO UN CONTROL — MEDIDO, no supuesto.
       *
       * `refresca()`, arriba, ya la pinta -ancho y posicion siguen a `scrollLeft`-, pero nada
       * escuchaba al reves: agarrar el pulgar y arrastrar no movia un pixel el track. Lo
       * confirme con un arrastre de raton sintetico en las 3 instancias de una pagina de
       * condado (`fs-slider-gallery`, `-projects`, `-resenas`): `scrollLeft` antes y despues,
       * identico los 3 casos. El pedido explicito era «scrollbar arrastrable», asi que esto
       * completa lo que `refresca()` ya daba por sentado que existia.
       *
       * Pointer Events, no mousedown/touchmove: un solo listener cubre raton y dedo, y
       * `setPointerCapture` mantiene el arrastre aunque el puntero salga del pulgar -sin eso,
       * un arrastre rapido lo pierde a medio camino, que es peor que no tener arrastre-.
       * `touch-action:none` en el pulgar evita que el propio gesto intente ademas paginar la
       * pantalla en movil: el area es pequena (1rem de alto) y facil de rozar en diagonal.
       *
       * Al soltar, redondea al `paso()` mas cercano. Sin esto el arrastre deja el track en
       * cualquier `scrollLeft` -el mandatory de scroll-snap no se aplica a una escritura
       * directa de `scrollLeft`, solo a gestos que el navegador reconoce como tales-, y una
       * tarjeta a medias tras soltar es exactamente el «salto» que este auditor existe para
       * cazar.
       */
      if (drag) {
        const barra = inst.querySelector('[fs-slider-element="scrollbar"]') ?? drag.parentElement;
        drag.style.touchAction = 'none';
        let activo = false, inicioX = 0, inicioScroll = 0;
        drag.addEventListener('pointerdown', (ev) => {
          const max = lista.scrollWidth - lista.clientWidth;
          if (max <= 0) return;
          activo = true;
          inicioX = ev.clientX;
          inicioScroll = lista.scrollLeft;
          drag.setPointerCapture(ev.pointerId);
          lista.style.scrollBehavior = 'auto';   // arrastre 1:1 con el dedo/raton, sin inercia de por medio
          ev.preventDefault();
        });
        drag.addEventListener('pointermove', (ev) => {
          if (!activo) return;
          const max = lista.scrollWidth - lista.clientWidth;
          const pista = barra.clientWidth - drag.offsetWidth;
          if (max <= 0 || pista <= 0) return;
          const dx = ev.clientX - inicioX;
          lista.scrollLeft = Math.min(max, Math.max(0, inicioScroll + dx * (max / pista)));
        });
        const soltar = (ev) => {
          if (!activo) return;
          activo = false;
          try { drag.releasePointerCapture(ev.pointerId); } catch { /* ya liberado */ }
          const reducido = matchMedia('(prefers-reduced-motion: reduce)').matches;
          lista.style.scrollBehavior = reducido ? 'auto' : 'smooth';
          const p = paso();
          if (p > 0) lista.scrollLeft = Math.round(lista.scrollLeft / p) * p;
        };
        drag.addEventListener('pointerup', soltar);
        drag.addEventListener('pointercancel', soltar);
      }

      lista.addEventListener('scroll', refresca, { passive: true });
      addEventListener('resize', () => { dimensiona(); refresca(); }, { passive: true });
      refresca();

      /**
       * AUTOPLAY. Tambien sale de la configuracion del sitio: el slider del blog y el de la
       * galeria avanzan cada 3 s. No implementarlo dejaba el slider quieto, y eso ES una
       * diferencia de comportamiento.
       *
       * `disableOnInteraction: true` en la config del sitio: se para en cuanto el visitante
       * toca. Y se respeta `prefers-reduced-motion`: un carrusel que se mueve solo es
       * exactamente lo que esa preferencia pide evitar.
       */
      if (conf?.autoplayMs && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
        const avanza = () => {
          const max = lista.scrollWidth - lista.clientWidth;
          if (lista.scrollLeft >= max - 1) lista.scrollLeft = 0;
          else lista.scrollLeft += paso();
        };

        /**
         * DOS ESTADOS DISTINTOS, y por eso hay dos variables en vez de un `null` con dos
         * significados: `detenido` es la parada DEFINITIVA que pedia `disableOnInteraction`
         * del config del sitio, y `tick` es solo si ahora mismo corre o no. Con una sola
         * variable, «pausado por hover» y «parado porque el visitante toco» se confunden, y
         * el sintoma seria un carrusel que revive al sacar el raton despues de que alguien
         * lo hubiera parado a proposito.
         */
        let tick = null;
        let detenido = false;
        const arranca = () => { if (!detenido && tick === null) tick = setInterval(avanza, conf.autoplayMs); };
        const frena = () => { if (tick !== null) { clearInterval(tick); tick = null; } };
        const para = () => { detenido = true; frena(); };

        arranca();
        for (const ev of ['pointerdown', 'keydown', 'wheel']) lista.addEventListener(ev, para, { once: true, passive: true });
        for (const b of [prev, next]) b?.addEventListener('click', para, { once: true });

        /**
         * PAUSA — WCAG 2.2.2, que pide poder parar lo que se mueve solo y dura mas de 5 s.
         * Lo de arriba ya paraba al tocar, pero eso no se descubre: hay que interactuar con
         * el carrusel para enterarse de que se puede. Pasar el raton por encima o llegar
         * tabulando lo pausa mientras se lee, que es cuando estorba.
         *
         * Va en `inst` y no en `lista` para que las flechas cuenten como «encima».
         * `focusin`/`focusout` y no `focus`/`blur`: estos no burbujean, y quien recibe el
         * foco es un hijo -la lista o un boton-, nunca la instancia.
         */
        inst.addEventListener('mouseenter', frena);
        inst.addEventListener('mouseleave', arranca);
        inst.addEventListener('focusin', frena);
        inst.addEventListener('focusout', arranca);
      }
    }

    // ── 4 · antes/despues ────────────────────────────────────────────────
    for (const w of document.querySelectorAll('[fb-before-after]')) {
      const handle = w.querySelector('[fb-before-after-handle]');
      if (!w.querySelector('.bas-image-after-h')) continue;
      const inicio = Number(w.getAttribute('fb-before-after-start') || 50);
      w.setAttribute('data-mm-ba', '');
      const pon = (pct) => w.style.setProperty('--fb-thumb-position', `${Math.min(100, Math.max(0, pct))}%`);
      pon(inicio);

      let arrastrando = false;
      const desde = (ev) => {
        const r = w.getBoundingClientRect();
        const x = (ev.touches?.[0]?.clientX ?? ev.clientX) - r.left;
        pon((x / r.width) * 100);
      };
      const empieza = (ev) => { arrastrando = true; desde(ev); ev.preventDefault(); };
      w.addEventListener('pointerdown', empieza);
      addEventListener('pointermove', (ev) => { if (arrastrando) desde(ev); });
      addEventListener('pointerup', () => { arrastrando = false; });

      // Accesible con teclado: sin esto, un control que solo responde al raton deja fuera a
      // quien navega con tabulador.
      if (handle) {
        handle.setAttribute('role', 'slider');
        handle.setAttribute('tabindex', '0');
        handle.setAttribute('aria-label', 'Compare before and after');
        handle.setAttribute('aria-valuemin', '0');
        handle.setAttribute('aria-valuemax', '100');
        handle.setAttribute('aria-valuenow', String(inicio));
        let v = inicio;
        handle.addEventListener('keydown', (ev) => {
          const paso = ev.shiftKey ? 10 : 2;
          if (ev.key === 'ArrowLeft') v -= paso;
          else if (ev.key === 'ArrowRight') v += paso;
          else return;
          ev.preventDefault();
          v = Math.min(100, Math.max(0, v));
          pon(v);
          handle.setAttribute('aria-valuenow', String(v));
        });
      }
    }

    // ── 5 · tabs ─────────────────────────────────────────────────────────
    for (const tabs of document.querySelectorAll('.w-tabs')) {
      const enlaces = [...tabs.querySelectorAll('.w-tab-link')];
      const panes = [...tabs.querySelectorAll('.w-tab-pane')];
      if (!enlaces.length || !panes.length) continue;
      const menu = tabs.querySelector('.w-tab-menu');
      if (menu) menu.setAttribute('role', 'tablist');

      const activa = (nombre) => {
        for (const a of enlaces) {
          const suyo = a.getAttribute('data-w-tab') === nombre;
          a.classList.toggle('w--current', suyo);
          a.setAttribute('role', 'tab');
          a.setAttribute('tabindex', suyo ? '0' : '-1');
          a.setAttribute('aria-selected', String(suyo));
        }
        for (const p of panes) {
          const suyo = p.getAttribute('data-w-tab') === nombre;
          p.classList.toggle('w--tab-active', suyo);
          p.setAttribute('role', 'tabpanel');
        }
      };
      for (const [i, a] of enlaces.entries()) {
        a.addEventListener('click', (ev) => { ev.preventDefault(); activa(a.getAttribute('data-w-tab')); });
        a.addEventListener('keydown', (ev) => {
          const d = ev.key === 'ArrowRight' ? 1 : ev.key === 'ArrowLeft' ? -1 : 0;
          if (!d) return;
          ev.preventDefault();
          const sig = enlaces[(i + d + enlaces.length) % enlaces.length];
          activa(sig.getAttribute('data-w-tab'));
          sig.focus();
        });
      }
      // Se respeta cual venia marcada en el marcado; si no hay ninguna, la primera.
      const actual = enlaces.find((a) => a.classList.contains('w--current')) ?? enlaces[0];
      activa(actual.getAttribute('data-w-tab'));
    }
  }());
</script>
