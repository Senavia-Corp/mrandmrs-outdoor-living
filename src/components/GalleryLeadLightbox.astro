---
/**
 * Lightbox partido de /gallery: foto+nav a la izquierda, el mismo formulario de 3 pasos de
 * /request-estimated a la derecha. Por debajo de 992 LA FOTO MANDA: el visor ocupa el dialogo
 * entero, el formulario viaja PLEGADO y lo despliega un CTA fijo abajo como hoja deslizante
 * -ver «HOJA DEL FORMULARIO» en el <style>-. Antes la foto era una banda de 186px con el
 * formulario debajo comiendose el 75 % de la pantalla, y Sebastian lo vio en su iPhone.
 * Ruta-limitado a proposito -no solo
 * autolimitado por DOM como Componentes.astro/Formularios.astro- porque si esto se pintara en
 * TODA pagina, /request-estimated tendria dos formularios "Request Quote Form" a la vez y
 * cualquier codigo por id chocaria. Aqui no hay ids -ver el <script>- pero el marcado tampoco
 * tiene por que existir donde no hace falta.
 *
 * El formulario embebido es una COPIA adaptada del de request-estimated.astro (que es DERIVADO
 * -ver scripts/build-paginas.mjs- y no se puede importar ni enlazar desde aqui sin arriesgarse a
 * que `npm run paginas` lo borre). Los 14 value= de las casillas de servicio ya vienen del mismo
 * arreglo que build-paginas.mjs le aplica a la pagina real -mismo texto, mismo orden-.
 *
 * R13-LBX. Las ETIQUETAS visibles de las casillas son cortas y las de la pagina real no: el
 * `value=` -lo que viaja al backend y sale en el correo del lead- es identico en las dos. El
 * texto de dentro del dialogo es libre porque check:texto compara `innerText` y un <dialog>
 * cerrado no pinta (display:none del UA), asi que aporta CERO lineas al baseline. Medido:
 * baseline/text/gallery.txt son 110 lineas y ninguna es del formulario.
 * La etiqueta larga partia en DOS lineas y ponia la ficha en 76px; en una linea mide 44 y es lo
 * que hace que los 14 servicios quepan sin scroll. Ver el bloque de la rejilla, mas abajo.
 */
// `/gallery/<slug>` tambien (2-oct-2026): las paginas de categoria son la misma rejilla y el
// visor con formulario es su mecanismo de captacion. Sigue sin pintarse en ninguna otra ruta.
const enGaleria = /^\/gallery(\/[^/]+)?\/?$/.test(Astro.url.pathname);
---
{enGaleria && (
  <dialog class="mm-lbx" aria-label="Photo and project estimate request">
    <button class="mm-lbx__x" type="button" aria-label="Close">
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" fill="none"/></svg>
    </button>
    <div class="mm-lbx__panel">
      <div class="mm-lbx__visor">
        <img class="mm-lbx__ambiente" alt="" aria-hidden="true" decoding="async" />
        <button class="mm-lbx__nav mm-lbx__nav--prev" type="button" aria-label="Previous image">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M15 5l-7 7 7 7" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" fill="none"/></svg>
        </button>
        <img class="mm-lbx__img" alt="" />
        <button class="mm-lbx__nav mm-lbx__nav--next" type="button" aria-label="Next image">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M9 5l7 7-7 7" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" fill="none"/></svg>
        </button>
        <p class="mm-lbx__cuenta" aria-live="polite"></p>
      </div>

      <div class="mm-lbx__cta">
        <button class="mm-lbx__pide" type="button" aria-expanded="false">Get a Free Estimate</button>
      </div>

      <div class="mm-lbx__formulario">
        <div class="mm-lbx__cabecera">
          <p>Get a Free Estimate</p>
          <button class="mm-lbx__pliega" type="button" aria-label="Back to photo">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 9l7 7 7-7" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" fill="none"/></svg>
          </button>
        </div>
        <form data-name="Request Quote Form" method="post" action="/api/formulario" data-mm-envia="1">
          <div class="step-wrapper">
            <div data-step="1" class="msf-step">
              <div class="header-form"><h2>What are you planning?</h2></div>
              <div class="services-form">
                <label class="w-checkbox"><input type="checkbox" name="checkbox" data-name="Checkbox" class="w-checkbox-input" value="New Pool and Spa Construction"><span class="w-form-label"><strong>Pool &amp; Spa</strong></span></label>
                <label class="w-checkbox"><input type="checkbox" name="checkbox" data-name="Checkbox" class="w-checkbox-input" value="Pool Remodeling and Renovation"><span class="w-form-label"><strong>Pool Remodel</strong></span></label>
                <label class="w-checkbox"><input type="checkbox" name="checkbox" data-name="Checkbox" class="w-checkbox-input" value="Pool Screen Enclosures"><span class="w-form-label"><strong>Pool Enclosure</strong></span></label>
                <label class="w-checkbox"><input type="checkbox" name="checkbox" data-name="Checkbox" class="w-checkbox-input" value="Aluminum and Wood Pergolas"><span class="w-form-label"><strong>Pergolas</strong></span></label>
                <label class="w-checkbox"><input type="checkbox" name="checkbox" data-name="Checkbox" class="w-checkbox-input" value="Louvered Roof Systems"><span class="w-form-label"><strong>Louvered Roof</strong></span></label>
                <label class="w-checkbox"><input type="checkbox" name="checkbox" data-name="Checkbox" class="w-checkbox-input" value="Pole Barn and Steel Buildings"><span class="w-form-label"><strong>Pole Barns</strong></span></label>
                <label class="w-checkbox"><input type="checkbox" name="checkbox" data-name="Checkbox" class="w-checkbox-input" value="Landscaping"><span class="w-form-label"><strong>Landscaping</strong></span></label>
                <label class="w-checkbox"><input type="checkbox" name="checkbox" data-name="Checkbox" class="w-checkbox-input" value="Automated Irrigation"><span class="w-form-label"><strong>Irrigation</strong></span></label>
                <label class="w-checkbox"><input type="checkbox" name="checkbox" data-name="Checkbox" class="w-checkbox-input" value="Smart Soffit LED Lighting"><span class="w-form-label"><strong>LED Lighting</strong></span></label>
                <label class="w-checkbox"><input type="checkbox" name="checkbox" data-name="Checkbox" class="w-checkbox-input" value="Custom Decks"><span class="w-form-label"><strong>Decks</strong></span></label>
                <label class="w-checkbox"><input type="checkbox" name="checkbox" data-name="Checkbox" class="w-checkbox-input" value="Patio Screen Rooms"><span class="w-form-label"><strong>Screen Rooms</strong></span></label>
                <label class="w-checkbox"><input type="checkbox" name="checkbox" data-name="Checkbox" class="w-checkbox-input" value="Retractable Screens"><span class="w-form-label"><strong>Retractables</strong></span></label>
                <label class="w-checkbox"><input type="checkbox" name="checkbox" data-name="Checkbox" class="w-checkbox-input" value="Outdoor Kitchens"><span class="w-form-label"><strong>Kitchens</strong></span></label>
                <label class="w-checkbox"><input type="checkbox" name="checkbox" data-name="Checkbox" class="w-checkbox-input" value="Outdoor Furniture"><span class="w-form-label"><strong>Furniture</strong></span></label>
              </div>
            </div>

            <div data-step="2" class="msf-step">
              <div class="header-form"><h2>Tell us about the project</h2></div>
              <div class="bugget-form">
                <div class="text-block-6">Estimated Project Budget:</div>
                <select name="Estimated-Project-Budget" data-name="Estimated Project Budget" data-required="true" class="select-field w-select">
                  <option value="">Select one...</option>
                  <option value="Under $25,000">Under $25,000</option>
                  <option value="$25,000 – $50,000">$25,000 – $50,000</option>
                  <option value="$50,000 – $75,000">$50,000 – $75,000</option>
                  <option value="$75,000 – $100,000">$75,000 – $100,000</option>
                  <option value="$100,000 – $150,000">$100,000 – $150,000</option>
                  <option value="$150,000+">$150,000+</option>
                </select>
              </div>
              <input data-required="true" class="text-field-form w-input" maxlength="256" name="Street-Address" data-name="Street Address" placeholder="Enter the street address" type="text">
              <input data-required="true" class="text-field-form w-input" maxlength="256" name="City" data-name="City" placeholder="Enter the city" type="text">
              <input class="text-field-form w-input" maxlength="256" name="State" data-name="State" placeholder="Enter the state" type="text">
              <input data-required="true" class="text-field-form w-input" maxlength="256" name="ZIP-Code" data-name="ZIP Code" placeholder="Enter ZIP code" type="text">
            </div>

            <div data-step="3" class="msf-step">
              <div class="header-form"><h2>How can we reach you?</h2></div>
              <input data-required="true" class="text-field-form w-input" maxlength="256" name="Full-Name" data-name="Full Name" placeholder="Enter your full name" type="text">
              <input data-required="true" class="text-field-form w-input" maxlength="256" name="email" data-name="Email" placeholder="Enter your email" type="email" data-type="email">
              <input data-required="true" class="text-field-form w-input" maxlength="256" name="Phone" data-name="Phone" placeholder="Enter your phone" type="tel" data-type="phone">
              <label class="w-checkbox checkbox-field">
                <input type="checkbox" name="Checkbox" data-name="Checkbox" required class="w-checkbox-input">
                <span class="checkbox-label-3 w-form-label">I agree to receive SMS messages related to project updates, promotions, and company communications from Mr. &amp; Mrs. Outdoor Living. I understand that I may opt out at any time by replying STOP. Message and data rates may apply.</span>
              </label>
              <div class="wrapper-buttons-center">
                <input type="submit" data-wait="Please wait..." class="button w-button msf-submit" value="Request My Estimate">
              </div>
              <div class="text-block-7">By submitting this form, you agree to our <a href="https://mrandmrsoutdoorsliving.com/terms-of-service" target="_blank" rel="noopener" class="link-4">Terms</a> &amp; <a href="https://mrandmrsoutdoorsliving.com/privacy-policy-page" target="_blank" rel="noopener" class="link-4">Privacy Policy.</a></div>
            </div>

            <div class="msf-buttons">
              <a href="#" class="msf-back w-button">Back</a>
              <a href="#" class="msf-next w-button">Next</a>
            </div>
          </div>
          <input type="text" name="ref_id" tabindex="-1" autocomplete="off" aria-hidden="true"
                 style="position:absolute;left:-9999px;width:1px;height:1px;opacity:0">
        </form>

        <div class="success-message-form w-form-done">
          <svg xmlns="http://www.w3.org/2000/svg" width="56" height="56" fill="none" viewBox="0 0 18 20"><path fill="currentColor" d="m17.351 3.063-8-3a1.009 1.009 0 0 0-.7 0l-8 3A1 1 0 0 0 0 4a19.394 19.394 0 0 0 8.47 15.848 1 1 0 0 0 1.06 0A19.394 19.394 0 0 0 18 4a1 1 0 0 0-.649-.937Zm-3.644 4.644-5 5A1 1 0 0 1 8 13c-.033 0-.065 0-.1-.005a1.001 1.001 0 0 1-.733-.44l-2-3a1 1 0 0 1 1.664-1.11l1.323 1.986 4.138-4.138a1 1 0 0 1 1.414 1.414h.001Z"/></svg>
          <h2>Thank you! Your request has been successfully received.</h2>
          <div>Our team is reviewing your project details and will contact you shortly with next steps and recommendations.</div>
        </div>
        <div class="w-form-fail"><div>Oops! Something went wrong while submitting the form.</div></div>
      </div>
    </div>
  </dialog>
)}

<style is:global>
  /* El dialogo CERRADO no declara `display` a proposito: hereda el display:none de la hoja de
     agente de usuario. Si aqui se escribiera un `display` sin `[open]`, las ~40 lineas del
     formulario entrarian en `innerText` y check:texto -que compara al 100 % y cuyo
     baseline/text/ NO se re-baseliniza nunca- se pondria rojo en /gallery. */
  .mm-lbx { border: 0; padding: 0; background: transparent; max-width: 100vw }
  .mm-lbx::backdrop { background-color: color-mix(in srgb, var(--mm-tinta-cuerpo) 90%, transparent) }

  /* mobile-first: hoja anclada abajo por margin dentro de la caja fixed del modal; el 4 % de
     velo que asoma arriba sigue siendo un camino de cierre (tocar fuera). ALTURA FIJA, no
     max-height: con altura de contenido, el dialogo encogia 100px al pasar del paso 1 al 2 y la
     foto saltaba. Sin el tope de 820px de antes: aqui el alto es FOTO, y en una tableta en
     vertical 820 dejaba 200px de velo muerto encima de ella.
     El fondo es el oscuro del visor, no la superficie blanca: por debajo de 992 lo que se ve es
     visor + barra del CTA, los dos oscuros; el blanco lo trae la hoja del formulario. */
  .mm-lbx[open] {
    display: flex;
    flex-direction: column;
    width: 100%;
    height: 96dvh;
    margin: auto 0 0;
    border-radius: var(--mm-r-24) var(--mm-r-24) 0 0;
    background-color: var(--mm-tinta-cuerpo);
    box-shadow: var(--mm-sombra-3);
    overflow: hidden;
  }
  /* flex-direction es CONTRATO: check-galeria-formulario.mjs exige `column` por debajo de 992 y
     `row` a partir de 992, medido en los dos anchos frontera. Nada de Grid aqui. */
  .mm-lbx__panel { display: flex; flex-direction: column; min-height: 0; flex: 1 1 auto }

  /* VISOR. Por debajo de 992 se lleva TODO lo que la barra del CTA no usa: `flex: 1 1 0` con
     el contenido en absoluto, asi que la base es 0 y crece hasta llenar la columna (~90 % del
     dialogo a 390x844 y a 991x800, medido por check-galeria-formulario.mjs). Antes era una
     banda 16:9 capada a min(22dvh, 240px) -186px a 390x844- con el formulario debajo ocupando
     el resto: una foto apaisada salia a 330px de ancho en una pantalla de 390. Ahora pinta a
     los 390 enteros, que es el maximo fisico de una foto apaisada en un telefono en vertical,
     y lo que `contain` deja arriba y abajo lo llena el sangrado ambiental.
     Ya no hay `aspect-ratio`, asi que tampoco esta la trampa de galeria.css:102-106
     (aspect-ratio + height en la misma caja). De las 137 fotos, 82 estan en 1,791 (=16:9 a un
     0,7 %) y solo 3 son verticales:
         $ ... | sips -g pixelWidth -g pixelHeight | awk '{w/h}' | sort -n | uniq -c
           82 1.791   29 1.340   8 1.490   15 resto apaisado   3 verticales (0,80 0,75 0,62)
     Por eso `object-fit` sigue siendo `contain` -la convencion de .mm-lb en Componentes.astro-:
     `cover` recortaria el 25 % de las 29 fotos a 4:3 y el 65 % de las verticales, y son obras
     reales de clientes. Lo que el `contain` deja libre no se deja en negro: se llena.
     `touch-action: pan-y pinch-zoom`: el deslizamiento horizontal es nuestro -pasa de foto,
     ver el <script>-; el vertical y el zoom siguen siendo del navegador. */
  .mm-lbx__visor {
    position: relative;
    flex: 1 1 0;
    min-height: 0;
    background-color: var(--mm-tinta-cuerpo);
    overflow: hidden;
    touch-action: pan-y pinch-zoom;
  }
  /* Velo sobre la foto mientras la hoja esta desplegada: la foto sigue ahi -es el contexto del
     formulario- pero deja de competir con el. Tocarlo pliega la hoja (ver el <script>). Las
     flechas llevan z-index:1 y quedan por encima, aunque la hoja ya las tapa casi enteras. */
  .mm-lbx--pide .mm-lbx__visor::after {
    content: ""; position: absolute; inset: 0;
    background-color: color-mix(in srgb, var(--mm-tinta-cuerpo) 55%, transparent);
  }

  /* SANGRADO AMBIENTAL. La misma foto, desenfocada y bajada de brillo, ocupa lo que `contain`
     deja libre. Antes eran 423px de negro muerto -el 53 % del panel a 1440x900-; ahora es el
     color de la propia foto, distinto en cada una de las 137. Cero recorte y cero negro.
     Va PRIMERO en el DOM: los dos <img> son `absolute` con z-index auto, asi que el orden de
     pintado es el orden del arbol y la foto nitida queda encima. El scale() esconde los bordes
     blandos que deja el blur en el perimetro. */
  .mm-lbx__ambiente {
    position: absolute; inset: 0; width: 100%; height: 100%;
    object-fit: cover;
    filter: blur(32px) saturate(1.2) brightness(.55);
    transform: scale(1.15);
  }
  .mm-lbx__img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: contain }

  /* Los tres controles del visor viven SOBRE la foto, asi que el velo tiene que ser oscuro. El
     blanco al 12 % de antes era invisible sobre las fotos claras -travertino, cielos quemados,
     y hay muchas- y ademas el boton X cae en escritorio sobre el panel BLANCO del formulario:
     era blanco sobre blanco. Con el velo negro al 60 %, el peor caso -foto blanca pura- resuelve
     el compuesto a #666666 y el blanco encima da 5,74:1: pasa los 4,5:1 de TEXTO (el contador) y
     de sobra los 3:1 de WCAG 1.4.11 (las flechas y la X). Se descarto el navy al 60 %, que da
     4,46:1 y solo habria valido para los iconos. */
  .mm-lbx__nav, .mm-lbx__x {
    position: absolute;
    background-color: color-mix(in srgb, var(--mm-tinta-cuerpo) 60%, transparent); border: 0; color: var(--mm-blanco); cursor: pointer;
    width: 44px; height: 44px; border-radius: 100%;
    display: grid; place-items: center; z-index: 1;
    transition: background-color 150ms ease-out, transform 150ms ease-out;
  }
  .mm-lbx__x:active { transform: scale(.94) }
  /* Las flechas ya van centradas con translateY: el :active lo REPITE en vez de sustituirlo,
     porque `transform` es una sola propiedad y escribir solo el scale las descolocaria. */
  .mm-lbx__nav--prev:active { transform: translateY(-50%) scale(.94) }
  .mm-lbx__nav--next:active { transform: translateY(-50%) scale(.94) }
  .mm-lbx__nav:hover, .mm-lbx__x:hover { background-color: color-mix(in srgb, var(--mm-tinta-cuerpo) 78%, transparent) }
  .mm-lbx__nav:focus-visible, .mm-lbx__x:focus-visible { outline: var(--mm-foco-grosor) solid var(--mm-foco-inverso); outline-offset: var(--mm-foco-aire) }
  .mm-lbx__nav svg, .mm-lbx__x svg { width: 22px; height: 22px }
  .mm-lbx__nav--prev { top: 50%; left: var(--mm-e-12); transform: translateY(-50%) }
  .mm-lbx__nav--next { top: 50%; right: var(--mm-e-12); transform: translateY(-50%) }
  .mm-lbx__x { top: var(--mm-e-12); right: var(--mm-e-12); z-index: 2 }
  .mm-lbx__cuenta {
    position: absolute; bottom: var(--mm-e-12); left: 50%; transform: translateX(-50%);
    margin: 0; padding: var(--mm-e-4) var(--mm-e-12);
    border-radius: var(--mm-r-pastilla);
    background-color: color-mix(in srgb, var(--mm-tinta-cuerpo) 60%, transparent);
    color: var(--mm-blanco); font-size: var(--mm-paso-0);
    font-variant-numeric: tabular-nums;
  }

  /* BARRA DEL CTA (solo <992: en escritorio el formulario ya esta a la vista y la barra sobra,
     ver la media query de abajo). Un solo boton a todo el ancho con el mismo texto que los
     8 «Get a Free Estimate» del sitio. 52 de alto, por encima del suelo tactil de 44, porque
     es EL boton de la pantalla. El safe-area es para la barra de inicio del iPhone: con el
     viewport-fit por defecto vale 0 y no estorba. */
  .mm-lbx__cta {
    flex: 0 0 auto;
    padding: var(--mm-e-12) var(--mm-e-16) calc(var(--mm-e-16) + env(safe-area-inset-bottom, 0px));
    background-color: var(--mm-tinta-cuerpo);
  }
  .mm-lbx__pide {
    display: flex; align-items: center; justify-content: center;
    width: 100%; min-height: 52px; padding: 0 var(--mm-e-24);
    border: 0; border-radius: var(--mm-r-pastilla);
    background-color: var(--mm-accion); color: var(--mm-sobre-accion);
    font-family: inherit; font-weight: var(--mm-peso-fuerte); font-size: var(--mm-paso-2);
    cursor: pointer;
    transition: background-color 150ms ease-out, transform 150ms ease-out;
  }
  .mm-lbx__pide:hover { background-color: var(--mm-accion-hover) }
  .mm-lbx__pide:active { transform: scale(.97) }
  .mm-lbx__pide:focus-visible { outline: var(--mm-foco-grosor) solid var(--mm-foco-inverso); outline-offset: var(--mm-foco-aire) }

  /* La cadena flex llega hasta .msf-buttons para que Back/Next queden clavados en el borde
     inferior del panel en los TRES pasos, en vez de bailar segun lo que mida cada uno. En movil
     ademas los deja al alcance del pulgar. `overflow-y: auto` se queda como red de seguridad
     -nunca atrapar contenido-, aunque la puerta exige que no haga falta usarlo. */
  /* HOJA DEL FORMULARIO (<992). Vive en absoluto sobre el visor, plegada fuera del dialogo por
     `translateY(100%)`, y la despliega `.mm-lbx--pide` -la clase que pone el CTA-. Ocupa el
     88 % del dialogo: el 12 % de foto que asoma arriba es el contexto («esto va de ESTA obra»)
     y el sitio donde sigue viva la X. `visibility: hidden` ademas de la traslacion: plegada,
     sus 20 campos no entran en el orden de tabulacion ni en el arbol de accesibilidad; el
     retardo hace que se esconda cuando ya termino de bajar, y al abrir el retardo es 0.
     `position: absolute` resuelve contra el <dialog>, que es `fixed` por hoja de agente.
     `z-index: 1`, el mismo que las flechas del visor: sin el, las flechas -absolutas y con
     z-index- pintaban ENCIMA de la hoja desplegada, a la altura de la tercera fila de
     servicios. Visto en captura. A igual z-index gana el orden del arbol, y la hoja va despues. */
  .mm-lbx__formulario {
    position: absolute; left: 0; right: 0; bottom: 0; height: 88%; z-index: 1;
    min-height: 0; overflow-y: auto;
    padding: var(--mm-e-24) var(--mm-e-16) calc(var(--mm-e-16) + env(safe-area-inset-bottom, 0px));
    display: flex; flex-direction: column;
    background-color: var(--mm-superficie);
    border-radius: var(--mm-r-24) var(--mm-r-24) 0 0;
    box-shadow: var(--mm-sombra-3);
    transform: translateY(100%);
    visibility: hidden;
    transition: transform 260ms ease-out, visibility 0s linear 260ms;
  }
  .mm-lbx--pide .mm-lbx__formulario { transform: none; visibility: visible; transition-delay: 0s }
  /* El asa es solo pictografica: la hoja se pliega con el boton de la cabecera, tocando la
     foto o con Esc. En absoluto para no entrar en la cadena flex -el panel de exito la centra-. */
  .mm-lbx__formulario::before {
    content: ""; position: absolute; top: var(--mm-e-8); left: 50%; transform: translateX(-50%);
    width: 40px; height: var(--mm-e-4); border-radius: var(--mm-r-pastilla);
    background-color: var(--mm-borde-control);
  }
  .mm-lbx__cabecera {
    display: flex; align-items: center; justify-content: space-between; gap: var(--mm-e-12);
    margin: 0 0 var(--mm-e-12); flex: 0 0 auto;
  }
  .mm-lbx__cabecera p { margin: 0; font-weight: var(--mm-peso-fuerte); font-size: var(--mm-paso-2); color: var(--mm-tinta) }
  .mm-lbx__pliega {
    flex: 0 0 auto; width: 44px; height: 44px; border: 0; border-radius: 100%;
    display: grid; place-items: center; cursor: pointer;
    background-color: var(--mm-fondo-tenue); color: var(--mm-tinta);
    transition: background-color 150ms ease-out;
  }
  .mm-lbx__pliega:hover { background-color: var(--mm-borde) }
  .mm-lbx__pliega:focus-visible { outline: var(--mm-foco-grosor) solid var(--mm-foco); outline-offset: var(--mm-foco-aire) }
  .mm-lbx__pliega svg { width: 22px; height: 22px }
  .mm-lbx__formulario form { display: flex; flex-direction: column; flex: 1 1 auto; min-height: 0 }
  /* Dos herencias de Webflow que hay que apagar a mano en el h2:
       · `text-transform: capitalize` — convertia "What are you planning?" en "What Are You
         Planning?". Es la trampa que check-texto.mjs:100 documenta como "la cuarta vez que
         esto muerde en este repo"; aqui no rompe la puerta -el dialogo cerrado no pinta- pero
         se lleva por delante la decision de copia.
       · `text-align: center` — un titulo centrado en una columna estrecha y con todo lo demas
         alineado a la izquierda es ruido: la vista tiene que volver al margen en cada bloque. */
  .mm-lbx__formulario .header-form h2 {
    font-size: var(--mm-paso-4); line-height: var(--mm-alto-titulo);
    margin: 0 0 var(--mm-e-12); color: var(--mm-tinta);
    text-transform: none; text-align: left; text-wrap: balance;
  }

  /* Webflow le pone 32px de padding a .msf-step. Aqui son 64px de alto tirados en cada paso y
     -peor- 64px de ancho menos para la rejilla, que es lo que partia las etiquetas en dos
     lineas y ponia la ficha en 57px en vez de 44. El panel del paso lo pinta el DIALOGO, no el
     paso (a diferencia de estimacion.css:123, donde el paso si es una tarjeta). */
  .mm-lbx__formulario .msf-step { padding: 0; background: transparent }

  .mm-lbx__formulario .step-wrapper { display: flex; flex-direction: column; gap: var(--mm-e-12); flex: 1 1 auto; min-height: 0; align-items: stretch }
  .mm-lbx__formulario .step-wrapper::before {
    content: "";
    align-self: stretch;
    height: var(--mm-e-8);
    border-radius: var(--mm-r-pastilla);
    background-repeat: no-repeat;
    background-image: linear-gradient(to right,
      var(--mm-tinta) 0 32%, transparent 32% 34%,
      var(--mm-borde-control) 34% 66%, transparent 66% 68%,
      var(--mm-borde-control) 68% 100%);
  }
  .mm-lbx__formulario .step-wrapper:has(.msf-step:nth-child(2):not([style*="none"]))::before {
    background-image: linear-gradient(to right,
      var(--mm-tinta) 0 32%, transparent 32% 34%,
      var(--mm-tinta) 34% 66%, transparent 66% 68%,
      var(--mm-borde-control) 68% 100%);
  }
  .mm-lbx__formulario .step-wrapper:has(.msf-step:nth-child(3):not([style*="none"]))::before {
    background-image: linear-gradient(to right,
      var(--mm-tinta) 0 32%, transparent 32% 34%,
      var(--mm-tinta) 34% 66%, transparent 66% 68%,
      var(--mm-tinta) 68% 100%);
  }

  .mm-lbx__formulario .bugget-form { display: flex; flex-direction: column; gap: var(--mm-e-8); margin-bottom: var(--mm-e-16) }
  .mm-lbx__formulario .text-block-6 { font-weight: var(--mm-peso-fuerte); color: var(--mm-tinta) }

  /* OJO con el alto: el `min-height: 48px` de aqui NO decide nada, porque .text-field-form
     trae de Webflow un `height: 55px` que gana siempre. Tocar el padding vertical no cambia el
     alto del campo ni un pixel -probado-: si algun dia hace falta bajarlo, es el `height`.
     `margin: 0 0 8px` en vez de solo `margin-bottom`: .w-input trae de Webflow un
     `margin-top: 10px` que aqui solo sirve para desajustar el ritmo -8 abajo, 10 arriba- y
     para colar 10px sueltos encima del primer campo de cada paso. */
  .mm-lbx__formulario .text-field-form,
  .mm-lbx__formulario .select-field {
    display: block; width: 100%; min-height: 48px; margin: 0 0 var(--mm-e-8);
    background-color: var(--mm-superficie); color: var(--mm-tinta);
    border: 1px solid var(--mm-tinta-suave); border-radius: var(--mm-r-8);
    padding: var(--mm-e-12) var(--mm-e-16); font-size: var(--mm-paso-3); font-family: inherit;
  }
  .mm-lbx__formulario .text-field-form:focus-visible,
  .mm-lbx__formulario .select-field:focus-visible {
    outline: var(--mm-foco-grosor) solid var(--mm-foco); outline-offset: var(--mm-foco-aire);
  }

  /* LA REJILLA DE SERVICIOS es de donde salio el desbordamiento: medía 567px de los 744 utiles
     en escritorio, y 1168 de los 440 en movil. Dos cambios, los dos medidos:
       · 2 columnas DESDE 0px, no desde 480. En movil eran 14 filas; ahora son 7. Ahi esta el
         95 % de los 802px que desbordaban a 390. (No es un breakpoint nuevo: es la base.)
       · la ficha pasa de 76px a 44. Los 76 no eran padding, era la etiqueta partiendo en DOS
         lineas -"New Pool and Spa Construction" en una columna de 230px-. Con la etiqueta corta
         cabe en una linea y la altura la fija el suelo tactil.
     El objetivo tactil de WCAG 2.2 AA 2.5.8 es la ETIQUETA entera -que es lo que se pulsa-, y
     mide >=44. Por eso la casilla se queda en 20x20 y no sube a los 24x24 de estimacion.css:242:
     alli la ficha lleva pictograma y otra caja; aqui subirla solo robaria ancho a la etiqueta. */
  .mm-lbx__formulario .services-form { display: grid; grid-template-columns: 1fr 1fr; gap: var(--mm-e-8) }
  /* De 480 a 991 el formulario ocupa la hoja ENTERA (el layout no pasa a dos columnas hasta
     992), asi que ahi caben mas: 14 servicios son 7 filas a 2 columnas, 5 a 3 y 4 a 4. */
  @media (min-width: 480px) { .mm-lbx__formulario .services-form { grid-template-columns: repeat(3, 1fr) } }
  @media (min-width: 768px) { .mm-lbx__formulario .services-form { grid-template-columns: repeat(4, 1fr) } }
  .mm-lbx__formulario .services-form .w-checkbox,
  .mm-lbx__formulario .checkbox-field {
    display: flex; align-items: center; gap: var(--mm-e-8); cursor: pointer;
    min-height: 44px; padding: var(--mm-e-8);
    border: 1px solid var(--mm-borde); border-radius: var(--mm-r-8);
    background-color: var(--mm-superficie);
    transition: border-color 150ms ease-out, background-color 150ms ease-out;
  }
  .mm-lbx__formulario .services-form .w-checkbox:hover { border-color: var(--mm-borde-control) }
  /* navy sobre la superficie tenue: 13,68:1 */
  .mm-lbx__formulario .services-form .w-checkbox:has(:checked) {
    border-color: var(--mm-tinta); background-color: var(--mm-fondo-tenue);
  }
  /* El anillo va en la FICHA, no en la casilla de 20px: es la caja que se pulsa. */
  .mm-lbx__formulario .services-form .w-checkbox:has(:focus-visible) {
    outline: var(--mm-foco-grosor) solid var(--mm-foco); outline-offset: var(--mm-foco-aire);
  }
  .mm-lbx__formulario .w-checkbox-input { accent-color: var(--mm-navy); width: 20px; height: 20px; flex-shrink: 0 }
  .mm-lbx__formulario .services-form .w-form-label { font-size: var(--mm-paso-2); line-height: var(--mm-alto-cuerpo); color: var(--mm-tinta) }
  /* El <strong> de Webflow a 700 en las 14 etiquetas no es enfasis, es ruido (estimacion.css:259). */
  .mm-lbx__formulario .services-form .w-form-label strong { font-weight: var(--mm-peso-medio) }
  .mm-lbx__formulario .checkbox-field { margin: var(--mm-e-12) 0 0; align-items: flex-start; padding: var(--mm-e-12) }
  .mm-lbx__formulario .checkbox-field .w-checkbox-input { margin-top: 2px }
  .mm-lbx__formulario .checkbox-field .w-form-label { font-size: var(--mm-paso-0); color: var(--mm-tinta-atenuada); text-wrap: pretty }

  .mm-lbx__formulario .msf-error-input { outline: none; box-shadow: inset 0 0 0 1px var(--mm-error) }
  .mm-lbx__formulario .msf-error { color: var(--mm-error); font-size: var(--mm-paso-0); font-weight: var(--mm-peso-fuerte); margin-top: calc(var(--mm-e-4) * -2) }

  .mm-lbx__formulario .msf-buttons { display: flex; gap: var(--mm-e-12); margin-top: auto }
  /* TURNSTILE. Formularios.astro mete el widget aqui dentro -antes del boton de envio- y desde
     que le pasa un `action` sin espacios se pinta DE VERDAD: 300x70 reales, no un div vacio.
     Compartir linea con el boton no cabe en NINGUN ancho -300+200 no entran ni en los 486 de
     1440-: a 390 el widget se salia de la pantalla por la izquierda y a 992 se metia encima de
     la foto. Medido, con capturas. Linea propia, y el aire lo pone el `gap`, no el
     `margin:.75rem 0` en linea que Formularios.astro escribe al pintarlo -de ahi el
     !important: un estilo en linea no se gana de otra forma-.
     Y fuera el `margin-top:1em/2em` que .wrapper-buttons-center trae de Webflow (Base.css, 112
     rutas lo usan): aqui son 18-28px de aire que nadie pidio, justo donde no sobra ni uno. */
  .mm-lbx__formulario .wrapper-buttons-center {
    display: flex; flex-wrap: wrap; justify-content: flex-end;
    gap: var(--mm-e-12); margin-top: 0;
  }
  .mm-lbx__formulario .mm-turnstile { flex: 0 0 100%; margin: 0 !important }
  .mm-lbx__formulario .msf-back,
  .mm-lbx__formulario .msf-next,
  .mm-lbx__formulario .msf-submit {
    display: inline-flex; align-items: center; justify-content: center;
    min-height: 48px; padding: 0 var(--mm-e-24);
    border-radius: var(--mm-r-pastilla);
    font-weight: var(--mm-peso-fuerte); font-size: var(--mm-paso-2);
    cursor: pointer; border: none; text-decoration: none;
    transition: background-color 150ms ease-out, transform 150ms ease-out;
  }
  .mm-lbx__formulario .msf-back:active,
  .mm-lbx__formulario .msf-next:active,
  .mm-lbx__formulario .msf-submit:active { transform: scale(.97) }
  .mm-lbx__formulario .msf-back { background-color: transparent; color: var(--mm-tinta); border: 1px solid var(--mm-tinta-suave) }
  .mm-lbx__formulario .msf-next,
  .mm-lbx__formulario .msf-submit { background-color: var(--mm-accion); color: var(--mm-sobre-accion); margin-left: auto }
  .mm-lbx__formulario .msf-next:hover,
  .mm-lbx__formulario .msf-submit:hover { background-color: var(--mm-accion-hover) }
  .mm-lbx__formulario .msf-back:focus-visible,
  .mm-lbx__formulario .msf-next:focus-visible,
  .mm-lbx__formulario .msf-submit:focus-visible {
    outline: var(--mm-foco-grosor) solid var(--mm-foco); outline-offset: var(--mm-foco-aire);
  }
  .mm-lbx__formulario .text-block-7 { font-size: var(--mm-paso-0); color: var(--mm-tinta-atenuada); margin-top: var(--mm-e-8); text-wrap: pretty }
  .mm-lbx__formulario .text-block-7 a { color: var(--mm-enlace) }

  /* Al enviar, Formularios.astro:90-91 esconde el <form> y pone el panel de exito en `block`.
     Sin esto, la tarjeta de gracias se quedaba pegada arriba con medio panel en blanco debajo.
     La tecnica -leer el `style` en linea con :has()- es la misma que ya usa la barra de
     progreso unas lineas mas arriba. */
  .mm-lbx__formulario:has(.success-message-form[style*="block"]) { justify-content: center }
  .mm-lbx__formulario .success-message-form {
    display: none; text-align: center;
    background-color: var(--mm-fondo-navy); color: var(--mm-tinta-inversa);
    border-radius: var(--mm-r-16); padding: var(--mm-e-24);
  }
  .mm-lbx__formulario .success-message-form svg { color: var(--mm-accion) }
  .mm-lbx__formulario .success-message-form h2 { color: var(--mm-tinta-inversa); margin: var(--mm-e-16) 0 var(--mm-e-8) }
  .mm-lbx__formulario .w-form-fail {
    display: none; background-color: var(--mm-fondo-tenue); color: var(--mm-error);
    border: 2px solid var(--mm-error); border-radius: var(--mm-r-8);
    padding: var(--mm-e-12) var(--mm-e-16); margin-top: var(--mm-e-16); font-size: var(--mm-paso-2);
  }

  @media (min-width: 992px) {
    /* 62/38 y no el 55/45 de antes. El negro no salia de que sobrara foto: salia de que la CAJA
       es mas alta que ancha para una foto apaisada, asi que ensanchar el formulario lo empeora y
       ensanchar la foto lo arregla. A 1280 de dialogo: la columna de foto mide 794 y una foto
       16:9 pinta 447 de los 600 de alto -26 % de sangrado-; a 55/45 pintaria 381 -36 %-.
       `height` fija, no `max-height`: es lo que evita que el dialogo encoja al cambiar de paso.
       El visor pierde aqui su aspect-ratio -se estira a la fila-, y por eso tampoco toca la
       trampa de aspect-ratio+height. */
    .mm-lbx[open] {
      width: min(94vw, 1280px);
      height: min(90vh, 720px);
      margin: auto;
      border-radius: var(--mm-r-24);
      background-color: var(--mm-superficie);
    }
    .mm-lbx__panel { flex-direction: row }
    .mm-lbx__visor { flex: 1 1 62%; min-width: 0 }
    /* Aqui no hay hoja: el formulario vuelve al flujo, siempre a la vista, y el CTA, la
       cabecera, el asa y el velo de movil se apagan. `.mm-lbx--pide` puede quedar puesta si se
       ensancha la ventana con la hoja abierta; a este ancho no hace nada.
       El padding-top de 64 es lo que mata el solape del boton X con la barra de progreso: la X
       ocupa hasta y=56 (12 de offset + 44 de alto) y el contenido arranca en 64. */
    .mm-lbx__formulario {
      position: static; height: auto; transform: none; visibility: visible; transition: none;
      flex: 1 1 38%; min-width: 0; padding: var(--mm-e-64) var(--mm-e-24) var(--mm-e-24);
      border-radius: 0; box-shadow: none;
    }
    .mm-lbx__formulario::before, .mm-lbx__cabecera, .mm-lbx__cta,
    .mm-lbx--pide .mm-lbx__visor::after { display: none }
    /* La columna del formulario vuelve a ser estrecha: 2 columnas otra vez. */
    .mm-lbx__formulario .services-form { grid-template-columns: 1fr 1fr }
  }

  @media (prefers-reduced-motion: reduce) {
    .mm-lbx__formulario, .mm-lbx__pide, .mm-lbx__pliega,
    .mm-lbx__nav, .mm-lbx__x,
    .mm-lbx__formulario .services-form .w-checkbox,
    .mm-lbx__formulario .msf-back,
    .mm-lbx__formulario .msf-next,
    .mm-lbx__formulario .msf-submit { transition: none }
    .mm-lbx__x:active, .mm-lbx__pide:active,
    .mm-lbx__formulario .msf-back:active,
    .mm-lbx__formulario .msf-next:active,
    .mm-lbx__formulario .msf-submit:active { transform: none }
    /* No es `none`: las flechas siguen necesitando su centrado vertical. */
    .mm-lbx__nav--prev:active, .mm-lbx__nav--next:active { transform: translateY(-50%) }
  }

  html.mm-scroll-lock { overflow: hidden }

  @media print { .mm-lbx { display: none } }
</style>

<script>
  (function () {
    'use strict';
    const dlg = document.querySelector('.mm-lbx');
    if (!dlg) return;   // absent on the other 114 pages by construction (route-gate in frontmatter)

    const img = dlg.querySelector('.mm-lbx__img');
    const ambiente = dlg.querySelector('.mm-lbx__ambiente');
    const cuenta = dlg.querySelector('.mm-lbx__cuenta');

    // Same anchors Componentes.astro's guard skips (a.closest('.gallery-page')) — never double-bound.
    const enlaces = [...document.querySelectorAll('a.w-lightbox')].filter((a) => a.closest('.gallery-page'));
    const fotos = enlaces.map((a) => {
      let d;
      try { d = JSON.parse(a.querySelector('script.w-json')?.textContent ?? '{}'); } catch { d = {}; }
      return { url: d.items?.[0]?.url ?? '', alt: a.querySelector('img')?.alt ?? '' };
    });

    let i = 0;
    let disparador = null;
    const pinta = () => {
      if (!fotos[i]) return;
      img.src = fotos[i].url;
      // Misma URL que la foto nitida: la segunda decodificacion sale de cache, no de la red.
      if (ambiente) ambiente.src = fotos[i].url;
      img.alt = fotos[i].alt;
      cuenta.textContent = fotos.length > 1 ? `${i + 1} / ${fotos.length}` : '';
      for (const b of dlg.querySelectorAll('.mm-lbx__nav')) b.hidden = fotos.length < 2;
    };
    const mueve = (d) => {
      if (fotos.length < 2) return;
      i = (i + d + fotos.length) % fotos.length;
      pinta();
    };

    enlaces.forEach((a, idx) => a.addEventListener('click', (ev) => {
      ev.preventDefault();
      ev.stopPropagation();
      i = idx;
      disparador = a;
      pinta();
      document.documentElement.classList.add('mm-scroll-lock');
      dlg.showModal();

      // TRACKING. La apertura del visor es la senal de intencion de esta pagina: mirar la obra
      // de cerca es el paso previo al formulario que vive en este mismo dialogo.
      // `link_text` sale del alt de la foto -es lo unico descriptivo que hay aqui-, nunca del
      // nombre del fichero. Solo categorico: ni un dato del visitante.
      try {
        var img = a.querySelector('img');
        window.dataLayer = window.dataLayer || [];
        window.dataLayer.push({
          event: 'view_project_gallery',
          link_text: ((img && img.getAttribute('alt')) || a.textContent || '').trim().slice(0, 100),
        });
      } catch (e) { /* la medicion nunca puede romper el visor */ }
    }));

    dlg.querySelector('.mm-lbx__x')?.addEventListener('click', () => dlg.close());
    dlg.querySelector('.mm-lbx__nav--prev')?.addEventListener('click', () => mueve(-1));
    dlg.querySelector('.mm-lbx__nav--next')?.addEventListener('click', () => mueve(1));
    dlg.addEventListener('click', (ev) => { if (ev.target === dlg) dlg.close(); });
    dlg.addEventListener('keydown', (ev) => {
      if (ev.key === 'ArrowLeft') mueve(-1);
      if (ev.key === 'ArrowRight') mueve(1);
    });

    // Root-scoped step engine — same algorithm as request-estimated.astro's P0, closed over
    // `root` instead of `document`/getElementById, so no ids are needed at all.
    const raiz = dlg.querySelector('.mm-lbx__formulario');
    if (raiz) initPasoAPaso(raiz);

    // LA HOJA (<992). El CTA la despliega, y la pliegan su boton de la cabecera, un toque en la
    // foto velada, o Esc. La clase vive en el <dialog> para que el CSS pueda velar el visor y
    // desplegar la hoja desde un solo sitio. En escritorio la BARRA del CTA no se pinta
    // (display:none) y `hayHoja()` lee esa verdad del CSS en vez de repetir el breakpoint aqui.
    // Se pregunta por las cajas del boton y no por su `display`: el display computado de un
    // elemento es el suyo propio aunque su padre sea display:none -ya mordio en la puerta-.
    const visor = dlg.querySelector('.mm-lbx__visor');
    const cta = dlg.querySelector('.mm-lbx__pide');
    const pliega = dlg.querySelector('.mm-lbx__pliega');
    const hayHoja = () => !!cta && cta.getClientRects().length > 0;
    const hojaAbierta = () => dlg.classList.contains('mm-lbx--pide');
    const abreHoja = () => {
      dlg.classList.add('mm-lbx--pide');
      cta?.setAttribute('aria-expanded', 'true');
      // El foco entra en la hoja: al primer control del paso que toque. En el paso 1 son
      // casillas, asi que no salta el teclado; en el 2 y el 3 si, y es lo que se quiere.
      const paso = raiz?.querySelector('[data-step]:not([style*="none"])');
      (paso?.querySelector('input, select, textarea') ?? pliega)?.focus?.();
    };
    const cierraHoja = (devuelveFoco) => {
      if (!hojaAbierta()) return;
      dlg.classList.remove('mm-lbx--pide');
      cta?.setAttribute('aria-expanded', 'false');
      if (devuelveFoco) cta?.focus?.();
    };
    cta?.addEventListener('click', abreHoja);
    pliega?.addEventListener('click', () => cierraHoja(true));
    visor?.addEventListener('click', (ev) => {
      if (hojaAbierta() && hayHoja() && !ev.target.closest('button')) cierraHoja(true);
    });
    // Esc pliega la hoja antes de cerrar el visor: lo mas cercano primero, como en cualquier
    // UI anidada. Solo cuando la hoja es hoja; en escritorio Esc cierra el dialogo como siempre.
    dlg.addEventListener('cancel', (ev) => {
      if (hojaAbierta() && hayHoja()) { ev.preventDefault(); cierraHoja(true); }
    });
    dlg.addEventListener('close', () => {
      cierraHoja(false);   // la proxima apertura empieza siempre por la foto
      document.documentElement.classList.remove('mm-scroll-lock');
      disparador?.focus();   // a gap Componentes.astro's own .mm-lb doesn't close today
    });

    // DESLIZAR para pasar de foto, solo con el dedo. Umbral de 48px y mas horizontal que
    // vertical (x1,5) para no confundirlo con un toque o con el gesto de la hoja. El visor
    // declara `touch-action: pan-y pinch-zoom`, asi que el navegador no se queda el gesto
    // horizontal y pointerup llega de verdad.
    let toque = null;
    visor?.addEventListener('pointerdown', (ev) => {
      toque = ev.pointerType === 'touch' ? { x: ev.clientX, y: ev.clientY } : null;
    });
    visor?.addEventListener('pointerup', (ev) => {
      if (!toque || hojaAbierta()) { toque = null; return; }
      const dx = ev.clientX - toque.x, dy = ev.clientY - toque.y;
      toque = null;
      if (Math.abs(dx) >= 48 && Math.abs(dx) > Math.abs(dy) * 1.5) mueve(dx < 0 ? 1 : -1);
    });
    visor?.addEventListener('pointercancel', () => { toque = null; });

    function initPasoAPaso(root) {
      const pasos = [...root.querySelectorAll('[data-step]')]
        .sort((a, b) => Number(a.dataset.step) - Number(b.dataset.step));
      const btnNext = root.querySelector('.msf-next');
      const btnBack = root.querySelector('.msf-back');
      const btnSubmit = root.querySelector('.msf-submit');
      const wrapper = root.querySelector('.step-wrapper');
      let actual = 0;

      const isVisible = (el) => !!(el.offsetWidth || el.offsetHeight || el.getClientRects().length);

      const showStep = (index) => {
        pasos.forEach((p, k) => { p.style.display = k === index ? 'block' : 'none'; });
        if (btnBack) btnBack.style.display = index === 0 ? 'none' : 'inline-flex';
        if (btnNext) btnNext.style.display = index === pasos.length - 1 ? 'none' : 'inline-flex';
        if (btnSubmit) btnSubmit.style.display = index === pasos.length - 1 ? 'inline-flex' : 'none';
      };

      const setFieldError = (field, message) => {
        field.classList.add('msf-error-input');
        field.setAttribute('aria-invalid', 'true');
        let msg = field.parentElement?.querySelector('.msf-error');
        if (!msg) {
          msg = document.createElement('div');
          msg.className = 'msf-error';
          field.parentElement?.appendChild(msg);
        }
        msg.textContent = message || 'Required';
      };
      const clearFieldError = (field) => {
        field.classList.remove('msf-error-input');
        field.removeAttribute('aria-invalid');
        const msg = field.parentElement?.querySelector('.msf-error');
        if (msg) msg.remove();
      };
      const validateField = (field) => {
        clearFieldError(field);
        const type = (field.dataset.type || '').toLowerCase();
        const tag = field.tagName.toLowerCase();
        const value = (field.value || '').trim();
        if (!value) { setFieldError(field, 'Required'); return false; }
        if (tag === 'select' && value.toLowerCase().startsWith('select')) {
          setFieldError(field, 'Please select an option'); return false;
        }
        if (type === 'email' && !/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(value)) {
          setFieldError(field, 'Enter a valid email'); return false;
        }
        if (type === 'phone' && !/^[0-9()+\-\s]{7,}$/.test(value)) {
          setFieldError(field, 'Enter a valid phone'); return false;
        }
        return true;
      };
      const validateStep = (index) => {
        const requiredFields = Array.from(pasos[index].querySelectorAll("[data-required='true']")).filter(isVisible);
        let ok = true;
        requiredFields.forEach((field) => { if (!validateField(field)) ok = false; });
        return ok;
      };

      wrapper?.addEventListener('input', (e) => {
        const field = e.target;
        if (field && field.matches("[data-required='true']")) clearFieldError(field);
      });

      btnNext?.addEventListener('click', (ev) => {
        ev.preventDefault();
        if (!validateStep(actual)) return;
        if (actual < pasos.length - 1) {
          actual++;
          showStep(actual);
          pasos[actual].querySelector('input, select, textarea')?.focus?.();
        }
      });
      btnBack?.addEventListener('click', (ev) => {
        ev.preventDefault();
        if (actual > 0) {
          actual--;
          showStep(actual);
          pasos[actual].querySelector('input, select, textarea')?.focus?.();
        }
      });

      showStep(actual);
    }
  }());
</script>
