---
// LA CABECERA Y EL MENÚ (G1) — REDISEÑO STITCH, ASTRO-1 (12-oct-2026).
//
// Componente PROPIO: ya no es DERIVADO de Webflow ni depende de su JS. Los datos salen de
// `src/data/menu.json` (nombres, títulos y frases del nav de origen; orden de la lámina
// aprobada), los teléfonos de `telefonos.json` y las fotos de `fotos-megamenu.json`.
//
//   · <header> con una franja de utilidades que NO es fija y la fila principal, que sí
//     (`position: sticky` con `top` negativo: la franja se va al desplazar).
//   · Escritorio: un solo <nav aria-label="Main">. Los desplegables son <details name>: se
//     abren y cierran sin JS, y de uno en uno. El script solo añade Esc, clic fuera y el
//     cambio de ficha al recorrer los servicios.
//   · Las fotos del panel de Services van `loading="lazy"` dentro de un <details> cerrado:
//     no se piden hasta abrirlo.
//   · Móvil: <dialog> con showModal(). Sin JS no se puede abrir, así que el <noscript> de
//     abajo lo pinta en su sitio.
//   · El teléfono se pinta con `visible` de telefonos.json, el mismo texto que usa el
//     `gtag config` de conversión de llamadas de Base.astro.
import MENU from '../data/menu.json';
import FOTOS from '../data/fotos-megamenu.json';
import TELEFONOS from '../data/telefonos.json';
import ICO from '../data/iconos-cascaron.json';

interface Props { ruta?: string }
const { ruta = '' } = Astro.props;
const aqui = (href: string) => (href === ruta ? 'page' : undefined);
/* D-87 (§11.7): donde el hero no lleva boton oro ni formulario en la primera pantalla, el oro es
 * el de la cabecera. Hoy, el articulo, el indice de galeria y las legales; los demas indices, con su plantilla. */
const ctaOro = /^\/blogs\/[^/]+$/.test(ruta) || ruta === '/gallery' || ruta.startsWith('/articles/') || ['/testimonials', '/videos', '/projects', '/blogs-tips', '/brochures', '/industry-solutions'].includes(ruta);
const enServicios = ruta.startsWith('/services') || ruta.startsWith('/commercial-services');
const activo = Math.max(0, MENU.servicios.findIndex((s) => ruta === s.href || ruta.startsWith(s.href + '/')));
const num = (i: number) => String(i + 1).padStart(2, '0');
const tels = TELEFONOS.items;
---
<a class="mm-salto" href="#contenido">Skip to content</a>
<header class="mm-cab" data-mm-cab>
  <div class="mm-cab-util">
    <div class="mm-cab-caja">
      <p class="mm-cab-lic"><Fragment set:html={ICO.escudo} /><span>Florida certified pool contractor · CPC1461119 · CPC1460562</span></p>
      <div class="mm-cab-enlaces">
        {tels.map((t) => (
          <a class="mm-cab-util-a" href={`tel:${t.tel}`}><span class="mm-cab-util-zona">{t.zona}</span><span class="mm-cab-util-num">{t.visible}</span></a>
        ))}
        <span class="mm-cab-raya" aria-hidden="true"></span>
        <a class="mm-cab-util-a" href="/financing" aria-current={aqui('/financing')}>financing</a>
        <a class="mm-cab-util-a" href="/contact-us" aria-current={aqui('/contact-us')}>Contact Us</a>
      </div>
    </div>
  </div>

  <div class="mm-cab-fila">
    <div class="mm-cab-caja">
      <a class="mm-cab-logo" href="/" aria-label="Mr & Mrs Outdoor Living — home"><img src="/images/site/logo-mr-mr.svg" width="193" height="61" alt="" /></a>

      <nav class="mm-cab-nav" aria-label="Main">
        <details class="mm-cab-grupo" name="mm-cab">
          <summary class={`mm-cab-item${enServicios ? ' mm-cab-item--actual' : ''}`}>Services<Fragment set:html={ICO.chevron} /></summary>
          <div class="mm-cab-panel mm-cab-panel--servicios">
            <div class="mm-cab-servicios">
              <ul class="mm-cab-indice">
                {MENU.servicios.map((s, i) => (
                  <li><a class={`mm-cab-fila-s${i === activo ? ' mm-cab-fila-s--activa' : ''}`} href={s.href} aria-current={aqui(s.href)} data-mm-servicio={i}><span class="mm-cab-nom">{s.nombre}</span></a></li>
                ))}
              </ul>
              <div class="mm-cab-comercial">
                <p class="mm-etiqueta">Commercial</p>
                <ul>{MENU.comercial.map((c) => <li><a href={c.href} aria-current={aqui(c.href)}>{c.texto}</a></li>)}</ul>
              </div>
            </div>
            {MENU.servicios.map((s, i) => (
              <div class="mm-cab-ficha" data-mm-ficha={i} hidden={i !== activo}>
                <p class="mm-etiqueta mm-cab-ficha-num" aria-hidden="true" data-num={num(i)}></p>
                <p class="mm-cab-ficha-t">{s.titulo}</p>
                <p class="mm-cab-ficha-p">{s.frase}</p>
                <a class="mm-cab-flecha" href={s.href}>{s.nombre}<Fragment set:html={ICO.flecha} /></a>
              </div>
            ))}
            {MENU.servicios.map((s, i) => {
              const f = s.foto ? (FOTOS as any)[s.foto] : null;
              return (
                <div class={`mm-cab-medio${f ? '' : ' mm-cab-medio--sin'}`} data-mm-medio={i} data-num={num(i)} hidden={i !== activo}>
                  {f && <img src={f.src} alt={f.alt} width={f.ancho} height={f.alto} loading="lazy" decoding="async" />}
                </div>
              );
            })}
          </div>
        </details>

        <details class="mm-cab-grupo" name="mm-cab">
          <summary class="mm-cab-item">About Us<Fragment set:html={ICO.chevron} /></summary>
          <div class="mm-cab-panel mm-cab-panel--lista">
            {MENU.about.map((x) => (
              <a class="mm-cab-sub" href={x.href} aria-current={aqui(x.href)}><span class="mm-cab-sub-ico" aria-hidden="true" set:html={x.icono} /><span class="mm-cab-sub-txt"><span class="mm-cab-sub-t" set:html={x.texto} /><span class="mm-cab-sub-p" set:html={x.frase} /></span></a>
            ))}
          </div>
        </details>

        <a class="mm-cab-item" href="/gallery" aria-current={aqui('/gallery')}>Project Gallery</a>

        <details class="mm-cab-grupo" name="mm-cab">
          <summary class="mm-cab-item">Resources<Fragment set:html={ICO.chevron} /></summary>
          <div class="mm-cab-panel mm-cab-panel--lista">
            {MENU.recursos.map((x) => (
              <a class="mm-cab-sub" href={x.href} aria-current={aqui(x.href)}><span class="mm-cab-sub-ico" aria-hidden="true" set:html={x.icono} /><span class="mm-cab-sub-txt"><span class="mm-cab-sub-t" set:html={x.texto} /><span class="mm-cab-sub-p" set:html={x.frase} /></span></a>
            ))}
          </div>
        </details>
      </nav>

      <a class:list={['mm-cab-cta', ctaOro && 'mm-cab-cta--oro']} href="/request-estimated" aria-current={aqui('/request-estimated')}>Get a Free Estimate</a>

      <div class="mm-cab-movil">
        <details class="mm-llama" data-mm-llama>
          <summary class="mm-cab-icono" aria-label="Call us"><Fragment set:html={ICO.tel} /></summary>
          <div class="mm-llama-panel mm-datos mm-datos--pila">
            {tels.map((t) => <a class="mm-dato" href={`tel:${t.tel}`}><span class="mm-dato-rot">{t.zona}</span><span class="mm-dato-val">{t.visible}</span></a>)}
          </div>
        </details>
        <button type="button" class="mm-cab-icono" aria-label="Open menu" aria-haspopup="dialog" aria-controls="mm-menu" data-mm-abrir><Fragment set:html={ICO.menu} /></button>
      </div>
    </div>
  </div>
</header>

<dialog class="mm-menu" id="mm-menu" aria-label="Menu">
  <div class="mm-menu-cab">
    <a class="mm-cab-logo" href="/" aria-label="Mr & Mrs Outdoor Living — home"><img src="/images/site/logo-mr-mr.svg" width="127" height="40" alt="" loading="lazy" /></a>
    <button type="button" class="mm-cab-icono" aria-label="Close menu" data-mm-cerrar><Fragment set:html={ICO.cerrar} /></button>
  </div>
  <div class="mm-menu-cuerpo">
    <a class="mm-menu-fila" href="/" aria-current={aqui('/')}>Home</a>
    <details name="mm-menu" open={enServicios}>
      <summary class="mm-menu-fila">Services<Fragment set:html={ICO.chevron} /></summary>
      <ul class="mm-menu-sub mm-menu-sub--num">
        {MENU.servicios.map((s) => <li><a href={s.href} aria-current={aqui(s.href)}>{s.nombre}</a></li>)}
      </ul>
      <ul class="mm-menu-sub mm-menu-sub--com">
        <li class="mm-etiqueta">Commercial</li>
        {MENU.comercial.map((c) => <li><a href={c.href} aria-current={aqui(c.href)}>{c.texto}</a></li>)}
      </ul>
    </details>
    <details name="mm-menu">
      <summary class="mm-menu-fila">About Us<Fragment set:html={ICO.chevron} /></summary>
      <ul class="mm-menu-sub">{MENU.about.map((x) => <li><a href={x.href} aria-current={aqui(x.href)} set:html={x.texto} /></li>)}</ul>
    </details>
    <a class="mm-menu-fila" href="/gallery" aria-current={aqui('/gallery')}>Project Gallery</a>
    <details name="mm-menu">
      <summary class="mm-menu-fila">Resources<Fragment set:html={ICO.chevron} /></summary>
      <ul class="mm-menu-sub">{MENU.recursos.map((x) => <li><a href={x.href} aria-current={aqui(x.href)} set:html={x.texto} /></li>)}</ul>
    </details>
    <a class="mm-menu-fila" href="/financing" aria-current={aqui('/financing')}>financing</a>
    <a class="mm-menu-fila" href="/contact-us" aria-current={aqui('/contact-us')}>Contact Us</a>
  </div>
  <div class="mm-menu-pie">
    <a class="mm-barra-btn mm-barra-btn--oro" href="/request-estimated">Get a Free Estimate</a>
    <div class="mm-menu-tels">
      {tels.map((t) => <a class="mm-barra-tel" href={`tel:${t.tel}`}><span class="mm-barra-tel-zona">{t.zona}</span><span class="mm-barra-tel-num">{t.visible}</span></a>)}
    </div>
  </div>
</dialog>
<noscript>
  <style>
    /* Sin JS el <dialog> no se puede abrir: por debajo de 992 se pinta en su sitio. */
    @media (max-width: 991.98px) { .mm-menu { display: flex; flex-direction: column; position: static; height: auto; } .mm-menu-cuerpo { flex: none; overflow: visible; } .mm-menu-cab, [data-mm-abrir] { display: none; } }
  </style>
</noscript>

<script>
  // Mejora progresiva. Sin esto: los desplegables de escritorio siguen abriendo y cerrando
  // (<details>), y el menú móvil lo cubre el <noscript> de arriba.
  const cab = document.querySelector<HTMLElement>('[data-mm-cab]');
  const menu = document.querySelector<HTMLDialogElement>('#mm-menu');
  if (cab) {
    const grupos = [...cab.querySelectorAll<HTMLDetailsElement>('.mm-cab-grupo, [data-mm-llama]')];
    const cerrar = (devolverFoco = false) => {
      for (const g of grupos) {
        if (!g.open) continue;
        const dentro = g.contains(document.activeElement);
        g.open = false;
        if (devolverFoco && dentro) g.querySelector('summary')?.focus();
      }
    };
    document.addEventListener('keydown', (e) => { if (e.key === 'Escape') cerrar(true); });
    document.addEventListener('click', (e) => { if (!grupos.some((g) => g.contains(e.target as Node))) cerrar(); });
    // Al salir con el tabulador por el final de un panel, se cierra.
    for (const g of grupos) g.addEventListener('focusout', (e) => { const a = (e as FocusEvent).relatedTarget as Node | null; if (a && !g.contains(a)) g.open = false; });

    // La ficha y la foto siguen al servicio que se recorre, con ratón o con teclado.
    const fichas = cab.querySelectorAll<HTMLElement>('[data-mm-ficha]');
    const medios = cab.querySelectorAll<HTMLElement>('[data-mm-medio]');
    const filas = cab.querySelectorAll<HTMLElement>('[data-mm-servicio]');
    const ver = (i: string) => {
      fichas.forEach((f) => { f.hidden = f.dataset.mmFicha !== i; });
      medios.forEach((m) => { m.hidden = m.dataset.mmMedio !== i; });
      filas.forEach((f) => f.classList.toggle('mm-cab-fila-s--activa', f.dataset.mmServicio === i));
    };
    filas.forEach((f) => { const i = f.dataset.mmServicio!; f.addEventListener('pointerenter', () => ver(i)); f.addEventListener('focus', () => ver(i)); });
  }
  // Foco a la vista. `scroll-padding-top` (sistema.css) ya lo resuelve en Chromium y Firefox;
  // Safari no lo aplica al desplazar por foco, y un campo enfocado quedaba bajo la fila fija
  // (medido con check:menu:webkit en /contact-us). Si pasa, se baja lo justo.
  const fila = cab?.querySelector<HTMLElement>('.mm-cab-fila');
  if (cab && fila) document.addEventListener('focusin', (e) => {
    const el = e.target as HTMLElement;
    if (cab.contains(el) || el.closest('dialog')) return;
    const r = el.getBoundingClientRect(); const c = fila.getBoundingClientRect();
    if (r.height > 0 && r.top < c.bottom && r.bottom > c.top) scrollBy(0, r.top - c.bottom - 16);
  });
  if (menu) {
    const abrir = document.querySelector<HTMLElement>('[data-mm-abrir]');
    abrir?.addEventListener('click', () => { if (typeof menu.showModal === 'function') menu.showModal(); });
    menu.querySelector('[data-mm-cerrar]')?.addEventListener('click', () => menu.close());
    menu.addEventListener('close', () => abrir?.focus());
    // Si la ventana pasa a escritorio con el menú abierto, se cierra: allí no existe.
    matchMedia('(min-width: 992px)').addEventListener('change', (e) => { if (e.matches && menu.open) menu.close(); });
  }
</script>
