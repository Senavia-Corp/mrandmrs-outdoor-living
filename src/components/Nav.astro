\n    const link = e.target.closest('.item-link[data-service]');\n    if (link && submenu.contains(link)) {\n      activateService(link.dataset.service);\n    }\n  });\n  \n  submenu.addEventListener('click', (e) => {\n    const link = e.target.closest('.item-link[data-service]');\n    if (link && submenu.contains(link)) {\n      activateService(link.dataset.service);\n    }\n  });\n})();\n</script></div></section>".replace(
