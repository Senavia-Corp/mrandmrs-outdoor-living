// LA LANDING DE CIUDAD, UNA PARA TODOS LOS SERVICIOS (LOOP-CIUDADES, Fase 1, 5-oct-2026).
// Es el cuerpo que hasta hoy vivia en `src/pages/services/pool-builders/[slug].astro`, movido
// aqui SIN CAMBIAR UNA LINEA de lo que pinta pool-builders: la prueba es el diff del HTML
// construido de las 53 contra el build de `main` (= 0, anotado en LOOP-CIUDADES-ESTADO.md).
// Lo que cambia de un servicio a otro llega por `servicio` (`src/lib/servicios-ciudad.mjs`):
// el `Service` del JSON-LD, la pestana abierta del panel de servicios, el set de la galeria
// de obra y el encabezado del carrusel. Todo lo demas —secciones, orden, componentes— es el
// mismo para todos, que es lo que pide el encargo («mismo diseno exacto»).
// La cabecera historica de la plantilla (los cinco cambios a mano) sigue en la pagina de
// pool-builders, que es donde vive `getStaticPaths` con Sanity.
import { enlazadoDeCiudad } from '../lib/vecinas.mjs';
import Base from '../layouts/Base.astro';
import ResenasGoogle from './widgets/ResenasGoogle.astro';
import CarruselBlog from './widgets/CarruselBlog.astro';
import CarruselProyectos from './widgets/CarruselProyectos.astro';
import ConfianzaCore from './widgets/ConfianzaCore.astro';
import FormularioCore from './widgets/FormularioCore.astro';
import InversionCore from './widgets/InversionCore.astro';
import ServiciosIndice from './widgets/ServiciosIndice.astro';
import { logoLigero } from '../lib/logo-ligero.mjs';
import { franjaLogos } from '../lib/logos-franja.mjs';
import GaleriaObra from './widgets/GaleriaObra.astro';
import { fotoDeHeroe, fotosDeSeccion } from '../lib/heroe-ciudad.mjs';
import { tramosMiga } from '../lib/miga-tramos.mjs';
import ASSETS from '../data/assets-locales.json';
import CAPTACION from '../data/captacion-servicios.json';
import TELEFONOS from '../data/telefonos.json';
import { sinAperturaDelFeed } from '../lib/feed-social.mjs';
import { partirPorElCarrusel } from '../lib/carrusel-proyectos.mjs';
import { partirEn, heroeDeCaptacion } from '../lib/captacion-ciudad.mjs';
import { conBandaGaleria, bandaCompactaHtml } from '../lib/galeria-categorias.mjs';
import LIT from '../data/plantilla-pool-builders.json';
import RESENAS from '../data/resenas.json';
const RESENAS_PERFIL = RESENAS.enlacePerfil;

const esc = (s) => String(s ?? '').replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');

/** Aplana el documento a rutas con puntos, igual que hizo el generador al derivar la plantilla. */
function aplanar(o, pref = '', prof = 0, salida = {}) {
  for (const [k, v] of Object.entries(o ?? {})) {
    if (k.startsWith('_')) continue;
    const ruta = pref ? `${pref}.${k}` : k;
    if (typeof v === 'string') salida[ruta] = v;
    else if (v && typeof v === 'object' && !Array.isArray(v) && prof < 3) aplanar(v, ruta, prof + 1, salida);
  }
  return salida;
}

// `slug` es el de SANITY (la clave de seo-pool-builders.json, ciudades-captacion.json y la cache);
// `Astro.params.slug` es el tramo publico (`ocala-fl`). RUTA es la URL servida.
const { doc, ruta: RUTA, servicio: SV, seoRutas: SEO_RUTAS, fotosCiudad: FOTOS_CIUDAD, enlaces: ENLACES, heroeFoto: HEROE_FOTO } = Astro.props;
const slug = doc.slug;
const VECINDAD = enlazadoDeCiudad(RUTA);
const d = aplanar(doc);
/**
 * CUARTO CAMBIO A MANO (SEO-AEO-GEO A3) — OVERRIDE POR CIUDAD.
 * Las 53 comparten UNA plantilla, asi que «heroe pool-first para Gainesville» no es un cambio
 * de una pagina: o se tocan las 53, o existe este mecanismo. `bloques` en
 * `src/data/seo-pool-builders.json` pisa campos sueltos del documento ANTES de que la plantilla
 * los pinte. Hoy solo lo usan las 2 ciudades que reciben trafico de pago; las otras 51 no
 * llevan `bloques` y salen exactamente igual que antes.
 * Cada linea cambiada va declarada en `TRADUCIDAS_A_PROPOSITO` de `check-texto.mjs`.
 */
Object.assign(d, SEO_RUTAS[slug]?.bloques ?? {});
/**
 * SEO-REMEDIACION (4-oct-2026) — EL CARRUSEL DE OBRA DEJA DE DECIR QUE LA OBRA ES DE AQUI.
 * Sanity escribia «Browse our <Ciudad> portfolio of waterfront pools…» en las 53, encima de un
 * carrusel que es EL MISMO en las 53 y en el que no hay ni una obra con ciudad verificada
 * (`REQUIRES_CLIENT_CONFIRMATION.md` #8/#19/#28). Una landing local que llama «portfolio de
 * Gainesville» a piscinas de otros mercados es justo la senal falsa que no se puede dar. Se
 * sustituye en la plantilla, sin tocar Sanity; el dia que haya obra con ciudad verificada, la
 * pagina de esa ciudad puede volver a decirlo con la obra delante.
 * Declarado en `check-texto.mjs` (`CARRUSEL_CIUDAD`).
 */
d.headingPortfolio = SV.carrusel.titulo;
d.paragraphPortfolio = SV.carrusel.entradilla;
/**
 * Y EL APOYO DEL HEROE, POR EL MISMO MECANISMO Y POR LA MISMA RAZON (R20-CIUDADES).
 * Sanity vende ahi «new pool construction, pool remodeling, and luxury pool design» en la tercera
 * linea de la primera pantalla. En una landing cuyo ad group compra CONSTRUCCION NUEVA eso es
 * ofrecer la puerta de al lado antes de que el visitante haya entendido esta —la remodelacion
 * tiene su propia landing, con su propio formulario, desde R19—. Sustitucion 1->1, linea entera,
 * y declarada en `TRADUCIDAS_A_PROPOSITO` de `check-texto.mjs`. Solo en las rutas con entrada.
 */
// RUTA llega por props: la calcula y la comprueba la pagina que monta este componente.
const CAP = CAPTACION[RUTA] ?? null;
if (CAP?.heroe?.apoyo) d['intro'] = CAP.heroe.apoyo;
const CAMPOS = [[null,{"c":"h1Title","tx":"","p":["",""]},null,{"c":"h2Title","tx":"","p":["",""]},null,{"c":"intro","tx":"","p":["",""]},null,{"c":"imagenIntro1.alt","tx":"","p":["<img src=\"/images/pool-builders/alachua-florida/custom-pool-pergola-outdoor-living-contractors-fl-1-.webp\" loading=\"lazy\" data-w-id=\"f72979fc-9196-9930-356a-1756486557d5\" alt=\"","\" class=\"image\">"]},null,{"c":"imagenIntro2.alt","tx":"","p":["<img src=\"/images/pool-builders/alachua-florida/luxury-outdoor-kitchen-pool-backyard-design-florida-1-.webp\" loading=\"lazy\" data-w-id=\"53f4d2e0-9a7a-0e16-e20a-ab8f9e03c935\" alt=\"","\" class=\"image\">"]},null,{"c":"imagenIntro3.alt","tx":"","p":["<img src=\"/images/pool-builders/alachua-florida/luxury-pool-builders-outdoor-living-florida-1-.webp\" loading=\"lazy\" data-w-id=\"8bad508e-9f02-2bc9-bf6d-6ac47990da3b\" alt=\"","\" class=\"image\">"]},null,{"c":"headingIntro","tx":"","p":["",""]},null,{"c":"paragraphIntro","tx":"","p":["",""]},null,{"c":"heading3DRendering","tx":"","p":["",""]},null,{"c":"paragraphReviews","tx":"","p":["",""]},null,{"c":"headingFeature","tx":"","p":["",""]},null,{"c":"paragraphFeatures","tx":"","p":["",""]},null,{"c":"headingPortfolio","tx":"","p":["",""]},null,{"c":"paragraphPortfolio","tx":"","p":["",""]},null,{"c":"headingReviews","tx":"","p":["",""]},null,{"c":"paragraphReviews","tx":"","p":["",""]},null],[],[],[null]];


/**
 * LAS TRES FOTOS DE `trusted-section` SALEN DE /gallery (R20-CIUDADES F2, Sebastian 14-sep-2026).
 *
 * QUE HABIA. Tres `.webp` de `/images/pool-builders/alachua-florida/`, LAS MISMAS en las 53
 * -comprobado en Ocala, Gainesville, Boca Raton y Palatka- y con tres defectos medidos:
 *   1. sin `width`/`height` -> salto de maquetacion en una landing de pago;
 *   2. sin `srcset` -> el navegador se bajaba el original para una celda de 299 px;
 *   3. el `alt` de Sanity AFIRMA LA CIUDAD («…in Boca Raton, FL.») sobre un fichero que es el
 *      mismo en las 53. Esa es la razon de peso: una foto no puede decir donde se hizo si es la
 *      misma en 53 sitios. Las de /gallery no situan la obra en ninguna ciudad.
 *
 * POR QUE SE DERIVA DEL CATALOGO Y NO SE CABLEA EL `<img>`. `ciudades-captacion.json` ya trae
 * `src`, `srcset`, `alt`, `ancho`, `alto` y `pos` verificados contra disco para las 10 del set
 * `construction`, y era la misma fuente que pintaba el collage de la FAQ. Cablear aqui una segunda
 * copia es la forma habitual de que las dos dejen de coincidir.
 *
 * EL `data-w-id` SE LEE DEL MARCADO VIEJO Y SE VUELVE A PONER, no se copia a mano: es el gancho
 * de IX2 y perderlo deja la imagen atrapada en `opacity:0` (regla 1 de `check:ix2`). Si algun dia
 * no esta, esto revienta el build en vez de publicar una foto invisible.
 *
 * LA `Y` DE `object-position` ES INERTE AQUI, y por eso se fuerza a 50 %. Las tres celdas son mas
 * ESTRECHAS que el original en proporcion -299x500 (0,60) y 299x250 (1,20) contra 1,33/1,79-, asi
 * que `object-fit:cover` escala por altura y recorta SOLO a lo ancho, en los cuatro anchos. Se
 * conserva la X del catalogo, que es la que decide que franja se ve. Va en `style` y no en CSS
 * porque `check:tokens` mide un presupuesto de 92 KB y esto son tres reglas de una ruta.
 *
 * LAS FOTOS SE ELIGIERON MIRANDO el recorte REAL de cada celda, no por el nombre del fichero
 * (00-PRINCIPIOS.md §4): 03 en la celda alta -casa, agua y palmeras llenan la franja vertical-,
 * 05 y 07 en las dos bajas -la cascada y la pergola con spa, que es lo que mejor se lee a 299x250-.
 * El solape esta declarado: el feed de Instagram de esta misma pagina pinta las 10, asi que estas
 * tres vuelven a salir mas abajo. Se reparten entre los dos collages -03 y 07 son del de Ocala,
 * 05 del de Gainesville- para que ninguna de las dos rutas de pago se lleve las tres.
 */
/* R21 (Sebastian, 18-sep-2026): las tres pasan a ser LAS MISMAS QUE PINTA LA HOME en su
 * `trusted-section`. El catalogo cambia de `fotos.construccion` a `fotos.intro`; el mecanismo
 * —derivar del catalogo en vez de cablear el `<img>`— no cambia, que es lo que impide que las dos
 * copias dejen de coincidir. El porque, y lo que cuesta, esta escrito en `fotos.intro._lee_esto`.
 *
 * SE MANTIENE TODO LO QUE F2 ARREGLO, y esto es lo que hay que vigilar al cambiar de fotos:
 * `width`/`height` horneados (la home las pinta SIN ellos y por eso ahi sigue habiendo salto de
 * maquetacion), el `alt` que no situa la obra en ninguna ciudad, y el `data-w-id` releido del
 * marcado viejo. Lo unico que decae es el `srcset`: estos tres ficheros no tienen derivados. */
const FOTOS_INTRO = { 'imagenIntro1.alt': '1', 'imagenIntro2.alt': '2', 'imagenIntro3.alt': '3' };
const SIZES_INTRO = '(min-width: 992px) 300px, 50vw';
for (const h of CAMPOS[0]) {
  if (!h || !(h.c in FOTOS_INTRO)) continue;
  const f = FOTOS_CIUDAD.fotos.intro[FOTOS_INTRO[h.c]];
  if (!f) throw new Error(`${slug}: la foto ${FOTOS_INTRO[h.c]} no esta en ciudades-captacion.json`);
  const wid = (h.p[0].match(/data-w-id="([^"]+)"/) ?? [])[1];
  if (!wid) {
    throw new Error(`${slug}: el <img> de ${h.c} ya no trae data-w-id. Es el gancho de IX2: `
      + 'sin el, la foto se queda en opacity:0. Revisa CAMPOS antes de seguir.');
  }
  const x = String(f.pos).split(' ')[0];
  /* `srcset` solo si el catalogo lo trae. Sin esta guarda se emitia `srcset="undefined"`, que el
   * navegador intenta descargar: una peticion rota por foto y por ruta. */
  const resp = f.srcset ? `sizes="${SIZES_INTRO}" srcset="${f.srcset}" ` : '';
  h.p[0] = `<img src="${f.src}" loading="lazy" data-w-id="${wid}" width="${f.ancho}" `
    + `height="${f.alto}" ${resp}`
    + `style="object-position:${x} 50%" alt="`;
  d[h.c] = f.alt;   // el alt de /gallery, que no situa la obra en ninguna ciudad. NO toca Sanity.
}

const TX = { '': esc, url: encodeURIComponent };
const valor = (h, o) => {
  const v = o[h.c];
  // Un campo vacio deja un hueco mudo en la pagina. Mejor que reviente el build.
  if (typeof v !== 'string') throw new Error(`${slug}: falta el campo ${h.c}`);
  return h.p.join(TX[h.tx](v));
};


/* PANELES-GALERIA (2-oct-2026): la banda de seis paneles pasa a ser «Project Gallery» y la pinta
 * `bandaGaleriaHtml()`, con su titular FIJO. `headingFeature`/`paragraphFeatures` dejan de leerse
 * de Sanity: sus huecos siguen en CAMPOS -renumerarlos es justo lo que `carrusel-proyectos.mjs`
 * explica que no se hace- pero se rellenan vacios, para que limpiar esos campos en Sanity no
 * tire el build por la guarda de `valor()`. El tramo viejo se construye y se descarta abajo. */
d.headingFeature = '';
d.paragraphFeatures = '';

const B = LIT.map((tr, b) => tr.map((x, i) => {
  if (x !== null) return x;
  const h = CAMPOS[b][i];
  return valor(h, d);
}).join(''));

// headingBlog/paragraphBlog ya no son huecos de CAMPOS (R11-BLOG-02, pasaron a props
// directas de CarruselBlog); esta guarda reemplaza la que perdian al salir de CAMPOS —
// un campo vacio en Sanity revienta el build en vez de dejar un carrusel mudo.
if (!d['headingBlog'] || !d['paragraphBlog']) throw new Error(`${slug}: falta headingBlog/paragraphBlog`);

// R15-IG: B[2] pega el `.cta-footer` a la apertura de `.social-media`, y el feed tiene que
// ir DELANTE del CTA. B[3] era el `</section>` suelto que lo cerraba; ya no se renderiza,
// porque la seccion se escribe entera abajo — el mismo marcado literal que usa la home.
// R16-PROY: el carrusel «Project Showcase» viaja DENTRO de B[0] y pasa a componente. Se abre
// la cadena por donde estaba y el tramo viejo -los 10 slides de Webflow- se descarta: el
// componente emite esos 10 mas las 5 obras propias, que a estas 53 rutas les faltaban. El
// encabezado sigue saliendo de Sanity y ahora va por props, igual que en CarruselBlog; sus dos
// campos (`headingPortfolio`/`paragraphPortfolio`) SIGUEN siendo huecos de CAMPOS, asi que la
// guarda de `valor()` -un campo vacio revienta el build- se mantiene sola y no hace falta
// repetir aqui la de headingBlog.
/* ── R20-CIUDADES · LA CAPA DE CAPTACION ─────────────────────────────────────────────────────
 * Sin entrada NO SE TOCA NADA: `b0` sigue siendo `B[0]`, los tres trozos nuevos quedan vacios y
 * `<Fragment set:html="" />` no emite un solo byte. Es lo que permite encender 2 de 53.
 *
 * Los tres cortes, en el orden en que quedan en la pagina:
 *   · antes de `.trusted-section`  -> entra la franja de confianza, que responde «¿por que
 *     vosotros?» ANTES de pedir datos;
 *   · antes de `._3d-section`      -> entra el formulario, detras de la intro, que es donde la
 *     ficha Core lo puso tras medirlo (R19 C4: se ve obra antes de dar los datos);
 *   · el corte del carrusel, que ya existia.
 * Los tres marcadores aparecen UNA vez en `B[0]`, comprobado; `partirEn` lo exige igualmente. */
let b0 = conBandaGaleria(B[0], `${RUTA} B[0]`);
/* LOOP-CIUDADES (6-oct-2026): EL FONDO DEL HEROE, DEL SERVICIO. El video de fondo de las ciudades es
 * el reel de piscina (`bg-video`); detras de «Custom Aluminum Pergola Builders» presentaria una
 * piscina como si fuera obra del servicio. Con `heroeFoto` (la foto de heroe de la ficha) el bloque
 * del video se sustituye por esa foto, con el MISMO marco y la misma clase que el poster del video
 * (`.mm-video-poster`), asi que se coloca igual y no cuesta CSS. Exactamente un bloque, o revienta. */
if (HEROE_FOTO) {
  const RE_VIDEO = /<div data-poster-url="\/images\/site\/bg-video-poster\.0000000\.jpg"[^>]*>[\s\S]*?<\/video><\/div>/g;
  const n = (b0.match(RE_VIDEO) ?? []).length;
  if (n !== 1) throw new Error(`${slug}: esperaba UN video de fondo en el heroe y hay ${n}`);
  b0 = b0.replace(RE_VIDEO, () => '<div class="background-video-page w-background-video w-background-video-atom">'
    + `<picture class="mm-video-poster-marco"><img class="mm-video-poster" src="${esc(HEROE_FOTO.src)}" `
    + `width="${HEROE_FOTO.ancho}" height="${HEROE_FOTO.alto}" alt="" loading="eager" fetchpriority="high"></picture></div>`);
}
let ANTES_CONF = '', ANTES_FORM = '';
if (CAP) {
  b0 = heroeDeCaptacion(b0, CAP, TELEFONOS.items, `${RUTA} heroe`);
  [ANTES_CONF, b0] = partirEn(b0, '<section class="trusted-section"', `${RUTA} B[0]`);
  [ANTES_FORM, b0] = partirEn(b0, '<section class="_3d-section"', `${RUTA} B[0]`);
}

/* ── ASTRO-2 · HERO A DE CIUDAD (lamina «HeroA», D-112 a D-114) ───────────────────────────────
 * El hero de Webflow (video de fondo, texto centrado, marquesina de logos) deja de pintarse: de
 * `ANTES_CONF` solo se leen los logos y su titular. Lo que se pinta sale de los mismos campos de
 * siempre (`h1Title`, `h2Title`, `intro`) y de la entrada de captacion (accion, telefonos,
 * licencia). EL VIDEO DE FONDO SALE de estas 118 paginas (D-113): el LCP pasa a ser una foto con
 * medidas y `fetchpriority="high"`, o texto en las que no tienen bolsa.
 * La foto la reparte `heroe-ciudad.mjs`; el pie es el `alt` del banco y no situa la obra en ninguna
 * ciudad, salvo en Alachua, que es la unica con obra verificada alli (D-80). */
if (!CAP) throw new Error(`${slug}: sin entrada en captacion-servicios.json no hay hero que pintar`);
// `assets-locales.json` es {id de Sanity: ruta publica} y el id lleva las medidas («…-842x296-png»).
const DIM_LOGO = new Map(Object.entries(ASSETS).map(([id, pub]) => [pub, id.match(/-(\d+)x(\d+)-[a-z0-9]+$/)])
  .filter(([, m]) => m).map(([pub, m]) => [pub, { w: Number(m[1]), h: Number(m[2]) }]));
const LOGOS = [...new Set([...ANTES_CONF.matchAll(/<img[^>]*src="(\/images\/logos\/[^"]+)"/g)].map((m) => m[1]))];
const LOGOS_TITULO = (ANTES_CONF.match(/<h2 class="heading-logos">([^<]*)<\/h2>/) ?? [])[1];
if (!LOGOS.length || !LOGOS_TITULO) throw new Error(`${slug}: el hero de origen ya no trae la franja de logos`);
for (const u of LOGOS) if (!DIM_LOGO.has(u)) throw new Error(`${slug}: el logo ${u} no tiene medidas en assets-locales.json`);
const HERO_FOTO = fotoDeHeroe(RUTA);
// El rotulador va en la ciudad, que es como cierran los titulares: «… in Alachua, Florida».
const H1 = esc(d.h1Title).replace(/(\bin\s+)([^,]+?)(,\s*Florida)?\s*$/i, (m, a, c, f) => `${a}<span class="mm-rot">${c}</span>${f ?? ''}`);
/* D-248 (P-9): un telefono y sin etiqueta de zona. `heroe.zonas` (el orden de los dos numeros, el de la region primero) dejo de existir. */
const HERO_ZONAS = TELEFONOS.items;
const [HERO_LIC_ROT, ...HERO_LIC_VAL] = CAP.heroe.licencias.split(' · ');

const FAQ = CAP?.faq?.anade?.length ? CAP.faq : null;

const [P_ANTES_CON_BANDA, P_DESPUES] = partirPorElCarrusel(b0, `${RUTA} B[0]`);

/* ── SEO-REMEDIACION (Sebastian, 4-oct-2026) · LOS SERVICIOS SECUNDARIOS, DEBAJO DE LA FAQ ──────
 * Estas 53 son paginas de PISCINA («pool builders <ciudad>»). La banda «Project Gallery» (seis
 * paneles: piscinas, remodelacion, pergolas, techos, cocinas, decks) y el panel de los 14
 * servicios iban a media pagina, por encima de las resenas, la obra y la FAQ: le contaban a
 * Google y al visitante que la pagina va de todo el patio. Bajan detras de la FAQ, enteros y en
 * el mismo orden entre si. No se quita nada: cambian de sitio.
 *
 * La banda es la ULTIMA seccion de `P_ANTES` (la pinta `conBandaGaleria`, que exige que salga
 * una sola vez), asi que se corta por su apertura y se exige que no quede nada detras de su
 * cierre: si la plantilla cambia de forma, revienta el build en vez de mover otra cosa.
 *
 * ORDEN-CIUDADES-2 (Sebastian, 6-oct-2026): el corte sigue IGUAL, pero la banda ya no se pinta
 * detras de la FAQ sino delante, pegada al 3D. El panel de servicios si sigue debajo de la FAQ.
 * Ver la nota ORDEN-CIUDADES-2 en el cuerpo. */
const [P_ANTES, BANDA] = partirEn(P_ANTES_CON_BANDA, '<section class="animated-divs-section">', `${RUTA} banda`);
if (!BANDA.trimEnd().endsWith('</section>') || BANDA.indexOf('<section', 1) >= 0) {
  throw new Error(`${slug}: la banda «Project Gallery» ya no es la ultima seccion de P_ANTES`);
}
/* LOOP-CIUDADES (D6 revisada, 6-oct-2026): LA SECCION 3D SOLO DONDE ES DEL SERVICIO. `P_ANTES` es
 * exactamente `._3d-section`, y su video es el de diseno 3D de PISCINAS (herramienta «Pool», coping,
 * pendiente del vaso). En una landing de pergolas o cocinas presentaria diseno de piscina como si
 * fuera del servicio, y la revision independiente lo rechazo. Los servicios con `sin3d` no la
 * pintan; pool-builders y pool-remodeling si. Si la plantilla cambia de forma, revienta el build. */
if (SV.sin3d && (!P_ANTES.trimStart().startsWith('<section class="_3d-section"') || (P_ANTES.match(/<section/g) ?? []).length !== 1)) {
  throw new Error(`${slug}: P_ANTES ya no es solo la seccion 3D; no se puede omitir sin llevarse otra cosa`);
}
const P_ANTES_PINTADO = SV.sin3d ? '' : P_ANTES;

/** El `.svc-cierre` repite el CTA del heroe (`heroe.cta`, generado por build-captacion-ciudades). */
const CTA_CIERRE = CAP?.heroe?.cta ?? 'Get a Free Estimate';
// La palabra con rotulador del titular de la galeria: la `marca` de la ficha del servicio.
const MARCA_SERVICIO = CAPTACION[`/services/${RUTA.split('/')[2]}`]?.heroe?.marca;

const CTA_PIE = sinAperturaDelFeed(B[2], `${RUTA} B[2]`);
// Y B[3] deja de renderizarse, asi que hay que AFIRMAR que no era mas que ese cierre: si la
// plantilla derivada le metiera contenido algun dia, se perderia sin un solo rojo.
if (B[3] !== '</section>') {
  throw new Error(`${slug}: B[3] ya no es el cierre suelto del feed, es ${JSON.stringify(B[3])}. `
    + 'Al dejar de renderizarlo se estaria tirando contenido — revisa scripts/build-plantillas.mjs.');
}

/* ── ASTRO-2 · LAS PIEZAS QUE LA CIUDAD COMPARTE CON LA FICHA ──────────────────────────────
 * Intro, FAQ, resenas y cierre dejan de pintarse desde las cadenas de la plantilla de Webflow
 * (`ANTES_FORM`, `P_DESPUES`, `CTA_PIE`): de ellas solo se LEE el texto fijo que no esta en ningun
 * campo —el enlace de la intro, el rotulo de las resenas, el titular y el parrafo de la banda
 * final—. Si la plantilla deja de traerlo, el build revienta con el nombre de la pieza. */
const lee = (cadena, re, que) => {
  const m = String(cadena).match(re);
  if (!m) throw new Error(`${slug}: la plantilla ya no trae ${que}`);
  return m;
};
const FLECHA = '<svg aria-hidden="true" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"></path><path d="m13 6 6 6-6 6"></path></svg>';
const CHEVRON = '<svg aria-hidden="true" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m6 9 6 6 6-6"></path></svg>';
const nb = (html) => String(html).replace(/Design-Buil[dt]/g, '<span class="mm-nb">$&</span>');
const MIGA = tramosMiga(RUTA);
const mIntro = lee(ANTES_FORM, /<a href="([^"]+)"[^>]*class="[^"]*button[^"]*"[^>]*>([^<]+)<\/a>/, 'el enlace de la intro');
const INTRO_ENLACE = { href: mIntro[1], texto: mIntro[2] };
// El rotulador, en el territorio: «… Contractors in Gainesville and Alachua County».
const INTRO_H2 = nb(esc(d.headingIntro).replace(/(\bin\s+)(.+?)\s*$/i, (m, a, c) => `${a}<span class="mm-rot">${c}</span>`));
const RES_ROTULO = lee(P_DESPUES, /<div class="label">([^<]+)<\/div>/, 'el rotulo de las resenas')[1];
const RES_H2 = nb(esc(d.headingReviews).replace(/\b(Clients)\b/, '<span class="mm-rot">$1</span>'));
const CIERRE_H2 = nb(lee(CTA_PIE, /<h2>([\s\S]*?)<\/h2>/, 'el titular de la banda final')[1]);
const CIERRE_P = lee(CTA_PIE, /<div class="text-block-3">([\s\S]*?)<\/div>/, 'el parrafo de la banda final')[1];
const [FOTO_FAQ, FOTO_CIERRE, FOTO_RES] = fotosDeSeccion(RUTA);

/* RENDER 3D (lamina «Render3d»; solo los servicios que lo llevan). De la seccion de Webflow se leen
 * el titular, el parrafo y el bloque del video TAL CUAL: `Base.astro` (`video-fondo.mjs`) lo sigue
 * reescribiendo igual —poster local, `preload="none"`, carga diferida y boton de pausa—, que es lo
 * que mide `check:video-fondo`. Lo demas (fondo decorativo, envoltorios, `data-w-id`) sale. */
let R3D = null;
if (P_ANTES_PINTADO) {
  const m3 = lee(P_ANTES_PINTADO, /class="header-3d-section"><h2>([\s\S]*?)<\/h2><p>([\s\S]*?)<\/p><\/div>/, 'el titular y el parrafo del render 3D');
  const i3 = P_ANTES_PINTADO.indexOf('<div data-poster-url=');
  const f3 = P_ANTES_PINTADO.lastIndexOf('</div></div></div></section>');
  if (i3 < 0 || f3 < i3) throw new Error(`${slug}: la seccion 3D ya no trae el bloque del video donde se esperaba`);
  // Los dos iconos del boton de pausa no traen medidas del origen: se les ponen (24 x 24).
  R3D = { h2: nb(m3[1]), p: m3[2], video: P_ANTES_PINTADO.slice(i3, f3) };
}

const FAQ_H2 = FAQ ? nb(esc(FAQ.titulo).replace(/(FAQs?)\s*$/, '<span class="mm-rot">$1</span>')) : '';

const { seo: SEO_WEBFLOW, ldCrudo: LD_CRUDO } = SEO_RUTAS[slug];

/**
 * SEO-REMEDIACION (4-oct-2026) — FUERA EL `LocalBusiness` FALSO DE CADA CIUDAD.
 *
 * Webflow publicaba en las 53 un `LocalBusiness` llamado «Gainesville», «Ocala»… con una
 * `PostalAddress` de esa ciudad, un `GeoCoordinates` VACIO, `priceRange: "$$$$"`, imagenes que ya
 * no salen en la pagina y `url` relativa. Es decir: 53 negocios que no existen, uno por ciudad,
 * compitiendo con el de verdad (`#negocio`, que inyecta `Base.astro`). Las directrices de Google
 * piden lo contrario: un negocio de area de servicio no inventa una sede por ciudad.
 *
 * Se sustituye por lo que la pagina ES: un `Service` (construccion de piscina) que presta
 * `#negocio` en esa ciudad. El condado solo entra si esta verificado en `ciudades-captacion.json`
 * (igual que el copy). `check-seo.mjs` lo declara en `BLOQUES_SUSTITUIDOS` y valida su forma.
 */
const SITIO = String(Astro.site).replace(/\/$/, '');
const FILA_CIUDAD = FOTOS_CIUDAD.ciudades.find((c) => c.slug === slug);
const enEstado = { '@type': 'State', name: 'Florida' };
const servicioCiudad = (lb) => {
  const ciudad = lb.areaServed?.name ?? lb.name;
  return {
    '@context': 'https://schema.org',
    '@type': 'Service',
    '@id': `${SITIO}${RUTA}#servicio`,
    name: SV.schema.nombre(ciudad),
    serviceType: SV.schema.tipo,
    description: d['seo.description'] || lb.description,
    url: `${SITIO}${RUTA}`,
    provider: { '@id': `${SITIO}/#negocio` },
    areaServed: {
      '@type': 'City',
      name: ciudad,
      containedInPlace: FILA_CIUDAD?.condado
        ? { '@type': 'AdministrativeArea', name: `${FILA_CIUDAD.condado} County`, containedInPlace: enEstado }
        : enEstado,
    },
  };
};
const SEO_ORIGEN = {
  ...SEO_WEBFLOW,
  jsonLd: (SEO_WEBFLOW.jsonLd ?? []).map((b) => (b?.['@type'] === 'LocalBusiness' ? servicioCiudad(b) : b)),
};

/**
 * EL `FAQPage`, CONSTRUIDO DE LA MISMA FUENTE QUE EL ACORDEON QUE SE VE.
 *
 * Va en SU PROPIO bloque y no colgado del `LocalBusiness` del origen, por dos motivos: meterlo
 * dentro cambiaria un bloque que `check:seo` compara CARACTER A CARACTER contra el baseline, y
 * ademas un `FAQPage` no es una propiedad del negocio, es de la pagina.
 *
 * 🚨 SE DERIVA DE `faq.anade`, NO SE ESCRIBE APARTE. R17-CORE §4.3 encontro la ficha Core
 * publicando en su `FAQPage` una pregunta que no estaba en la pagina —y con una cifra sin
 * verificar dentro—. Un schema que promete respuestas que el visitante no encuentra es marcado
 * que miente, y Google lo trata como tal. Construyendolo del mismo array que pinta el acordeon,
 * el 1:1 no es una promesa: es una consecuencia. La regla 14 de `check:ads` lo comprueba igual,
 * porque «es imposible que se desvie» ya ha sido falso otras veces en este repo.
 */
const SEO = FAQ
  ? { ...SEO_ORIGEN, jsonLd: [...(SEO_ORIGEN.jsonLd ?? []), {
      '@context': 'https://schema.org',
      '@type': 'FAQPage',
      mainEntity: FAQ.anade.map((q) => ({
        '@type': 'Question',
        name: q.pregunta,
        acceptedAnswer: { '@type': 'Answer', text: q.respuesta },
      })),
    }] }
  : SEO_ORIGEN;---
<Base titulo={d["seo.title"]} descripcion={d["seo.description"]} ruta={RUTA} seo={SEO} jsonLdCrudo={LD_CRUDO}>
  <section class:list={['mm-hero-a', 'mm-hero-a--ciudad', !HERO_FOTO && 'mm-hero-a--sin']}>
    <div class="mm-hero-a-txt">
      {MIGA.length > 1 && (
        <nav class="mm-miga" aria-label="Breadcrumb"><ol>
          {MIGA.map((t, i) => (i === MIGA.length - 1 ? <li aria-current="page">{t.nombre}</li> : <li><a href={t.href}>{t.nombre}</a></li>))}
        </ol></nav>
      )}
      <h1 class="mm-h1" set:html={H1} />
      <h2 class="mm-hero-a-sub">{d.h2Title}</h2>
      <p class="mm-p">{d.intro}</p>
      <div class="mm-hero-a-acc">
        <a class="mm-btn" href={CAP.heroe.ancla}>{CAP.heroe.cta ?? 'Get a Free Estimate'}</a>
        <a class="mm-btn mm-btn--linea" href="/gallery">Project Gallery</a>
      </div>
      <div class="mm-datos mm-datos--3">
        {HERO_ZONAS.map((t) => <a class="mm-dato" href={`tel:${t.tel}`}><span class="mm-dato-val">{t.visible}</span></a>)}
        <div class="mm-dato"><span class="mm-dato-rot">{HERO_LIC_ROT}</span><span class="mm-dato-val">{HERO_LIC_VAL.join(' · ')}</span></div>
      </div>
    </div>
    {HERO_FOTO && (
      <figure class="mm-hero-a-medio">
        <img sizes="(min-width: 992px) 50vw, 100vw" src={HERO_FOTO.src} alt={HERO_FOTO.alt} width={HERO_FOTO.ancho} height={HERO_FOTO.alto} loading="eager" fetchpriority="high" decoding="async" />
        <figcaption class="mm-pie-foto"><span class="mm-dato-rot">Project</span><span>{HERO_FOTO.pie}</span></figcaption>
      </figure>
    )}
    {/* E7 (D-166): la franja de logos desfila. Marcado y duracion, en `logos-franja.mjs`.
        D-132: a 36 px de alto se sirve la version ligera del logo si la hay. */}
    <Fragment set:html={franjaLogos(LOGOS_TITULO, LOGOS.map((u) => logoLigero(u, DIM_LOGO.get(u))))} />
  </section>
  {/* ASTRO-2 (12-oct-2026) · ORDEN DE LA LAMINA «Ciudad»: confianza · intro · galeria de obra · render
       3D · servicios · inversion · FAQ · galeria por categorias · proyectos · articulos · resenas ·
       cierre · formulario. El porque de cada orden anterior (R20, R21, ORDEN-CIUDADES 1 y 2) esta en
       el historial de este fichero; el vigente lo afirma `check-estructura-ciudades.mjs`.
       La miga va dentro del hero. El feed de Instagram sale (T-42). */}
  <ConfianzaCore ruta={RUTA} />
  <section class="svc-intro mm-intro">
    <div class="mm-marco">
      <h2 class="mm-h2" set:html={INTRO_H2} />
      <p class="mm-p">{d.paragraphIntro}</p>
      <a class="mm-flecha" href={INTRO_ENLACE.href}>{INTRO_ENLACE.texto}<Fragment set:html={FLECHA} /></a>
    </div>
  </section>
  <GaleriaObra clave={SV.galeria} accion={CTA_CIERRE} marca={MARCA_SERVICIO} />
  {R3D && (
    <section class="mm-3d">
      <div class="mm-sec-cab">
        <h2 class="mm-h2" set:html={R3D.h2} />
        <div class="mm-sec-lado">
          <p class="mm-p" set:html={R3D.p} />
          <div class="mm-sec-acc"><a class="mm-btn mm-btn--linea mm-btn--linea-inv" href="#estimate">{CTA_CIERRE}</a></div>
        </div>
      </div>
      <figure class="mm-3d-medio" set:html={R3D.video} />
    </section>
  )}
  {/* Los 14 servicios a la vista, abierta la ficha del servicio de la pagina (D-129), con la accion en la cabecera. */}
  <ServiciosIndice servicio={RUTA.split('/')[2]} accion={CTA_CIERRE} />
  <InversionCore ruta={RUTA} />
  {FAQ && (
    <section class:list={['mm-faq', !FOTO_FAQ && 'mm-faq--sin']}>
      <div class="mm-sec-cab">
        <h2 class="mm-h2" set:html={FAQ_H2} />
        <div class="mm-sec-lado"><p class="mm-p">{FAQ.entradilla}</p></div>
      </div>
      <div class="mm-faq-cuerpo">
        <div class="mm-faq-col">
          <div class="mm-faq-lista">
            {FAQ.anade.map((q) => (
              <details class="mm-faq-item">
                <summary><h3>{q.pregunta}</h3><Fragment set:html={CHEVRON} /></summary>
                <div class="mm-faq-r">
                  <p>{q.respuesta}</p>
                  {q.fuentes?.length ? (
                    <p class="mm-faq-fuentes">Official sources:{' '}
                      {q.fuentes.map((f, i) => (<>{i ? ' · ' : ''}<a href={f.url} target="_blank" rel="noopener">{f.nombre}</a></>))}
                    </p>
                  ) : null}
                </div>
              </details>
            ))}
          </div>
          {/* LOOP-CIUDADES: el enlazado de las landings —su ficha, su condado y los otros servicios
               de la MISMA ciudad—. Las 53 de piscina no traen `enlaces` y no pintan nada. */}
          {ENLACES && (
            <p class="mm-faq-fuentes mm-faq-mas">More for {doc.name} homeowners:{' '}
              {[
                { href: ENLACES.ficha, nombre: `${SV.nombre} in Florida` },
                ...ENLACES.hermanas.map((h) => ({ href: h.href, nombre: `${h.nombre} in ${doc.name}` })),
                ...(ENLACES.condado ? [{ href: ENLACES.condado, nombre: `${FILA_CIUDAD?.condado} County` }] : []),
              ].map((e, i) => (<>{i ? ' · ' : ''}<a href={e.href}>{e.nombre}</a></>))}
            </p>
          )}
          {/* E5-SEO (puntos 2 y 4): las 53 de piscina ganan la misma fila —su ficha, los otros servicios
               de su ciudad y su condado—, y las 118, una segunda con hasta cinco ciudades del mismo
               servicio en su condado o en su zona. Todo sale de `src/lib/vecinas.mjs`. */}
          {!ENLACES && VECINDAD && (
            <p class="mm-faq-fuentes mm-faq-mas">{VECINDAD.rotuloMas}{' '}
              {VECINDAD.mas.map((e, i) => (<>{i ? ' · ' : ''}<a href={e.href}>{e.nombre}</a></>))}
            </p>
          )}
          {VECINDAD?.vecinas.length ? (
            <p class="mm-faq-fuentes mm-faq-mas">{VECINDAD.rotuloVecinas}{' '}
              {VECINDAD.vecinas.map((e, i) => (<>{i ? ' · ' : ''}<a href={e.href}>{e.nombre}</a></>))}
            </p>
          ) : null}
        </div>
        <div class="mm-faq-lado">
          {FOTO_FAQ && (
            <figure class="mm-lam-medio mm-faq-medio"><img class="mm-lam-foto" sizes="(min-width: 992px) 42vw, 100vw" src={FOTO_FAQ.src} alt={FOTO_FAQ.alt} width={FOTO_FAQ.ancho} height={FOTO_FAQ.alto} loading="lazy" decoding="async" /></figure>
          )}
          <div class="mm-faq-accion">
            <a class="mm-btn" href="#estimate">{CTA_CIERRE}</a>
            <div class="mm-datos mm-datos--tel">{HERO_ZONAS.map((t) => <a class="mm-dato" href={`tel:${t.tel}`}><span class="mm-dato-val">{t.visible}</span></a>)}</div>
          </div>
        </div>
      </div>
    </section>
  )}
  <Fragment set:html={bandaCompactaHtml(CTA_CIERRE)} />
  <CarruselProyectos titulo={d['headingPortfolio']} entradilla={d['paragraphPortfolio']} />
  <CarruselBlog titulo={d['headingBlog']} entradilla={d['paragraphBlog']} />
  <section class:list={['mm-res', !FOTO_RES && 'mm-res--sin']}>
    <div class="mm-sec-cab">
      <div class="mm-sec-tit"><p class="mm-etiqueta">{RES_ROTULO}</p><h2 class="mm-h2" set:html={RES_H2} /></div>
      <div class="mm-sec-lado">
        <p class="mm-p">{d.paragraphReviews}</p>
        <div class="mm-sec-acc">
          <a class="mm-btn mm-btn--linea" href="#estimate">{CTA_CIERRE}</a>
          <a class="mm-flecha" href={RESENAS_PERFIL} target="_blank" rel="noopener noreferrer">See all reviews<Fragment set:html={FLECHA} /></a>
        </div>
      </div>
    </div>
    <div class="mm-res-cuerpo">
      <div class="mm-res-col">
        <ResenasGoogle />
        <div class="mm-datos mm-datos--tel">{HERO_ZONAS.map((t) => <a class="mm-dato" href={`tel:${t.tel}`}><span class="mm-dato-val">{t.visible}</span></a>)}</div>
      </div>
      {FOTO_RES && (
        <figure class="mm-res-medio"><img src={FOTO_RES.src} alt={FOTO_RES.alt} width={FOTO_RES.ancho} height={FOTO_RES.alto} loading="lazy" decoding="async" /></figure>
      )}
    </div>
  </section>
  <section class:list={['mm-cierre', !FOTO_CIERRE && 'mm-cierre--sin']}>
    <div class="mm-cierre-caja">
      <div class="mm-cierre-txt">
        <h2 class="mm-h2" set:html={CIERRE_H2} />
        <p class="mm-p" set:html={CIERRE_P} />
        <div class="mm-datos mm-datos--tel">{HERO_ZONAS.map((t) => <a class="mm-dato" href={`tel:${t.tel}`}><span class="mm-dato-val">{t.visible}</span></a>)}</div>
      </div>
      {FOTO_CIERRE && (
        <figure class="mm-cierre-medio"><img src={FOTO_CIERRE.src} alt={FOTO_CIERRE.alt} width={FOTO_CIERRE.ancho} height={FOTO_CIERRE.alto} loading="lazy" decoding="async" /></figure>
      )}
    </div>
  </section>
  <FormularioCore ruta={RUTA} />
</Base>
