---
/**
 * LA FICHA DE UNA OBRA DE AUTORIA PROPIA (ASTRO-4 lote A).
 *
 * Las 5 obras de `proyectos-propios.json` pintan la MISMA ficha que las 10 que salen del origen:
 * el marcado lo escribe `src/lib/ficha-proyecto.mjs`, que es tambien el que usa
 * `scripts/build-paginas.mjs` para aquellas. Aqui solo se le pasan los datos de la obra.
 *
 *   hero C (titular, relato y portada) · «Project Details» con sus tres datos, la accion y todas
 *   las fotos a la vista · «More Projects» · banda de cierre · formulario (D-82).
 *
 * Cada foto de la galeria lleva su `alt` real (en las del origen viene vacio) y sus medidas, que
 * se leen del fichero: el JSON no las trae.
 */
import path from 'node:path';
import sharp from 'sharp';
import { heroProyectoHtml, detalleProyectoHtml, cierreProyectoHtml, conAlt } from '../lib/ficha-proyecto.mjs';
import { tramosMiga } from '../lib/miga-tramos.mjs';
import TELEFONOS from '../data/telefonos.json';
import CarruselProyectos from './widgets/CarruselProyectos.astro';
import FormularioCore from './widgets/FormularioCore.astro';

interface Props { obra: { tituloFicha: string; resumen: string; ubicacion: string;
  estilo: string; tipo: string; galeria: { src: string; alt: string }[] } }
const { obra } = Astro.props;

const esc = (t: string) => t.replace(/&/g, '&amp;').replace(/</g, '&lt;');
const fotos = conAlt(await Promise.all(obra.galeria.map(async (f) => {
  const m = await sharp(path.join(process.cwd(), 'public', f.src)).metadata();
  if (!m.width || !m.height) throw new Error(`FichaObra: no puedo medir ${f.src}`);
  return { ...f, w: m.width, h: m.height };
})), obra.tituloFicha);
const telefonos = TELEFONOS.items;
---
<Fragment set:html={heroProyectoHtml({ tituloHtml: esc(obra.tituloFicha), resumenHtml: esc(obra.resumen), fotos, tramos: tramosMiga(`/project/${obra.slug}`) })} />
<Fragment set:html={detalleProyectoHtml({
  tituloHtml: 'Project Details',
  datos: [['Location', obra.ubicacion], ['Design Style', obra.estilo], ['Project Type', obra.tipo]],
  fotos,
  accion: { href: '/request-estimated', texto: 'Get a Free Estimate' },
  telefonos,
})} />
<CarruselProyectos />
<Fragment set:html={cierreProyectoHtml({
  tituloHtml: 'Request a Design-Build Project Evaluation',
  parrafoHtml: 'Share your property details, project scope, and investment range. Our licensed design-build pool builders will review your request and confirm alignment before next steps.',
  telefonos,
})} />
<FormularioCore />
