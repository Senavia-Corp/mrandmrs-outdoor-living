---
/**
 * Reseñas de Google, nativas. Sustituye al widget de Elfsight `ce5a93b9-…` (decisión D2).
 *
 * DÓNDE VIVE
 * Dentro de `section.testimonial-section` de la home, justo debajo del encabezado que ya
 * existe («TESTIMONIALS» + h2 + párrafo). Esa sección tiene FONDO OSCURO con imagen y
 * `color: var(--white)`, así que las tarjetas son de vidrio sobre el fondo, no blancas
 * opacas: el sitio ya usa ese lenguaje (`.hero-glass-section-page`).
 *
 * SI NO HAY DATOS, NO PINTA NADA
 * `src/data/resenas.json` está vacío a propósito y NO se rellena con texto de ejemplo.
 * Una reseña inventada en un sitio de captación de clientes no es un marcador de posición,
 * es un problema. Los datos los trae la integración con el perfil del cliente
 * (CID 13592496939047920063).
 */
import datos from '../../data/resenas.json';

interface Props {
  /** Solo para la vista de diseño. En el sitio manda src/data/resenas.json. */
  datosDemo?: typeof datos;
}
const d = (Astro.props.datosDemo ?? datos) as {
  publicar?: boolean;
  items: { autor: string; foto?: string; estrellas: number; texto: string; fecha?: string }[];
  valoracion: number | null; total: number | null; enlacePerfil: string; actualizado: string | null;
};
const { items, valoracion, total, enlacePerfil, actualizado } = d;
/**
 * Dos condiciones, y la primera es un INTERRUPTOR HUMANO que vive en el JSON.
 *
 * `publicar: false` deja las 83 rutas que montan este componente exactamente como
 * estaban, sin desmontarlo de ninguna: el dia que haya material aprobado se cambia
 * un booleano y salen. La decision es sobre los DATOS, no sobre el markup, y por eso
 * no se apaga comentando el componente en 83 sitios.
 *
 * `!== false` y no `=== true`: un JSON antiguo sin el campo sigue pintando si tiene
 * reseñas, que es el comportamiento de antes. Solo un `false` explicito apaga.
 */
const hay = d.publicar !== false && items.length > 0;
/**
 * Mes y año en la zona del NEGOCIO, no en la de quien mira.
 *
 * Sin `timeZone` esto lo resuelve el navegador del visitante: una reseña de las
 * 21:00 del 31 de agosto en Florida llega como 2026-09-01T01:00Z y se veia
 * «Aug 2026» desde Miami y «Sep 2026» desde Madrid. Es la fecha en que un cliente
 * escribio su reseña: no puede depender de donde este el que la lee.
 */
const fmt = (f?: string) => (f
  ? new Date(f).toLocaleDateString('en-US',
      { month: 'short', year: 'numeric', timeZone: 'America/New_York' })
  : '');
---
{hay && (
  <div class="mm-resenas">
    <div class="mm-resenas__resumen">
      {/* LOS CUATRO HEX DE LA G SON DE GOOGLE Y NO SE TOCAN. Son los colores oficiales
          de su logotipo: #4285F4 azul, #34A853 verde, #FBBC05 amarillo, #EA4335 rojo.
          Retonarlos al eje de marca de esta casa seria repintar la marca de un tercero,
          asi que se quedan como literal a proposito: no pueden vivir en
          `disenio/tokens.css`, que es el vocabulario de Mr & Mrs, no el de Google. */}
      <svg class="mm-resenas__g" viewBox="0 0 24 24" aria-hidden="true">
        <path fill="#4285F4" d="M23.5 12.3c0-.8-.1-1.6-.2-2.3H12v4.5h6.5a5.6 5.6 0 0 1-2.4 3.7v3h3.9c2.3-2.1 3.5-5.2 3.5-8.9Z"/>
        <path fill="#34A853" d="M12 24c3.2 0 5.9-1.1 7.9-2.9l-3.9-3a7.2 7.2 0 0 1-10.7-3.8H1.3v3.1A12 12 0 0 0 12 24Z"/>
        <path fill="#FBBC05" d="M5.3 14.3a7.1 7.1 0 0 1 0-4.6V6.6H1.3a12 12 0 0 0 0 10.8l4-3.1Z"/>
        <path fill="#EA4335" d="M12 4.8c1.8 0 3.4.6 4.6 1.8l3.5-3.5A12 12 0 0 0 1.3 6.6l4 3.1A7.2 7.2 0 0 1 12 4.8Z"/>
      </svg>
      {valoracion != null && (
        <p class="mm-resenas__nota"><strong>{valoracion.toFixed(1)}</strong></p>
      )}
      {valoracion != null && (
        <div class="mm-resenas__estrellas" role="img" aria-label={`${valoracion} de 5 estrellas`}>
          {[1, 2, 3, 4, 5].map((n) => (
            <svg viewBox="0 0 20 20" class={n <= Math.round(valoracion) ? 'llena' : ''} aria-hidden="true">
              <path d="M10 1.5l2.6 5.3 5.9.9-4.3 4.1 1 5.8L10 14.9 4.8 17.6l1-5.8L1.5 7.7l5.9-.9L10 1.5Z"/>
            </svg>
          ))}
        </div>
      )}
      {total != null && <p class="mm-resenas__total">{total} Google reviews</p>}
      <a class="mm-resenas__enlace" href={enlacePerfil} target="_blank" rel="noopener noreferrer">
        See all reviews
      </a>
    </div>

    <div class="mm-resenas__carrusel" fs-slider-instance="fs-slider-resenas">
    <ul class="mm-resenas__lista" fs-slider-element="list" role="list">
      {items.map((r) => (
        <li class="mm-resenas__tarjeta" fs-slider-element="slide" role="listitem">
          <div class="mm-resenas__estrellas mm-resenas__estrellas--card" role="img" aria-label={`${r.estrellas} de 5`}>
            {[1, 2, 3, 4, 5].map((n) => (
              <svg viewBox="0 0 20 20" class={n <= r.estrellas ? 'llena' : ''} aria-hidden="true">
                <path d="M10 1.5l2.6 5.3 5.9.9-4.3 4.1 1 5.8L10 14.9 4.8 17.6l1-5.8L1.5 7.7l5.9-.9L10 1.5Z"/>
              </svg>
            ))}
          </div>
          <p class="mm-resenas__texto">{r.texto}</p>
          <div class="mm-resenas__autor">
            {r.foto
              ? <img src={r.foto} alt="" width="40" height="40" loading="lazy" decoding="async" />
              : <span class="mm-resenas__inicial" aria-hidden="true" data-inicial={r.autor.trim().charAt(0)}></span>}
            <span>
              <strong>{r.autor}</strong>
              {r.fecha && <em>{fmt(r.fecha)}</em>}
            </span>
          </div>
        </li>
      ))}
    </ul>
      <div fs-slider-element="navigation" class="mm-resenas__nav">
        <button type="button" fs-slider-element="previous" class="mm-resenas__flecha" aria-label="Previous reviews">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M15 5l-7 7 7 7" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </button>
        <button type="button" fs-slider-element="next" class="mm-resenas__flecha" aria-label="Next reviews">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M9 5l7 7-7 7" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </button>
      </div>
      <div fs-slider-element="scrollbar" class="mm-resenas__barra" role="presentation">
        <div fs-slider-element="scrollbar-drag" class="mm-resenas__barra-drag"></div>
      </div>
    </div>
    {actualizado && <p class="mm-resenas__pie">Updated {fmt(actualizado)}</p>}
  </div>
)}

<style>
  .mm-resenas { width: 100%; max-width: 1250px; margin-inline: auto }

  /* ── el resumen ───────────────────────────────────────────────────────── */
  .mm-resenas__resumen {
    display: flex; align-items: center; justify-content: center;
    flex-wrap: wrap; gap: .75rem 1rem;
    margin-bottom: 2rem;
    text-align: center;
  }
  .mm-resenas__g { width: 26px; height: 26px; flex: none }
  .mm-resenas__nota { margin: 0; font-size: 34px; line-height: 1; font-weight: 700 }
  .mm-resenas__total { margin: 0; font-size: 15px; font-weight: 600; opacity: .85 }

  .mm-resenas__enlace {
    display: inline-block;
    padding: .5rem 1.1rem;
    border-radius: 8px;
    font-size: 14px; font-weight: 700; text-decoration: none;
    color: var(--mm-navy);
    /* El degradado dorado de .button-styles del sitio, ahora en tokens. Los tres
       oros resuelven a los MISMOS hex que habia (#f4b248 / #d99933 / #edb660), asi
       que no mueve un pixel. Ratios MEDIDOS con la formula de luminancia relativa de
       WCAG 2.x sobre esos hex, no estimados — coinciden al decimal con los que ya
       declara `disenio/tokens.css`:
           var(--mm-navy) sobre --mm-oro ......... 8,40:1
           var(--mm-navy) sobre --mm-oro-hondo ... 6,35:1   <- el peor punto (25/75 %)
           var(--mm-navy) sobre --mm-oro-claro ... 8,51:1
       El peor punto del recorrido pasa AA y AAA para texto normal. */
    background-image: linear-gradient(135deg,
      var(--mm-oro), var(--mm-oro-hondo) 25%,
      var(--mm-oro-claro) 50%, var(--mm-oro-hondo) 75%, var(--mm-oro));
  }
  /* MEDIDO Y NO TOCADO (era `#fff`, mismo valor). Este anillo vale sobre el fondo
     oscuro de la home, pero el componente tambien vive en /testimonials y /contact-us,
     con seccion BLANCA: ahi es blanco sobre blanco = 1,00:1 y suspende los 3:1 de WCAG
     1.4.11. Cambiar el color es una decision de diseno —el hermano de abajo usa
     `currentColor`, que si se adapta—, no una traduccion a tokens; queda anotado. */
  .mm-resenas__enlace:focus-visible { outline: var(--mm-foco-grosor) solid var(--mm-foco); outline-offset: var(--mm-foco-aire); box-shadow: var(--mm-foco-halo) }

  /* ── estrellas ────────────────────────────────────────────────────────── */
  .mm-resenas__estrellas { display: flex; gap: 2px }
  /* `currentColor` y no un blanco fijo: este componente vive en fondo OSCURO en
     la home y en fondo BLANCO en /testimonials y /contact-us. Con #ffffff3d la
     estrella vacia era invisible en la mitad de las rutas. */
  .mm-resenas__estrellas svg { width: 18px; height: 18px; fill: currentColor; opacity: .24 }
  .mm-resenas__estrellas svg.llena { fill: var(--mm-oro); opacity: 1 }

  /* ── el carrusel ──────────────────────────────────────────────────────────
     El motor vive en Componentes.astro y es global: se activa solo con los
     atributos fs-slider-* mas una entrada en la configuracion de sliders. Aqui
     NO se escribe JS. El desplazamiento, el scroll-snap y el ocultado de la
     barra nativa los pone el, colgados de [fs-slider-element="list"].

     ALTURA CONSTANTE, y es load-bearing: check-visual.mjs corta por diferencia
     de alto ANTES de comparar un solo pixel. Si la seccion creciera con el
     numero o la longitud de las reseñas, cada refresco semanal movería todo lo
     que va debajo y pondría en rojo las 83 rutas sin que nada este roto. De ahi
     las tres alturas clavadas: resumen, tarjeta y pie.
     ─────────────────────────────────────────────────────────────────────────── */
  .mm-resenas__carrusel { position: relative }

  .mm-resenas__lista {
    list-style: none; margin: 0; padding: 0;
    display: flex; gap: 1.25rem;
  }

  .mm-resenas__tarjeta {
    display: flex; flex-direction: column; gap: .85rem;
    padding: 1.5rem;
    border-radius: 15px;                        /* el radio de .card del sitio */
    /* Vidrio que se adapta al fondo: la primera declaracion de cada par pone el velo
       BLANCO y la segunda lo retiñe con el color de texto heredado, asi que funciona
       igual sobre el fondo oscuro de la home que sobre el blanco de /testimonials.
       Los dos velos blancos eran hex de 8 digitos y ahora son EL MISMO valor escrito
       con token: alfa 0x14 = 20/255 = 7,84 % -> 8 %; alfa 0x29 = 41/255 = 16,08 % -> 16 %.
       EL 16 % NO ES ERRATA: es lo que valia el literal. Que la linea de debajo diga 18 %
       ya pasaba antes de esta migracion; igualarlos es una decision de diseno, no de
       traduccion, y no se toma aqui.
       LO QUE CUESTA, dicho: la primera declaracion ya no es respaldo para navegadores
       sin color-mix, porque ahora tambien lo usa. Ahi la tarjeta se queda sin velo en
       vez de con el blanco. Se acepta porque color-mix es linea base del repo —lo usan
       `disenio/propio.css` y la SEGUNDA declaracion de cada par de aqui mismo, o sea
       que en ese navegador el vidrio adaptativo no existia igualmente. */
    background-color: color-mix(in srgb, var(--mm-blanco) 8%, transparent);
    background-color: color-mix(in srgb, currentColor 8%, transparent);
    border: 1px solid color-mix(in srgb, var(--mm-blanco) 16%, transparent);
    border-color: color-mix(in srgb, currentColor 18%, transparent);
    backdrop-filter: blur(6px);
    /* `flex: none` + `height` fijo: el motor escribe el `width` en linea a partir
       de la configuracion, y la altura no puede depender del texto. El respaldo
       de `flex-basis` es para cuando el motor aun no ha dimensionado. */
    flex: none; height: 320px; flex-basis: min(380px, 82%);
    box-sizing: border-box;
  }

  .mm-resenas__texto {
    margin: 0; font-size: 16px; line-height: 1.55;
    /* El recorte es SOLO visual: el texto entero sigue en el DOM y en el HTML
       servido, que es donde esta todo el valor -lo leen los crawlers y los
       motores de respuesta-. `height` y no `max-height` para que una reseña
       corta ocupe lo mismo que una larga. */
    display: -webkit-box; -webkit-line-clamp: 6; -webkit-box-orient: vertical;
    overflow: hidden;
    height: calc(6 * 1.55em);
  }

  /* ── flechas y barra ──────────────────────────────────────────────────── */
  .mm-resenas__nav { display: flex; gap: .6rem; justify-content: center; margin-top: 1.5rem }
  .mm-resenas__flecha {
    width: 3rem; height: 3rem; flex: none;
    display: grid; place-items: center;
    border: 0; border-radius: 100%; cursor: pointer;
    color: var(--mm-navy);
    background-image: linear-gradient(135deg,
      var(--mm-oro), var(--mm-oro-hondo) 25%,
      var(--mm-oro-claro) 50%, var(--mm-oro-hondo) 75%, var(--mm-oro));
  }
  .mm-resenas__flecha svg { width: 1.35rem; height: 1.35rem }
  .mm-resenas__flecha:focus-visible { outline: 3px solid currentColor; outline-offset: 3px }
  /* El motor marca los extremos con aria-disabled, no con el atributo disabled. */
  .mm-resenas__flecha[aria-disabled="true"] { opacity: .35; pointer-events: none }

  .mm-resenas__barra {
    height: 1rem; margin-top: 1rem; border-radius: 1rem;
    background-color: color-mix(in srgb, var(--mm-blanco) 16%, transparent);
    overflow: hidden;
    background-color: color-mix(in srgb, currentColor 18%, transparent);
  }
  .mm-resenas__barra-drag {
    width: 20%; height: 1rem; border-radius: 1rem;
    background-image: linear-gradient(135deg,
      var(--mm-oro), var(--mm-oro-hondo) 25%,
      var(--mm-oro-claro) 50%, var(--mm-oro-hondo) 75%, var(--mm-oro));
  }

  .mm-resenas__autor { display: flex; align-items: center; gap: .7rem; margin-top: auto }
  .mm-resenas__autor img,
  .mm-resenas__inicial {
    width: 40px; height: 40px; border-radius: 100%; flex: none;
    object-fit: cover;
  }
  .mm-resenas__inicial {
    display: grid; place-items: center;
    background-color: var(--mm-oro);
    color: var(--mm-navy);
    font-weight: 700; font-size: 17px;
  }
  /* Contenido generado a proposito: como <span> de texto, `display:grid` lo
     blockifica y se lleva una linea propia de innerText, que es la puerta mas
     severa del repo. Con ::before no cuenta. Mismo truco que el contador 3/7. */
  .mm-resenas__inicial::before { content: attr(data-inicial) }
  .mm-resenas__autor span { display: flex; flex-direction: column; line-height: 1.3 }
  .mm-resenas__autor em { font-style: normal; font-size: 13px; opacity: .75 }

  .mm-resenas__pie { margin: 1.25rem 0 0; text-align: center; font-size: 13px; opacity: .6 }

  @media (max-width: 767px) {
    /* El numero de tarjetas por vista lo gobierna slidesPerView, no el CSS. */
    .mm-resenas__nota { font-size: 28px }
    .mm-resenas__tarjeta { height: 300px }
  }
</style>
