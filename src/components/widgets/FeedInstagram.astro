---
/**
 * Feed de Instagram, nativo. Sustituye al widget de Elfsight `fdd09947-…` (decisión D2).
 *
 * DÓNDE VIVE
 * Es la `section.social-media` entera de la home: hoy esa sección existe pero llega a
 * altura 0 porque el widget no pinta. Aquí se pinta desde datos propios.
 *
 * SI NO HAY DATOS, NO PINTA NADA. `src/data/instagram.json` está vacío a propósito: el
 * snapshot lo trae la integración en build time, nunca un token vivo en el navegador
 * —un token de Instagram caduca y apaga el feed un martes cualquiera sin avisar—.
 *
 * Las imágenes se sirven LOCALES: el CDN de Instagram firma sus URLs y caducan en horas,
 * así que apuntar ahí es un feed que se rompe solo. La integración las descarga.
 */
import datos from '../../data/instagram.json';

interface Props {
  /** Solo para la vista de diseño. En el sitio manda src/data/instagram.json. */
  datosDemo?: typeof datos;
}
const d = (Astro.props.datosDemo ?? datos) as {
  items: { id: string; imagen: string; alt?: string; enlace: string; ancho?: number; alto?: number }[];
  usuario: string; fuente: string;
};
const { items, usuario, fuente } = d;
const hay = items.length > 0;
---
{hay && (
  <div class="mm-ig">
    <div class="mm-ig__cabecera">
      <svg class="mm-ig__logo" viewBox="0 0 24 24" aria-hidden="true">
        <path fill="currentColor" d="M12 2.2c3.2 0 3.6 0 4.9.07 1.2.05 1.8.25 2.2.42.6.22 1 .48 1.4.9.43.42.69.83.91 1.4.17.42.37 1.05.42 2.2.06 1.28.07 1.66.07 4.89s-.01 3.6-.07 4.89c-.05 1.15-.25 1.78-.42 2.2a3.9 3.9 0 0 1-.9 1.4c-.43.43-.84.69-1.41.91-.42.17-1.05.37-2.2.42-1.28.06-1.66.07-4.89.07s-3.6-.01-4.89-.07c-1.15-.05-1.78-.25-2.2-.42a3.9 3.9 0 0 1-1.4-.9 3.9 3.9 0 0 1-.91-1.41c-.17-.42-.37-1.05-.42-2.2C2.21 15.6 2.2 15.23 2.2 12s.01-3.6.07-4.89c.05-1.15.25-1.78.42-2.2.22-.57.48-.98.9-1.4.42-.43.83-.69 1.4-.91.42-.17 1.05-.37 2.2-.42C8.4 2.21 8.78 2.2 12 2.2Zm0 3.1a6.7 6.7 0 1 0 0 13.4 6.7 6.7 0 0 0 0-13.4Zm0 11.05a4.35 4.35 0 1 1 0-8.7 4.35 4.35 0 0 1 0 8.7Zm6.96-11.31a1.56 1.56 0 1 1-3.13 0 1.56 1.56 0 0 1 3.13 0Z"/>
      </svg>
      <a class="mm-ig__usuario" href={fuente} target="_blank" rel="noopener noreferrer">@{usuario}</a>
      <a class="mm-ig__seguir" href={fuente} target="_blank" rel="noopener noreferrer">Follow</a>
    </div>

    <ul class="mm-ig__rejilla" role="list">
      {items.map((p) => (
        <li class="mm-ig__celda">
          <a href={p.enlace} target="_blank" rel="noopener noreferrer">
            <img
              src={p.imagen}
              alt={p.alt ?? ''}
              width={p.ancho ?? 640}
              height={p.alto ?? 640}
              loading="lazy"
              decoding="async"
            />
            <span class="mm-ig__velo" aria-hidden="true">
              <svg viewBox="0 0 24 24" aria-hidden="true">
                <path fill="currentColor" d="M12 2.2c3.2 0 3.6 0 4.9.07 1.2.05 1.8.25 2.2.42.6.22 1 .48 1.4.9.43.42.69.83.91 1.4.17.42.37 1.05.42 2.2.06 1.28.07 1.66.07 4.89s-.01 3.6-.07 4.89c-.05 1.15-.25 1.78-.42 2.2a3.9 3.9 0 0 1-.9 1.4c-.43.43-.84.69-1.41.91-.42.17-1.05.37-2.2.42-1.28.06-1.66.07-4.89.07s-3.6-.01-4.89-.07c-1.15-.05-1.78-.25-2.2-.42a3.9 3.9 0 0 1-1.4-.9 3.9 3.9 0 0 1-.91-1.41c-.17-.42-.37-1.05-.42-2.2C2.21 15.6 2.2 15.23 2.2 12s.01-3.6.07-4.89c.05-1.15.25-1.78.42-2.2.22-.57.48-.98.9-1.4.42-.43.83-.69 1.4-.91.42-.17 1.05-.37 2.2-.42C8.4 2.21 8.78 2.2 12 2.2Zm0 3.1a6.7 6.7 0 1 0 0 13.4 6.7 6.7 0 0 0 0-13.4Zm0 11.05a4.35 4.35 0 1 1 0-8.7 4.35 4.35 0 0 1 0 8.7Zm6.96-11.31a1.56 1.56 0 1 1-3.13 0 1.56 1.56 0 0 1 3.13 0Z"/>
              </svg>
            </span>
          </a>
        </li>
      ))}
    </ul>
  </div>
)}

<style>
  .mm-ig { width: 100%; max-width: 1250px; margin-inline: auto; padding-inline: 1rem }

  .mm-ig__cabecera {
    display: flex; align-items: center; gap: .75rem;
    margin-bottom: 1.25rem;
  }
  /* El navy de marca sobre el fondo de la seccion. Ratios MEDIDOS con la formula de
     luminancia relativa de WCAG 2.x (script en el informe), no estimados:
       navy / blanco ......... 15,60:1     navy / --mm-azul-50 ... 14,30:1
       navy / --mm-azul-100 .. 13,68:1
     La seccion no fija fondo aqui, asi que hereda el de la pagina; los tres papeles
     claros del sistema pasan AA de sobra. */
  .mm-ig__logo { width: 26px; height: 26px; flex: none; color: var(--mm-navy) }
  .mm-ig__usuario {
    font-family: Montserrat, sans-serif;
    font-size: 16px; font-weight: 700; text-decoration: none;
    color: var(--mm-navy);
  }
  .mm-ig__usuario:hover { text-decoration: underline }
  .mm-ig__seguir {
    margin-left: auto;
    padding: .5rem 1.1rem; border-radius: 8px;
    font-size: 14px; font-weight: 700; text-decoration: none;
    color: var(--mm-navy);
    background-image: linear-gradient(135deg,
      var(--mm-oro), var(--mm-oro-hondo) 25%,
      var(--mm-oro-claro) 50%, var(--mm-oro-hondo) 75%, var(--mm-oro));
  }
  .mm-ig__seguir:focus-visible,
  /* OJO, HEREDADO — no lo introduce esta migracion: `--upcolor` ya valia #1cadeb y el
     token de valor IDENTICO es --mm-cian, asi que el foco no se mueve ni un pixel. Pero
     medido no llega a los 3:1 de WCAG 1.4.11 contra lo que lo rodea:
       cian / blanco .. 2,55:1 SUSPENSO   cian / --mm-oro .. 1,37:1 SUSPENSO
       cian / navy .... 6,11:1 ok
     El sistema tiene --mm-foco (navy: 15,60 sobre blanco, 8,40 sobre oro) justo para esto.
     Cambiarlo es un cambio de VALOR, no una migracion: queda pedido en el informe. */
  .mm-ig__usuario:focus-visible { outline: var(--mm-foco-grosor) solid var(--mm-foco); outline-offset: var(--mm-foco-aire); box-shadow: var(--mm-foco-halo) }

  .mm-ig__rejilla {
    list-style: none; margin: 0; padding: 0;
    display: grid; gap: .6rem;
    grid-template-columns: repeat(auto-fill, minmax(180px, 1fr));
  }

  .mm-ig__celda a {
    position: relative; display: block;
    aspect-ratio: 1;
    border-radius: 15px;                 /* el radio de .card del sitio */
    overflow: hidden;
  }
  /* Con `aspect-ratio` y la altura ya fijada por el atributo, el ancho se DERIVA y desborda
     la columna. Las dos dimensiones o ninguna; aquí, height:auto. Medido en Pergola Plus. */
  .mm-ig__celda img {
    width: 100%; height: 100%;
    object-fit: cover; display: block;
    transition: transform .35s cubic-bezier(.165,.84,.44,1);
  }
  .mm-ig__celda a:hover img { transform: scale(1.06) }

  .mm-ig__velo {
    position: absolute; inset: 0;
    display: grid; place-items: center;
    /* Era #001c6300: alfa 0x00 = 0/255 = 0 %. Velo apagado. */
    background-color: color-mix(in srgb, var(--mm-navy) 0%, transparent);
    color: var(--mm-blanco);
    transition: background-color .25s ease;
  }
  .mm-ig__velo svg { width: 34px; height: 34px; opacity: 0; transition: opacity .25s ease }
  /* Era #001c6373: alfa 0x73 = 115/255 = 45,098 % -> 45 %. El redondeo mueve 0,00098 de
     alfa, o sea 0,25 niveles de 8 bits como MUCHO en un canal (peor caso: foto blanca).
     Blanco encima del velo: 2,85:1 sobre foto blanca, 19,22:1 sobre foto negra — el icono
     es decorativo (`aria-hidden`) y duplica el enlace, asi que no transporta informacion. */
  .mm-ig__celda a:hover .mm-ig__velo { background-color: color-mix(in srgb, var(--mm-navy) 45%, transparent) }
  .mm-ig__celda a:hover .mm-ig__velo svg { opacity: 1 }
  .mm-ig__celda a:focus-visible { outline: var(--mm-foco-grosor) solid var(--mm-foco); outline-offset: var(--mm-foco-aire); box-shadow: var(--mm-foco-halo) }

  @media (max-width: 479px) {
    .mm-ig__rejilla { grid-template-columns: repeat(2, 1fr) }
  }

  @media (prefers-reduced-motion: reduce) {
    .mm-ig__celda img { transition: none }
    .mm-ig__celda a:hover img { transform: none }
    .mm-ig__velo, .mm-ig__velo svg { transition: none }
  }
  @media print { .mm-ig__seguir { display: none } }
</style>
