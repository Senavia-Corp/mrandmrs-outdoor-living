---
/**
 * LA GALERIA DE OBRA DE LAS PAGINAS DE CIUDAD, EN MOSAICO (ASTRO-2, lamina «Ciudad»).
 *
 * Nacio como carrusel (R21-CIUDADES, 18-sep-2026); desde ASTRO-2 es el mismo mosaico que la
 * ficha de servicio (`mosaicoDeObra` en `build-paginas.mjs`): las seis primeras fotos en
 * `.mm-mosaico` y el resto en `.mm-mosaico-resto`, todas a la vista y en el HTML (D-117). Cada
 * foto es un `<button data-mm-foto>` que abre el visor de `Componentes.astro` en su foto.
 *
 * EL SET ES UNO POR SERVICIO (`_defecto.fotos` para las 53 de piscina; `servicio:<slug>` para las
 * demas) y se pinta EN SU ORDEN, que es comercial —seis de piscina antes del primer servicio
 * secundario— y lo vigila `scripts/check-galeria-obra.mjs` junto con la procedencia de cada foto.
 * `pos` es el `object-position` de la celda. `loading="lazy"` + `decoding="async"`, y
 * `width`/`height` reales contra el CLS.
 *
 * EL `<h2>` SE QUEDA EN OBRA, NO EN REMODELACION: Gainesville y Ocala son la Final URL de ad
 * groups de *new pool construction*, y las 53 venden lo mismo.
 */
import DATOS from '../../data/galeria-obra-por-ruta.json';

interface Props {
  /** Encabezado propio de la ruta. Sin el se busca por ruta y luego el `_defecto`. */
  titulo?: string;
  entradilla?: string;
  /** Set por SERVICIO (LOOP-CIUDADES): las landings `/services/<servicio>/<ciudad>-fl` comparten el
   *  set de su servicio, `DATOS[clave]`. La ruta propia sigue mandando; sin clave, como siempre. */
  clave?: string;
  /** Texto de la accion de la pagina (va en la cabecera) y palabra del titular que lleva rotulador. */
  accion: string;
  marca?: string;
}
const { titulo, entradilla, clave, accion, marca } = Astro.props;

const ruta = Astro.url.pathname.replace(/(.)\/$/, '$1');
/* Cascada igual que `CarruselProyectos.astro:48-51`, y sin `throw`: una ruta que monte esto sin
 * entrada propia cae al `_defecto`, que es el de las landings de ciudad. El que SI revienta es
 * el `_defecto` ausente, porque eso ya no es una ruta sin personalizar: es el fichero roto. */
const propio = DATOS[ruta] ?? (clave ? DATOS[clave] : undefined);
if (!DATOS._defecto) throw new Error('GaleriaObra: falta `_defecto` en galeria-obra-por-ruta.json.');
const d = { ...DATOS._defecto, ...(propio ?? {}) };
const tituloFinal = titulo ?? d.titulo;
const entradillaFinal = entradilla ?? d.entradilla;
if (!d.fotos?.length) throw new Error(`GaleriaObra (${ruta}): 0 fotos. El carrusel saldria vacio.`);
const fotos: { src: string; alt: string; ancho: number; alto: number; pos?: string }[] = d.fotos;

const tituloHtml = marca && tituloFinal.includes(marca) ? tituloFinal.replace(marca, `<span class="mm-rot">${marca}</span>`) : tituloFinal;
const FLECHA = '<svg aria-hidden="true" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"></path><path d="m13 6 6 6-6 6"></path></svg>';
/* Lo que ocupa cada celda, para que `srcset-auto.mjs` no sirva el original de 1600 px a una celda
 * de 300: la primera va a media anchura (entera en movil); las demas a un cuarto (media en movil). */
const SIZES = { grande: '(min-width: 768px) 50vw, 100vw', celda: '(min-width: 768px) 25vw, 50vw', resto: '(min-width: 768px) 20vw, 50vw' };
const enMosaico = fotos.slice(0, 6);
const resto = fotos.slice(6);
if (enMosaico.length < 3) throw new Error(`GaleriaObra (${ruta}): ${enMosaico.length} fotos; el mosaico pide 3.`);
---

<section class="mm-gal svc-galeria">
  <div class="mm-sec-cab">
    <h2 class="mm-h2" set:html={tituloHtml} />
    <div class="mm-sec-lado">
      <p class="mm-p">{entradillaFinal}</p>
      <div class="mm-sec-acc">
        <a class="mm-btn mm-btn--linea" href="#estimate">{accion}</a>
        <a class="mm-flecha" href="/gallery">Project Gallery<Fragment set:html={FLECHA} /></a>
      </div>
    </div>
  </div>
  <div class="mm-fotos">
    <div class={`mm-mosaico mm-mosaico--${enMosaico.length}`}>
      {enMosaico.map((f, i) => (
        <button type="button" class="mm-celda" data-mm-foto={f.src} aria-label={`Open photo: ${f.alt}`}><img src={f.src} alt={f.alt} width={f.ancho} height={f.alto} sizes={i === 0 ? SIZES.grande : SIZES.celda} style={f.pos ? `object-position:${f.pos}` : undefined} loading="lazy" decoding="async" /></button>
      ))}
    </div>
    {resto.length > 0 && (
      <div class:list={['mm-mosaico-resto', resto.length === 5 && 'mm-mosaico-resto--5']}>
        {resto.map((f) => (
          <button type="button" class="mm-celda mm-celda--resto" data-mm-foto={f.src} aria-label={`Open photo: ${f.alt}`}><img src={f.src} alt={f.alt} width={f.ancho} height={f.alto} sizes={SIZES.resto} style={f.pos ? `object-position:${f.pos}` : undefined} loading="lazy" decoding="async" /></button>
        ))}
      </div>
    )}
  </div>
</section>
