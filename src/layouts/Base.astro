---
/**
 * El cascarón: nav + contenido + pie, más el botón flotante de llamada.
 *
 * `.menu` es position:fixed y mide 85 px, así que TODA página escrita a mano empieza en y=0,
 * por detrás del nav. El padding superior va como calc(85px + aire), con el motivo al lado.
 *
 * El <head> reproduce lo que hay en el origen, MENOS lo que se va a propósito:
 *   · preconnect al CDN de Webflow y a Google Fonts -> ya no se usa ninguno de los dos
 *   · webfont.js + WebFont.load        -> las fuentes se auto-alojan
 *   · elfsightcdn.com/platform.js      -> decisión D2: los 3 widgets se rehacen nativos
 *   · el script de analítica de Webflow -> es de la plataforma que abandonamos
 *
 * Y MENOS el bloque <style> anti-FOUC del origen, a propósito y con motivo:
 * dice `html.w-mod-js:not(.w-mod-ix) [data-w-id="…"]{opacity:0}`, o sea «mantén esto
 * invisible hasta que arranque IX2». Si se copiara tal cual sin webflow.js, la clase
 * `w-mod-ix` no la pone nadie y esos elementos se quedan invisibles PARA SIEMPRE. Es
 * literalmente lo que ya pasó una vez en AMS. Lo sustituye el sello de la Fase 7.
 */
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import ClickToCall from '../components/widgets/ClickToCall.astro';
// Las fuentes son los .woff2 EXACTOS de Google, no @fontsource: con el Inter variable de
// fontsource el nav salía al 95,85 % contra el baseline porque un a.nav-link medía 57,35 px
// en vez de 59,54. Ver scripts/fetch-fuentes.mjs.
import '../styles/fuentes.css';
import '../styles/webflow.css';

interface Props {
  titulo: string;
  descripcion?: string;
  ruta?: string;
  /** Metadatos del <head> tal cual los sirve el origen: og:*, twitter:*, robots y JSON-LD.
   *  Los pasa el generador desde _source/vivo/. */
  seo?: {
    meta?: Record<string, string>;
    jsonLd?: unknown[];
  };
  /** Bloques de JSON-LD del origen que NO parsean. Se emiten CRUDOS: es un defecto del sitio
   *  vivo (un salto de línea literal dentro de la cadena) en 8 fichas de `/project/`, y el
   *  contrato dice replicarlo, no arreglarlo. Anotado como mejora candidata. */
  jsonLdCrudo?: string[];
  /** `/brochures` NO TIENE PIE en el origen. Rareza real, medida sobre las 115: es la única
   *  página con cascarón que se acaba sin él. Ponerle uno sería añadir una sección. */
  conPie?: boolean;
}
const { titulo, descripcion, ruta = Astro.url.pathname, conPie = true, seo = {}, jsonLdCrudo = [] } = Astro.props;

/**
 * La canónica es una ADICIÓN DELIBERADA, no paridad: el sitio vivo NO tiene ni una en las 115
 * (comprobado). La pide la Fase 9 del encargo.
 *
 * El interruptor falla CERRADO: solo se indexa con el valor exacto "1". Y ojo con el
 * fallback de la URL — si cayera en el dominio del cliente mientras esto vive en una preview,
 * las 115 canónicas apuntarían al sitio VIEJO. Ese fue el fallo real en Pergola Plus. Por eso
 * en preview no se emite canónica y se emite noindex.
 */
const ES_PRODUCCION = import.meta.env.PUBLIC_ES_PRODUCCION === '1';
const canonica = ES_PRODUCCION ? new URL(ruta, Astro.site).href : null;
/**
 * `og:image` y `twitter:image` tienen que ser ABSOLUTAS: los rastreadores sociales no
 * resuelven una ruta relativa, y al pasar las URLs del CDN a local se habian quedado en
 * `/images/...`. El origen las servia absolutas; esto lo restituye.
 */
const meta = Object.fromEntries(Object.entries(seo.meta ?? {}).map(([k, v]) => [
  k, /^(og:image|twitter:image)/.test(k) && typeof v === 'string' && v.startsWith('/')
    ? new URL(v, Astro.site).href : v,
]));
const jsonLd = seo.jsonLd ?? [];
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{titulo}</title>
    {descripcion && <meta name="description" content={descripcion} />}
    {Object.entries(meta).map(([k, v]) => (k.startsWith('og:')
      ? <meta property={k} content={v} />
      : <meta name={k} content={v} />))}
    {canonica && <link rel="canonical" href={canonica} />}
    {!ES_PRODUCCION && <meta name="robots" content="noindex, nofollow" />}
    {jsonLd.map((b) => <script type="application/ld+json" set:html={JSON.stringify(b)} />)}
    {jsonLdCrudo.map((b) => <script type="application/ld+json" set:html={b} />)}
    <link rel="shortcut icon" href="/images/site/favicon.png" />
    <link rel="apple-touch-icon" href="/images/site/webclip.png" />
    {/* Webflow marca el <html> con w-mod-js y w-mod-touch y HAY CSS QUE DEPENDE DE ELLO.
        Va en línea y en el head para que no haya un fotograma sin la clase. */}
    <script is:inline>
      !function (o, c) {
        var n = c.documentElement, t = ' w-mod-';
        n.className += t + 'js';
        ('ontouchstart' in o || o.DocumentTouch && c instanceof o.DocumentTouch) && (n.className += t + 'touch');
      }(window, document);
    </script>
  </head>
  <body>
    {/* El <noscript> de GTM va lo primero del body, como en el origen (section.code,
        idéntica en las 115 páginas que llevan cascarón). */}
    <section class="code">
      <div class="w-embed w-iframe">
        <noscript><iframe src="https://www.googletagmanager.com/ns.html?id=GTM-N9BWB3BV"
          height="0" width="0" style="display:none;visibility:hidden"></iframe></noscript>
      </div>
    </section>
    {/* /gallery tiene su section.hero-section ANTES del nav en el documento. El nav es
        fixed, así que no cambia lo que se ve, pero sí el ORDEN del innerText — y check:texto
        compara línea a línea. Es la única página así de las 115. */}
    <slot name="antes-nav" />
    <Nav ruta={ruta} />
    <slot />
    {conPie && <Footer ruta={ruta} />}
    {/* 2 páginas llevan un <script>+<style> DESPUÉS del pie: el redimensionador del iframe
        del estimador. Va en su sitio o cambia el orden del documento. */}
    <slot name="tras-pie" />
    <ClickToCall />
  </body>
</html>
