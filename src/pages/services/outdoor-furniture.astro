const T2 = "<section class=\"svc-intro mm-intro\"><div class=\"mm-marco\"><h2 class=\"mm-h2\">Premium Outdoor Furniture Installation for <span class=\"mm-rot\">Florida Homes</span></h2><p class=\"mm-p\">We help homeowners across North &amp; South Florida select and install premium outdoor furniture collections, focusing on weather-resistant, marine-grade materials engineered to withstand intense heat, humidity, and harsh coastal conditions year-round.</p><a class=\"mm-flecha\" href=\"/about\">More About Us<svg aria-hidden=\"true\" width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M5 12h14\"></path><path d=\"m13 6 6 6-6 6\"></path></svg></a></div></section>";
