ecoding=\"async\"></li><li style=\"width:77px\"><img src=\"/images/logos/irrigreen/irrigreen-logo-black-web.png\" alt=\"\" width=\"600\" height=\"280\" loading=\"lazy\" decoding=\"async\"></li><li style=\"width:140px\"><img src=\"/images/logos/milestone-p8m6r/image-mmh108.webp\" alt=\"\" width=\"432\" height=\"108\" loading=\"lazy\" decoding=\"async\"></li><li style=\"width:140px\"><img src=\"/images/logos/gemstone/gemstonelights-newlogo.png\" alt=\"\" width=\"930\" height=\"201\" loading=\"lazy\" decoding=\"async\"></li><li style=\"width:126px\"><img src=\"/images/logos/coyote/coyote-logo-glow-mmh108.webp\" alt=\"\" width=\"379\" height=\"108\" loading=\"lazy\" decoding=\"async\"></li><li style=\"width:125px\"><img src=\"/images/logos/alumawood/alumawood-mmh108.webp\" alt=\"\" width=\"374\" height=\"108\" loading=\"lazy\" decoding=\"async\"></li></ul></div></div></div></div></section>";
const T2 = "<section class=\"svc-intro mm-intro\"><div class=\"mm-marco\"><h2 class=\"mm-h2\">Premium Outdoor Furniture Installation for <span class=\"mm-rot\">Florida Homes</span></h2><p class=\"mm-p\">We help homeowners across North &amp; South Florida select and install premium outdoor furniture collections, focusing on weather-resistant, marine-grade materials engineered to withstand intense heat, humidity, and harsh coastal conditions year-round.</p><a class=\"mm-flecha\" href=\"/about\">More About Us<svg aria-hidden=\"true\" width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M5 12h14\"></path><path d=\"m13 6 6 6-6 6\"></path></svg></a></div></section><section class=\"mm-gal\"><div class=\"mm-sec-cab\"><h2 class=\"mm-h2\">Furniture Installation Gallery</h2><div class=\"mm-sec-lado\"><p class=\"mm-p\">Premium outdoor furniture collections installed across Florida patios and pool areas.</p><div class=\"mm-sec-acc\"><a class=\"mm-btn mm-btn--linea\" href=\"#estimate\">Get a Free Estimate</a><a class=\"mm-flecha\" href=\"/gallery\">Project Gallery<svg aria-hidden=\"true\" width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M5 12h14\"></path><path d=\"m13 6 6 6-6 6\"></path></svg></a></div></div></div><div class=\"mm-fotos\"><div class=\"mm-mosaico mm-mosaico--6\"><button type=\"button\" class=\"mm-celda\" data-mm-foto=\"/images/banco/pergolas/insulated-patio-cover-white-yellow-house-florida-02.webp\" aria-label=\"Open photo: White insulated patio cover with rafter tails across the back of a yellow two-story house with tile roof\"><img src=\"/images/banco/pergolas/insulated-patio-cover-white-yellow-house-florida-02.webp\" alt=\"White insulated patio cover with rafter tails across the back of a yellow two-story house with tile roof\" width=