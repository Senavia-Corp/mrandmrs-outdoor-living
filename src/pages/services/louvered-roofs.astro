const T0 = "<section class=\"mm-hero-a\"><div class=\"mm-hero-a-txt\"><nav class=\"mm-miga\" aria-label=\"Breadcrumb\"><ol><li><a href=\"/\">Home</a></li><li aria-current=\"page\">Louvered Roofs</li></ol></nav><p class=\"mm-etiqueta\">Licensed &amp; insured Contractors</p><h1 class=\"mm-h1\">Motorized <span class=\"mm-rot\">Louvered Roof</span> Systems</h1><p class=\"mm-p\">Motorized louvered roof builders and installation contractors in North &amp; South Florida, offering adjustable shade and weather protection.</p><div class=\"mm-hero-a-acc\"><a class=\"mm-btn\" href=\"#estimate\">Get a Free Estimate</a></div><div class=\"mm-datos mm-datos--3\"><a class=\"mm-dato\" href=\"tel:+13527403361\"><span class=\"mm-dato-rot\">North Florida</span><span class=\"mm-dato-val\">+1 (352) 740-3361</span></a><a class=\"mm-dato\" href=\"tel:+19549137112\"><span class=\"mm-dato-rot\">South Florida</span><span class=\"mm-dato-val\">+1 (954) 913-7112</span></a><div class=\"mm-dato\"><span class=\"mm-dato-rot\">Florida licensed &amp; insured</span><span class=\"mm-dato-val\">CPC1461119 · CPC1460562 · SCC131153553</span></div></div></div><figure class=\"mm-hero-a-medio\"><img sizes=\"(min-width: 992px) 50vw, 100vw\" src=\"/images/obra/obra-033/louvered-roof-white-large-span-travertine-patio-florida-heroe.avif\" alt=\"Large white louvered roof with partly open blades over a travertine patio with wicker lounge furniture\" width=\"1600\" height=\"900\" loading=\"eager\" fetchpriority=\"high\" decoding=\"async\"><figcaption class=\"mm-pie-foto\"><span class=\"mm-dato-rot\">Project</span><span>Large white louvered roof with partly open blades over a travertine patio with wicker lounge furniture</span></figcaption></figure><div class=\"mm-hero-a-logos\"><h2 class=\"mm-etiqueta\">Trusted by Florida's finest homeowners</h2><ul class=\"mm-hero-a-fila\"><li><img src=\"/images/logos/delta/delta-removebg-preview-mmh108.webp\" alt=\"\" width=\"344\" height=\"108\" loading=\"lazy\" decoding=\"async\