iver hurricane-rated structures across North and South Florida.</p></div><div class=\"process-steps-nav\"><div class=\"process-step-wrapper w-dyn-list\"><div role=\"list\" class=\"process-step-list w-dyn-items\"><div role=\"listitem\" class=\"process-step-item w-dyn-item\"><div class=\"process-step-header\"><div class=\"tab-circle\"><div class=\"step-number\">1</div></div></div></div><div role=\"listitem\" class=\"process-step-item w-dyn-item\"><div class=\"process-step-header\"><div class=\"tab-circle\"><div class=\"step-number\">2</div></div></div></div><div role=\"listitem\" class=\"process-step-item w-dyn-item\"><div class=\"process-step-header\"><div class=\"tab-circle\"><div class=\"step-number\">3</div></div></div></div><div role=\"listitem\" class=\"process-step-item w-dyn-item\"><div class=\"process-step-header\"><div class=\"tab-circle\"><div class=\"step-number\">4</div></div></div></div></div></div><div class=\"line-bar\"></div></div><div class=\"process-content-wrapper w-dyn-list\"><div role=\"list\" class=\"process-content-list w-dyn-items\"><div role=\"listitem\" class=\"process-content-item w-dyn-item\"><div class=\"process-step\"><div class=\"image-step-tab\"><img alt=\"\" loading=\"lazy\" src=\"/images/procesos/pole-barn-step-1/pole-barn-steel-buildings-site-evaluation-structural-assessment.avif\" class=\"img-process\"></div><div class=\"content-step-tab\"><div class=\"wrapper-vertical-text\"><h2>Site Evaluation &amp; Structural Assessment</h2><div class=\"text-divider\"><div class=\"w-richtext\"><p>Comprehensive site survey capturing lot dimensions, soil conditions, setback requirements, and intended use. We assess building size requirements, foundation needs, and local code compliance to determine engineering specifications.</p></div></div></div></div></div></div><div role=\"listitem\" class=\"process-content-item w-dyn-item\"><div class=\"process-step\"><div class=\"image-step-tab\"><img alt=\"\" loading=\"lazy\" src=\"/images/procesos/pole-barn-step-2/pole-barn-steel-buildings-custom-design-structural-engineering.avif\" class=\"img-process\"></div><div class=\"content-step-tab\"><div class=\"wrapper-vertical-text\"><h2>Custom Design &amp; Structural Engineering</h2><div class=\"text-divider\"><div class=\"w-richtext\"><p>Detailed design of steel building or pole barn structure with professional engineering for load-bearing capacity, beam sizing, and foundation requirements. 3D renderings and full material specifications provided.</p></div></div></div></div></div></div><div role=\"listitem\" class=\"process-content-item w-dyn-item\"><div class=\"process-step\"><div class=\"image-step-tab\"><img alt=\"\" loading=\"lazy\" src=\"/images/procesos/pole-barn-step-3/pole-barn-steel-buildings-building-permits-code-compliance.avif\" class=\"img-process\"></div><div class=\"content-step-tab\"><div class=\"wrapper-vertical-text\"><h2>Building Permits &amp; Code Compliance</h2><div class=\"text-divider\"><div class=\"w-richtext\"><p>Permit acquisition for steel structure including wind-load certifications, setback verification, and structural engineering approvals per Florida Building Code. HVHZ compliance for high-wind zones where applicable.</p></div></div></div></div></div></div><div role=\"listitem\" class=\"process-content-item w-dyn-item\"><div class=\"process-step\"><div class=\"image-step-tab\"><img alt=\"\" loading=\"lazy\" src=\"/images/procesos/pole-barn-step-4/pole-barn-steel-buildings-construction-final-inspection.avif\" class=\"img-process\"></div><div class=\"content-step-tab\"><div class=\"wrapper-vertical-text\"><h2>Construction &amp; Final Inspection</h2><div class=\"text-divider\"><div class=\"w-richtext\"><p>Full construction including foundation work, steel framing installation, roofing, and all finishing components. Final inspections confirm structural integrity and code compliance for delivery and handover.</p></div></div></div></div></div></div></div></div><div class=\"w-embed w-script\"><script>\ndocument.addEventListener('DOMContentLoaded', function () {\n\n  const AUTOPLAY_DELAY = 5000;\n\n  const COLOR_ACTIVE   = '#001C63';\n  const COLOR_INACTIVE = '#D99933';\n\n  const dots  = document.querySelectorAll('.process-step-item');\n  const steps = document.querySelectorAll('.process-content-item');\n\n  if (!dots.length || !steps.length) return;\n\n  let currentStep = 0;\n  let autoTimer   = null;\n  let isAnimating = false;\n\n  function goToStep(index) {\n    if (isAnimating) return;\n    isAnimating = true;\n\n    const prevStep = currentStep;\n    currentStep = index;\n\n    // ── 1. Actualizar DOTS (nav) ──────────────────────────\n    dots.forEach(function (dot, i) {\n      const circle = dot.querySelector('.tab-circle, [class*=\"tab-circle\"], [class*=\"Tab-Circle\"]');\n      const number = dot.querySelector('[class*=\"step-number\"], [class*=\"Step-Number\"]'); // ✅ DENTRO de goToStep\n\n      if (!circle) return;\n\n      if (i === currentStep) {\n        circle.style.background = COLOR_ACTIVE;\n        circle.style.transform  = 'scale(1.15)';\n        circle.style.boxShadow  = '0 4px 16px rgba(0,28,99,0.25)';\n        circle.style.transition = 'all 0.35s ease';\n        if (number) number.style.color = '#FFFFFF'; // ✅ Blanco activo\n      } else {\n        circle.style.background = COLOR_INACTIVE;\n        circle.style.transform  = 'scale(1)';\n        circle.style.boxShadow  = 'none';\n        circle.style.transition = 'all 0.35s ease';\n        if (number) number.style.color = '#001C63'; // ✅ Navy inactivo\n      }\n    });\n\n    // ── 2. Animar salida del paso anterior ────────────────\n    if (steps[prevStep] && prevStep !== currentStep) {\n      const outEl = steps[prevStep];\n      outEl.style.transition = 'opacity 0.3s ease, transform 0.3s ease';\n      outEl.style.opacity    = '0';\n      outEl.style.transform  = 'translateY(-10px)';\n\n      setTimeout(function () {\n        outEl.style.display = 'none';\n        showCurrentStep();\n      }, 300);\n    } else {\n      showCurrentStep();\n    }\n  }\n\n  function showCurrentStep() {\n    steps.forEach(function (s) {\n      s.style.display = 'none';\n      s.style.opacity = '0';\n    });\n\n    const activeEl = steps[currentStep];\n    if (!activeEl) { isAnimating = false; return; }\n\n    activeEl.style.display   = 'flex';\n    activeEl.style.transform = 'translateY(12px)';\n    activeEl.style.opacity   = '0';\n\n    void activeEl.offsetWidth;\n\n    activeEl.style.transition = 'opacity 0.4s ease, transform 0.4s ease';\n    activeEl.style.opacity    = '1';\n    activeEl.style.transform  = 'translateY(0)';\n\n    setTimeout(function () { isAnimating = false; }, 420);\n  }\n\n  function startAutoplay() {\n    stopAutoplay();\n    autoTimer = setInterval(function () {\n      const next = (currentStep + 1) % dots.length;\n      goToStep(next);\n    }, AUTOPLAY_DELAY);\n  }\n\n  function stopAutoplay() {\n    if (autoTimer) { clearInterval(autoTimer); autoTimer = null; }\n  }\n\n  dots.forEach(function (dot, i) {\n    dot.style.cursor = 'pointer';\n    dot.addEventListener('click', function () {\n      if (i === currentStep) return;\n      stopAutoplay();\n      goToStep(i);\n      startAutoplay();\n    });\n  });\n\n  const section = document.querySelector('.process-section');\n  if (section) {\n    section.addEventListener('mouseenter', stopAutoplay);\n    section.addEventListener('mouseleave', startAutoplay);\n  }\n\n  goToStep(0);\n  startAutoplay();\n\n});\n</script></div></div><img sizes=\"100vw\" srcset=\"/images/site/design3-p-500.webp 500w, /images/site/design3-p-800.webp 800w, /images/site/design3-p-1080.webp 1080w, /images/site/design3-p-1600.webp 1600w, /images/site/design3.webp 1920w\" alt=\"\" src=\"/images/site/design3.webp\" loading=\"lazy\" class=\"design-bg\"></section><section class=\"gallery\"><div class=\"block-gallery\"><div fs-slider-type=\"cms\" fs-slider-instance=\"fs-slider-gallery\" class=\"slider-gallery-page\"><div data-w-