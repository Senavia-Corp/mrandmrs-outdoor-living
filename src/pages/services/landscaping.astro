const T2 = "<section class=\"svc-intro mm-intro\"><div class=\"mm-marco\"><h2 class=\"mm-h2\">Professional Landscaping Contractors in <span class=\"mm-rot\">North &amp; South Florida</span></h2><p class=\"mm-p\">Our landscaping company offers full-service landscape design, installation, and maintenance in North &amp; South Florida, using native plants and sustainable practices to enhance curb appeal and property value.</p><a class=\"mm-flecha\" href=\"/about\">More About Us<svg aria-hidden=\"true\" width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M5 12h14\"></path><path d=\"m13 6 6 6-6 6\"></path></svg></a></div></section>";
const T4 = "<section class=\"mm-gal\"><div class=\"mm-sec-cab\"><h2 class=\"mm-h2\"><span class=\"mm-rot\">Landscaping</span> Project Gallery</h2><div class=\"mm-sec-lado\"><p class=\"mm-p\">Florida landscape designs — native plants, tropical beauty, and premium hardscaping work.</p><div class=\"mm-sec-acc\"><a class=\"mm-btn mm-btn--linea\" href=\"#estimate\">Get a Free Estimate</a><a class=\"mm-flecha\" href=\"/gallery\">Project Gallery<svg aria-hidden=\"true\" width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M5 12h14\"></path><path d=\"m13 6 6 6-6 6\"></path></svg></a></div></div></div><div class=\"mm-mosaico mm-mosaico--6\"><button type=\"button\" class=\"mm-celda\" data-mm-foto=\"/images/images/landscaping-10/luxury-landscaping-construction-contractors-florida-10.jpg\" aria-label=\"Open photo: Residential front yard landscaping construction with palms and pavers by Florida landscape professionals.\"><img src=\"/images/images/landscaping-10/luxury-landscaping-construction-contractors-florida-10.jpg\" alt=\"Residential front yard landscaping construction with palms and pavers by Florida landscape professionals.\" width=\"1250\" height=\"698\" loading=\"lazy\" decoding=\"async\"></button><button type=\"button\" class=\"mm-celda\" data-mm-foto=\"/images/images/landscaping-9/luxury-landscaping-construction-contractors-florida-09.jpg\" aria-label=\"Open photo: Custom landscape walkway with stone steps and greenery installed by Florida landscaping contractors.\"><img src=\"/images/images/landscaping-9/luxury-landscaping-construction-contractors-florida-09.jpg\" alt=\"Custom landscape walkway with stone steps and greenery installed by Florida landscaping contractors.\" width=\"1250\" height=\"698\" loading=\"lazy\" decoding=\"async\"></button><button type=\"button\" class=\"mm-celda\" data-mm-foto=\"/images/images/landscaping-8/luxury-landscaping-construction-contractors-florida-08.jpg\" aria-label=\"Open photo: Coastal luxury landscaping project with turf and walkways designed by Florida landscape builders.\"><img src=\"/images/images/landscaping-8/luxury-landscaping-construction-contractors-florida-08.jpg\" alt=\"Coastal luxury landscaping project with turf and walkways designed by Florida landscape builders.\" width=\"1250\" height=\"698\" loading=\"lazy\" decoding=\"async\"></button><button type=\"button\" class=\"mm-celda\" data-mm-foto=\"/images/banco/landscaping/backyard-putting-green-artificial-turf-oak-trees-florida-01.webp\" aria-label=\"Open photo: Kidney-shaped artificial turf putting green with fringe under tall oak trees and gravel paths.\"><img src=\"/images/banco/landscaping/backyard-putting-green-artificial-turf-oak-trees-florida-01.webp\" alt=\"Kidney-shaped artificial turf putting green with fringe under tall oak trees and gravel paths.\" width=\"1600\" height=\"1200\" loading=\"lazy\" decoding=\"async\"></button><button type=\"button\" class=\"mm-celda\" data-mm-foto=\"/images/images/landscaping-6/luxury-landscaping-construction-contractors-florida-06.jpg\" aria-label=\"Open photo: Luxury residential landscaping construction featuring custom plant selection and stone elements in Florida.\"><img src=\"/images/images/landscaping-6/luxury-landscaping-construction-contractors-florida-06.jpg\" alt=\"Luxury residential landscaping construction featuring custom plant selection and stone elements in Florida.\" width=\"1250\" height=\"698\" loading=\"lazy\" decoding=\"async\"></button><button type=\"button\" class=\"mm-celda\" data-mm-foto=\"/images/images/landscaping-5/luxury-landscaping-construction-contractors-florida-05.jpg\" aria-label=\"Open photo: High-end garden landscaping with water features and stone paths built by Florida landscape contractors.\"><img src=\"/images/images/landscaping-5/luxury-landscaping-construction-contractors-florida-05.jpg\" alt=\"High-end garden landscaping with water features and stone paths built by Florida landscape contractors.\" width=\"1250\" height=\"698\" loading=\"lazy\" decoding=\"async\"></button></div><script type=\"application/json\" class=\"mm-gal-mas\">[{\"url\":\"/images/images/landscaping-4/luxury-landscaping-construction-contractors-florida-04.jpg\",\"alt\":\"Luxury pool landscaping construction with tropical plants and hardscape by Florida landscaping builders.\"},{\"url\":\"/images/images/landscaping-3/luxury-landscaping-construction-contractors-florida-03.jpg\",\"alt\":\"Custom tropical landscaping project for residential property built by South Florida landscape contractors.\"},{\"url\":\"/images/images/landscaping-1/luxury-landscaping-construction-contractors-florida-01.jpg\",\"alt\":\"Custom pergola and luxury patio landscaping project by professional contractors serving North and South Florida.\"},{\"url\":\"/images/banco/landscaping/landscaping-stepping-stone-path-black-slate-chips-florida-01.webp\",\"alt\":\"Side-yard path of square limestone stepping stones set in black slate chips leading to a metal gate.\"}]</script></section><div><section class=\"mm-que\"><div class=\"mm-sec-cab\"><div class=\"mm-sec-tit\"><p class=\"mm-etiqueta\">What do we do!</p><h2 class=\"mm-h2\">Professional Landscape Design &amp; Maintenance Services</h2></div><div class=\"mm-sec-lado\"><p class=\"mm-p\">We provide full-service landscaping in North &amp; South Florida, using native plants and sustainable designs to enhance curb appeal.</p><div class=\"mm-sec-acc\"><a class=\"mm-btn mm-btn--linea\" href=\"#estimate\">Get a Free Estimate</a></div></div></div><div class=\"mm-que-cuerpo\"><div class=\"mm-que-col\"><ol class=\"mm-grupos\"><li class=\"mm-grupo\"><h3 class=\"mm-grupo-t\">Site Design &amp; Plant Selection</h3><p class=\"mm-grupo-p\">Our designs set the planting beds, lawn areas and sight lines to scale, with plant palettes built on Florida natives, xeriscape groupings and rain gardens. Those species take the salt drift, UV and summer downpours of a coastal lot, so the yard fills in instead of thinning out.</p><dl class=\"mm-grupo-dl\"><div class=\"mm-grupo-i\"><dt>Landscape Design &amp; Consultation</dt><dd>South &amp; North Florida designers provide consultations, create scaled plans, and develop tailored landscape designs</dd></div><div class=\"mm-grupo-i\"><dt>Native Plant &amp; Sustainable Landscaping</dt><dd>Designers incorporate native plants, xeriscaping, and rain gardens for eco‑friendly, low‑maintenance yards</dd></div></dl></li><li class=\"mm-grupo mm-grupo--activo\"><h3 class=\"mm-grupo-t\">Sod, Trees &amp; Planting Beds</h3><p class=\"mm-grupo-p\">We lay certified sod over graded, amended soil so roots knit into the base instead of sitting on loose sand. Trees and shrubs go in at nursery depth, staked against Florida wind, and beds get defined edges plus mulch that holds moisture through the dry season.</p><dl class=\"mm-grupo-dl\"><div class=\"mm-grupo-i\"><dt>Sod Installation Contractors</dt><dd>Installers lay fresh, high‑quality sod to instantly improve curb appeal and establish new lawns</dd></div><div class=\"mm-grupo-i\"><dt>Plant &amp; Tree Installation Services</dt><dd>Landscape contractors plant trees, shrubs, and flowers using proper techniques for long‑term health</dd></div><div class=\"mm-grupo-i\"><dt>Mulching &amp; Edging Services</dt><dd>Landscape teams apply mulch and define edges to retain moisture and polish planting beds</dd></div></dl></li><li class=\"mm-grupo\"><h3 class=\"mm-grupo-t\">Pavers, Patios &amp; Walkways</h3><p class=\"mm-grupo-p\">We build paver patios, walkways and retaining walls on a compacted limerock base with aluminum edge restraint and polymeric sand, so the surface holds its line after heavy rain. Wall heights, drainage behind the wall and soil loads follow the Florida Building Code.</p><dl class=\"mm-grupo-dl\"><div class=\"mm-grupo-i\"><dt>Hardscape &amp; Paver Patio Construction</dt><dd>Builders install paver patios, walkways, and retaining walls to enhance outdoor living spaces</dd></div></dl></li><li class=\"mm-grupo\"><h3 class=\"mm-grupo-t\">Drainage &amp; Night Lighting</h3><p class=\"mm-grupo-p\">French drains, catch basins and regrading pull water off the lawn and away from the slab, which matters on flat lots where the water table sits close to the surface. Low-voltage LED path lights, uplights and security fixtures use marine-grade wire and sealed housings that survive salt air.</p><dl class=\"mm-grupo-dl\"><div class=\"mm-grupo-i\"><dt>Drainage System Installation</dt><dd>Contractors install French drains, catch basins, and grading solutions to protect landscapes from water damage</dd></div><div class=\"mm-grupo-i\"><dt>Landscape Lighting Installation</dt><dd>Professionals design and install LED path lights, uplights, and security lighting for nighttime beauty</dd></div></dl></li></ol><div class=\"mm-datos\"><a class=\"mm-dato\" href=\"tel:+13527403361\"><span class=\"mm-dato-rot\">North Florida</span><span class=\"mm-dato-val\">+1 (352) 740-3361</span></a><a class=\"mm-dato\" href=\"tel:+19549137112\"><span class=\"mm-dato-rot\">South Florida</span><span class=\"mm-dato-val\">+1 (954) 913-7112</span></a></div></div><figure class=\"mm-lam-medio mm-que-medio\"><img class=\"mm-lam-foto\" src=\"/images/images/landscaping-9/luxury-landscaping-construction-contractors-florida-09.jpg\" alt=\"Front-yard planting beds with palms along a paver drive\" width=\"1250\" height=\"698\" loading=\"lazy\" decoding=\"async\"><div class=\"mm-lam-pie\" aria-hidden=\"true\" data-n=\"02 / 04\" data-t=\"Sod, Trees &amp; Planting Beds\"></div></figure></div></section><section class=\"mm-proc mm-proc--sin\"><div class=\"mm-sec-cab\"><h2 class=\"mm-h2\">Our Landscaping Design <span class=\"mm-rot\">Process</span></h2><div class=\"mm-sec-lado\"><p class=\"mm-p\">Our landscaping company manages design, plant selection, installation, and ongoing care to deliver thriving outdoor spaces across North &amp; South Florida.</p><div class=\"mm-sec-acc\"><a class=\"mm-btn mm-btn--linea\" href=\"#estimate\">Get a Free Estimate</a></div></div></div><div class=\"mm-proc-cuerpo\"><ol class=\"mm-pasos\"><li class=\"mm-paso\"><span class=\"mm-paso-n\">1</span><h3 class=\"mm-paso-t\">Landscape Consultation &amp; Site Analysis</h3><p>Comprehensive landscape assessment including soil conditions, sunlight exposure, salt-air resilience (South FL), plant selections, and hardscape integration. Climate-appropriate plant recommendations.</p></li><li class=\"mm-paso\"><span class=\"mm-paso-n\">2</span><h3 class=\"mm-paso-t\">Landscape Design &amp; Visualization</h3><p>Complete landscape design showing plant placement, seasonal color progression, irrigation integration, and hardscape features (planters, pathways, focal points). 3D renderings of mature landscape.</p></li><li class=\"mm-paso\"><span class=\"mm-paso-n\">3</span><h3 class=\"mm-paso-t\">Materials &amp; Irrigation Planning</h3><p>Specification of plant materials, mulches, soil amendments, and custom hardscape elements. Irrigation system design optimized for plant health and water conservation.</p></li><li class=\"mm-paso\"><span class=\"mm-paso-n\">4</span><h3 class=\"mm-paso-t\">Installation &amp; Establishment</h3><p>Full landscape installation including soil preparation, plant installation, hardscape placement, irrigation system installation, and initial maintenance (mulching, staking). Establishment care plan provided.</p></li></ol></div></section>";
const T6 = "<section class=\"mm-faq\"><div class=\"mm-sec-cab\"><h2 class=\"mm-h2\">Landscaping Services <span class=\"mm-rot\">FAQs</span></h2><div class=\"mm-sec-lado\"><p class=\"mm-p\">Have questions about professional landscaping installation in North or South Florida? Our expert team answers the top questions from Florida homeowners.</p></div></div><div class=\"mm-faq-cuerpo\"><div class=\"mm-faq-lista\"><details class=\"mm-faq-item\"><summary><h3>Do landscaping contractors use native Florida plants?</h3><svg aria-hidden=\"true\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"m6 9 6 6 6-6\"></path></svg></summary><div class=\"mm-faq-r\"><p>Yes. Our landscaping contractors prioritize native and Florida-Friendly plant selections that require less irrigation, resist local pests, and thrive without heavy chemical inputs. This approach delivers landscapes that look beautiful year-round while meaningfully reducing your long-term water consumption and maintenance requirements.</p></div></details><details class=\"mm-faq-item\"><summary><h3>Can professional landscaping increase home value?</h3><svg aria-hidden=\"true\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"m6 9 6 6 6-6\"></path></svg></summary><div class=\"mm-faq-r\"><p>Professional landscaping can increase Florida property values by up to 20% while delivering immediate improvements to curb appeal and livability. Thoughtfully designed landscapes with native plantings, clean hardscaping, and proper irrigation signal long-term investment — making a strong impression on neighbors, visitors, and future buyers.</p></div></details><details class=\"mm-faq-item\"><summary><h3>Can landscaping help reduce water usage in Florida?</h3><svg aria-hidden=\"true\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"m6 9 6 6 6-6\"></path></svg></summary><div class=\"mm-faq-r\"><p>Yes. Landscapes designed with drought-tolerant native plants, strategic mulching, and smart irrigation significantly reduce water consumption. Our team creates designs that meet local water restriction guidelines while maintaining a lush, well-maintained appearance year-round for homeowners across North and South Florida.</p></div></details><details class=\"mm-faq-item\"><summary><h3>Do you offer ongoing landscaping maintenance plans?</h3><svg aria-hidden=\"true\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"m6 9 6 6 6-6\"></path></svg></summary><div class=\"mm-faq-r\"><p>Yes. Our landscaping company offers maintenance plans covering trimming, fertilization, pest treatment, seasonal planting, and irrigation adjustments. Regular visits from our North and South Florida teams keep professionally installed landscapes looking pristine and thriving year-round without requiring homeowners to manage ongoing upkeep.</p></div></details><details class=\"mm-faq-item\"><summary><h3>How do you handle salty soil in Florida landscapes?</h3><svg aria-hidden=\"true\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"m6 9 6 6 6-6\"></path></svg></summary><div class=\"mm-faq-r\"><p>We select salt-tolerant, wind-resistant plants and improve soil drainage to ensure landscapes thrive near Florida's coast and inland areas. Combined with smart irrigation and professional hardscaping, this approach produces landscapes that remain lush, healthy, and visually polished throughout Florida's demanding growing seasons.</p></div></details></div><div class=\"mm-faq-lado\"><figure class=\"mm-lam-medio mm-faq-medio\"><img class=\"mm-lam-foto\" src=\"/images/images/landscaping-4/luxury-landscaping-construction-contractors-florida-04.jpg\" alt=\"Luxury pool landscaping construction with tropical plants and hardscape by Florida landscaping builders.\" width=\"1250\" height=\"698\" loading=\"lazy\" decoding=\"async\"></figure><div class=\"mm-faq-accion\"><a class=\"mm-btn\" href=\"#estimate\">Get a Free Estimate</a><div class=\"mm-datos\"><a class=\"mm-dato\" href=\"tel:+13527403361\"><span class=\"mm-dato-rot\">North Florida</span><span class=\"mm-dato-val\">+1 (352) 740-3361</span></a><a class=\"mm-dato\" href=\"tel:+19549137112\"><span class=\"mm-dato-rot\">South Florida</span><span class=\"mm-dato-val\">+1 (954) 913-7112</span></a></div></div></div></div></section><section class=\"testimonial-section\"><div class=\"w-layout-blockcontainer container w-container\"><div data-w-id=\"74852c7c-aeb3-35a7-5cf1-44f4ce6ecae5\" class=\"header-reviews\"><div class=\"label\">TESTIMONIALS</div><h2 class=\"white\">What Our Clients Say About Mr &amp; Mrs Outdoor Living</h2><p>Hear from Florida clients who love how our landscaping company transformed their properties with native plants, refined hardscaping, and lasting beauty.</p></div>";
