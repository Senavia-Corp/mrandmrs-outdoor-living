const T2 = "<section class=\"svc-intro mm-intro\"><div class=\"mm-marco\"><h2 class=\"mm-h2\">Professional Landscaping Contractors in <span class=\"mm-rot\">North &amp; South Florida</span></h2><p class=\"mm-p\">Our landscaping company offers full-service landscape design, installation, and maintenance in North &amp; South Florida, using native plants and sustainable practices to enhance curb appeal and property value.</p><a class=\"mm-flecha\" href=\"/about\">More About Us<svg aria-hidden=\"true\" width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M5 12h14\"></path><path d=\"m13 6 6 6-6 6\"></path></svg></a></div></section><section class=\"mm-gal\"><div class=\"mm-sec-cab\"><h2 class=\"mm-h2\"><span class=\"mm-rot\">Landscaping</span> Project Gallery</h2><div class=\"mm-sec-lado\"><p class=\"mm-p\">Florida landscape designs — native plants, tropical beauty, and premium hardscaping work.</p><div class=\"mm-sec-acc\"><a class=\"mm-btn mm-btn--linea\" href=\"#estimate\">Get a Free Estimate</a><a class=\"mm-flecha\" href=\"/gallery\">Project Gallery<svg aria-hidden=\"true\" width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M5 12h14\"></path><path d=\"m13 6 6 6-6 6\"></path></svg></a></div></div></div><div class=\"mm-fotos\"><div class=\"mm-mosaico mm-mosaico--6\"><button type=\"button\" class=\"mm-celda\" data-mm-foto=\"/images/images/landscaping-10/luxury-landscaping-construction-contractors-florida-10.jpg\" aria-label=\"Open photo: Residential front yard landscaping construction with palms and pavers by Florida landscape professionals.\"><img src=\"/images/images/landscaping-10/luxury-landscaping-construction-contractors-florida-10.jpg\" alt=\"Residential front yard landscaping construction with palms and pavers by Florida landscape profe