cess-step\"><div class=\"image-step-tab\"><img alt=\"Selected LED fixtures and smart control components are confirmed with the supplier. Lead times and delivery specs are locked in to ensure your Florida lighting project stays on track.\" loading=\"lazy\" src=\"/images/procesos/smart-lighting-step-2/smart-lighting-step-2.png\" class=\"img-process\"></div><div class=\"content-step-tab\"><div class=\"wrapper-vertical-text\"><h2>Smart Lighting System Design &amp; Integration</h2><div class=\"text-divider\"><div class=\"w-richtext\"><p>Design of lighting zones using Gemstone Lights IP68-rated fixtures. Integration with smart home systems for automated scheduling, color adjustments, and scene creation for entertaining.</p></div></div></div></div></div></div><div role=\"listitem\" class=\"process-content-item w-dyn-item\"><div class=\"process-step\"><div class=\"image-step-tab\"><img alt=\"Delivery is coordinated with your project timeline. Licensed electricians install, connect, and position every fixture per your approved lighting design for a precise Florida installation.\" loading=\"lazy\" src=\"/images/procesos/smart-lighting-step-3/smart-lighting-step-3.png\" class=\"img-process\"></div><div class=\"content-step-tab\"><div class=\"wrapper-vertical-text\"><h2>Electrical Work &amp; Permitting</h2><div class=\"text-divider\"><div class=\"w-richtext\"><p>Electrical plan development for wiring routes, power supply adequacy, and any required permits. Installation of electrical infrastructure supporting all lighting zones.</p></div></div></div></div></div></div><div role=\"listitem\" class=\"process-content-item w-dyn-item\"><div class=\"process-step\"><div class=\"image-step-tab\"><img alt=\"Every light zone is tested, adjusted, and calibrated. A final walkthrough confirms flawless smart control performance — your Florida property is transformed with professional exterior lighting.\" loading=\"lazy\" src=\"/images/procesos/smart-lighting-step-4/smart-lighting-installation-smart-automation-setup.avif\" class=\"img-process\"></div><div class=\"content-step-tab\"><div class=\"wrapper-vertical-text\"><h2>Installation &amp; Smart Automation Setup</h2><div class=\"text-divider\"><div class=\"w-richtext\"><p>Professional installation of all fixtures, wiring, controllers, and smart home integration. Testing of all lighting zones, app setup for remote control, and automated scheduling configuration.</p></div></div></div></div></div></div></div></div><div class=\"w-embed w-script\"><script>\ndocument.addEventListener('DOMContentLoaded', function () {\n\n  const AUTOPLAY_DELAY = 5000;\n\n  const COLOR_ACTIVE   = '#0D1C3F';\n  const COLOR_INACTIVE = '#C9A84C';\n\n  const dots  = document.querySelectorAll('.process-step-item');\n  const steps = document.querySelectorAll('.process-content-item');\n\n  if (!dots.length || !steps.length) return;\n\n  let currentStep = 0;\n  let autoTimer   = null;\n  let isAnimating = false;\n\n  function goToStep(index) {\n    if (isAnimating) return;\n    isAnimating = true;\n\n    const prevStep = currentStep;\n    currentStep = index;\n\n    // ── 1. Actualizar DOTS (nav) ──────────────────────────\n    dots.forEach(function (dot, i) {\n      const circle = dot.querySelector('.tab-circle, [class*=\"tab-circle\"], [class*=\"Tab-Circle\"]');\n      const number = dot.querySelector('[class*=\"step-number\"], [class*=\"Step-Number\"]'); // ✅ DENTRO de goToStep\n\n      if (!circle) return;\n\n      if (i === currentStep) {\n        circle.style.background = COLOR_ACTIVE;\n        circle.style.transform  = 'scale(1.15)';\n        circle.style.boxShadow  = '0 4px 16px rgba(13,28,63,0.25)';\n        circle.style.transition = 'all 0.35s ease';\n        if (number) number.style.color = '#FFFFFF'; // ✅ Blanco activo\n      } else {\n        circle.style.background = COLOR_INACTIVE;\n        circle.style.transform  = 'scale(1)';\n        circle.style.boxShadow  = 'none';\n        circle.style.transition = 'all 0.35s ease';\n        if (number) number.style.color = '#0D1C3F'; // ✅ Navy inactivo\n      }\n    });\n\n    // ── 2. Animar salida del paso anterior ────────────────\n    if (steps[prevStep] && prevStep !== currentStep) {\n      const outEl = steps[prevStep];\n      outEl.style.transition = 'opacity 0.3s ease, transform 0.3s ease';\n      outEl.style.opacity    = '0';\n      outEl.style.transform  = 'translateY(-10px)';\n\n      setTimeout(function () {\n        outEl.style.display = 'none';\n        showCurrentStep();\n      }, 300);\n    } else {\n      showCurrentStep();\n    }\n  }\n\n  function showCurrentStep() {\n    steps.forEach(function (s) {\n      s.style.display = 'none';\n      s.style.opacity = '0';\n    });\n\n    const activeEl = steps[currentStep];\n    if (!activeEl) { isAnimating = false; return; }\n\n    activeEl.style.display   = 'flex';\n    activeEl.style.transform = 'translateY(12px)';\n    activeEl.style.opacity   = '0';\n\n    void activeEl.offsetWidth;\n\n    activeEl.style.transition = 'opacity 0.4s ease, transform 0.4s ease';\n    activeEl.style.opacity    = '1';\n    activeEl.style.transform  = 'translateY(0)';\n\n    setTimeout(function () { isAnimating = false; }, 420);\n  }\n\n  function startAutoplay() {\n    stopAutoplay();\n    autoTimer = setInterval(function () {\n      const next = (currentStep + 1) % dots.length;\n      goToStep(next);\n    }, AUTOPLAY_DELAY);\n  }\n\n  function stopAutoplay() {\n    if (autoTimer) { clearInterval(autoTimer); autoTimer = null; }\n  }\n\n  dots.forEach(function (dot, i) {\n    dot.style.cursor = 'pointer';\n    dot.addEventListener('click', function () {\n      if (i === currentStep) return;\n      stopAutoplay();\n      goToStep(i);\n      startAutoplay();\n    });\n  });\n\n  const section = document.querySelector('.process-section');\n  if (section) {\n    section.addEventListener('mouseenter', stopAutoplay);\n    section.addEventListener('mouseleave', startAutoplay);\n  }\n\n  goToStep(0);\n  startAutoplay();\n\n});\n</script></div></div><img sizes=\"100vw\" srcset=\"/images/site/design3-p-500.webp 500w, /images/site/design3-p-800.webp 800w, /images/site/design3-p-1080.webp 1080w, /images/site/design3-p-1600.webp 1600w, /images/site/design3.webp 1920w\" alt=\"\" src=\"/images/site/design3.webp\" loading=\"lazy\" class=\"design-bg\"></section><section class=\"gallery\"><div class=\"block-gallery\"><div fs-slider-type=\"cms\" fs-slider-instance=\"fs-slider-gallery\" class=\"slider-gallery-page\"><div data-w-id=\"3e7b68e7-e033-ed34-b3a7-e87aed50972d\" class=\"header-gallery\"><div><h2 class=\"white\">Soffit &amp; LED Lighting Gallery</h2><div>See Gemstone Lights soffit LED installations across North &amp; South Florida homes.</div></div><div fs-slider-element=\"navigation\" class=\"fs-slider-gallery_navigation\"><button fs-slider-element=\"previous\" class=\"fs-slider-gallery_button\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"50\" height=\"50\" viewBox=\"0 0 1024 1024\" app=\"ikonik\" class=\"icon-arrow\"><path fill=\"currentColor\" d=\"M512 64C264.6 64 64 264.6 64 512s200.6 448 448 448 448-200.6 448-448S759.4 64 512 64zm104 316.9c0 10.2-4.9 19.9-13.2 25.9L457.4 512l145.4 105.2c8.3 6 13.2 15.6 13.2 25.9V690c0 6.5-7.4 10.3-12.7 6.5l-246-178a7.95 7.95 0 0 1 0-12.9l246-178a8 8 0 0 1 12.7 6.5v46.8z\" app=\"ikonik\" class=\"path-x7uxa\"></path></svg></button><button fs-slider-element=\"next\" class=\"fs-slider-gallery_button\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"50\" height=\"50\" viewBox=\"0 0 1024 1024\" app=\"ikonik\" class=\"icon-arrow\"><path fill=\"currentColor\" d=\"M512 64C264.6 64 64 264.6 64 512s200.6 448 448 448 448-200.6 448-448S759.4 64 512 64zm154.7 454.5l-246 178c-5.3 3.8-12.7 0-12.7-6.5v-46.9c0-10.2 4.9-19.9 13.2-25.9L566.6 512 421.2 406.8c-8.3-6-13.2-15.6-13.2-25.9V334c0-6.5 7.4-10.3 12.7-6.5l246 178c4.4 3.2 4.4 9.8 0 13z\" app=\"ikonik\" class=\"path-5odzh\"></path></svg></button></div></div><div class=\"block-gallery-absolute\