const T2 = "<section class=\"svc-intro mm-intro\"><div class=\"mm-marco\"><h2 class=\"mm-h2\">Motorized Retractable Screen Contractors in <span class=\"mm-rot\">Florida</span></h2><p class=\"mm-p\">Our team designs and installs motorized retractable screens across North &amp; South Florida, offering flexible shade, effective insect control, and enhanced privacy with whisper-quiet smooth operation and completely unobstructed open views when fully re</p><a class=\"mm-flecha\" href=\"/about\">More About Us<svg aria-hidden=\"true\" width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M5 12h14\"></path><path d=\"m13 6 6 6-6 6\"></path></svg></a></div></section><section class=\"mm-gal\"><div class=\"mm-sec-cab\"><h2 class=\"mm-h2\"><span class=\"mm-rot\">Retractable</span> Screen Gallery</h2><div class=\"mm-sec-lado\"><p class=\"mm-p\">View motorized retractable screen projects across Florida patios and pool enclosures.</p><div class=\"mm-sec-acc\"><a class=\"mm-btn mm-btn--linea\" href=\"#estimate\">Get a Free Estimate</a><a class=\"mm-flecha\" href=\"/gallery\">Project Gallery<svg aria-hidden=\"true\" width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M5 12h14\"></path><path d=\"m13 6 6 6-6 6\"></path></svg></a></div></div></div><div class=\"mm-fotos\"><div class=\"mm-mosaico mm-mosaico--6\"><button type=\"button\" class=\"mm-celda\" data-mm-foto=\"/images/images/retractable-screen-7/retractable-screen-installation-contractors-florida-7.jpg\" aria-label=\"Open photo: Professionally installed motorized patio screen system providing insect protection, shade, and enhanced comfort for South Florida outdoor living spaces.\"><img src=\"/images/images/retractable-screen-7/retractable-screen-installation-contractors-florida-7.jpg\" alt=\"Professionally installed motorized patio screen system providing insect protection, shade, and enhanced comfort for South Florida outdoor living spaces.\" width=\"1250\" height=\"927\" sizes=\"(min-width: 768px) 50vw, 100vw\" loading=\"lazy\" decoding=\"async\"></button><button type=\"button\" class=\"mm-celda\" data-mm-foto=\"/images/images/retractable-screen-1/retractable-screen-installation-contractors-florida-1.jpg\" aria-label=\"Open photo: Modern residential patio featuring a motorized retractable screen system designed to protect outdoor living areas from insects, sun, and weather. Ideal solution for pool patios in South Florida homes.\"><img src=\"/images/images/retractable-screen-1/retractable-screen-installation-contractors-florida-1.jpg\" alt=\"Modern residential patio featuring a motorized retractable screen system designed to protect outdoor living areas from insects, sun, and weather. Ideal solution for pool patios in South Florida homes.\" width=\"1250\" height=\"833\" sizes=\"(min-width: 768px) 25vw, 50vw\" loading=\"lazy\" decoding=\"async\"></button><button type=\"button\" class=\"mm-celda\" data-mm-foto=\"/images/images/retractable-screen-8/retractable-screen-installation-contractors-florida-8.jpg\" aria-label=\"Open photo: High-end pergola system with motorized retractable screens designed for luxury outdoor living in modern Florida homes.\"><img src=\"/images/images/retractable-screen-8/retractable-screen-installation-contractors-florida-8.jpg\" alt=\"High-end pergola system with motorized retractable screens designed for luxury outdoor living in modern Florida homes.\" width=\"1250\" height=\"1202\" sizes=\"(min-width: 768px) 25vw, 50vw\" loading=\"lazy\" decoding=\"async\"></button><button type=\"button\" class=\"mm-celda\" data-mm-foto=\"/images/images/retractable-screen-6/retractable-screen-installation-contractors-florida-6.jpg\" aria-label=\"Open photo: Motorized screen enclosure protecting an outdoor kitchen and dining area, ideal for Florida homeowners looking to extend outdoor living year-round.\"><img src=\"/images/images/retractable-screen-6/retractable-screen-installation-contractors-florida-6.jpg\" alt=\"Motorized screen enclosure protecting an outdoor kitchen and dining area, ideal for Florida homeowners looking to extend outdoor living year-round.\" width=\"778\" height=\"1250\" sizes=\"(min-width: 768px) 25vw, 50vw\" loading=\"lazy\" decoding=\"async\"></button><button type=\"button\" class=\"mm-celda\" data-mm-foto=\"/images/images/retractable-screen-2/retractable-screen-installation-contractors-florida-2.jpg\" aria-label=\"Open photo: High-quality motorized retractable screens installed on a residential lanai, providing shade, privacy, and insect protection for outdoor living spaces in Florida.\"><img src=\"/images/images/retractable-screen-2/retractable-screen-installation-contractors-florida-2.jpg\" alt=\"High-quality motorized retractable screens installed on a residential lanai, providing shade, privacy, and insect protection for outdoor living spaces in Florida.\" width=\"1000\" height=\"1250\" sizes=\"(min-width: 768px) 25vw, 50vw\" loading=\"lazy\" decoding=\"async\"></button><button type=\"button\" class=\"mm-celda\" data-mm-foto=\"/images/images/retractable-screen-10/retractable-screen-installation-contractors-florida-10.jpg\" aria-label=\"Open photo: Custom motorized retractable screen system enclosing an outdoor kitchen and dining space, designed to enhance comfort, privacy, and year-round outdoor living in Florida residential properties.\"><img src=\"/images/images/retractable-screen-10/retractable-screen-installation-contractors-florida-10.jpg\" alt=\"Custom motorized retractable screen system enclosing an outdoor kitchen and dining space, designed to enhance comfort, privacy, and year-round outdoor living in Florida residential properties.\" width=\"1250\" height=\"682\" sizes=\"(min-width: 768px) 25vw, 50vw\" loading=\"lazy\" decoding=\"async\"></button></div><div class=\"mm-mosaico-resto\"><button type=\"button\" class=\"mm-celda mm-celda--resto\" data-mm-foto=\"/images/images/retractable-screen-9/retractable-screen-installation-contractors-florida-09.jpg\" aria-label=\"Open photo: Modern outdoor living space featuring a louvered roof pergola with integrated motorized retractable screens, providing shade, insect protection, and weather control for South Florida homes.\"><img src=\"/images/images/retractable-screen-9/retractable-screen-installation-contractors-florida-09.jpg\" alt=\"Modern outdoor living space featuring a louvered roof pergola with integrated motorized retractable screens, providing shade, insect protection, and weather control for South Florida homes.\" width=\"1250\" height=\"698\" sizes=\"(min-width: 768px) 25vw, 50vw\" loading=\"lazy\" decoding=\"async\"></button><button type=\"button\" class=\"mm-celda mm-celda--resto\" data-mm-foto=\"/images/images/retractable-screen-5/retractable-screen-installation-contractors-florida-5.jpg\" aria-label=\"Open photo: Custom motorized retractable screens installed on a backyard patio, creating a comfortable outdoor environment for families in South Florida.\"><img src=\"/images/images/retractable-screen-5/retractable-screen-installation-contractors-florida-5.jpg\" alt=\"Custom motorized retractable screens installed on a backyard patio, creating a comfortable outdoor environment for families in South Florida.\" width=\"1250\" height=\"830\" sizes=\"(min-width: 768px) 25vw, 50vw\" loading=\"lazy\" decoding=\"async\"></button><button type=\"button\" class=\"mm-celda mm-celda--resto\" data-mm-foto=\"/images/images/retractable-screen-4/retractable-screen-installation-contractors-florida-4.jpg\" aria-label=\"Open photo: Exterior motorized retractable screen system designed for sun control, privacy, and weather protection on patios and outdoor kitchens in Florida homes.\"><img src=\"/images/images/retractable-screen-4/retractable-screen-installation-contractors-florida-4.jpg\" alt=\"Exterior motorized retractable screen system designed for sun control, privacy, and weather protection on patios and outdoor kitchens in Florida homes.\" width=\"1250\" height=\"831\" sizes=\"(min-width: 768px) 25vw, 50vw\" loading=\"lazy\" decoding=\"async\"></button><button type=\"button\" class=\"mm-celda mm-celda--resto\" data-mm-foto=\"/images/images/retractable-screen-3/retractable-screen-installation-contractors-florida-3.jpg\" aria-label=\"Open photo: Contemporary pergola with integrated motorized retractable screens, enhancing comfort and usability of outdoor spaces in South Florida residential properties.\"><img src=\"/images/images/retractable-screen-3/retractable-screen-installation-contractors-florida-3.jpg\" alt=\"Contemporary pergola with integrated motorized retractable screens, enhancing comfort and usability of outdoor spaces in South Florida residential properties.\" width=\"1250\" height=\"836\" sizes=\"(min-width: 768px) 25vw, 50vw\" loading=\"lazy\" decoding=\"async\"></button></div></div></section><section class=\"mm-proc mm-proc--sin\"><div class=\"mm-sec-cab\"><h2 class=\"mm-h2\">Our Retractable Screen <span class=\"mm-rot\">Process</span></h2><div class=\"mm-sec-lado\"><p class=\"mm-p\">Our installation team custom-measures, fabricates, and installs MaestroShield retractable screens with smart controls for Florida outdoor living spaces.</p><div class=\"mm-sec-acc\"><a class=\"mm-btn mm-btn--linea\" href=\"#estimate\">Get a Free Estimate</a></div></div></div><div class=\"mm-proc-cuerpo\"><ol class=\"mm-pasos\"><li class=\"mm-paso\"><span class=\"mm-paso-n\">1</span><h3 class=\"mm-paso-t\">Screen System Assessment &amp; Selection</h3><p>Comprehensive consultation on retractable screen benefits, motorization options, and MaestroShield system selection. Assessment of door/window configurations and retraction requirements.</p></li><li class=\"mm-paso\"><span class=\"mm-paso-n\">2</span><h3 class=\"mm-paso-t\">System Design &amp; Custom Fitting</h3><p>Detailed measurement and design of custom retractable screen installations for doors, windows, or open areas. Integration with existing frame systems and automation compatibility.</p></li><li class=\"mm-paso\"><span class=\"mm-paso-n\">3</span><h3 class=\"mm-paso-t\">Installation Permits &amp; Certification</h3><p>Verification of installation requirements, electrical permits (if motorized), and MaestroShield certification documentation. Quality assurance inspection prior to activation.</p></li><li class=\"mm-paso\"><span class=\"mm-paso-n\">4</span><h3 class=\"mm-paso-t\">Installation &amp; System Activation</h3><p>Professional installation of track systems, screen mechanisms, and motorization (if included). Full testing of retraction/extension, integration with smart home systems, and customer training.</p></li></ol></div></section><section class=\"mm-que\"><div class=\"mm-sec-cab\"><div class=\"mm-sec-tit\"><p class=\"mm-etiqueta\">What do we do!</p><h2 class=\"mm-h2\">Motorized Retractable Screen &amp; Enclosure Systems FL</h2></div><div class=\"mm-sec-lado\"><p class=\"mm-p\">We install motorized MaestroShield retractable screens for North and South Florida estates with smart automation and UV-blocking fabrics.</p><div class=\"mm-sec-acc\"><a class=\"mm-btn mm-btn--linea\" href=\"#estimate\">Get a Free Estimate</a></div></div></div><div class=\"mm-que-cuerpo\"><div class=\"mm-que-col\"><ol class=\"mm-grupos\"><li class=\"mm-grupo\"><h3 class=\"mm-grupo-t\">Motorized Openings &amp; Automation</h3><p class=\"mm-grupo-p\">We install MaestroShield motorized screens on patios and lanais, with side tracks and housings anchored into the existing structure. Broward openings sit in the High-Velocity Hurricane Zone, so we match tracks, fasteners and motors to the product approval covering that opening. Wall switches, remotes or a smart hub handle daily operation.</p><dl class=\"mm-grupo-dl\"><div class=\"mm-grupo-i\"><dt>Motorized Patio Screen Installation</dt><dd>South Florida contractors install motorized retractable screens that enclose patios at the touch of a button</dd></div><div class=\"mm-grupo-i\"><dt>Smart Remote Screen Integration</dt><dd>Installers integrate remote controls or smart devices to operate retractable screens seamlessly.</dd></div></dl></li><li class=\"mm-grupo\"><h3 class=\"mm-grupo-t\">Manual Screens, Lanais, Garages</h3><p class=\"mm-grupo-p\">Not every opening needs a motor. We fit hand-operated retractable screens on lanais, porches and entry openings, and we screen garage bays so the space ventilates with the door up. All of them run in the same guided tracks and close on an insect-tight bottom seal.</p><dl class=\"mm-grupo-dl\"><div class=\"mm-grupo-i\"><dt>Manual Retractable Screen Installers</dt><dd>Installers fit manually operated screens for lanais and porches, providing shade and insect protection</dd></div><div class=\"mm-grupo-i\"><dt>Lanai &amp; Porch Enclosure Installation</dt><dd>Contractors enclose lanais and porches with retractable screens for year‑round comfort.</dd></div><div class=\"mm-grupo-i\"><dt>Garage Retractable Screen Installation</dt><dd>Builders install retractable screens for garages to improve airflow and keep insects out.</dd></div></dl></li><li class=\"mm-grupo\"><h3 class=\"mm-grupo-t\">Custom Frames, Mesh Options</h3><p class=\"mm-grupo-p\">We build each screen to the measured opening and powder-coat frames to match the trim already on the house. Mesh is the decision that matters: tight weaves stop no-see-ums, solar fabrics cut UV and afternoon glare on west-facing lanais, and clear vinyl blocks wind-driven rain.</p><dl class=\"mm-grupo-dl\"><div class=\"mm-grupo-i\"><dt>Custom Screen Design &amp; Fabrication</dt><dd>Designers build custom retractable screen systems to match frames, fabric opacity, and operation methods</dd></div><div class=\"mm-grupo-i\"><dt>Upgraded Mesh &amp; Fabric Replacement</dt><dd>Renovation experts replace screen mesh with upgraded, durable fabrics for improved visibility and protection.</dd></div></dl></li><li class=\"mm-grupo mm-grupo--activo\"><h3 class=\"mm-grupo-t\">Repairs, Motors &amp; Rescreening</h3><p class=\"mm-grupo-p\">Salt air and UV finish off mesh, motors and hardware long before the tracks give out. We rescreen torn fabric, replace corroded rollers and burned-out motors, and service systems other contractors installed, moving coastal openings onto stainless fasteners that survive the exposure.</p><dl class=\"mm-grupo-dl\"><div class=\"mm-grupo-i\"><dt>Screen Replacement &amp; Repair Contractors</dt><dd>North Florida contractors replace damaged screens and perform repairs to restore retractable systems</dd></div></dl></li></ol><div class=\"mm-datos mm-datos--tel\"><a class=\"mm-dato\" href=\"tel:+13527403361\"><span class=\"mm-dato-rot\">North Florida</span><span class=\"mm-dato-val\">+1 (352) 740-3361</span></a><a class=\"mm-dato\" href=\"tel:+19549137112\"><span class=\"mm-dato-rot\">South Florida</span><span class=\"mm-dato-val\">+1 (954) 913-7112</span></a></div></div><figure class=\"mm-lam-medio mm-que-medio\"><img class=\"mm-lam-foto\" sizes=\"(min-width: 992px) 42vw, 100vw\" src=\"/images/obra/suelta/retractable-screens-motorized-dark-mesh-lanai-florida.avif\" alt=\"Screened lanai with seating and a pool beyond\" width=\"1600\" height=\"1067\" loading=\"lazy\" decoding=\"async\"><div class=\"mm-lam-pie\" aria-hidden=\"true\" data-n=\"04 / 04\" data-t=\"Repairs, Motors &amp; Rescreening\"></div></figure></div></section>";
const T4 = "<section class=\"mm-faq\"><div class=\"mm-sec-cab\"><h2 class=\"mm-h2\">Retractable Screen <span class=\"mm-rot\">FAQs</span></h2><div class=\"mm-sec-lado\"><p class=\"mm-p\">Have questions about motorized retractable screen installation in Florida? Our MaestroShield-certified specialists answer top questions below.</p></div></div><div class=\"mm-faq-cuerpo\"><div class=\"mm-faq-lista\"><details class=\"mm-faq-item\"><summary><h3>How do motorized retractable screens work?</h3><svg aria-hidden=\"true\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"m6 9 6 6 6-6\"></path></svg></summary><div class=\"mm-faq-r\"><p>Motorized retractable screens deploy smoothly from compact overhead housings using remote control or smartphone app. As a certified MaestroShield dealer, Mr. &amp; Mrs. Outdoor Living engineers each system to fit your exact opening dimensions, ensuring a precise fit for lanais, patios, and outdoor rooms.</p></div></details><details class=\"mm-faq-item\"><summary><h3>Do retractable screens block outdoor views?</h3><svg aria-hidden=\"true\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"m6 9 6 6 6-6\"></path></svg></summary><div class=\"mm-faq-r\"><p>No. MaestroShield retractable screens fully retract into compact housings when not in use, preserving unobstructed views of your yard, pool, or waterfront. When deployed, they reduce solar heat gain, block insects, and create a private, comfortable outdoor room without permanent enclosure.</p></div></details><details class=\"mm-faq-item\"><summary><h3>Are retractable screens weather-resistant in Florida?</h3><svg aria-hidden=\"true\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"m6 9 6 6 6-6\"></path></svg></summary><div class=\"mm-faq-r\"><p>Yes. Retractable screen systems use powder-coated aluminum tracks and UV-stabilized mesh fabrics engineered to withstand Florida's intense sun, humidity, coastal salt air, and seasonal wind. Corrosion-resistant components maintain smooth operation year-round with minimal maintenance beyond occasional rinsing and lubrication of the track system.</p></div></details><details class=\"mm-faq-item\"><summary><h3>Can retractable screens integrate with smart home systems?</h3><svg aria-hidden=\"true\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"m6 9 6 6 6-6\"></path></svg></summary><div class=\"mm-faq-r\"><p>Yes. Motorized retractable screens can be connected to smart home platforms for automated operation based on schedules, sunlight levels, or wind speed sensors. This lets Florida homeowners control their screens remotely via smartphone, voice command, or preset daily routines for hands-free comfort.</p></div></details><details class=\"mm-faq-item\"><summary><h3>Do retractable screens increase home value?</h3><svg aria-hidden=\"true\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"m6 9 6 6 6-6\"></path></svg></summary><div class=\"mm-faq-r\"><p>Retractable screens add usable square footage, reduce solar heat gain, and enhance the energy efficiency of your Florida home. As a design feature, motorized screens are increasingly valued by buyers in competitive Florida markets — and as a certified MaestroShield dealer, Mr. &amp; Mrs. Outdoor Living ensures your investment is engineered to last.</p></div></details></div><div class=\"mm-faq-lado\"><figure class=\"mm-lam-medio mm-faq-medio\"><img class=\"mm-lam-foto\" sizes=\"(min-width: 992px) 42vw, 100vw\" src=\"/images/banco/screens/retractable-screens-raised-covered-patio-pool-florida-01.webp\" alt=\"Covered patio with its motorized retractable screens raised, open to a pool and travertine deck.\" width=\"1600\" height=\"1067\" loading=\"lazy\" decoding=\"async\"></figure><div class=\"mm-faq-accion\"><a class=\"mm-btn\" href=\"#estimate\">Get a Free Estimate</a><div class=\"mm-datos mm-datos--tel\"><a class=\"mm-dato\" href=\"tel:+13527403361\"><span class=\"mm-dato-rot\">North Florida</span><span class=\"mm-dato-val\">+1 (352) 740-3361</span></a><a class=\"mm-dato\" href=\"tel:+19549137112\"><span class=\"mm-dato-rot\">South Florida</span><span class=\"mm-dato-val\">+1 (954) 913-7112</span></a></div></div></div></div></section><section class=\"mm-zonas\"><div class=\"mm-zonas-caja\"><div class=\"mm-zonas-txt\"><div class=\"mm-sec-tit\"><h2 class=\"mm-etiqueta\">Where We Serve</h2><p class=\"mm-h2\">Regional <span class=\"mm-rot\">Coverage</span> With National Vision</p></div><div class=\"mm-zonas-lista\"><article class=\"mm-zona\"><h3 class=\"mm-zona-t\">North Florida</h3><p>Licensed luxury pool builders in North Florida specializing in custom inground pools and outdoor living design-build projects, engineered for structural integrity and long-term durability.</p><div class=\"mm-datos\"><a class=\"mm-dato\" href=\"tel:+13527403361\"><span class=\"mm-dato-rot\">North Florida</span><span class=\"mm-dato-val\">+1 (352) 740-3361</span></a></div><a class=\"mm-flecha\" href=\"/where-we-serve/north-florida\">View North Florida Service Areas<svg aria-hidden=\"true\" width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M5 12h14\"></path><path d=\"m13 6 6 6-6 6\"></path></svg></a></article><article class=\"mm-zona\"><h3 class=\"mm-zona-t\">South Florida</h3><p>Licensed luxury pool builders in South Florida specializing in custom inground pools and outd