dex) {\n    if (isAnimating) return;\n    isAnimating = true;\n\n    const prevStep = currentStep;\n    currentStep = index;\n\n    // ── 1. Actualizar DOTS (nav) ──────────────────────────\n    dots.forEach(function (dot, i) {\n      const circle = dot.querySelector('.tab-circle, [class*=\"tab-circle\"], [class*=\"Tab-Circle\"]');\n      const number = dot.querySelector('[class*=\"step-number\"], [class*=\"Step-Number\"]'); // ✅ DENTRO de goToStep\n\n      if (!circle) return;\n\n      if (i === currentStep) {\n        circle.style.background = COLOR_ACTIVE;\n        circle.style.transform  = 'scale(1.15)';\n        circle.style.boxShadow  = '0 4px 16px rgba(0,28,99,0.25)';\n        circle.style.transition = 'all 0.35s ease';\n        if (number) number.style.color = '#FFFFFF'; // ✅ Blanco activo\n      } else {\n        circle.style.background = COLOR_INACTIVE;\n        circle.style.transform  = 'scale(1)';\n        circle.style.boxShadow  = 'none';\n        circle.style.transition = 'all 0.35s ease';\n        if (number) number.style.color = '#001C63'; // ✅ Navy inactivo\n      }\n    });\n\n    // ── 2. Animar salida del paso anterior ────────────────\n    if (steps[prevStep] && prevStep !== currentStep) {\n      const outEl = steps[prevStep];\n      outEl.style.transition = 'opacity 0.3s ease, transform 0.3s ease';\n      outEl.style.opacity    = '0';\n      outEl.style.transform  = 'translateY(-10px)';\n\n      setTimeout(function () {\n        outEl.style.display = 'none';\n        showCurrentStep();\n      }, 300);\n    } else {\n      showCurrentStep();\n    }\n  }\n\n  function showCurrentStep() {\n    steps.forEach(function (s) {\n      s.style.display = 'none';\n      s.style.opacity = '0';\n    });\n\n    const activeEl = steps[currentStep];\n    if (!activeEl) { isAnimating = false; return; }\n\n    activeEl.style.display   = 'flex';\n    activeEl.style.transform = 'translateY(12px)';\n    activeEl.style.opacity   = '0';\n\n    void activeEl.offsetWidth;\n\n    activeEl.style.transition = 'opacity 0.4s ease, transform 0.4s ease';\n    activeEl.style.opacity    = '1';\n    activeEl.style.transform  = 'translateY(0)';\n\n    setTimeout(function () { isAnimating = false; }, 420);\n  }\n\n  function startAutoplay() {\n    stopAutoplay();\n    autoTimer = setInterval(function () {\n      const next = (currentStep + 1) % dots.length;\n      goToStep(next);\n    }, AUTOPLAY_DELAY);\n  }\n\n  function stopAutoplay() {\n    if (autoTimer) { clearInterval(autoTimer); autoTimer = null; }\n  }\n\n  dots.forEach(function (dot, i) {\n    dot.style.cursor = 'pointer';\n    dot.addEventListener('click', function () {\n      if (i === currentStep) return;\n      stopAutoplay();\n      goToStep(i);\n      startAutoplay();\n    });\n  });\n\n  const section = document.querySelector('.process-section');\n  if (section) {\n    section.addEventListener('mouseenter', stopAutoplay);\n    section.addEventListener('mouseleave', startAutoplay);\n  }\n\n  goToStep(0);\n  startAutoplay();\n\n});\n</script></div></div><img sizes=\"100vw\" srcset=\"/images/site/design3-p-500.webp 500w, /images/site/design3-p-800.webp 800w, /images/site/design3-p-1080.webp 1080w, /images/site/design3-p-1600.webp 1600w, /images/site/design3.webp 1920w\" alt=\"\" src=\"/images/site/design3.webp\" loading=\"lazy\" class=\"design-bg\" width=\"1920\" height=\"255\"></section>";
