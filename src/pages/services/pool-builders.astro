const T2 = "<section class=\"svc-intro mm-intro\"><div class=\"mm-marco\"><h2 class=\"mm-h2\">Custom Pool &amp; Spa Builders Serving in <span class=\"mm-rot\">North &amp; South Florida</span></h2><p class=\"mm-p\">Our licensed pool builders design and construct custom pools and spas across North &amp; South Florida, combining luxury designs, premium materials, and expert professional installation for lasting performance and lasting value.</p><a class=\"mm-flecha\" href=\"/about\">More About Us<svg aria-hidden=\"true\" width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M5 12h14\"></path><path d=\"m13 6 6 6-6 6\"></path></svg></a></div></section>";
const T4 = "<section class=\"mm-gal\"><div class=\"mm-sec-cab\"><h2 class=\"mm-h2\">Custom <span class=\"mm-rot\">Pool</span> Project Gallery</h2><div class=\"mm-sec-lado\"><p class=\"mm-p\">Custom pool builds across Florida — from resort-style lagoons to sleek modern lap pools.</p><div class=\"mm-sec-acc\"><a class=\"mm-btn mm-btn--linea\" href=\"#estimate\">Request a Design-Build Project Evaluation</a><a class=\"mm-flecha\" href=\"/gallery\">Project Gallery<svg aria-hidden=\"true\" width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M5 12h14\"></path><path d=\"m13 6 6 6-6 6\"></path></svg></a></div></div></div><div class=\"mm-mosaico mm-mosaico--6\"><button type=\"button\" class=\"mm-celda\" data-mm-foto=\"/images/images/pool-construction-10/custom-pool-spa-builders-florida-10.jpg\" aria-label=\"Open photo: Rectangular pool with a raised mosaic spa set in artificial turf with a hedge border, custom pool and spa built in Florida\"><img src=\"/images/images/pool-construction-10/custom-pool-spa-builders-florida-10.jpg\" alt=\"Rectangular pool with a raised mosaic spa set in artificial turf with a hedge border, custom pool and spa built in Florida\" width=\"1250\" height=\"933\" loading=\"lazy\" decoding=\"async\"></button><button type=\"button\" class=\"mm-celda\" data-mm-foto=\"/images/images/pool-construction-9/custom-pool-spa-builders-florida-09.jpg\" aria-label=\"Open photo: Wide pool with a sun shelf and travertine deck in a palm-lined backyard, custom pool built in Florida\"><img src=\"/images/images/pool-construction-9/custom-pool-spa-builders-florida-09.jpg\" alt=\"Wide pool with a sun shelf and travertine deck in a palm-lined backyard, custom pool built in Florida\" width=\"1250\" height=\"933\" loading=\"lazy\" decoding=\"async\"></button><button type=\"button\" class=\"mm-celda\" data-mm-foto=\"/images/images/pool-construction-8/custom-pool-spa-builders-florida-08.jpg\" aria-label=\"Open photo: Rectangular pool with a sun shelf, loungers and an attached spa overlooking a lake, custom pool construction in Florida\"><img src=\"/images/images/pool-construction-8/custom-pool-spa-builders-florida-08.jpg\" alt=\"Rectangular pool with a sun shelf, loungers and an attached spa overlooking a lake, custom pool construction in Florida\" width=\"1250\" height=\"698\" loading=\"lazy\" decoding=\"async\"></button><button type=\"button\" class=\"mm-celda\" data-mm-foto=\"/images/images/pool-construction-7/custom-pool-spa-builders-florida-07.jpg\" aria-label=\"Open photo: Pool with a tiled raised spa, in-water loungers and a pergola-covered patio, new custom pool built in Florida\"><img src=\"/images/images/pool-construction-7/custom-pool-spa-builders-florida-07.jpg\" alt=\"Pool with a tiled raised spa, in-water loungers and a pergola-covered patio, new custom pool built in Florida\" width=\"1250\" height=\"933\" loading=\"lazy\" decoding=\"async\"></button><button type=\"button\" class=\"mm-celda\" data-mm-foto=\"/images/images/pool-construction-6/custom-pool-spa-builders-florida-06.jpg\" aria-label=\"Open photo: Pool with a raised tiled spa and lounge chairs facing a palm-lined golf course, custom pool and spa construction in Florida\"><img src=\"/images/images/pool-construction-6/custom-pool-spa-builders-florida-06.jpg\" alt=\"Pool with a raised tiled spa and lounge chairs facing a palm-lined golf course, custom pool and spa construction in Florida\" width=\"1250\" height=\"698\" loading=\"lazy\" decoding=\"async\"></button><button type=\"button\" class=\"mm-celda\" data-mm-foto=\"/images/images/pool-construction-5/custom-pool-spa-builders-florida-05.jpg\" aria-label=\"Open photo: Pool with three sheer-descent water features on a raised wall and a lake view, custom pool construction in Florida\"><img src=\"/images/images/pool-construction-5/custom-pool-spa-builders-florida-05.jpg\" alt=\"Pool with three sheer-descent water features on a raised wall and a lake view, custom pool construction in Florida\" width=\"1250\" height=\"698\" loading=\"lazy\" decoding=\"async\"></button></div><script type=\"application/json\" class=\"mm-gal-mas\">[{\"url\":\"/images/images/pool-construction-4/custom-pool-spa-builders-florida-04.jpg\",\"alt\":\"Rectangular pool with a raised glass-tile spa, stepping stones in the lawn and a covered patio, custom pool in Florida\"},{\"url\":\"/images/images/pool-construction-3/custom-pool-spa-builders-florida-03.jpg\",\"alt\":\"L-shaped pool with a sun shelf, raised spa and travertine deck beside a white single-story home, new pool built in Florida\"},{\"url\":\"/images/images/pool-construction-2/custom-pool-spa-builders-florida-02.jpg\",\"alt\":\"Overhead view of a rectangular pool with a mosaic-tile spa and travertine border between hedges, custom pool built in Florida\"},{\"url\":\"/images/images/pool-construction-1/custom-pool-spa-builders-florida-01.jpg\",\"alt\":\"Freeform pool with an attached spa and herringbone paver deck behind a two-story home, custom pool construction in Florida\"}]</script></section><div><section class=\"mm-que\"><div class=\"mm-sec-cab\"><div class=\"mm-sec-tit\"><p class=\"mm-etiqueta\">What we do</p><h2 class=\"mm-h2\">Custom Pools &amp; Spas Design-Built for Florida Luxury Living</h2></div><div class=\"mm-sec-lado\"><p class=\"mm-p\">We design and build custom inground pools, spas, and hardscapes for discerning homeowners across North and South Florida.</p><div class=\"mm-sec-acc\"><a class=\"mm-btn mm-btn--linea\" href=\"#estimate\">Request a Design-Build Project Evaluation</a></div></div></div><div class=\"mm-que-cuerpo\"><div class=\"mm-que-col\"><ol class=\"mm-grupos\"><li class=\"mm-grupo mm-grupo--activo\"><h3 class=\"mm-grupo-t\">Designed Around Your Lot</h3><p class=\"mm-grupo-p\">Every pool starts with your lot, not a catalog shape. We survey the site, model the pool in 3D against setbacks, soil conditions and the Florida Building Code, and you approve the rendering before we pull a permit.</p><dl class=\"mm-grupo-dl\"><div class=\"mm-grupo-i\"><dt>Custom Pool Design &amp; Engineering</dt><dd>Custom pool design engineered for Florida homes and code compliance.</dd></div></dl></li><li class=\"mm-grupo\"><h3 class=\"mm-grupo-t\">Plumbing, Equipment, Automation</h3><p class=\"mm-grupo-p\">What keeps the water clear is buried before the plaster goes in. Lines are sized to your pool rather than to habit, and the pumps, filters and heaters come back to one app instead of a wall of valves.</p><dl class=\"mm-grupo-dl\"><div class=\"mm-grupo-i\"><dt>Pool Plumbing &amp; Circulation Systems Installation</dt><dd>Plumbing and circulation built for proper water flow and filtration.</dd></div><div class=\"mm-grupo-i\"><dt>Pool Equipment Installation &amp; Automation</dt><dd>Modern pumps, filters, heaters, and automation systems for efficient pool use.</dd></div></dl></li><li class=\"mm-grupo\"><h3 class=\"mm-grupo-t\">Finishes, Tile &amp; Coping</h3><p class=\"mm-grupo-p\">The finish is what you touch and what you look at for the next twenty years. We build in plaster, quartz and pebble, and match tile and coping to the deck so the pool reads as part of the house.</p><dl class=\"mm-grupo-dl\"><div class=\"mm-grupo-i\"><dt>Pool Finishes &amp; Interior Surface Installation</dt><dd>Interior pool finishes including plaster, quartz, and pebble for lasting beauty.</dd></div><div class=\"mm-grupo-i\"><dt>Pool Tile &amp; Coping Installation</dt><dd>Tile and coping that improve pool safety, durability, and modern design.</dd></div></dl></li><li class=\"mm-grupo\"><h3 class=\"mm-grupo-t\">Remodeling &amp; Spa Additions</h3><p class=\"mm-grupo-p\">If the shell is sound, a remodel gets you there faster than a new build. Same licensed crew and the same permits, applied to the pool you already own.</p><dl class=\"mm-grupo-dl\"><div class=\"mm-grupo-i\"><dt><a href=\"/services/pool-remodeling\">Inground Pool Remodeling</a></dt><dd>Complete inground pool renovations focused on performance and aesthetics.</dd></div><div class=\"mm-grupo-i\"><dt><a href=\"/services/pool-remodeling\">Integrated Spa Remodeling</a></dt><dd>Spa remodeling seamlessly integrated into existing pools for comfort and style.</dd></div><div class=\"mm-grupo-i\"><dt><a href=\"/services/pool-remodeling\">Pool Deck &amp; Hardscape Remodeling</a></dt><dd>Pool deck remodeling using pavers or concrete for safety and durability.</dd></div></dl></li></ol><div class=\"mm-datos\"><a class=\"mm-dato\" href=\"tel:+13527403361\"><span class=\"mm-dato-rot\">North Florida</span><span class=\"mm-dato-val\">+1 (352) 740-3361</span></a><a class=\"mm-dato\" href=\"tel:+19549137112\"><span class=\"mm-dato-rot\">South Florida</span><span class=\"mm-dato-val\">+1 (954) 913-7112</span></a></div></div><figure class=\"mm-lam-medio mm-que-medio\"><img class=\"mm-lam-foto\" src=\"/images/projects/estate-pool-spa-sun-shelf-north-florida/estate-pool-spa-sun-shelf-north-florida-project-1.avif\" alt=\"Aerial view of a custom pool and spa sited on a Florida acreage lot\" width=\"1250\" height=\"698\" loading=\"lazy\" decoding=\"async\"><div class=\"mm-lam-pie\" aria-hidden=\"true\" data-n=\"01 / 04\" data-t=\"Designed Around Your Lot\"></div></figure></div></section><section class=\"before-after-section\"><div class=\"w-layout-blockcontainer container w-container\"><div class=\"before-after-content\"><div fb-before-after-start=\"50\" fb-before-after=\"true\" fb-before-after-direction=\"horizontal\" class=\"bas-wrapper\"><img alt=\"Before: empty backyard lawn and a small concrete patio behind a two-story Florida home, ahead of a new pool build\" loading=\"lazy\" src=\"/images/site/backyard-transformation-before-empty-lawn-concrete-patio-1280.avif\" class=\"bas-image-before\" srcset=\"/images/site/backyard-transformation-before-empty-lawn-concrete-patio-640.avif 640w, /images/site/backyard-transformation-before-empty-lawn-concret