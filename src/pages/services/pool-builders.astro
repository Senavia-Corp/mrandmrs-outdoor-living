const T0 = "<section class=\"mm-hero-a\"><div class=\"mm-hero-a-txt\"><p class=\"mm-etiqueta\">Licensed &amp; insured Contractors</p><h1 class=\"mm-h1\">Custom <span class=\"mm-rot\">Pool</span> Builders</h1><p class=\"mm-p\">New custom inground pools for North Florida homeowners — 3D design, permits, construction and final start-up, from one licensed team. We also build across South Florida.</p><div class=\"mm-hero-a-acc\"><a class=\"mm-btn\" href=\"#estimate\">Request a Design-Build Project Evaluation</a></div><div class=\"mm-datos mm-datos--3\"><a class=\"mm-dato\" href=\"tel:+13527403361\"><span class=\"mm-dato-rot\">North Florida</span><span class=\"mm-dato-val\">+1 (352) 740-3361</span></a><a class=\"mm-dato\" href=\"tel:+19549137112\"><span class=\"mm-dato-rot\">South Florida</span><span class=\"mm-dato-val\">+1 (954) 913-7112</span></a><div class=\"mm-dato\"><span class=\"mm-dato-rot\">Florida certified pool contractor</span><span class=\"mm-dato-val\">CPC1461119 · CPC1460562</span></div></div></div><figure class=\"mm-hero-a-medio\"><img src=\"/images/projects/estate-pool-spa-sun-shelf-north-florida/estate-pool-spa-sun-shelf-north-florida-project-2.avif\" alt=\"Custom inground pool and raised spa on a Florida acreage lot, built by Mr &amp; Mrs Outdoor Living\" width=\"1250\" height=\"698\" loading=\"eager\" fetchpriority=\"high\" decoding=\"async\"></figure><div class=\"mm-hero-a-logos\"><h2 class=\"mm-etiqueta\">Trusted by Florida's finest homeowners</h2><ul class=\"mm-hero-a-fila\"><li><img src=\"/images/logos/delta/delta-removebg-preview.png\" alt=\"\" width=\"700\" height=\"220\" loading=\"lazy\" decoding=\"async\"></li><li><img src=\"/images/logos/biggreen/bge-logo-lineup-removebg-preview.png\" alt=\"\" width=\"840\" height=\"271\" loading=\"lazy\" decoding=\"async\"></li><li><img src=\"/images/logos/alfresco/alfresco-logo-removebg-preview.png\" alt=\"\" width=\"842\" height=\"296\" loading=\"lazy\" decoding=\"async\"></li><li><img src=\"/images/logos/sunbrella/530-5307608-awning-vector-colorful-sunbrella-logo-transparent-hd-png-removebg-preview.png\" alt=\"\" width=\"280\" height=\"280\" loading=\"lazy\" decoding=\"async\"></li><li><img src=\"/images/logos/zodiac/zodiac-new.png\" alt=\"\" width=\"232\" height=\"127\" loading=\"lazy\" decoding=\"async\"></li><li><img src=\"/images/logos/sgm/sgm-pool-logo-e1585262761892.jpg\" alt=\"\" width=\"480\" height=\"167\" loading=\"lazy\" decoding=\"async\"></li><li><img src=\"/images/logos/npt/medium-tveat8emx4.png\" alt=\"\" width=\"1222\" height=\"700\" loading=\"lazy\" decoding=\"async\"></li><li><img src=\"/images/logos/pelican-reef/logo-pelican-reef-800x800tiny.png\" alt=\"\" width=\"800\" height=\"800\" loading=\"lazy\" decoding=\"async\"></li><li><img src=\"/images/logos/jandy/jandy-logo.png\" alt=\"\" width=\"334\" height=\"105\" loading=\"lazy\" decoding=\"async\"></li><li><img src=\"/images/logos/irrigreen/irrigreen-logo-black-web.png\" alt=\"\" width=\"600\" height=\"280\" loading=\"lazy\" decoding=\"async\"></li><li><img src=\"/images/logos/milestone-p8m6r/image.png\" alt=\"\" width=\"1040\" height=\"260\" loading=\"lazy\" decoding=\"async\"></li><li><img src=\"/images/logos/gemstone/gemstonelights-newlogo.png\" alt=\"\" width=\"930\" height=\"201\" loading=\"lazy\" decoding=\"async\"></li><li><img src=\"/images/logos/coyote/coyote-logo-glow.png\" alt=\"\" width=\"2637\" height=\"752\" loading=\"lazy\" decoding=\"async\"></li><li><img src=\"/images/logos/alumawood/alumawood.png\" alt=\"\" width=\"2744\" height=\"792\" loading=\"lazy\" decoding=\"async\"></li></ul></div></section>";
const T2 = "<section class=\"svc-intro mm-intro\"><div class=\"mm-marco\"><h2 class=\"mm-h2\">Custom Pool &amp; Spa Builders Serving in <span class=\"mm-rot\">North &amp; South Florida</span></h2><p class=\"mm-p\">Our licensed pool builders design and construct custom pools and spas across North &amp; South Florida, combining luxury designs, premium materials, and expert professional installation for lasting performance and lasting value.</p><a class=\"mm-flecha\" href=\"/about\">More About Us<svg aria-hidden=\"true\" width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M5 12h14\"></path><path d=\"m13 6 6 6-6 6\"></path></svg></a></div></section><section class=\"mm-gal\"><div class=\"mm-sec-cab\"><h2 class=\"mm-h2\">Custom <span class=\"mm-rot\">Pool</span> Project Gallery</h2><div class=\"mm-sec-lado\"><p class=\"mm-p\">Custom pool builds across Florida — from resort-style lagoons to sleek modern lap pools.</p><div class=\"mm-sec-acc\"><a class=\"mm-btn mm-btn--linea\" href=\"#estimate\">Request a Design-Build Project Evaluation</a><a class=\"mm-flecha\" href=\"/gallery\">Project Gallery<svg aria-hidden=\"true\" width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M5 12h14\"></path><path d=\"m13 6 6 6-6 6\"></path></svg></a></div></div></div><div class=\"mm-mosaico mm-mosaico--6\"><button type=\"button\" class=\"mm-celda\" data-mm-foto=\"/images/images/pool-construction-10/custom-pool-spa-builders-florida-10.jpg\" aria-label=\"Open photo: Rectangular pool with a raised mosaic spa set in artificial turf with a hedge border, custom pool and spa built in Florida\"><img src=\"/images/images/pool-construction-10/custom-pool-spa-builders-florida-10.jpg\" alt=\"Rectangular pool with a raised mosaic spa set in artificial turf with a hedge border, custom pool and spa built in Florida\" width=\"1250\" height=\"933\" loading=\"lazy\" decoding=\"async\"></button><button type=\"button\" class=\"mm-celda\" data-mm-foto=\"/images/images/pool-construction-9/custom-pool-spa-builders-florida-09.jpg\" aria-label=\"Open photo: Wide pool with a sun shelf and travertine deck in a palm-lined backyard, custom pool built in Florida\"><img src=\"/images/images/pool-construction-9/custom-pool-spa-builders-florida-09.jpg\" alt=\"Wide pool with a sun shelf and travertine deck in a palm-lined backyard, custom pool built in Florida\" width=\"1250\" height=\"933\" loading=\"lazy\" decoding=\"async\"></button><button type=\"button\" class=\"mm-celda\" data-mm-foto=\"/images/images/pool-construction-8/custom-pool-spa-builders-florida-08.jpg\" aria-label=\"Open photo: Rectangular pool with a sun shelf, loungers and an attached spa overlooking a lake, custom pool construction in Florida\"><img src=\"/images/images/pool-construction-8/custom-pool-spa-builders-florida-08.jpg\" alt=\"Rectangular pool with a sun shelf, loungers and an attached spa overlooking a lake, custom pool construction in Florida\" width=\"1250\" height=\"698\" loading=\"lazy\" decoding=\"async\"></button><button type=\"button\" class=\"mm-celda\" data-mm-foto=\"/images/images/pool-construction-7/custom-pool-spa-builders-florida-07.jpg\" aria-label=\"Open photo: Pool with a tiled raised spa, in-water loungers and a pergola-covered patio, new custom pool built in Florida\"><img src=\"/images/images/pool-construction-7/custom-pool-spa-builders-florida-07.jpg\" alt=\"Pool with a tiled raised spa, in-water loungers and a pergola-covered patio, new custom pool built in Florida\" width=\"1250\" height=\"933\" loading=\"lazy\" decoding=\"async\"></button><button type=\"button\" class=\"mm-celda\" data-mm-foto=\"/images/images/pool-construction-6/custom-pool-spa-builders-florida-06.jpg\" aria-label=\"Open photo: Pool with a raised tiled spa and lounge chairs facing a palm-lined golf course, custom pool and spa construction in Florida\"><img src=\"/images/images/pool-construction-6/custom-pool-spa-builders-florida-06.jpg\" alt=\"Pool with a raised tiled spa and lounge chairs facing a palm-lined golf course, custom pool and spa construction in Florida\" width=\"1250\" height=\"698\" loading=\"lazy\" decoding=\"async\"></button><button type=\"button\" class=\"mm-celda\" data-mm-foto=\"/images/images/pool-construction-5/custom-pool-spa-builders-florida-05.jpg\" aria-label=\"Open photo: Pool with three sheer-descent water features on a raised wall and a lake view, custom pool construction in Florida\"><img src=\"/images/images/pool-construction-5/custom-pool-spa-builders-florida-05.jpg\" alt=\"Pool with three sheer-descent water features on a raised wall and a lake view, custom pool construction in Florida\" width=\"1250\" height=\"698\" loading=\"lazy\" decoding=\"async\"></button></div><script type=\"application/json\" class=\"mm-gal-mas\">[{\"url\":\"/images/images/pool-construction-4/custom-pool-spa-builders-florida-04.jpg\",\"alt\":\"Rectangular pool with a raised glass-tile spa, stepping stones in the lawn and a covered patio, custom pool in Florida\"},{\"url\":\"/images/images/pool-construction-3/custom-pool-spa-builders-florida-03.jpg\",\"alt\":\"L-shaped pool with a sun shelf, raised spa and travertine deck beside a white single-story home, new pool built in Florida\"},{\"url\":\"/images/images/pool-construction-2/custom-pool-spa-builders-florida-02.jpg\",\"alt\":\"Overhead view of a rectangular pool with a mosaic-tile spa and travertine border between hedges, custom pool built in Florida\"},{\"url\":\"/images/images/pool-construction-1/custom-pool-spa-builders-florida-01.jpg\",\"alt\":\"Freeform pool with an attached spa and herringbone paver deck behind a two-story home, custom pool construction in Florida\"}]</script></section><section class=\"mm-proc\"><div class=\"mm-sec-cab\"><h2 class=\"mm-h2\">Our Custom Pool Build <span class=\"mm-rot\">Process</span></h2><div class=\"mm-sec-lado\"><p class=\"mm-p\">Our pool builders guide your project from 3D design to final installation, delivering code-compliant custom pools across North &amp; South Florida.</p><div class=\"mm-sec-acc\"><a class=\"mm-btn mm-btn--linea\" href=\"#estimate\">Request a Design-Build Project Evaluation</a></div></div></div><div class=\"mm-proc-cuerpo\"><figure class=\"mm-lam-medio mm-proc-medio\" data-mm-pasos-medio=\"\"><img class=\"mm-lam-foto\" src=\"/images/obra/obra-065/custom-pool-construction-backyard-lot-before-excavation.avif\" alt=\"Backyard lot behind a new farmhouse with materials staged on the sand before excavation, custom pool construction in Florida\" width=\"1600\" height=\"1200\" loading=\"lazy\" decoding=\"async\"><div class=\"mm-lam-pie\" aria-hidden=\"true\" data-n=\"01 / 04\" data-t=\"Site Assessment &amp; Structural Evaluation\"></div></figure><ol class=\"mm-pasos\" data-mm-pasos=\"\"><li class=\"mm-paso\"><span class=\"mm-paso-n\">1</span><img class=\"mm-paso-foto\" src=\"/images/obra/obra-065/custom-pool-construction-backyard-lot-before-excavation.avif\" alt=\"Backyard lot behind a new farmhouse with materials staged on the sand before excavation, custom pool construction in Florida\" width=\"1600\" height=\"1200\" loading=\"lazy\" decoding=\"async\"><h3 class=\"mm-paso-t\">Site Assessment &amp; Structural Evaluation</h3><p>Comprehensive evaluation of lot configuration, soil stability, and hydrostatic pressure zones using 3D surveying technology. We assess setback requirements per Florida Building Code Chapter 45, HOA restrictions, and geotechnical conditions to determine engineering specifications.</p></li><li class=\"mm-paso\"><span class=\"mm-paso-n\">2</span><img class=\"mm-paso-foto\" src=\"/images/obra/obra-065/custom-pool-and-spa-layout-painted-on-site-aerial.avif\" alt=\"Top-down drone view of the approved pool and spa layout painted on the sand next to the house, new pool build in Florida\" width=\"1600\" height=\"1200\" loading=\"lazy\" decoding=\"async\" style=\"object-position:60% 60%\"><h3 class=\"mm-paso-t\">Design Consultation &amp; 3D Rendering</h3><p>Custom design consultation creating detailed 3D architectural renderings showing pool shape, depth variations, spa integration, and surrounding deck configurations. Our licensed designers present multiple options for approval before construction begins.</p></li><li class=\"mm-paso\"><span class=\"mm-paso-n\">3</span><img class=\"mm-paso-foto\" src=\"/images/obra/obra-065/custom-pool-steel-rebar-and-drains-before-gunite.avif\" alt=\"Steel rebar cage tied over wood forms with main drains and plumbing ready for inspection, custom pool builders in Florida\" width=\"1600\" height=\"1200\" loading=\"lazy\" decoding=\"async\"><h3 class=\"mm-paso-t\">Permits &amp; Regulatory Compliance</h3><p>Comprehensive permit acquisition including Notice of Commencement (NOC), VGB compliance certification, and ARB approvals if applicable. We manage all interactions with county building departments and HOA review boards to ensure seamless approval.</p></li><li class=\"mm-paso\"><span class=\"mm-paso-n\">4</span><img class=\"mm-paso-foto\" src=\"/images/obra/obra-065/custom-pool-gunite-shell-being-sprayed-aerial.avif\" alt=\"Top-down view of a crew spraying the gunite shell beside the spa form, custom pool construction in Florida\" width=\"1600\" height=\"1200\" loading=\"lazy\" decoding=\"async\" style=\"object-position:40% 50%\"><h3 class=\"mm-paso-t\">Construction &amp; Installation</h3><p>Full construction execution including gunite shell application with pneumatic concrete, hydrostatic pressure management systems, bond coat application, plaster finishes, equipment installation, and final inspections with CPC licensing.</p></li></ol></div></section><section class=\"mm-que\"><div class=\"mm-sec-cab\"><div class=\"mm-sec-tit\"><p class=\"mm-etiqueta\">What we do</p><h2 class=\"mm-h2\">Custom Pools &amp; Spas <span class=\"mm-nb\">Design-Built</span> for Florida Luxury Living</h2></div><div class=\"mm-sec-lado\"><p class=\"mm-p\">We design and build custom inground pools, spas, and hardscapes for discerning homeowners across North and South Florida.</p><div class=\"mm-sec-acc\"><a class=\"mm-btn mm-btn--linea\" href=\"#estimate\">Request a Design-Build Project Evaluation</a></div></div></div><div class=\"mm-que-cuerpo\"><div class=\"mm-que-col\"><ol class=\"mm-grupos\"><li class=\"mm-grupo mm-grupo--activo\"><h3 class=\"mm-grupo-t\">Designed Around Your Lot</h3><p class=\"mm-grupo-p\">Every pool starts with your lot, not a catalog shape. We survey the site, model the pool in 3D against setbacks, soil conditions and the Florida Building Code, and you approve the rendering before we pull a permit.</p><dl class=\"mm-grupo-dl\"><div class=\"mm-grupo-i\"><dt>Custom Pool Design &amp; Engineering</dt><dd>Custom pool design engineered for Florida homes and code compliance.</dd></div></dl></li><li class=\"mm-grupo\"><h3 class=\"mm-grupo-t\">Plumbing, Equipment, Automation</h3><p class=\"mm-grupo-p\">What keeps the water clear is buried before the plaster goes in. Lines are sized to your pool rather than to habit, and the pumps, filters and heaters come back to one app instead of a wall of valves.</p><dl class=\"mm-grupo-dl\"><div class=\"mm-grupo-i\"><dt>Pool Plumbing &amp; Circulation Systems Installation</dt><dd>Plumbing and circulation built for proper water flow and filtration.</dd></div><div class=\"mm-grupo-i\"><dt>Pool Equipment Installation &amp; Automation</dt><dd>Modern pumps, filters, heaters, and automation systems for efficient pool use.</dd></div></dl></li><li class=\"mm-grupo\"><h3 class=\"mm-grupo-t\">Finishes, Tile &amp; Coping</h3><p class=\"mm-grupo-p\">The finish is what you touch and what you look at for the next twenty years. We build in plaster, quartz and pebble, and match tile and coping to the deck so the pool reads as part of the house.</p><dl class=\"mm-grupo-dl\"><div class=\"mm-grupo-i\"><dt>Pool Finishes &amp; Interior Surface Installation</dt><dd>Interior pool finishes including plaster, quartz, and pebble for lasting beauty.</dd></div><div class=\"mm-grupo-i\"><dt>Pool Tile &amp; Coping Installation</dt><dd>Tile and coping that improve pool safety, durability, and modern design.</dd></div></dl></li><li class=\"mm-grupo\"><h3 class=\"mm-grupo-t\">Remodeling &amp; Spa Additions</h3><p class=\"mm-grupo-p\">If the shell is sound, a remodel gets you there faster than a new build. Same licensed crew and the same permits, applied to the pool you already own.</p><dl class=\"mm-grupo-dl\"><div class=\"mm-grupo-i\"><dt><a href=\"/services/pool-remodeling\">Inground Pool Remodeling</a></dt><dd>Complete inground pool renovations focused on performance and aesthetics.</dd></div><div class=\"mm-grupo-i\"><dt><a href=\"/services/pool-remodeling\">Integrated Spa Remodeling</a></dt><dd>Spa remodeling seamlessly integrated into existing pools for comfort and style.</dd></div><div class=\"mm-grupo-i\"><dt><a href=\"/services/pool-remodeling\">Pool Deck &amp; Hardscape Remodeling</a></dt><dd>Pool deck remodeling using pavers or concrete for safety and durability.</dd></div></dl></li></ol><div class=\"mm-datos\"><a class=\"mm-dato\" href=\"tel:+13527403361\"><span class=\"mm-dato-rot\">North Florida</span><span class=\"mm-dato-val\">+1 (352) 740-3361</span></a><a class=\"mm-dato\" href=\"tel:+19549137112\"><span class=\"mm-dato-rot\">South Florida</span><span class=\"mm-dato-val\">+1 (954) 913-7112</span></a></div></div><figure class=\"mm-lam-medio mm-que-medio\"><img class=\"mm-lam-foto\" src=\"/images/projects/estate-pool-spa-sun-shelf-north-florida/estate-pool-spa-sun-shelf-north-florida-project-1.avif\" alt=\"Aerial view of a custom pool and spa sited on a Florida acreage lot\" width=\"1250\" height=\"698\" loading=\"lazy\" decoding=\"async\"><div class=\"mm-lam-pie\" aria-hidden=\"true\" data-n=\"01 / 04\" data-t=\"Designed Around Your Lot\"></div></figure></div></section>";
const T4 = "<section class=\"mm-faq\"><div class=\"mm-sec-cab\"><h2 class=\"mm-h2\">Custom Pool Construction <span class=\"mm-rot\">FAQs</span></h2><div class=\"mm-sec-lado\"><p class=\"mm-p\">Have questions about custom pool construction in Florida? Our licensed pool builders answer the most common questions from Florida homeowners below.</p></div></div><div class=\"mm-faq-cuerpo\"><div class=\"mm-faq-lista\"><details class=\"mm-faq-item\"><summary><h3>Do custom pool installations increase home value in Florida?</h3><svg aria-hidden=\"true\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"m6 9 6 6 6-6\"></path></svg></summary><div class=\"mm-faq-r\"><p>It can, but no honest builder can promise a percentage: the effect depends on the neighborhood, the home and the quality of the build. What we control is what buyers, inspectors and appraisers check: a permitted pool built under our Florida pool contractor licenses (CPC1461119 and CPC1460562), with its inspections passed and its final approval on file.</p></div></details><details class=\"mm-faq-item\"><summary><h3>What pool and spa design options are available?</h3><svg aria-hidden=\"true\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"m6 9 6 6 6-6\"></path></svg></summary><div class=\"mm-faq-r\"><p>We offer fully custom pool designs with flexible shapes, depths, and integrated features including attached spas, tanning ledges, waterfalls, LED lighting systems, and swim-up bars. Every design begins with a full 3D architectural rendering so you can visualize the finished pool before construction begins.</p></div></details><details class=\"mm-faq-item\"><summary><h3>Are custom pools in Florida low-maintenance?</h3><svg aria-hidden=\"true\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"m6 9 6 6 6-6\"></path></svg></summary><div class=\"mm-faq-r\"><p>Modern pool systems equipped with variable-speed pumps, saltwater generators, and automated controllers significantly reduce the time and cost of pool ownership in Florida. Smart filtration and chemical automation handle routine tasks, so homeowners spend less time on upkeep and more time enjoying their custom pool year-round.</p></div></details><details class=\"mm-faq-item\"><summary><h3>How long does pool construction take in Florida?</h3><svg aria-hidden=\"true\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"m6 9 6 6 6-6\"></path></svg></summary><div class=\"mm-faq-r\"><p>It depends on the design, the permit review and the weather, so we give you a schedule for your own project instead of a generic number. The sequence is always the same: design and engineering, permit review, excavation, steel and gunite, plumbing and electrical, tile, coping and deck, interior finish, and start-up, with the county or city inspections between stages. We coordinate every one of them.</p></div></details><details class=\"mm-faq-item\"><summary><h3>Can I finance a custom pool project in Florida?</h3><svg aria-hidden=\"true\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"m6 9 6 6 6-6\"></path></svg></summary><div class=\"mm-faq-r\"><p>Yes. We connect Florida homeowners with lending partners, and the order matters: you get your design and a fixed project price in writing first, and only then review how to pay for it. Approval and terms come from the lender.</p></div></details><details class=\"mm-faq-item\"><summary><h3>How much does a custom pool cost in North Florida?</h3><svg aria-hidden=\"true\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"m6 9 6 6 6-6\"></path></svg></summary><div class=\"mm-faq-r\"><p>There is no single number: a custom pool is priced from its own design, size, finishes and site conditions. Our estimator walks you through the choices that move the price, and you get a fixed project price in writing before you commit.</p></div></details><details class=\"mm-faq-item\"><summary><h3>Who pulls the permits for a pool in Florida?</h3><svg aria-hidden=\"true\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"m6 9 6 6 6-6\"></path></svg></summary><div class=\"mm-faq-r\"><p>We do. Permitting and code compliance are part of the build: we prepare the submittal, pull the permits and coordinate the county inspections through to final start-up.</p></div></details><details class=\"mm-faq-item\"><summary><h3>What is included in a custom pool project?</h3><svg aria-hidden=\"true\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"m6 9 6 6 6-6\"></path></svg></summary><div class=\"mm-faq-r\"><p>Design and 3D rendering, engineering, permitting, excavation, the gunite shell, plumbing and circulation, electrical and equipment, interior finish, tile and coping, the deck, and final start-up.</p></div></details></div><div class=\"mm-faq-lado\"><figure class=\"mm-lam-medio mm-faq-medio\"><img class=\"mm-lam-foto\" src=\"/images/images/pool-construction-4/custom-pool-spa-builders-florida-04.jpg\" alt=\"Rectangular pool with a raised glass-tile spa, stepping stones in the lawn and a covered patio, custom pool in Florida\" width=\"1250\" height=\"698\" loading=\"lazy\" decoding=\"async\"></figure><div class=\"mm-faq-accion\"><a class=\"mm-btn\" href=\"#estimate\">Request a Design-Build Project Evaluation</a><div class=\"mm-datos\"><a class=\"mm-dato\" href=\"tel:+13527403361\"><span class=\"mm-dato-rot\">North Florida</span><span class=\"mm-dato-val\">+1 (352) 740-3361</span></a><a class=\"mm-dato\" href=\"tel:+19549137112\"><span class=\"mm-dato-rot\">South Florida</span><span class=\"mm-dato-val\">+1 (954) 913-7112</span></a></div></div></div></div></section><section class=\"mm-zonas\"><div class=\"mm-zonas-caja\"><div class=\"mm-zonas-txt\"><div class=\"mm-sec-tit\"><h2 class=\"mm-etiqueta\">Where We Serve</h2><p class=\"mm-h2\">Regional <span class=\"mm-rot\">Coverage</span> With National Vision</p></div><div class=\"mm-zonas-lista\"><article class=\"mm-zona\"><h3 class=\"mm-zona-t\">North Florida</h3><p>Licensed luxury pool builders in North Florida specializing in custom inground pools and outdoor living design-build projects, engineered for structural integrity and long-term durability.</p><div class=\"mm-datos\"><a class=\"mm-dato\" href=\"tel:+13527403361\"><span class=\"mm-dato-rot\">North Florida</span><span class=\"mm-dato-val\">+1 (352) 740-3361</span></a></div><a class=\"mm-flecha\" href=\"/where-we-serve/north-florida\">View North Florida Service Areas<svg aria-hidden=\"true\" width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M5 12h14\"></path><path d=\"m13 6 6 6-6 6\"></path></svg></a></article><article class=\"mm-zona\"><h3 class=\"mm-zona-t\">South Florida</h3><p>Licensed luxury pool builders in South Florida specializing in custom inground pools and outdoor living design-build projects, engineered, permitted, and built for high-end residential properties.</p><div class=\"mm-datos\"><a class=\"mm-dato\" href=\"tel:+19549137112\"><span class=\"mm-dato-rot\">South Florida</span><span class=\"mm-dato-val\">+1 (95