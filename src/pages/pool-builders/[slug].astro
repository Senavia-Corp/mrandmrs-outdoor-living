---
// DERIVADO - no editar a mano. Lo genera scripts/build-plantillas.mjs por diff de las
// 53 paginas que habia antes; la autocomprobacion las reprodujo 53/53 byte a byte.
// Regenerar: npm run plantillas — SALVO el carrusel de blog: ese pipeline ya no puede
// re-derivarse (las 53 paginas de origen no existen desde la Fase 6b, `npm run plantillas`
// sale con «0 paginas · ya convertida»), asi que R11-BLOG-02 lo migro a mano, una vez, con
// scripts/migrar-blog-pool-builders.mjs. Ese cambio puntual SI hay que mantenerlo a mano.
// SEGUNDO CAMBIO A MANO (R15-IG): el feed de Instagram sube por encima del `.cta-footer`.
// El origen de Webflow lo traia DEBAJO (`blog -> cta-footer -> social-media`, medido en
// _source/vivo/pool-builders_*.html), asi que esto NO es paridad: es rediseno deliberado,
// para que las 53 acaben como la home y como las 16 de services/+Estado. Con el feed vacio
// -altura 0- la diferencia no se veia; poblado, el CTA quedaba a media pagina.
import Base from '../../layouts/Base.astro';
import ResenasGoogle from '../../components/widgets/ResenasGoogle.astro';
import FeedInstagram from '../../components/widgets/FeedInstagram.astro';
import CarruselBlog from '../../components/widgets/CarruselBlog.astro';
import SEO_RUTAS from '../../data/seo-pool-builders.json';
import { sinAperturaDelFeed } from '../../lib/feed-social.mjs';
import LIT from '../../data/plantilla-pool-builders.json';

const esc = (s) => String(s ?? '').replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');

/** Aplana el documento a rutas con puntos, igual que hizo el generador al derivar la plantilla. */
function aplanar(o, pref = '', prof = 0, salida = {}) {
  for (const [k, v] of Object.entries(o ?? {})) {
    if (k.startsWith('_')) continue;
    const ruta = pref ? `${pref}.${k}` : k;
    if (typeof v === 'string') salida[ruta] = v;
    else if (v && typeof v === 'object' && !Array.isArray(v) && prof < 3) aplanar(v, ruta, prof + 1, salida);
  }
  return salida;
}

export async function getStaticPaths() {
  // El proyecto y el dataset van AQUI DENTRO, no en una constante del modulo: Astro extrae
  // `getStaticPaths` a su propio modulo para el prerender y alli no existe nada de fuera.
  // El sintoma era `PID is not defined` al construir, no al escribir el codigo.
  const PID = import.meta.env.PUBLIC_SANITY_PROJECT_ID ?? "m273z6jc";
  const DS = import.meta.env.PUBLIC_SANITY_DATASET ?? "production";
  // Las listas se piden con su proyeccion: las de REFERENCIAS con `->` para traer el documento
  // destino, porque el marcado pinta su nombre y su slug, no el identificador.
  const q = '*[_type=="poolBuilder" && defined(slug.current)]{..., "slug": slug.current}';
  const r = await fetch(`https://${PID}.api.sanity.io/v2024-01-01/data/query/${DS}?query=${encodeURIComponent(q)}`);
  const { result, error } = await r.json();
  // Sin datos no se construye media coleccion: se para el build. 53 URLs que
  // desaparecen en silencio son 53 404 con el despliegue en verde.
  if (error || !result?.length) throw new Error('Sanity no devolvio poolBuilder: ' + JSON.stringify(error ?? 'vacio'));
  return result.map((doc) => ({ params: { slug: doc.slug }, props: { doc } }));
}

const { slug } = Astro.params;
const d = aplanar(Astro.props.doc);
const CAMPOS = [[null,{"c":"h1Title","tx":"","p":["",""]},null,{"c":"h2Title","tx":"","p":["",""]},null,{"c":"intro","tx":"","p":["",""]},null,{"c":"imagenIntro1.alt","tx":"","p":["<img src=\"/images/pool-builders/alachua-florida/custom-pool-pergola-outdoor-living-contractors-fl-1-.webp\" loading=\"lazy\" data-w-id=\"f72979fc-9196-9930-356a-1756486557d5\" alt=\"","\" class=\"image\">"]},null,{"c":"imagenIntro2.alt","tx":"","p":["<img src=\"/images/pool-builders/alachua-florida/luxury-outdoor-kitchen-pool-backyard-design-florida-1-.webp\" loading=\"lazy\" data-w-id=\"53f4d2e0-9a7a-0e16-e20a-ab8f9e03c935\" alt=\"","\" class=\"image\">"]},null,{"c":"imagenIntro3.alt","tx":"","p":["<img src=\"/images/pool-builders/alachua-florida/luxury-pool-builders-outdoor-living-florida-1-.webp\" loading=\"lazy\" data-w-id=\"8bad508e-9f02-2bc9-bf6d-6ac47990da3b\" alt=\"","\" class=\"image\">"]},null,{"c":"headingIntro","tx":"","p":["",""]},null,{"c":"paragraphIntro","tx":"","p":["",""]},null,{"c":"heading3DRendering","tx":"","p":["",""]},null,{"c":"paragraphReviews","tx":"","p":["",""]},null,{"c":"headingFeature","tx":"","p":["",""]},null,{"c":"paragraphFeatures","tx":"","p":["",""]},null,{"c":"headingPortfolio","tx":"","p":["",""]},null,{"c":"paragraphPortfolio","tx":"","p":["",""]},null,{"c":"headingReviews","tx":"","p":["",""]},null,{"c":"paragraphReviews","tx":"","p":["",""]},null],[],[],[null]];


const TX = { '': esc, url: encodeURIComponent };
const valor = (h, o) => {
  const v = o[h.c];
  // Un campo vacio deja un hueco mudo en la pagina. Mejor que reviente el build.
  if (typeof v !== 'string') throw new Error(`${slug}: falta el campo ${h.c}`);
  return h.p.join(TX[h.tx](v));
};


const B = LIT.map((tr, b) => tr.map((x, i) => {
  if (x !== null) return x;
  const h = CAMPOS[b][i];
  return valor(h, d);
}).join(''));

// headingBlog/paragraphBlog ya no son huecos de CAMPOS (R11-BLOG-02, pasaron a props
// directas de CarruselBlog); esta guarda reemplaza la que perdian al salir de CAMPOS —
// un campo vacio en Sanity revienta el build en vez de dejar un carrusel mudo.
if (!d['headingBlog'] || !d['paragraphBlog']) throw new Error(`${slug}: falta headingBlog/paragraphBlog`);

// R15-IG: B[2] pega el `.cta-footer` a la apertura de `.social-media`, y el feed tiene que
// ir DELANTE del CTA. B[3] era el `</section>` suelto que lo cerraba; ya no se renderiza,
// porque la seccion se escribe entera abajo — el mismo marcado literal que usa la home.
const CTA_PIE = sinAperturaDelFeed(B[2], `/pool-builders/${slug} B[2]`);
// Y B[3] deja de renderizarse, asi que hay que AFIRMAR que no era mas que ese cierre: si la
// plantilla derivada le metiera contenido algun dia, se perderia sin un solo rojo.
if (B[3] !== '</section>') {
  throw new Error(`${slug}: B[3] ya no es el cierre suelto del feed, es ${JSON.stringify(B[3])}. `
    + 'Al dejar de renderizarlo se estaria tirando contenido — revisa scripts/build-plantillas.mjs.');
}

const { seo: SEO, ldCrudo: LD_CRUDO } = SEO_RUTAS[slug];
---
<Base titulo={d["seo.title"]} descripcion={d["seo.description"]} ruta={`/pool-builders/${slug}`} seo={SEO} jsonLdCrudo={LD_CRUDO}>
  <Fragment set:html={B[0]} />
  <ResenasGoogle />
  <Fragment set:html={B[1]} />
  <CarruselBlog titulo={d['headingBlog']} entradilla={d['paragraphBlog']} />
  <section class="social-media">
    <FeedInstagram />
  </section>
  <Fragment set:html={CTA_PIE} />
</Base>
