---
// LA HOME (ASTRO-4 lote A, lamina «Home»). Se edita A MANO y NO se regenera: `npm run paginas`
// no la toca. Hasta ASTRO-4 era el HTML de Webflow partido en nueve cadenas `S_*`.
//
// QUE CONSIGUE: que en la primera pantalla se lea quien es la empresa y se vea una obra suya, y
// que el resto de la pagina sea un recorrido por lo que hace —los 14 servicios a la vista, el 3D,
// obras, zonas, una reforma real, articulos, resenas— que acaba en el formulario (D-82).
//
// QUE CAMBIA DE COMPOSICION: el hero a sangre con el video detras del texto pasa a hero partido
// (texto sobre navy, obra al lado; D-38: 6/6), con el video solo desde 992 px y de 12 s; las
// pestanas de servicios pasan al indice de los 14 con su ficha (D-69); los carruseles de obras y
// de articulos, a lista editorial; las zonas, a dos columnas con su telefono y el mapa; el
// antes/despues vuelve a su par de produccion con deslizador, rotulado como visualizacion (D-194,
// que revoca D-96 y D-138 en la home); y la banda final se funde con el formulario. Salen la banda repetida a media
// pagina (D-83, T-50) y la seccion de Instagram (T-42).
//
// EL TEXTO NO SE TOCA: cada cadena de abajo es la del origen. Lo que entra y lo que cambia de
// sitio lo declara `check-texto.mjs` (T-89).
import path from 'node:path';
import sharp from 'sharp';
import Base from '../layouts/Base.astro';
import ServiciosIndice from '../components/widgets/ServiciosIndice.astro';
import ResenasGoogle from '../components/widgets/ResenasGoogle.astro';
import CarruselProyectos from '../components/widgets/CarruselProyectos.astro';
import CarruselBlog from '../components/widgets/CarruselBlog.astro';
import FormularioCore from '../components/widgets/FormularioCore.astro';
import TELEFONOS from '../data/telefonos.json';
import RESENAS from '../data/resenas.json';
import HEROES from '../data/heroes-ciudad.json';
import BANCO from '../data/banco-imagenes.json';
import { logoLigero, ALTO_LOGO } from '../lib/logo-ligero.mjs';
import { franjaLogos } from '../lib/logos-franja.mjs';

const telefonos = TELEFONOS.items;
const ACCION = 'Request a Design-Build Project Evaluation';
const FLECHA = '<svg aria-hidden="true" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"></path><path d="m13 6 6 6-6 6"></path></svg>';

/* Los dos videos son el atomo de Webflow tal cual: `videoFondo()` (Base.astro) le pone el poster
 * como imagen y deja el video sin `src` hasta que el cargador decide. El del hero es el corte de
 * 12 s (2,3 MB; el original de 26 s sigue en disco) y solo llega desde 992 px (`data-mm-min`). */
const VIDEO_HERO = "<div data-poster-url=\"/images/site/bg-video-1-poster.0000000.jpg\" data-video-urls=\"/videos/bg-video-1-12s.mp4,/videos/bg-video-1-12s.webm\" data-autoplay=\"true\" data-loop=\"true\" data-wf-ignore=\"true\" class=\"background-video w-background-video w-background-video-atom\"><video data-mm-min=\"992\" id=\"bf5925c7-6577-ba84-77a6-25f8d09f7390-video\" autoplay=\"\" loop=\"\" style=\"background-image:url(/images/site/bg-video-1-poster.0000000.jpg)\" muted=\"\" playsinline=\"\" data-wf-ignore=\"true\" data-object-fit=\"cover\"><source src=\"/videos/bg-video-1-12s.mp4\" data-wf-ignore=\"true\"><source src=\"/videos/bg-video-1-12s.webm\" data-wf-ignore=\"true\"></video><div aria-live=\"polite\"><button type=\"button\" data-w-bg-video-control=\"true\" aria-controls=\"bf5925c7-6577-ba84-77a6-25f8d09f7390-video\" class=\"w-backgroundvideo-backgroundvideoplaypausebutton w-background-video--control\"><span><img src=\"/images/site/pause.svg\" loading=\"lazy\" alt=\"Pause video\"></span><span hidden=\"\"><img loading=\"lazy\" alt=\"Play video\" src=\"/images/site/play-24.svg\"></span></button></div></div>";
const VIDEO_3D = "<div data-poster-url=\"/images/site/bg-video-3d-poster.0000000.jpg\" data-video-urls=\"/videos/bg-video-3d-mp4.mp4,/videos/bg-video-3d-webm.webm\" data-autoplay=\"true\" data-loop=\"true\" data-wf-ignore=\"true\" class=\"background-video-3d w-background-video w-background-video-atom\"><video id=\"530cbcaa-1f3f-21e1-a774-0f91a89c10ec-video\" autoplay=\"\" loop=\"\" style=\"background-image:url(/images/site/bg-video-3d-poster.0000000.jpg)\" muted=\"\" playsinline=\"\" data-wf-ignore=\"true\" data-object-fit=\"cover\"><source src=\"/videos/bg-video-3d-mp4.mp4\" data-wf-ignore=\"true\"><source src=\"/videos/bg-video-3d-webm.webm\" data-wf-ignore=\"true\"></video><div aria-live=\"polite\"><button type=\"button\" data-w-bg-video-control=\"true\" aria-controls=\"530cbcaa-1f3f-21e1-a774-0f91a89c10ec-video\" class=\"w-backgroundvideo-backgroundvideoplaypausebutton w-background-video--control\"><span><img src=\"/images/site/pause.svg\" loading=\"lazy\" alt=\"Pause video\"></span><span hidden=\"\"><img loading=\"lazy\" alt=\"Play video\" src=\"/images/site/play-24.svg\"></span></button></div></div>";

const SELLOS = [{"icono": "/images/site/icon-1-.svg", "texto": "Licensed & Insured"}, {"icono": "/images/site/icon-2.svg", "texto": "Financing Available"}, {"icono": "/images/site/icon-4.svg", "texto": "3D Design "}, {"icono": "/images/site/icon-3.svg", "texto": "North & South Florida"}];
const SRC_LOGOS = ["/images/logos/delta/delta-removebg-preview.png", "/images/logos/biggreen/bge-logo-lineup-removebg-preview.png", "/images/logos/alfresco/alfresco-logo-removebg-preview.png", "/images/logos/sunbrella/530-5307608-awning-vector-colorful-sunbrella-logo-transparent-hd-png-removebg-preview.png", "/images/logos/zodiac/zodiac-new.png", "/images/logos/sgm/sgm-pool-logo-e1585262761892.jpg", "/images/logos/npt/medium-tveat8emx4.png", "/images/logos/pelican-reef/logo-pelican-reef-800x800tiny.png", "/images/logos/jandy/jandy-logo.png", "/images/logos/irrigreen/irrigreen-logo-black-web.png", "/images/logos/milestone-p8m6r/image.png", "/images/logos/gemstone/gemstonelights-newlogo.png", "/images/logos/coyote/coyote-logo-glow.png", "/images/logos/alumawood/alumawood.png"];
const LOGOS = await Promise.all(SRC_LOGOS.map(async (src) => {
  const m = await sharp(path.join(process.cwd(), 'public', src)).metadata();
  const l = logoLigero(src, { w: m.width, h: m.height });
  return l.h === ALTO_LOGO ? l : { ...l, src };
}));

/* EL ANTES/DESPUES (D-194, decidido el 14-oct-2026). El par de produccion, que casa al pixel
 * porque el «antes» esta hecho a partir del «despues» (D-95): por eso va ROTULADO como lo que es,
 * `Visualization` / `Completed`, con una linea que lo dice, y el `alt` izquierdo empieza por
 * «Illustration:». No entra en ningun `ImageObject` ni en `/projects`. Deslizador: `.mm-desl` en
 * `sistema.css` y su guion en `Componentes.astro`. */
const AD_ANCHOS = [640, 960, 1280, 1600, 2000];
const adSrcset = (nombre: string) => AD_ANCHOS.map((w) => `/images/site/${nombre}-${w}.avif ${w}w`).join(', ');
const AD = {
  vis: { nombre: 'backyard-transformation-before-empty-lawn-concrete-patio', alt: 'Illustration: the backyard of a two-story house shown as an empty lawn with a small concrete patio.' },
  hecho: { nombre: 'backyard-transformation-after-louvered-pergola-pool-travertine-deck', alt: 'Completed backyard with a rectangular pool behind a safety fence, a dark louvered patio cover, a light paver deck and loungers.' },
};
const AD_SIZES = '(min-width: 1440px) 1312px, (min-width: 1200px) calc(100vw - 128px), (min-width: 768px) calc(100vw - 64px), calc(100vw - 48px)';

/* Las fotos de resenas y de la banda final salen de la bolsa de piscina nueva de
 * `heroes-ciudad.json` (obra real, terminada, con recorte 4:5 seguro). */
const deBolsa = (k: number) => {
  const e = (BANCO as any[]).find((x) => x.id === HEROES.bolsas['pool-builders'][k]);
  if (!e || e.procedencia !== 'obra_real' || !e.alt) throw new Error(`home: la foto ${k} de la bolsa no es obra real con alt`);
  return e;
};
const FOTO_RES = deBolsa(0);
const FOTO_CIERRE = deBolsa(1);

const SEO = {"meta":{},"jsonLd":[{"@context":"https://schema.org","@type":"Organization","address":{"@type":"PostalAddress","addressCountry":"US","addressRegion":"FL"},"areaServed":[{"@type":"State","name":"Florida"}],"description":"Florida licensed outdoor living contractors specializing in custom in-ground pool construction and luxury pool remodeling. We design and build high-end outdoor spaces for homeowners across North and South Florida.","logo":{"@type":"ImageObject","url":"/images/site/logo-mr-mr.svg"},"name":"Mr & Mrs Outdoor Living","url":"/"}]};
const LD_CRUDO = [];
/**
 * SEO-REMEDIACION (4-oct-2026) — LA HOME DEJA DE PUBLICAR UNA SEGUNDA ENTIDAD.
 * Webflow traia aqui un `Organization` sin `@id`, con `url` relativa, una `PostalAddress` a medias
 * (solo pais y estado) y el logo en el CDN de Webflow. `Base.astro` ya inyecta el negocio de
 * verdad (`#negocio`, un `LocalBusiness`, que es un `Organization`), asi que la home publicaba DOS
 * entidades para la misma empresa. Se sustituye por el `WebSite` del sitio, que es lo que le
 * faltaba a la home y que apunta a `#negocio` como editor. Declarado en `check-seo.mjs`
 * (`BLOQUES_SUSTITUIDOS`).
 */
const SEO_HOME = {
  ...SEO,
  jsonLd: SEO.jsonLd.map((b) => (b['@type'] === 'Organization' ? {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    '@id': 'https://www.mrandmrsoutdoorliving.com/#website',
    url: 'https://www.mrandmrsoutdoorliving.com/',
    name: 'Mr & Mrs Outdoor Living',
    description: b.description,
    inLanguage: 'en-US',
    publisher: { '@id': 'https://www.mrandmrsoutdoorliving.com/#negocio' },
  } : b)),
};
---
<Base titulo="Florida Pool Builders & Outdoor Living Design-Build Contractors" descripcion="Custom inground pool builders and outdoor living design-build contractors serving North & South Florida. Licensed, engineered, and turnkey construction." ruta="/" seo={SEO_HOME} jsonLdCrudo={LD_CRUDO}>
  <section class="mm-hero-b">
    <div class="mm-hero-b-caja">
      <div class="mm-hero-b-txt">
        <h1 class="mm-h1">Licensed Custom Pool Builders &amp; Outdoor Living Contractors in Florida</h1>
        <h2 class="mm-hero-a-sub">Custom Inground Pool Builders &amp; Outdoor Living Design-Build—Licensed, Engineered, and Turnkey Construction in Florida</h2>
        <div class="mm-hero-b-acc">
          <a class="mm-btn" href="#estimate">{ACCION}</a>
          <a class="mm-btn mm-btn--linea mm-btn--linea-inv" href="/gallery">Project Gallery</a>
        </div>
      </div>
      <figure class="mm-hero-b-medio"><Fragment set:html={VIDEO_HERO} /></figure>
    </div>
    <ul class="mm-hero-b-sellos" role="list">
      {SELLOS.map((x) => <li><img src={x.icono} alt="" width="24" height="24" loading="lazy" decoding="async" /><span>{x.texto}</span></li>)}
    </ul>
    {/* E7 (D-166): la franja de logos desfila. Marcado y duracion, en `logos-franja.mjs`. */}
    <Fragment set:html={franjaLogos("Trusted by Florida's finest homeowners", LOGOS)} />
  </section>

  <section class="svc-intro mm-intro mm-intro--home">
    <div class="mm-marco">
      <h2 class="mm-h2">Complete Outdoor Construction Services: <span class="mm-rot">Luxury Pools</span>, Pergolas, Kitchens &amp; Decks</h2>
      <p class="mm-p">At Mr &amp; Mrs Outdoor Living, we are Florida licensed outdoor living contractors specializing in custom in-ground pool construction &amp; luxury pool remodeling. We design &amp; build high-end backyard outdoor spaces with custom features for homeowners across North and South Florida, delivering craftsmanship, and quality. Our expertise and experience in inground swimming pools, combined with our commitment to outdoor living design build Florida, ensures that each project is executed with precision and attention to detail. We consider factors such as landscape integration, functionality, and aesthetic appeal, providing our clients with a seamless and elegant outdoor oasis that enhances their property's value and enjoyment.</p>
      <a class="mm-flecha" href="/about">More About Us<Fragment set:html={FLECHA} /></a>
    </div>
  </section>

  <ServiciosIndice />

  <section class="mm-3d">
    <div class="mm-sec-cab">
      <h2 class="mm-h2">3D Pool Design &amp; Visualization</h2>
      <div class="mm-sec-lado">
        <p class="mm-p">Advanced 3D pool design and visualization for custom pool construction and remodeling across North &amp; South Florida.</p>
        <div class="mm-sec-acc"><a class="mm-btn mm-btn--linea mm-btn--linea-inv" href="#estimate">{ACCION}</a></div>
      </div>
    </div>
    <figure class="mm-3d-medio"><Fragment set:html={VIDEO_3D} /></figure>
  </section>

  <CarruselProyectos />

  <section class="mm-zonas">
    <div class="mm-zonas-caja">
      <div class="mm-zonas-txt">
        <div class="mm-sec-tit"><h2 class="mm-etiqueta">Where We Serve</h2><p class="mm-h2">Regional <span class="mm-rot">Coverage</span> With National Vision</p></div>
        <div class="mm-zonas-lista">
          <article class="mm-zona">
            <h3 class="mm-zona-t">North Florida</h3>
            <p>Licensed luxury pool builders in North Florida specializing in custom inground pools and outdoor living design-build projects, engineered for structural integrity and long-term durability.</p>
            <div class="mm-datos">{telefonos.filter((t) => t.zona === 'North Florida').map((t) => <a class="mm-dato" href={`tel:${t.tel}`}><span class="mm-dato-rot">{t.zona}</span><span class="mm-dato-val">{t.visible}</span></a>)}</div>
            <a class="mm-flecha" href="/where-we-serve/north-florida">View North Florida Service Areas<Fragment set:html={FLECHA} /></a>
          </article>
          <article class="mm-zona">
            <h3 class="mm-zona-t">South Florida</h3>
            <p>Licensed luxury pool builders in South Florida specializing in custom inground pools and outdoor living design-build projects, engineered, permitted, and built for high-end residential properties.</p>
            <div class="mm-datos">{telefonos.filter((t) => t.zona === 'South Florida').map((t) => <a class="mm-dato" href={`tel:${t.tel}`}><span class="mm-dato-rot">{t.zona}</span><span class="mm-dato-val">{t.visible}</span></a>)}</div>
            <a class="mm-flecha" href="/where-we-serve/south-florida">View South Florida Service Areas<Fragment set:html={FLECHA} /></a>
          </article>
        </div>
      </div>
      <svg class="mm-mapa" viewBox="0 0 420 460" aria-hidden="true" focusable="false"><path d="M20 60 H250 L262 40 H330 L352 92 L372 150 L386 214 L392 280 L384 340 L360 392 L334 420 L318 404 L300 350 L270 300 L246 250 L226 196 L214 150 L196 118 L150 104 L96 110 L60 96 L20 92 Z" class="mm-plano-vaso"></path><path d="M212 200 L392 236" class="mm-plano-cota" stroke-dasharray="6 6"></path><circle cx="300" cy="130" r="5" class="mm-plano-punto"></circle><circle cx="348" cy="330" r="5" class="mm-plano-punto"></circle></svg>
    </div>
  </section>

  <section class="mm-ad">
    <div class="mm-sec-cab">
      <h2 class="mm-h2" id="mm-ad-titulo">Before &amp; After <span class="mm-rot">Transformations</span></h2>
      <div class="mm-sec-lado">
        <p class="mm-p">Most homeowners don't realize what their outdoor space is capable of until they see it transformed. From empty slabs to resort-style living — our licensed design-build team handles every detail, from permitting to final startup.</p>
        <div class="mm-sec-acc">
          <a class="mm-btn mm-btn--linea" href="/request-estimated">Get a Free Estimate</a>
          <a class="mm-flecha" href="/projects">View All Projects<Fragment set:html={FLECHA} /></a>
        </div>
      </div>
    </div>
    <div class="mm-desl" data-mm-desl style="--mm-desl: 50%">
      <figure class="mm-desl-marco">
        <img class="mm-desl-foto" src={`/images/site/${AD.hecho.nombre}-1280.avif`} srcset={adSrcset(AD.hecho.nombre)} sizes={AD_SIZES} alt={AD.hecho.alt} width="2000" height="1116" loading="lazy" decoding="async" />
        <img class="mm-desl-foto mm-desl-foto--vis" src={`/images/site/${AD.vis.nombre}-1280.avif`} srcset={adSrcset(AD.vis.nombre)} sizes={AD_SIZES} alt={AD.vis.alt} width="2000" height="1116" loading="lazy" decoding="async" />
        <span class="mm-ad-etq mm-ad-etq--antes">Visualization</span>
        <span class="mm-ad-etq mm-ad-etq--despues">Completed</span>
        <input class="mm-desl-rango" type="range" min="0" max="100" value="50" step="1" aria-labelledby="mm-ad-titulo" />
        <span class="mm-desl-costura" aria-hidden="true"><span class="mm-desl-tirador"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m9 6-6 6 6 6"></path><path d="m15 6 6 6-6 6"></path></svg></span></span>
      </figure>
      <p class="mm-desl-nota">Design visualization created from a completed Mr &amp; Mrs project.</p>
    </div>
    <div class="mm-ad-datos">
      <div><h3 class="mm-dato-rot">Design-Build Authority</h3><p>One team handles design, permits, engineering, and construction. No subcontractor surprises, no gaps in accountability.</p></div>
      <div><h3 class="mm-dato-rot">Licensed &amp; Engineered</h3><p>Florida licensed and insured professionals. Every project is built to code, built to last, and built to impress.</p></div>
    </div>
  </section>

  <CarruselBlog />

  <section class="mm-res">
    <div class="mm-sec-cab">
      <div class="mm-sec-tit"><p class="mm-etiqueta">TESTIMONIALS</p><h2 class="mm-h2">What Our <span class="mm-rot">Clients</span> Say About Mr &amp; Mrs Outdoor Living</h2></div>
      <div class="mm-sec-lado">
        <p class="mm-p">From North to South Florida, homeowners trust our Florida-licensed design-build team for exceptional custom pool construction, remodeling, pergolas, and outdoor living transformations.</p>
        <div class="mm-sec-acc">
          <a class="mm-btn mm-btn--linea" href="#estimate">{ACCION}</a>
          <a class="mm-flecha" href={RESENAS.enlacePerfil} target="_blank" rel="noopener noreferrer">See all reviews<Fragment set:html={FLECHA} /></a>
        </div>
      </div>
    </div>
    <div class="mm-res-cuerpo">
      <div class="mm-res-col">
        <ResenasGoogle />
        <div class="mm-datos mm-datos--tel">{telefonos.map((t) => <a class="mm-dato" href={`tel:${t.tel}`}><span class="mm-dato-rot">{t.zona}</span><span class="mm-dato-val">{t.visible}</span></a>)}</div>
      </div>
      <figure class="mm-res-medio"><img src={FOTO_RES.src} alt={FOTO_RES.alt} width={FOTO_RES.ancho} height={FOTO_RES.alto} loading="lazy" decoding="async" /></figure>
    </div>
  </section>

  <section class="mm-cierre">
    <div class="mm-cierre-caja">
      <div class="mm-cierre-txt">
        <h2 class="mm-h2">Request a <span class="mm-nb">Design-Build</span> Project Evaluation</h2>
        <p class="mm-p">Share your property details, project scope, and investment range. Our licensed design-build pool builders will review your request and confirm alignment before next steps.</p>
        <div class="mm-datos mm-datos--tel">{telefonos.map((t) => <a class="mm-dato" href={`tel:${t.tel}`}><span class="mm-dato-rot">{t.zona}</span><span class="mm-dato-val">{t.visible}</span></a>)}</div>
      </div>
      <figure class="mm-cierre-medio"><img src={FOTO_CIERRE.src} alt={FOTO_CIERRE.alt} width={FOTO_CIERRE.ancho} height={FOTO_CIERRE.alto} loading="lazy" decoding="async" /></figure>
    </div>
  </section>
  <FormularioCore ruta="/" />
</Base>
