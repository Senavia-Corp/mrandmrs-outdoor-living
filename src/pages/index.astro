ref=\"/services/steel-building-pole-barn-construction-in-north-south-florida\" class=\"button w-button\">See More</a></div></div></div></div></div></div><div data-service-id=\"lighting\" role=\"listitem\" class=\"cms-item-services js-service-item w-dyn-item\"><div data-service-id=\"lighting\" class=\"block-services service-link\"><div class=\"content-services\"><img src=\"/images/residentials/smart-soffit-led-lighting-installation-in-north-south-florida/artboard-12.svg\" loading=\"lazy\" alt=\"\" class=\"icon-services\"><h3 class=\"heading-services\">Smart Soffit LED Lighting</h3></div><div fs-cmsfilter-field=\"Categories\" class=\"filter-wrapper-categories w-dyn-list\"><div role=\"list\" class=\"filter-list-categories w-dyn-items\"><div role=\"listitem\" class=\"filter-item-categories w-dyn-item\"><div class=\"block-categories\"><div class=\"js-service-cat\">outdoor-living</div></div></div></div></div></div><div data-service-id=\"lighting\" class=\"block-services-info service-detail is-active\"><img alt=\"Smart soffit LED lighting installed by professional outdoor lighting contractors in Florida.\" loading=\"lazy\" src=\"/images/residentials/smart-soffit-led-lighting-installation-in-north-south-florida/smart-soffit-led-lighting-florida.avif\" class=\"image-bg-services\"><div class=\"wrapper-services\"><div class=\"block-info-services\"><div class=\"blck-glass\"></div><div class=\"block-text-service\"><div class=\"block-content-service\"><h4 class=\"heading-3\">Smart Soffit &amp; LED Lighting Installation</h4><div class=\"paragraph-mini\">Smart soffit and LED lighting installation company serving North &amp; South Florida, enhancing curb appeal and exterior security.</div></div><div class=\"block-buttom-services\"><a href=\"/services/smart-soffit-led-lighting-installation-in-north-south-florida\" class=\"button w-button\">See More</a></div></div></div></div></div></div></div></div></div></div><div class=\"w-embed w-script\"><style>\n\n/* TAB DE CATEGORÍA ACTIVO */\n.js-category-tab.is-active {\n  background: linear-gradient(180deg, #5acef8 0%, #0cace5 100%);\n  color: #ffffff;\n  border-color: transparent;\n}\n\n/* Asegura que el texto interno también sea blanco */\n.js-category-tab.is-active * {\n  color: #ffffff;\n}\n\n\n</style>\n\n\n\n<script>\n(() => {\n  // =========================\n  // CONFIG (selectores)\n  // =========================\n  const TAB_SEL = '.js-category-tab';\n  const LINK_SEL = '.service-link';\n  const DETAIL_SEL = '.service-detail';\n  const CAT_BADGE_SEL = '.js-service-cat';\n\n  const DEFAULT_CATEGORY_SLUG = 'outdoor-living'; // <- cambia si tu slug real es otro\n\n  // =========================\n  // Helpers\n  // =========================\n  const qs = (sel, root = document) => root.querySelector(sel);\n  const qsa = (sel, root = document) => Array.from(root.querySelectorAll(sel));\n\n  const normalize = (v) =>\n    (v || '')\n      .toString()\n      .trim()\n      .toLowerCase();\n\n  const isTabletDown = () => window.matchMedia('(max-width: 991px)').matches;\n\n  function getTabs() { return qsa(TAB_SEL); }\n  function getLinks() { return qsa(LINK_SEL); }\n  function getDetails() { return qsa(DETAIL_SEL); }\n\n  // Extrae categorías desde los badges dentro del link (por texto)\n  function getServiceCategories(linkEl) {\n    const badges = qsa(CAT_BADGE_SEL, linkEl);\n    return badges.map(b => normalize(b.textContent));\n  }\n\n  function hideAllDetails() {\n    getDetails().forEach(d => {\n      d.style.display = 'none';\n      d.classList.remove('is-active');\n    });\n    getLinks().forEach(l => l.classList.remove('is-active'));\n  }\n\n  function showServiceDetail(id) {\n    getDetails().forEach(d => {\n      const dId = d.getAttribute('data-service-id');\n      const match = dId === id;\n      d.style.display = match ? 'flex' : 'none';\n      d.classList.toggle('is-active', match);\n    });\n  }\n\n  function setActiveTab(tabEl) {\n    getTabs().forEach(t => t.classList.remove('is-active'));\n    if (tabEl) tabEl.classList.add('is-active');\n  }\n\n  // ✅ Filtra servicios y además muestra SOLO 1 tag (el de la categoría activa)\n  function filterServicesByCategory(categorySlug) {\n    const wanted = normalize(categorySlug);\n    const links = getLinks();\n\n    links.forEach(link => {\n      const cats = getServiceCategories(link);\n      const match = cats.includes(wanted);\n\n      // 1) Mostrar/ocultar servicio\n      link.style.display = match ? '' : 'none';\n\n      // 2) Mostrar SOLO la píldora que coincide con la categoría activa\n      const badges = qsa(CAT_BADGE_SEL, link);\n      badges.forEach(b => {\n        const isThis = normalize(b.textContent) === wanted;\n        b.style.display = (match && isThis) ? '' : 'none';\n      });\n    });\n  }\n\n  function openFirstVisibleService() {\n    if (isTabletDown()) return; // en mobile no abrimos por default (si quieres, quítalo)\n\n    const firstVisibleLink = getLinks().find(l => l.style.display !== 'none');\n    if (!firstVisibleLink) return;\n\n    const id = firstVisibleLink.getAttribute('data-service-id');\n    if (!id) return;\n\n    hideAllDetails();\n    firstVisibleLink.classList.add('is-active');\n    showServiceDetail(id);\n  }\n\n  function initDefaultCategory() {\n    const tabs = getTabs();\n    if (!tabs.length) return;\n\n    // busca tab por slug primero\n    let defaultTab = tabs.find(t => normalize(t.getAttribute('data-category-slug')) === normalize(DEFAULT_CATEGORY_SLUG));\n\n    // si no existe, usa el primero\n    if (!defaultTab) defaultTab = tabs[0];\n\n    const slug =\n      defaultTab.getAttribute('data-category-slug') ||\n      defaultTab.getAttribute('data-category-name') ||\n      defaultTab.textContent;\n\n    hideAllDetails();\n    setActiveTab(defaultTab);\n    filterServicesByCategory(slug);\n    openFirstVisibleService();\n  }\n\n  // =========================\n  // Click: Tabs (categorías)\n  // =========================\n  document.addEventListener('click', (e) => {\n    const tab = e.target.closest(TAB_SEL);\n    if (!tab) return;\n\n    e.preventDefault();\n\n    const slug =\n      tab.getAttribute('data-category-slug') ||\n      tab.getAttribute('data-category-name') ||\n      tab.textContent;\n\n    hideAllDetails();\n    setActiveTab(tab);\n    filterServicesByCategory(slug);\n    openFirstVisibleService();\n  });\n\n  // =========================\n  // Click: Servicios (lista izquierda)\n  // =========================\n  document.addEventListener('click', (e) => {\n    const link = e.target.closest(LINK_SEL);\n    if (!link) return;\n\n    // si está oculto por filtro, no hace nada\n    if (link.style.display === 'none') return;\n\n    e.preventDefault();\n\n    const id = link.getAttribute('data-service-id');\n    if (!id) return;\n\n    const links = getLinks();\n    const targetDetail = getDetails().find(d => d.getAttribute('data-service-id') === id);\n\n    const isActiveLink = link.classList.contains('is-active');\n    const detailIsVisible = targetDetail && targetDetail.style.display !== 'none';\n\n    // 📱 Tablet/Mobile: toggle\n    if (isTabletDown()) {\n      if (isActiveLink && detailIsVisible) {\n        hideAllDetails();\n        return;\n      }\n      hideAllDetails();\n      link.classList.add('is-active');\n      showServiceDetail(id);\n      return;\n    }\n\n    // 🖥️ Desktop: solo cambia, nunca cierra\n    links.forEach(l => l.classList.remove('is-active'));\n    link.classList.add('is-active');\n    showServiceDetail(id);\n  });\n\n  // =========================\n  // Re-init on resize (debounce)\n  // =========================\n  let rTimer = null;\n  window.addEventListener('resize', () => {\n    clearTimeout(rTimer);\n    rTimer = setTimeout(() => initDefaultCategory(), 150);\n  });\n\n  // =========================\n  // Re-init if Webflow re-renders\n  // =========================\n  const observer = new MutationObserver((mutations) => {\n    const shouldReinit = mutations.some(m =>\n      Array.from(m.addedNodes).some(n =>\n        n.nodeType === 1 && (\n          n.matches?.(TAB_SEL) || n.matches?.(LINK_SEL) || n.matches?.(DETAIL_SEL) ||\n          n.querySelector?.(TAB_SEL) || n.querySelector?.(LINK_SEL) || n.querySelector?.(DETAIL_SEL)\n        )\n      )\n    );\n    if (shouldReinit) initDefaultCategory();\n  });\n\n  document.addEventListener('DOMContentLoaded', () => {\n    setTimeout(() => {\n      initDefaultCategory();\n      observer.observe(document.body, { childList: true, subtree: true });\n    }, 50);\n  });\n})();\n</script></div></div></section><section class=\"before-after-section\"><div class=\"w-layout-blockcontainer container w-container\"><div class=\"before-after-content\"><div fb-before-after-start=\"50\" fb-before-after=\"true\" fb-before-after-direction=\"horizontal\" class=\"bas-wrapper\"><img alt=\"A spacious residential backyard featuring a green lawn, white picket fence, and tropical palm trees before a luxury renovation. Showcase of the initial stage for an outdoor living area project\" loading=\"lazy\" src=\"/images/site/modern-backyard-renovation-before-landscaping-project-1.avif\" class=\"bas-image-before\"><img fb-before-after-side=\"after\" alt=\"Stunning backyard transformation featuring a modern swimming pool, custom black aluminum pergola with wood slats, string lighting, and a luxury L-shaped outdoor sectional on ivory travertine pavers.\" src=\"/images/site/luxury-outdoor-living-design-pool-pergola-travertine-pavers-1.avif\" loading=\"lazy\" class=\"bas-image-after-h\"><div fb-before-after-handle=\"true\" class=\"bas-handle-h\"><div class=\"bas-icon-regular w-embed\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"25\" viewBox=\"0 0 24 25\" fill=\"none\">\n  <path d=\"M9.04304 6.29297L2.83594 12.5001L9.04304 18.7072L10.4573 17.293L5.66436 12.5001L10.4573 7.70718L9.04304 6.29297ZM14.957 18.7073L21.1641 12.5002L14.957 6.29312L13.5427 7.70733L18.3356 12.5002L13.5427 17.2931L14.957 18.7073Z\" f