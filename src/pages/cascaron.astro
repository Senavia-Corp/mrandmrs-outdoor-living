---
/**
 * Página de prueba de la Fase 4: solo cascarón, sin contenido. Sirve para medir el nav y el
 * pie contra el baseline sin que nada de la página se meta por medio.
 *
 * ⚠️ SE BORRA ANTES DE LA FASE 6, igual que vista-widgets: es una ruta que el origen no
 * tiene y `check:rutas` la va a cazar.
 */
import Base from '../layouts/Base.astro';
---
<Base titulo="Cascarón" ruta="/">
  <main style="min-height: 40vh; padding-top: calc(85px + 2rem)"></main>
</Base>
