---
// LABORATORIO R9-HERO paso 1 — NO ES UNA PAGINA DEL SITIO.
// Generado desde la constante S_HERO de index.astro, para que el texto sea identico
// por construccion y no por cuidado. Se renombra a _lab-heroe.astro al terminar de
// capturar: con guion bajo Astro NO la enruta (verificado: 404 tambien en dev), asi que
// no puede aparecer en check:rutas.
//
// PARA VOLVER A VERLA:  mv src/pages/_lab-heroe.astro src/pages/lab-heroe.astro
//                       npx astro dev --port 4326   ->  http://localhost:4326/lab-heroe
//                       y RENOMBRALA DE VUELTA al terminar: mientras esté sin guion bajo
//                       es una ruta 116 y check:rutas (115/115, 0 extras) se pone en ROJO.
//
// Los cuatro heroes van SIN data-w-id a proposito: cuatro copias del mismo id harian
// que Interacciones.astro animase las cuatro a la vez. En index.astro el data-w-id se
// queda donde esta y viaja con el elemento (check:ix2, HUERFANAS_ESPERADAS = 14).
import Base from '../layouts/Base.astro';
---
<Base titulo="LAB R9-HERO" descripcion="laboratorio, no es una pagina del sitio" conPie={false}>
<style is:global>
/* ══ ANDAMIO DEL LABORATORIO — esto NO viaja a home.css ═══════════════════════
   .lab-marco lleva z-index:0 a proposito: crea contexto de apilamiento y retiene
   el <video z-index:-100> dentro de su copia. Sin el, los cuatro videos se escapan
   al contexto raiz y se pintan unos sobre otros. Reproduce el apilamiento real:
   el video pinta en el paso 2 y el fondo de la seccion en el 6, o sea encima.    */
.lab-rotulo{position:sticky;top:0;z-index:9;background-color:var(--mm-navy);color:var(--mm-blanco);
  font:600 13px/1 var(--mm-fuente);letter-spacing:.08em;padding:10px 16px}
.lab-marco{position:relative;z-index:0}

/* ══ COMUN A LAS TRES VARIANTES ═══════════════════════════════════════════════
   Todo cuelga de .mm-hero, que solo existe en la home. Sin ese ancla,
   .button-styles pinta 59 ficheros de pagina y .heading-hero 23.
   Y ojo: .mm-hero .x es 0-2-0 y las reglas de Webflow son 0-1-0, asi que estas
   ganan tambien DENTRO de sus max-width:991/767/479. Toda propiedad que se toca
   aqui hay que volver a declararla en los cuatro anchos.                        */

/* Punto 5 — el text-shadow de 991/479 era el parche del scrim que no protegia.
   Con velo de verdad, sobra.  Punto 6 — fuera la regla de oro de 1100 px. */
.mm-hero .subheading-hero{text-shadow:none}
.mm-hero .heading-hero{border-bottom-width:0;padding-bottom:0;text-wrap:balance}

/* Punto 7 — la jerarquia se resuelve por MEDIDA, no por tamano: el titular mide
   1100 px y el subtitulo 950, el 86 %. Bajarlo a --mm-medida (650) lo convierte
   en pie de titular. La h1 no se toca: ya es de 60 px. */
.mm-hero .subheading-hero{max-width:var(--mm-medida);margin-inline:auto}

/* Punto 2 — el aire se reparte en tres zonas en vez de acumularse arriba y abajo */
.mm-hero .text-divider-hero{margin-bottom:var(--mm-e-32)}
.mm-hero .wrapper-buttons-center{margin-top:var(--mm-e-32)}

/* Punto 1 — el CTA medía 181x38,4 px: el 0,53 % del heroe.
   navy sobre el degradado de oro = 8,40:1 en #f4b248 y 6,35:1 en #d99933, y es
   OPACO: el unico elemento del heroe legible en cualquier fotograma. */
.mm-hero .wrapper-buttons-center .button-styles{display:inline-flex;align-items:center;
  justify-content:center;min-height:var(--mm-e-48);padding:var(--mm-e-12) var(--mm-e-32);
  font-size:var(--mm-paso-3);font-weight:var(--mm-peso-fuerte);line-height:var(--mm-alto-cuerpo);
  border-radius:var(--mm-r-8);box-shadow:var(--mm-sombra-2)}
.mm-hero .wrapper-buttons-center .button-styles:focus-visible{
  outline:var(--mm-foco-grosor) solid var(--mm-foco-inverso);outline-offset:var(--mm-foco-aire)}

/* Punto 3 — las bullets bajaban a 7 px a 479. El contraste ya estaba bien
   (navy sobre blanco al 70 % = 7,96:1 sobre el peor pixel oscuro); lo roto era
   el tamano. --mm-paso-1 = 14 px a 479 y 16 a 992+. */
.mm-hero .heading-mini-hero{font-size:var(--mm-paso-1);line-height:var(--mm-alto-cuerpo)}
.mm-hero .icon-hero{width:var(--mm-e-16);height:var(--mm-e-16)}
.mm-hero .block-icon-hero{padding:var(--mm-e-4)}
.mm-hero .block-value-bullets{padding:var(--mm-e-8) var(--mm-e-12);border-radius:var(--mm-r-pastilla)}
.mm-hero .text-divider-hero{grid-column-gap:var(--mm-e-8);grid-row-gap:var(--mm-e-8)}

@media (min-width:992px){
  .mm-hero .wrapper-buttons-center .button-styles{
    min-height:calc(var(--mm-e-48) + var(--mm-e-8));padding-inline:var(--mm-e-48)}
  .mm-hero .text-divider-hero{margin-bottom:var(--mm-e-48)}
  .mm-hero .wrapper-buttons-center{margin-top:var(--mm-e-48)}
}

/* ══ A · CIMIENTO ═════════════════════════════════════════════════════════════
   El velo nace del BORDE INFERIOR y tiene LINEA DE AGUA: un borde definido entre
   24 % y 31 % de alto, no un desvanecido. Es el detalle que dice "piscina" a
   quien entiende de piscinas, y a la vez es lo que permite poner el 74 % de navy
   solo donde esta el texto en vez de untar un 40 % por todo.
   El texto vive entre 0,277 y 0,723 de la seccion (medido), o sea por debajo de
   la linea: navy >=74 % sobre el peor pixel medido (255) = 6,97:1.
   Las bullets caen justo sobre la linea y se vuelven blancas: navy encima 15,60:1. */
.mm-v-a{background-image:linear-gradient(to bottom,
  color-mix(in srgb,var(--mm-navy) 12%,transparent) 0%,
  color-mix(in srgb,var(--mm-navy) 14%,transparent) 27%,
  color-mix(in srgb,var(--mm-navy) 74%,transparent) 30%,
  color-mix(in srgb,var(--mm-navy) 80%,transparent) 100%)}
.mm-v-a .block-value-bullets{background-color:var(--mm-blanco)}

/* ══ B · VELO ═════════════════════════════════════════════════════════════════
   El velo nace del PROPIO TEXTO: una elipse centrada en el bloque. El video
   queda limpio en las cuatro esquinas (14 %). El texto vive dentro del nucleo:
   navy >=70 % sobre 255 = 6,17:1.
   Las bullets se integran en el velo con superficie navy propia y tinta blanca:
   blanco sobre navy al 66 % = 5,41:1 en el peor caso, y mejor dentro de la elipse. */
.mm-v-b{background-image:radial-gradient(115% 72% at 50% 50%,
  color-mix(in srgb,var(--mm-navy) 78%,transparent) 0%,
  color-mix(in srgb,var(--mm-navy) 70%,transparent) 40%,
  color-mix(in srgb,var(--mm-navy) 30%,transparent) 76%,
  color-mix(in srgb,var(--mm-navy) 14%,transparent) 100%)}
.mm-v-b .block-value-bullets{background-color:color-mix(in srgb,var(--mm-navy) 66%,transparent);
  color:var(--mm-blanco);border:1px solid color-mix(in srgb,var(--mm-blanco) 28%,transparent)}
.mm-v-b .block-icon-hero{background-color:color-mix(in srgb,var(--mm-blanco) 16%,transparent)}

/* ══ C · PLACA ════════════════════════════════════════════════════════════════
   No inventa nada: ENCIENDE .bg-cover, la placa de cristal que la base de Webflow
   ya trae escrita y apagada con display:none — el "glass" que da nombre a la
   seccion. Se retine de navy porque el blanco al 25 % de fabrica EMPEORA el
   contraste. Fuera de la placa el video va casi limpio (20-28 %).
   Composicion: 255 -> navy 20 % -> navy 68 %; blanco encima = 6,96:1.
   Las bullets pierden su pastilla y se vuelven una fila con divisores: la
   superficie la pone la placa, no cada una. */
.mm-v-c{background-image:linear-gradient(
  color-mix(in srgb,var(--mm-navy) 20%,transparent),
  color-mix(in srgb,var(--mm-navy) 28%,transparent))}
.mm-v-c .wrapper-main-hero{padding-inline:var(--mm-e-24)}
.mm-v-c .bg-cover{display:block;inset-block:calc(var(--mm-e-24) * -1);inset-inline:0;
  background-color:color-mix(in srgb,var(--mm-navy) 68%,transparent);
  border:1px solid color-mix(in srgb,var(--mm-blanco) 20%,transparent);
  border-radius:var(--mm-r-24)}
.mm-v-c .block-value-bullets{background-color:transparent;color:var(--mm-blanco);
  border-radius:0;padding-inline:var(--mm-e-16)}
.mm-v-c .block-icon-hero{background-color:color-mix(in srgb,var(--mm-blanco) 16%,transparent)}

/* La placa NO se saca hacia fuera con inset negativo: se le da padding al texto y
   la placa se queda en su caja natural. Dos fallos medidos que esto evita:
     -32 px lateral a 479 -> innerWidth 495 en viewport de 479 (scroll horizontal
     en la banda 480-767, que ninguna puerta fotografia)
     -32 px lateral a 992 -> la placa quedaba de 0 a 992, a ras del viewport, sin
     margen y con los bordes contra el canto, justo en un ancho que SI se fotografia
   Va al final porque la regla base tiene la misma especificidad (0-2-0) y esta mas
   arriba: un @media colocado antes quedaria MUERTO. */
@media (min-width:992px){
  .mm-v-c .wrapper-main-hero{padding-inline:var(--mm-e-48)}
  /* El divisor es un recurso de UNA fila. A <=991 las bullets envuelven
     (.text-divider-hero{flex-flow:wrap} de Webflow a 479) y el `+` dejaba un
     divisor a la IZQUIERDA del primer chip de la segunda fila. Medido en captura. */
  .mm-v-c .block-value-bullets + .block-value-bullets{
    border-left:1px solid color-mix(in srgb,var(--mm-blanco) 24%,transparent)}
}

</style>
<div class="lab-rotulo"><span>0 · HOY (control, sin tocar)</span></div>
