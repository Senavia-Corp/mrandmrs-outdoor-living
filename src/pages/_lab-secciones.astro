/**
 * PRUEBA FORZADA que pide CRITERIO.md:122: se le anade UNA linea al parrafo de UNA sola
 * tarjeta. Si las dos siguen midiendo lo mismo y sus dos CTA comparten base, la igualdad es
 * estructural y no una casualidad de que los dos textos midan parecido.
 * Solo vive en este banco: el texto del sitio no se toca.
 */
const S_UBICACION_FORZADA = S_UBICACION.replace(
  'high-end residential properties.',
  'high-end residential properties. Esta linea existe solo en el banco de pruebas para forzar el desequilibrio de altura y comprobar que las dos tarjetas siguen midiendo lo mismo.'
);
if (S_UBICACION_FORZADA === S_UBICACION) throw new Error('la prueba forzada no engancho: revisa la subcadena');

const DEMO = {
  usuario: 'mrandmrsoutdoorliving',
  fuente: 'https://www.instagram.com/mrandmrsoutdoorliving/',
  items: ITEMS_DEMO,
};

---
<Base titulo="Banco R10-SEC · PULIDOR-2" ruta="/" conPie={false}>
  <main class="lab">
    <div class="lab__cab">
      <h1>Banco R10-SEC</h1>
      <p>Dos variantes por seccion, sobre el markup real. Elige una por encargo.</p>
    </div>

    <div class="lab__caso"><p class="lab__etq"><b>R10-3D · A</b> Marco — centrada, sobre blanco</p>
      <div class="lab--a"><Fragment set:html={S_3D} /></div></div>
    <div class="lab__caso"><p class="lab__etq"><b>R10-3D · B</b> Rail — ELEGIDA, sale de render3d.css</p>
      <div class="lab--b"><Fragment set:html={S_3D} /></div></div>

    <div class="lab__caso"><p class="lab__etq"><b>R10-UBI · A</b> Placa — tarjetas a sangre</p>
      <div class="lab--a"><Fragment set:html={S_UBICACION} /></div></div>
    <div class="lab__caso"><p class="lab__etq"><b>R10-UBI · B</b> Cobertura — ELEGIDA, sale de ubicacion.css</p>
      <div class="lab--b"><Fragment set:html={S_UBICACION} /></div></div>
    <div class="lab__caso"><p class="lab__etq"><b>R10-UBI · prueba forzada</b> una linea de mas en UNA tarjeta (variante B)</p>
      <div class="lab--b"><Fragment set:html={S_UBICACION_FORZADA} /></div></div>

    <div class="lab__caso"><p class="lab__etq"><b>R10-SOC · A</b> Hoja de contactos — 6 / 6 / 3 / 2 columnas</p>
      <div class="lab--a"><section class="social-media"><FeedInstagram datosDemo={DEMO} /></section></div></div>
    <div class="lab__caso"><p class="lab__etq"><b>R10-SOC · B</b> Escaparate — ELEGIDA, sale de social.css</p>
      <div class="lab--b"><section class="social-media"><FeedInstagram datosDemo={DEMO} /></section></div></div>
    <div class="lab__caso"><p class="lab__etq"><b>R10-SOC · guarda de vacio</b> con items:[] no se pinta nada y la seccion no ocupa</p>
      <div class="lab--a"><section class="social-media"><FeedInstagram datosDemo={{ ...DEMO, items: [] }} /></section></div></div>
  </main>
</Base>

<style is:global>
  /* ══ CROMO DEL BANCO — no forma parte de ninguna variante ═══════════════════════════ */
  .lab { padding-top: calc(85px + var(--mm-e-16)); }
  .lab__cab { max-width: var(--mm-ancho); margin-inline: auto; padding: var(--mm-e-24) var(--mm-canal); }
  .lab__cab h1 { font-size: var(--mm-paso-5); line-height: var(--mm-alto-apretado); color: var(--mm-tinta); margin: 0 0 var(--mm-e-8); }
  .lab__cab p  { font-size: var(--mm-paso-2); color: var(--mm-tinta-atenuada); margin: 0; max-width: var(--mm-medida); }
  .lab__caso { border-top: var(--mm-foco-grosor) solid var(--mm-borde); }
  .lab__etq {
    position: sticky; top: 85px; z-index: 40; margin: 0;
    padding: var(--mm-e-8) var(--mm-canal);
    background-color: var(--mm-fondo-navy); color: var(--mm-tinta-inversa-2);
    font-family: var(--mm-fuente); font-size: var(--mm-paso-0); font-weight: var(--mm-peso-normal);
  }
  .lab__etq b { color: var(--mm-tinta-inversa); font-weight: var(--mm-peso-negro); margin-right: var(--mm-e-8); }

  /* ══════════════════════════════════════════════════════════════════════════════════════
   * `.lab--b` NO LLEVA NI UNA REGLA AQUI. Es lo que emiten `render3d.css`, `ubicacion.css` y
   * `social.css`, tal cual, a especificidad de PRODUCCION. Asi el banco no puede aprobar algo
   * que en las 115 rutas no gana la cascada — que es el fallo que este repo lleva contando
   * siete veces con otro nombre.
   *
   * `.lab--a` son los DELTAS que devuelven la variante descartada, para poder compararlas.
   * Suben una clase de especificidad, y por eso la A vive aqui y no al reves.
   * ═══════════════════════════════════════════════════════════════════════════════════ */

  /* ── R10-3D · A «Marco» — centrada, video contenido, sombra media ── */
  .lab--a ._3d-section,
  .lab--a ._3d-section .wrapper-video { text-align: center; }
  .lab--a ._3d-section .header-3d-section { max-width: var(--mm-medida); margin-inline: auto; }
  .lab--a ._3d-section .block-video { margin-top: var(--mm-e-32); box-shadow: var(--mm-sombra-2); }

  /* ── R10-UBI · A «Placa» — las tarjetas a sangre, sin radio ──
     El canal se lo pone la propia tarjeta: su padding izquierdo vale lo mismo que el margen
     del contenedor, asi que el TEXTO de la primera tarjeta cae en la misma x que el titular.
     Lectura amplia de CRITERIO.md:110; la B alinea en cambio el BORDE de la tarjeta. */
  .lab--a .location .cms-country { max-width: none; margin-inline: 0; padding-inline: 0; }
  .lab--a .location .item-country {
    border-radius: 0;
    padding-inline: calc(max(0px, (100vw - var(--mm-ancho)) / 2) + var(--mm-canal));
  }

  /* ── R10-SOC · A «Hoja de contactos» — densa: 6 columnas, hueco 8, radio 8 ── */
  .lab--a section.social-media .mm-ig .mm-ig__rejilla { gap: var(--mm-e-8); }
  .lab--a section.social-media .mm-ig .mm-ig__rejilla .mm-ig__celda a[href] { border-radius: var(--mm-r-8); }
  @media (min-width: 768px) { .lab--a section.social-media .mm-ig .mm-ig__rejilla { grid-template-columns: repeat(6, 1fr); } }
</style><img data-wf-bgvideo-fallback-img=\"true\" src=\"/images/site/bg-video-3d-poster.0000000.jpg\" alt=\"\"></noscript><div aria-live=\"polite\"><button type=\"button\" data-w-bg-video-control=\"true\" aria-controls=\"530cbcaa-1f3f-21e1-a774-0f91a89c10ec-video\" class=\"w-backgroundvideo-backgroundvideoplaypausebutton w-background-video--control\"><span><img src=\"/images/site/pause.svg\" loading=\"lazy\" alt=\"Pause video\"></span><span hidden=\"\"><img loading=\"lazy\" alt=\"Play video\" src=\"/images/site/play-24.svg\"></span></button></div></div></div></div></div></section>";
const S_UBICACION = "<section class=\"location\"><div class=\"w-layout-blockcontainer container w-container\"><div data-w-id=\"dfdd7317-58e7-27b3-99a6-2c20a5e8a7be\" class=\"header-location\"><h2>Where We Serve</h2><p>Regional Coverage With National Vision</p></div></div><div class=\"cms-country w-dyn-list\"><div role=\"list\" class=\"cms-list-country w-dyn-items\"><div role=\"listitem\" class=\"item-country w-dyn-item\"><img src=\"/images/where-we-serves/custom-pool-builders-south-florida/custom-inground-pool-builders-remodeling-florida.avif\" loading=\"lazy\" alt=\"Aerial drone view of a luxury custom pool and outdoor living project in South Florida, showcasing modern pool design by expert custom pool builders.\" class=\"full-image-background\"><div data-w-id=\"dfdd7317-58e7-27b3-99a6-2c20a5e8a7c8\" class=\"block-info-country\"><h3 class=\"white\">South Florida</h3><p>Licensed luxury pool builders in South Florida specializing in custom inground pools and outdoor living design-build projects, engineered, permitted, and built for high-end residential properties.</p><a href=\"/where-we-serves/custom-pool-builders-south-florida\" class=\"button button-styles w-button\">View South Florida Service Areas</a></div></div><div role=\"listitem\" class=\"item-country w-dyn-item\"><img src=\"/images/where-we-serves/custom-pool-builders-north-florida/service-areas-north-south-florida-pools.avif\" loading=\"lazy\" alt=\"Service areas map showing North Florida coverage for luxury custom pool builders and outdoor living services.\" class=\"full-image-background\"><div data-w-id=\"dfdd7317-58e7-27b3-99a6-2c20a5e8a7c8\" class=\"block-info-country\"><h3 class=\"white\">North Florida</h3><p>Licensed luxury pool builders in North Florida specializing in custom inground pools and outdoor living design-build projects, engineered for structural integrity and long-term durability.</p><a href=\"/where-we-serves/custom-pool-builders-north-florida\" class=\"button button-styles w-button\">Vi