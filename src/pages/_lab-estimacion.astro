/* ══════════════════════════════════════════════════════════════════════════════
 * _lab-estimacion.astro — BANCO DE PRUEBAS del encargo R12-EST. NO SE DESPLIEGA.
 *
 * El guion bajo hace que Astro NO la enrute: no genera HTML, no entra en el sitemap
 * y no la ve ninguna puerta de rutas.
 *
 * NO LLEVA CSS PROPIO. Todo lo que se ve sale de `src/styles/estimacion.css`, que
 * `Base.astro` ya importa: asi el banco no puede derivar respecto a la hoja de
 * produccion. Aqui solo vive el cromo del laboratorio (la barra de pasos), que va
 * con prefijo `lab-` y no toca ni una clase del formulario.
 *
 * PARA QUE SIRVE: recorrer los 3 pasos, el mensaje de exito y el de fallo sin tener
 * que rellenar el formulario, y —lo importante— PINTAR EL WIDGET DE TURNSTILE de
 * mentira. En local el de verdad no pinta (no estamos en el dominio registrado), que
 * es justo por lo que esta pagina esta en DISTINTAS_A_PROPOSITO, y por lo que su
 * defecto mas caro no lo ensena ninguna captura: con el widget puesto y
 * `.wrapper-buttons-center` en fila, el BOTON DE ENVIO se sale de la pantalla en
 * movil (borde derecho en 485 px sobre un viewport de 479; en 375 px, 433).
 *
 * EL MARKUP ES EL REAL, extraido de `request-estimated.astro` sin retecleado: mismo
 * texto, mismas clases, mismos `data-step`, mismo honeypot `ref_id`.
 *
 * El JS de aqui reproduce `showStep()` (estilo `display` EN LINEA sobre pasos y
 * botones), porque el carril de progreso de `estimacion.css` depende exactamente de
 * eso. No es el JS de produccion.
 * ════════════════════════════════════════════════════════════════════════════ */
import Base from '../layouts/Base.astro';

const FORM = "<section class=\"appointment-section\"><div class=\"w-container\"><div data-w-id=\"d01628ed-7f34-9b3f-2b4a-9f22c92ec16a\" class=\"header-form-block\"><h1><strong>Request Your Custom Outdoor Living Estimate</strong></h1><div>Tell us about your project and budget. Our licensed outdoor living team will review your request and contact you shortly.</div></div><div data-w-id=\"69e4df55-86c1-a89d-281e-f454cb25cb86\" class=\"block-form\"><div class=\"main-form-block w-form\"><form id=\"wf-form-Request-Quote-Form\" name=\"wf-form-Request-Quote-Form\" data-name=\"Request Quote Form\" method=\"post\" data-wf-page-id=\"69716d1b9825d78efed19041\" data-wf-element-id=\"a0265b5a-3dcd-f95b-4d90-eb5bbbfcaa57\" data-turnstile-sitekey=\"0x4AAAAAAAQTptj2So4dx43e\" action=\"/api/formulario\" data-mm-envia=\"1\"><div id=\"msf\" class=\"step-wrapper\"><div data-step=\"1\" class=\"msf-step\"><div class=\"header-form\"><h2>Select Services &amp; Estimate Your Project Budget</h2><div>Choosing services and budget helps our design team create a solution aligned with your goals, space, and investment.</div></div><div class=\"bugget-form\"><div class=\"text-block-6\">Estimated Project Budget:</div><select id=\"Estimated-Project-Budget\" name=\"Estimated-Project-Budget\" data-name=\"Estimated Project Budget\" data-required=\"true\" class=\"select-field w-select\"><option value=\"\">Select one...</option><option value=\"Under $25,000\">Under $25,000</option><option value=\"$25,000 \u2013 $50,000\">$25,000 \u2013 $50,000</option><option value=\"$50,000 \u2013 $75,000\">$50,000 \u2013 $75,000</option><option value=\"$75,000 \u2013 $100,000\">$75,000 \u2013 $100,000</option><option value=\"$100,000 \u2013 $150,000\">$100,000 \u2013 $150,000</option><option value=\"$150,000+\">$150,000+</option></select></div><div class=\"services-form\"><label class=\"w-checkbox\"><input type=\"checkbox\" id=\"checkbox\" name=\"checkbox\" data-name=\"Checkbox\" class=\"w-checkbox-input\"><span class=\"w-f