 class=\"w-checkbox\"><input type=\"checkbox\" id=\"checkbox\" name=\"checkbox\" data-name=\"Checkbox\" class=\"w-checkbox-input\"><span class=\"w-form-label\" for=\"checkbox\"><strong>Custom Decks</strong></span></label><label class=\"w-checkbox\"><input type=\"checkbox\" id=\"checkbox\" name=\"checkbox\" data-name=\"Checkbox\" class=\"w-checkbox-input\"><span class=\"w-form-label\" for=\"checkbox\"><strong>Patio Screen Rooms</strong></span></label><label class=\"w-checkbox\"><input type=\"checkbox\" id=\"checkbox\" name=\"checkbox\" data-name=\"Checkbox\" class=\"w-checkbox-input\"><span class=\"w-form-label\" for=\"checkbox\"><strong>Retractable Screens</strong></span></label><label class=\"w-checkbox\"><input type=\"checkbox\" id=\"checkbox\" name=\"checkbox\" data-name=\"Checkbox\" class=\"w-checkbox-input\"><span class=\"w-form-label\" for=\"checkbox\"><strong>Outdoor Kitchens</strong></span></label><label class=\"w-checkbox\"><input type=\"checkbox\" id=\"checkbox\" name=\"checkbox\" data-name=\"Checkbox\" class=\"w-checkbox-input\"><span class=\"w-form-label\" for=\"checkbox\"><strong>Outdoor Furniture</strong></span></label></div></div><div data-step=\"2\" class=\"msf-step\"><div class=\"header-form\"><h2>Project Property Address</h2><div>Enter the address where the project will take place so we can confirm service availability and prepare an accurate estimate.</div></div><input data-required=\"true\" class=\"text-field-form w-input\" maxlength=\"256\" name=\"Street-Address\" data-name=\"Street Address\" placeholder=\"Enter the street address\" type=\"text\" id=\"Street-Address\"><input data-required=\"true\" class=\"text-field-form w-input\" maxlength=\"256\" name=\"City\" data-name=\"City\" placeholder=\"Enter the city\" type=\"text\" id=\"City\"><input class=\"text-field-form w-input\" maxlength=\"256\" name=\"State\" data-name=\"State\" placeholder=\"Enter the state\" type=\"text\" id=\"State\"><input data-required=\"true\" class=\"text-field-form w-input\" maxlength=\"256\" name=\"ZIP-Code\" data-name=\"ZIP Code\" placeholder=\"Enter ZIP code\" type=\"text\" id=\"ZIP-Code\"></div><div data-step=\"3\" class=\"msf-step\"><div class=\"header-form\"><h2>Contact Information</h2><div>Provide your contact details so our design team can review your request and guide you through the next steps.</div></div><input data-required=\"true\" class=\"text-field-form w-input\" maxlength=\"256\" name=\"Full-Name\" data-name=\"Full Name\" placeholder=\"Enter your full name\" type=\"text\" id=\"Full-Name\"><input data-required=\"true\" class=\"text-field-form w-input\" maxlength=\"256\" name=\"email\" data-name=\"Email\" placeholder=\"Enter your email\" type=\"email\" id=\"email\" data-type=\"email\"><input data-required=\"true\" class=\"text-field-form w-input\" maxlength=\"256\" name=\"Phone\" data-name=\"Phone\" placeholder=\"Enter your phone\" type=\"tel\" id=\"Phone\" data-type=\"phone\"><label class=\"w-checkbox checkbox-field\"><input type=\"checkbox\" id=\"Checkbox\" name=\"Checkbox\" data-name=\"Checkbox\" required=\"\" class=\"w-checkbox-input\"><span class=\"checkbox-label-3 w-form-label\" for=\"Checkbox\">I agree to receive SMS messages related to project updates, promotions, and company communications from Mr. &amp; Mrs. Outdoor Living. I understand that I may opt out at any time by replying STOP. Message and data rates may apply.</span></label><div class=\"wrapper-buttons-center\"><input type=\"submit\" data-wait=\"Please wait...\" id=\"msf-submit\" class=\"button w-button\" value=\"Request My Estimate\"></div><div class=\"text-block-7\">By submitting this form, you agree to our <a href=\"https://mrandmrsoutdoorsliving.com/terms-of-service\" target=\"_blank\" class=\"link-4\">Terms</a> &amp; <a href=\"https://mrandmrsoutdoorsliving.com/privacy-policy-page\" target=\"_blank\" class=\"link-4\">Privacy Policy.</a></div></div><div class=\"msf-buttons\"><a id=\"msf-back\" href=\"#\" class=\"msf-back w-button\">Back</a><a id=\"msf-next\" href=\"#\" class=\"msf-next w-button\">Next</a></div></div><input type=\"text\" name=\"ref_id\" tabindex=\"-1\" autocomplete=\"off\" aria-hidden=\"true\" style=\"position:absolute;left:-9999px;width:1px;height:1px;opacity:0\"></form><div class=\"success-message-form w-form-done\"><div><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"110\" height=\"110\" fill=\"none\" viewBox=\"0 0 18 20\" app=\"ikonik\" class=\"ikonik-t882o\"><path fill=\"currentColor\" d=\"m17.351 3.063-8-3a1.009 1.009 0 0 0-.7 0l-8 3A1 1 0 0 0 0 4a19.394 19.394 0 0 0 8.47 15.848 1 1 0 0 0 1.06 0A19.394 19.394 0 0 0 18 4a1 1 0 0 0-.649-.937Zm-3.644 4.644-5 5A1 1 0 0 1 8 13c-.033 0-.065 0-.1-.005a1.001 1.001 0 0 1-.733-.44l-2-3a1 1 0 0 1 1.664-1.11l1.323 1.986 4.138-4.138a1 1 0 0 1 1.414 1.414h.001Z\" app=\"ikonik\" class=\"path-m3hdu\"></path></svg></div><h2><strong>Thank you! Your request has been successfully received.</strong></h2><div>Our team is reviewing your project details and will contact you shortly with next steps and recommendations.</div><div class=\"wrapper-buttons-center\"><a href=\"/\" class=\"button w-button\">Go to the main page</a></div></div><div class=\"w-form-fail\"><div>Oops! Something went wrong while submitting the form.</div></div></div></div></div></section>";
---
<Base titulo="LAB R12-EST — banco del formulario de presupuesto" ruta="/_lab-estimacion">

  <div class="lab-barra">
    <strong>LAB R12-EST</strong>
    <button type="button" data-lab-paso="1">Paso 1</button>
    <button type="button" data-lab-paso="2">Paso 2</button>
    <button type="button" data-lab-paso="3">Paso 3</button>
    <button type="button" data-lab-exito>Exito</button>
    <button type="button" data-lab-fallo>Fallo</button>
    <button type="button" data-lab-captcha>Captcha de mentira</button>
  </div>

  <Fragment set:html={FORM} />

</Base>

<style is:global>
/* Cromo del laboratorio, con prefijo propio. No toca ninguna clase del formulario. */
.lab-barra {
  position: sticky; top: 0; z-index: 90;
  display: flex; flex-wrap: wrap; align-items: center; gap: var(--mm-e-8);
  padding: var(--mm-e-12) var(--mm-e-24);
  background-color: var(--mm-fondo-navy); color: var(--mm-tinta-inversa);
  font-family: var(--mm-fuente); font-size: var(--mm-paso-1);
}
.lab-barra button {
  min-height: 34px; padding: var(--mm-e-4) var(--mm-e-12);
  border: 1px solid var(--mm-borde-control-inverso); border-radius: var(--mm-r-8);
  background-color: transparent; color: var(--mm-tinta-inversa);
  font-family: var(--mm-fuente); font-size: var(--mm-paso-0); cursor: pointer;
}
.lab-barra button:hover { background-color: var(--mm-navy-lomo) }
/* Se ensenan a demanda. `display` y nada mas: cero opacidades. */
.lab-exito .success-message-form { display: block }
.lab-exito .main-form-block form { display: none }
.lab-fallo .w-form-fail { display: block }
</style>

<script is:inline>
/* Reproduce showStep() del sitio: lo unico que le importa al CSS del carril es que el
 * paso dormido acabe con style="display: none" y el vivo con display: block. */
(() => {
  const raiz = document.querySelector('.appointment-section');
  if (!raiz) return;
  const pasos = [...raiz.querySelectorAll('[data-step]')].sort((a, b) => a.dataset.step - b.dataset.step);
  const next = raiz.querySelector('.msf-next');
  const back = raiz.querySelector('.msf-back');
  const env  = raiz.querySelector('input[type=submit]');
  let i = 0;
  const pinta = (n) => {
    i = n;
    pasos.forEach((s, k) => s.style.display = k === n ? 'block' : 'none');
    if (back) back.style.display = n === 0 ? 'none' : 'inline-block';
    if (next) next.style.display = n === pasos.length - 1 ? 'none' : 'inline-block';
    if (env)  env.style.display  = n === pasos.length - 1 ? 'inline-block' : 'none';
  };
  next?.addEventListener('click', (e) => { e.preventDefault(); if (i < pasos.length - 1) pinta(i + 1) });
  back?.addEventListener('click', (e) => { e.preventDefault(); if (i > 0) pinta(i - 1) });
  pinta(0);

  const modo = (clase) => { raiz.classList.remove('lab-exito', 'lab-fallo'); if (clase) raiz.classList.add(clase) };
  document.querySelectorAll('[data-lab-paso]').forEach((b) =>
    b.addEventListener('click', () => { modo(null); pinta(+b.dataset.labPaso - 1) }));
  document.querySelector('[data-lab-exito]')?.addEventListener('click', () => modo('lab-exito'));
  document.querySelector('[data-lab-fallo]')?.addEventListener('click', () => { modo('lab-fallo'); pinta(2) });

  /* EL WIDGET DE MENTIRA. Mismo tamano (300x65) y MISMA insercion que
   * Formularios.astro:57-58, que es lo unico que reproduce el defecto de movil. */
  document.querySelector('[data-lab-captcha]')?.addEventListener('click', () => {
    if (raiz.querySelector('.mm-turnstile')) return;
    modo(null); pinta(2);
    const caja = document.createElement('div');
    caja.className = 'mm-turnstile';
    caja.style.cssText = 'width:300px;height:65px;background:#dfe6f2;border:1px dashed #8794b6';
    env.parentElement.insertBefore(caja, env);
    caja.style.margin = '.75rem 0';
  });
})();
</script>
