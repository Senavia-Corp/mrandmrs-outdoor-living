ata-service-id=\"landscaping\" class=\"block-services-info service-detail is-active\"><img alt=\"Professional landscaping services designed for Florida residential properties.\" loading=\"lazy\" src=\"/images/residentials/professional-landscaping-services-in-north-south-florida/landscaping-services-florida.avif\" class=\"image-bg-services\"><div class=\"wrapper-services\"><div class=\"block-info-services\"><div class=\"blck-glass\"></div><div class=\"block-text-service\"><div><h4>Professional Landscaping Services</h4><div class=\"paragraph-mini\">Landscaping design and installation company serving North &amp; South Florida, providing complete outdoor solutions that improve curb appeal.</div></div><div class=\"block-buttom-services\"><a href=\"/services/professional-landscaping-services-in-north-south-florida\" class=\"button w-button\">See More</a></div></div></div></div></div></div><div data-service-id=\"kitchens\" role=\"listitem\" class=\"cms-item-services js-service-item w-dyn-item\"><div data-service-id=\"kitchens\" class=\"block-services service-link\"><div class=\"content-services\"><img src=\"/images/residentials/custom-outdoor-kitchens-for-north-south-florida-homes/artboard-8.svg\" loading=\"lazy\" alt=\"\" class=\"icon-services\"><h3 class=\"heading-services\">Outdoor Kitchens</h3></div><div fs-cmsfilter-field=\"Categories\" class=\"filter-wrapper-categories w-dyn-list\"><div role=\"list\" class=\"filter-list-categories w-dyn-items\"><div role=\"listitem\" class=\"filter-item-categories w-dyn-item\"><div class=\"block-categories\"><div class=\"js-service-cat\">outdoor-living</div></div></div></div></div></div><div data-service-id=\"kitchens\" class=\"block-services-info service-detail is-active\"><img alt=\"Custom outdoor kitchen built by professional outdoor kitchen builders in Florida.\" loading=\"lazy\" src=\"/images/residentials/custom-outdoor-kitchens-for-north-south-florida-homes/covered-custom-outdoor-kitchen-florida.avif\" class=\"image-bg-services\"><div class=\"wrapper-services\"><div class=\"block-info-services\"><div class=\"blck-glass\"></div><div class=\"block-text-service\"><div><h4>Custom Outdoor Kitchens</h4><div class=\"paragraph-mini\">Outdoor kitchen builders and installation contractors serving North &amp; South Florida with custom layouts for entertaining and daily use.</div></div><div class=\"block-buttom-services\"><a href=\"/services/custom-outdoor-kitchens-for-north-south-florida-homes\" class=\"button w-button\">See More</a></div></div></div></div></div></div><div data-service-id=\"enclosures\" role=\"listitem\" class=\"cms-item-services js-service-item w-dyn-item\"><div data-service-id=\"enclosures\" class=\"block-services service-link\"><div class=\"content-services\"><img src=\"/images/residentials/pool-screen-enclosures-for-north-south-florida-pools/artboard-6.svg\" loading=\"lazy\" alt=\"\" class=\"icon-services\"><h3 class=\"heading-services\">Pool Screen Enclosures</h3></div><div fs-cmsfilter-field=\"Categories\" class=\"filter-wrapper-categories w-dyn-list\"><div role=\"list\" class=\"filter-list-categories w-dyn-items\"><div role=\"listitem\" class=\"filter-item-categories w-dyn-item\"><div class=\"block-categories\"><div class=\"js-service-cat\">patio-cover</div></div></div><div role=\"listitem\" class=\"filter-item-categories w-dyn-item\"><div class=\"block-categories\"><div class=\"js-service-cat\">pool-spa</div></div></div></div></div></div><div data-service-id=\"enclosures\" class=\"block-services-info service-detail is-active\"><img alt=\"Pool screen enclosures installed by licensed Florida enclosure contractors\" loading=\"lazy\" src=\"/images/residentials/pool-screen-enclosures-for-north-south-florida-pools/pool-screen-enclosures-florida.avif\" class=\"image-bg-services\"><div class=\"wrapper-services\"><div class=\"block-info-services\"><div class=\"blck-glass\"></div><div class=\"block-text-service\"><div><h4>Pool Screen Enclosures</h4><div class=\"paragraph-mini\">Pool screen enclosure builders and installation contractors in North &amp; South Florida, improving pool safety and cleanliness.</div></div><div class=\"block-buttom-services\"><a href=\"/services/pool-screen-enclosures-for-north-south-florida-pools\" class=\"button w-button\">See More</a></div></div></div></div></div></div></div></div></div></div><div class=\"w-embed w-script\"><style>\n\n/* TAB DE CATEGORÍA ACTIVO */\n.js-category-tab.is-active {\n  background: linear-gradient(180deg, #5acef8 0%, #0cace5 100%);\n  color: #ffffff;\n  border-color: transparent;\n}\n\n/* Asegura que el texto interno también sea blanco */\n.js-category-tab.is-active * {\n  color: #ffffff;\n}\n\n\n</style>\n\n\n\n<script>\n(() => {\n  // =========================\n  // CONFIG (selectores)\n  // =========================\n  const TAB_SEL = '.js-category-tab';\n  const LINK_SEL = '.service-link';\n  const DETAIL_SEL = '.service-detail';\n  const CAT_BADGE_SEL = '.js-service-cat';\n\n  const DEFAULT_CATEGORY_SLUG = 'pool-spa'; // <- cambia si tu slug real es otro\n\n  // =========================\n  // Helpers\n  // =========================\n  const qs = (sel, root = document) => root.querySelector(sel);\n  const qsa = (sel, root = document) => Array.from(root.querySelectorAll(sel));\n\n  const normalize = (v) =>\n    (v || '')\n      .toString()\n      .trim()\n      .toLowerCase();\n\n  const isTabletDown = () => window.matchMedia('(max-width: 991px)').matches;\n\n  function getTabs() { return qsa(TAB_SEL); }\n  function getLinks() { return qsa(LINK_SEL); }\n  function getDetails() { return qsa(DETAIL_SEL); }\n\n  // Extrae categorías desde los badges dentro del link (por texto)\n  function getServiceCategories(linkEl) {\n    const badges = qsa(CAT_BADGE_SEL, linkEl);\n    return badges.map(b => normalize(b.textContent));\n  }\n\n  function hideAllDetails() {\n    getDetails().forEach(d => {\n      d.style.display = 'none';\n      d.classList.remove('is-active');\n    });\n    getLinks().forEach(l => l.classList.remove('is-active'));\n  }\n\n  function showServiceDetail(id) {\n    getDetails().forEach(d => {\n      const dId = d.getAttribute('data-service-id');\n      const match = dId === id;\n      d.style.display = match ? 'flex' : 'none';\n      d.classList.toggle('is-active', match);\n    });\n  }\n\n  function setActiveTab(tabEl) {\n    getTabs().forEach(t => t.classList.remove('is-active'));\n    if (tabEl) tabEl.classList.add('is-active');\n  }\n\n  // ✅ Filtra servicios y además muestra SOLO 1 tag (el de la categoría activa)\n  function filterServicesByCategory(categorySlug) {\n    const wanted = normalize(categorySlug);\n    const links = getLinks();\n\n    links.forEach(link => {\n      const cats = getServiceCategories(link);\n      const match = cats.includes(wanted);\n\n      // 1) Mostrar/ocultar servicio\n      link.style.display = match ? '' : 'none';\n\n      // 2) Mostrar SOLO la píldora que coincide con la categoría activa\n      const badges = qsa(CAT_BADGE_SEL, link);\n      badges.forEach(b => {\n        const isThis = normalize(b.textContent) === wanted;\n        b.style.display = (match && isThis) ? '' : 'none';\n      });\n    });\n  }\n\n  function openFirstVisibleService() {\n    if (isTabletDown()) return; // en mobile no abrimos por default (si quieres, quítalo)\n\n    const firstVisibleLink = getLinks().find(l => l.style.display !== 'none');\n    if (!firstVisibleLink) return;\n\n    const id = firstVisibleLink.getAttribute('data-service-id');\n    if (!id) return;\n\n    hideAllDetails();\n    firstVisibleLink.classList.add('is-active');\n    showServiceDetail(id);\n  }\n\n  function initDefaultCategory() {\n    const tabs = getTabs();\n    if (!tabs.length) return;\n\n    // busca tab por slug primero\n    let defaultTab = tabs.find(t => normalize(t.getAttribute('data-category-slug')) === normalize(DEFAULT_CATEGORY_SLUG));\n\n    // si no existe, usa el primero\n    if (!defaultTab) defaultTab = tabs[0];\n\n    const slug =\n      defaultTab.getAttribute('data-category-slug') ||\n      defaultTab.getAttribute('data-category-name') ||\n      defaultTab.textContent;\n\n    hideAllDetails();\n    setActiveTab(defaultTab);\n    filterServicesByCategory(slug);\n    openFirstVisibleService();\n  }\n\n  // =========================\n  // Click: Tabs (categorías)\n  // =========================\n  document.addEventListener('click', (e) => {\n    const tab = e.target.closest(TAB_SEL);\n    if (!tab) return;\n\n    e.preventDefault();\n\n    const slug =\n      tab.getAttribute('data-category-slug') ||\n      tab.getAttribute('data-category-name') ||\n      tab.textContent;\n\n    hideAllDetails();\n    setActiveTab(tab);\n    filterServicesByCategory(slug);\n    openFirstVisibleService();\n  });\n\n  // =========================\n  // Click: Servicios (lista izquierda)\n  // =========================\n  document.addEventListener('click', (e) => {\n    const link = e.target.closest(LINK_SEL);\n    if (!link) return;\n\n    // si está oculto por filtro, no hace nada\n    if (link.style.display === 'none') return;\n\n    e.preventDefault();\n\n    const id = link.getAttribute('data-service-id');\n    if (!id) return;\n\n    const links = getLinks();\n    const targetDetail = getDetails().find(d => d.getAttribute('data-service-id') === id);\n\n    const isActiveLink = link.classList.contains('is-active');\n    const detailIsVisible = targetDetail && targetDetail.style.display !== 'none';\n\n    // 📱 Tablet/Mobile: toggle\n    if (isTabletDown()) {\n      if (isActiveLink && detailIsVisible) {\n        hideAllDetails();\n        return;\n      }\n      hideAllDetails();\n      link.classList.add('is-active');\n      showServiceDetail(id);\n      return;\n    }\n\n    // 🖥️ Desktop: solo cambia, nunca cierra\n    links.forEach(l => l.classList.remove('is-active'));\n    link.classList.add('is-active');\n    showServiceDetail(id);\n  });\n\n  // =========================\n  // Re-init on resize (debounce)\n  // =========================\n  let rTimer = null;\n  window.addEventListener('resize', () => {\n    clearTimeout(rTimer);\n    rTimer = setTimeout(() => initDefaultCategory(), 150);\n  });\n\n  // =========================\n  // Re-init if Webflow re-renders\n  // =========================\n  const observer = new MutationObserver((mutations) => {\n    const shouldReinit = mutations.some(m =>\n      Array.from(m.addedNodes).some(n =>\n        n.nodeType === 1 && (\n          n.matches?.(TAB_SEL) || n.matches?.(LINK_SEL) || n.matches?.(DETAIL_SEL) ||\n          n.querySelector?.(TAB_SEL) || n.querySelector?.(LINK_SEL) || n.querySelector?.(DETAIL_SEL)\n        )\n      )\n    );\n    if (shouldReinit) initDefaultCategory();\n  });\n\n  document.addEventListener('DOMContentLoaded', () => {\n    setTimeout(() => {\n      initDefaultCategory();\n      observer.observe(document.body, { childList: true, subtree: true });\n    }, 50);\n  });\n})();\n</script></div></div></section><section class=\"animated-divs-section\"><div class=\"w-layout-blockcontainer container w-container\"><div data-w-id=\"330b3a3f-e72c-3f91-1f24-8dfe4f37952f\" class=\"header-feature\"><h2 class=\"white\">Featured Luxury Pool Projects Across North Florida</h2><p>Our advanced 3D rendering technology allows you to preview your North Florida luxury pool and outdoor living space before construction begins. As luxury pool builders in North Florida, we create photorealistic designs that help you explore layouts, materials, and finishes in detail. This collaborative process improves clarity, minimizes surprises, and ensures your final project reflects your vision with confidence.</p></div><div data-w-id=\"330b3a3f-e72c-3f91-1f24-8dfe4f379534\" class=\"wrapper-feature\"><div id=\"w-node-_330b3a3f-e72c-3f91-1f24-8dfe4f379535-4f37952d\" class=\"feature-card is-active\"><img src=\"/images/site/adobe-express-file.webp\" loading=\"lazy\" alt=\"\" sizes=\"(max-width: 767px) 100vw, (max-width: 991px) 7