const P0 = "<script>\ndocument.addEventListener(\"DOMContentLoaded\", () => {\n  const wrapper = document.getElementById(\"msf\");\n  if (!wrapper) return;\n\n  // Steps\n  const steps = Array.from(wrapper.querySelectorAll(\"[data-step]\"))\n    .sort((a,b) => Number(a.dataset.step) - Number(b.dataset.step));\n\n  // Buttons\n  const btnNext = document.getElementById(\"msf-next\");\n  const btnBack = document.getElementById(\"msf-back\");\n  const btnSubmit = document.getElementById(\"msf-submit\");\n\n  let current = 0;\n\n  // Helpers\n  const isVisible = (el) => !!(el.offsetWidth || el.offsetHeight || el.getClientRects().length);\n\n  const showStep = (index) => {\n    steps.forEach((s, i) => s.style.display = i === index ? \"block\" : \"none\");\n\n    if (btnBack) btnBack.style.display = index === 0 ? \"none\" : \"inline-block\";\n    if (btnNext) btnNext.style.display = index === steps.length - 1 ? \"none\" : \"inline-block\";\n    if (btnSubmit) btnSubmit.style.display = index === steps.length - 1 ? \"inline-block\" : \"none\";\n  };\n\n  const setFieldError = (field, message) => {\n    field.classList.add(\"msf-error-input\");\n    field.setAttribute(\"aria-invalid\", \"true\");\n\n    let msg = field.parentElement?.querySelector(\".msf-error\");\n    if (!msg) {\n      msg = document.createElement(\"div\");\n      msg.className = \"msf-error\";\n      field.parentElement?.appendChild(msg);\n    }\n    msg.textContent = message || \"Required\";\n  };\n\n  const clearFieldError = (field) => {\n    field.classList.remove(\"msf-error-input\");\n    field.removeAttribute(\"aria-invalid\");\n    const msg = field.parentElement?.querySelector(\".msf-error\");\n    if (msg) msg.remove();\n  };\n\n  const validateField = (field) => {\n    clearFieldError(field);\n\n    const type = (field.dataset.type || \"\").toLowerCase();\n    const tag = field.tagName.toLowerCase();\n    const value = (field.value || \"\").trim();\n\n    // Required empty\n    if (!value) {\n      setFieldError(field, \"Required\");\n      return false;\n    }\n\n    // Select placeholder common cases\n    if (tag === \"select\") {\n      const v = value.toLowerCase();\n      if (v === \"select one...\" || v === \"select one\" || v === \"select...\" || v === \"select\") {\n        setFieldError(field, \"Please select an option\");\n        return false;\n      }\n    }\n\n    // Email\n    if (type === \"email\") {\n      const ok = /^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$/.test(value);\n      if (!ok) {\n        setFieldError(field, \"Enter a valid email\");\n        return false;\n      }\n    }\n\n    // Phone\n    if (type === \"phone\") {\n      const ok = /^[0-9()+\\-\\s]{7,}$/.test(value);\n      if (!ok) {\n        setFieldError(field, \"Enter a valid phone\");\n        return false;\n      }\n    }\n\n    // ZIP (US 5 digits)\n    if (type === \"zip\") {\n      const ok = /^\\d{5}$/.test(value);\n      if (!ok) {\n        setFieldError(field, \"Enter a valid 5-digit ZIP\");\n        return false;\n      }\n    }\n\n    return true;\n  };\n\n  const validateStep = (index) => {\n    const step = steps[index];\n    const requiredFields = Array.from(step.querySelectorAll(\"[data-required='true']\")).filter(isVisible);\n\n    let ok = true;\n    requiredFields.forEach((field) => {\n      if (!validateField(field)) ok = false;\n    });\n\n    return ok;\n  };\n\n  // Clear errors while typing\n  wrapper.addEventListener(\"input\", (e) => {\n    const field = e.target;\n    if (field && field.matches(\"[data-required='true']\")) clearFieldError(field);\n  });\n\n  // Next / Back\n  btnNext?.addEventListener(\"click\", (e) => {\n    e.preventDefault();\n    if (!validateStep(current)) return;\n    if (current < steps.length - 1) {\n      current++;\n      showStep(current);\n      steps[current].querySelector(\"input, select, textarea\")?.focus?.();\n    }\n  });\n\n  btnBack?.addEventListener(\"click\", (e) => {\n    e.preventDefault();\n    if (current > 0) {\n      current--;\n      showStep(current);\n      steps[current].querySelector(\"input, select, textarea\")?.focus?.();\n    }\n  });\n\n  // Init\n  showStep(current);\n});\n</script><style>\n/* Estilos mínimos de error (puedes ajustarlos en Webflow) */\n.msf-error-input { outline: 2px solid currentColor; }\n.msf-error { margin-top: 6px; font-size: 12px; }\n</style>";
