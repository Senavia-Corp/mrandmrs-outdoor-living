<style is:global>
/* ══ COMUN A LAS DOS VARIANTES ═══════════════════════════════════════════════
 * Esto viaja TAL CUAL a folletos.css cuando Sebastian elija.
 * 23 reglas · 0 declaraciones inertes de 132 medibles. */
/* ══════════════════════════════════════════════════════════════════════════════
 * R12-FOL · CANDIDATO PARA folletos.css — laboratorio, aún NO aplicado
 *
 * Se ELEVA la tarjeta de Webflow, no se sustituye: mismos componentes, mismo
 * orden, misma identidad. Lo que cambia es que la portada SE VE ENTERA.
 *
 * Gana por ORDEN DE CARGA (esta capa va después de webflow.css), nunca por
 * `!important`. Ningún literal de color: solo var(--mm-*). Breakpoints solo
 * min-width 480/768/992, jamás mezclados con los max-width de Webflow.
 * ══════════════════════════════════════════════════════════════════════════ */

/* ── COMÚN A LAS DOS VARIANTES ─────────────────────────────────────────────
 * Estas reglas son idénticas en A y en B: son los siete defectos medidos que
 * no dependen de cómo se resuelva la portada. */

/* 1 · El catálogo recupera 250 px. El vacío que queda a 1920 lo fija
 *     `.container{max-width:1250px}`, que es cromo compartido y no es de este
 *     lote: 1000 -> 1250 es todo lo que puedo recuperar sin invadirlo. */
.container-large { max-width: var(--mm-ancho); }

/* 2 · El panel de filtros era visible durante 404 px de un scroll de 10.822.
 *     Pegajoso desde 768: por debajo Webflow ya lo apila a ancho completo y
 *     fijarlo ahí taparía media pantalla de móvil. */
.filter_block {
  border-radius: var(--mm-r-16);
  box-shadow: var(--mm-sombra-2);
}
.filter_block_header { padding-bottom: var(--mm-e-8); }   /* Webflow ya da 1rem arriba y a los lados */
.filter_block_title  { font-size: var(--mm-paso-3); letter-spacing: -.01em; }
.filter_list         { gap: var(--mm-e-4); padding-inline: var(--mm-e-8); padding-bottom: var(--mm-e-8); }

/* 3 · La fila de filtro pasa de 25,2 px a 44, y la etiqueta de 12 px al paso 1.
 *     Receta de altura la que ya funciona en el repo (intro.css:161-166):
 *     min-height + flex + centrado. Nunca `height` fija. */
.checkbox_field {
  min-height: 44px;   /* convención de la casa: intro.css:165, base.css:234 */
  gap: var(--mm-e-12);
  padding-left: var(--mm-e-8);
  padding-right: var(--mm-e-8);
  border-radius: var(--mm-r-8);
  font-size: var(--mm-paso-1);
}
.checkbox_label { font-size: inherit; margin-right: 0; }
.checkbox_input { margin-top: 0; margin-right: 0; border-radius: var(--mm-r-8); }

/* 4 · Estados. Hoy la sección tiene CERO reglas de estado en sus 66 controles.
 *     blanco sobre --mm-navy-lomo = 11,90:1 (medido en tokens.css). */
.checkbox_field:hover {
  background-color: var(--mm-navy-lomo);
  color: var(--mm-tinta-inversa);
}
/* El input real está a `position:absolute;z-index:-1`, así que el anillo va en
 * la fila. Blanco sobre navy = 15,60:1 contra sus DOS vecinos. */
.checkbox_field:has(input:focus-visible) {
  outline: var(--mm-foco-grosor) solid var(--mm-foco-inverso);
  outline-offset: var(--mm-foco-aire);
}
/* Webflow enfoca la casilla con #b9fd3b —verde ácido de plantilla, fuera de la
 * paleta—. Se sustituye por el foco del sistema. */
.checkbox_input.w--redirected-focus-visible {
  outline-color: var(--mm-foco-inverso);
  outline-offset: var(--mm-foco-aire);
}

/* 5 · La tarjeta. `height:auto` va PRIMERO y explícito: mata los 350/300/250 px
 *     de Webflow antes de que ningún `aspect-ratio` entre en juego —con la
 *     altura declarada, aspect-ratio calcula el ANCHO y desborda la columna—. */
.cms_list-item { max-width: none; }
.brochure-wrapper-page {
  height: auto;
  flex-direction: column;
  align-items: stretch;
  justify-content: flex-start;
  gap: var(--mm-e-12);
  /* el borde era `2px solid var(--white)` sobre fondo blanco: invisible.
   * La sombra era `0 2px 5px #0003`, negro puro. */
  border: 1px solid var(--mm-borde);
  border-radius: var(--mm-r-16);
  box-shadow: var(--mm-sombra-1);
  background-color: var(--mm-superficie);
  transition: box-shadow .2s ease, border-color .2s ease;
}
.brochure-wrapper-page:hover,
.brochure-wrapper-page:focus-within {
  border-color: var(--mm-borde-control);
  box-shadow: var(--mm-sombra-2);
}

/* 6 · La portada sale del posicionamiento absoluto y pasa a mandar en el flujo.
 *     Aquí es donde se acaba el recorte del 37,9 % / 45,4 %. */
.cover-brochure-page {
  position: static;
  inset: auto;
  width: 100%;
  height: auto;
}

/* 7 · El botón deja de ir ENCIMA del arte y pasa a 44 px de alto. */
.brochure-wrapper-page .button-styles {
  min-height: 44px;   /* convención de la casa: intro.css:165, base.css:234 */
  display: inline-flex;
  align-items: center;
  justify-content: center;
  align-self: center;
  border: 1px solid var(--mm-borde-control);   /* 3,03:1 sobre blanco */
  border-radius: var(--mm-r-8);
  padding: var(--mm-e-8) var(--mm-e-24);
  font-size: var(--mm-paso-1);
  transition: background-color .2s ease, color .2s ease;
}
.brochure-wrapper-page .button-styles:hover {
  background-color: var(--mm-navy);            /* blanco encima = 15,60:1 */
  color: var(--mm-tinta-inversa);
}
.brochure-wrapper-page .button-styles:focus-visible {
  outline: var(--mm-foco-grosor) solid var(--mm-foco);
  outline-offset: var(--mm-foco-aire);
}

@media (prefers-reduced-motion: reduce) {
  .brochure-wrapper-page,
  .brochure-wrapper-page .button-styles { transition: none; }
}

/* 8 · Rejilla y panel por tramo. Recuento DETERMINISTA, nunca auto-fill, y
 *     jamás crece al estrechar: 1 / 2 / 2 / 3. El `gap` NO se redeclara: Webflow
 *     ya da 1.5rem = 24px, o sea el propio --mm-e-24. */
@media (min-width: 480px) {
  .cms_list { grid-template-columns: 1fr 1fr; }
}
@media (min-width: 768px) {
  /* Webflow deja el panel en `.66fr 1fr` en 768-991: el 40 % del ancho para
   * nueve casillas. Se devuelve a `auto 1fr`, que es su propio valor de
   * escritorio, y ahí ya se puede pegar. */
  .filter_grid { grid-template-columns: auto 1fr; }
  .filter_form_block { position: sticky; top: var(--mm-e-96); }
}
@media (min-width: 992px) {
