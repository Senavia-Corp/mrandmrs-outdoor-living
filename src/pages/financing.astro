---
/**
 * `/financing` — LA PRIMERA RUTA DE AUTORIA PROPIA DEL SITIO.
 *
 * Las otras 115 son la migracion de Webflow y se miden contra el origen. Esta no existe alli:
 * el nav apuntaba fuera, a Acorn, y esta pagina es lo que se puso en medio. Por eso hay que
 * declararla a mano en las puertas — `scripts/lib/rutas-propias.mjs` es donde se hace, en un
 * solo sitio para que check:rutas, check:seo y check:visual no discrepen.
 *
 * NO ES DERIVADA. `build-paginas.mjs` no la toca: itera `_source/routes.csv` y
 * `_source/vivo/*.html` (`:297-300`), y `/financing` no esta en ninguno de los dos.
 * TIENE que quedarse en la raiz de `src/pages`: `build-plantillas.mjs:357,648` hace
 * readdirSync + unlinkSync sobre las 7 carpetas de familia y la borraria.
 *
 * SIN UN SOLO `data-w-id`, A PROPOSITO. El sistema de reveals oculta con
 * `html[data-anim] [data-w-id][data-rev]:not([data-visto]) { opacity: 0 }`
 * (`Interacciones.astro:41`) y el `data-rev` lo pone el JS al casar el `data-w-id` contra
 * `src/data/reveals.json`. Un `data-w-id` inventado no casa con nada: no recibe `data-rev`,
 * asi que el selector no le aplica y el elemento se ve — pero seria una entrada por scroll
 * que no anima nunca, o sea marcado que miente. Esta pagina no lleva reveals y no los finge.
 * Es ademas la trampa de AMS que documenta `Base.astro:15-20`.
 *
 * PIEZAS (ASTRO-4 lote C): todas del sistema —hero D, proceso numerado, ficha de obra, resenas en
 * lista, FAQ en `<details>` y banda de cierre—; lo unico propio son las dos secciones `.mm-franja`
 * de `sistema.css`. Las fotos de los seis servicios son obra real del registro de galeria.
 *
 * NI UNA CIFRA FINANCIERA, por decision de Sebastian del 2-sep-2026: ni APR, ni plazos, ni
 * cuotas, ni importes, ni tiempos de aprobacion. Nombrar una tasa o una cuota dispara
 * obligaciones de disclosure (TILA/Reg Z) que este sitio no tiene escritas. Todo lo que la
 * pagina afirma es sobre lo que hace MR & MRS —precio cerrado por escrito antes de
 * solicitar—, no sobre lo que hace el prestamista.
 */
import Base from '../layouts/Base.astro';
import ResenasGoogle from '../components/widgets/ResenasGoogle.astro';
import TELEFONOS from '../data/telefonos.json';
import BANCO from '../data/banco-imagenes.json';
import RESENAS from '../data/resenas.json';


const ACORN = 'https://your.acornfinance.com/apply?d=NXJVM';

/* ASTRO-4: las tres fotos de obra que acompanan a resenas, FAQ y banda (obra real, terminada, con
 * alt). E12 (D-197): resenas y FAQ llevan las suyas, de la sesion profesional; la banda sigue con la
 * de la bolsa de piscina nueva, que es vertical y llena la caja 4:5 sin derivada. */
const FOTOS = ['bi-1282', 'bi-1283', 'bi-0969'].map((id) => {
  const e = (BANCO as any[]).find((x) => x.id === id);
  if (!e || e.procedencia !== 'obra_real' || !e.alt) throw new Error(`/financing: la foto ${id} no es obra real con alt`);
  return e;
});
const FLECHA = '<svg aria-hidden="true" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"></path><path d="m13 6 6 6-6 6"></path></svg>';
const ABRE = '<svg aria-hidden="true" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m6 9 6 6 6-6"></path></svg>';

/** Los 4 pasos. El orden ES el contenido: la financiacion va DESPUES del precio cerrado. */
const PASOS = [
  {
    n: '1',
    titulo: 'Design consultation',
    texto: 'We walk your property, talk through how you want to use the space, and put a design on paper.',
  },
  {
    n: '2',
    titulo: 'Written scope and fixed price',
    texto: 'You get the scope in writing and a fixed project price. This is the number you build on.',
  },
  {
    n: '3',
    titulo: 'Review your financing options',
    texto: 'With the price settled, you review options through our lending partner. Approval and terms come from the lender.',
    clave: true,
  },
  {
    n: '4',
    titulo: 'Permitting and construction',
    texto: 'Engineering, permits, and the build itself, managed by a licensed Florida contractor.',
  },
];

/**
 * Foto de obra real, de las que ya sirve /gallery. `src` es el original de 1250w; si Webflow le
 * genero variantes, estan en `/images/site/<nombre>-p-500|800|1080.jpg` y SOLO ellas van al
 * `srcset`: la ranura mide 400px como mucho y 1080w cubre DPR 2,7, mientras que el original de
 * la piscina pesa 1,1 MB —4-5 veces sus hermanas— y solo lo pedia un DPR 3 de escritorio.
 * Elegidas por hoja de contactos recortada a 4:3 —lo que ensena la tarjeta—, no por nombre.
 * El `alt` describe lo que se ve: el de /gallery no siempre casa con su foto (el del techo de
 * lamas dice «over pool deck» y es un patio de adoquin junto a una pista de tenis).
 */
const foto = (src, ancho, alto, alt, variantes = true) => {
  const nombre = src.split('/').pop().replace(/\.\w+$/, '');
  const srcset = variantes
    ? [500, 800, 1080].map((w) => `/images/site/${nombre}-p-${w}.jpg ${w}w`).join(', ')
    : undefined;
  return { src, srcset, ancho, alto, alt };
};

/** Solo servicios que el sitio construye de verdad, enlazando a su ficha. */
const SERVICIOS = [
  ['Pools and spas', 'Custom inground pools and spas, engineered and permitted.', '/services/pool-builders',
    foto('/images/images/pool-construction-10/custom-pool-spa-builders-florida-10.jpg', 1250, 933, 'Rectangular pool with a raised spa, surrounded by lawn')],
  ['Pergolas', 'Custom aluminum pergolas built for Florida sun and wind.', '/services/pergola-builders',
    foto('/images/images/pergolas-2/custom-pergola-patio-cover-builders-florida-02.jpg', 1250, 933, 'Dark aluminum pergola with a slatted privacy screen beside a pool and spa')],
  ['Outdoor kitchens', 'Built-in cooking, storage, and counter space.', '/services/outdoor-kitchens',
    foto('/images/images/kitchen-2/custom-outdoor-kitchen-poolside-florida.avif', 1250, 698, 'L-shaped outdoor kitchen with a built-in grill and stainless steel doors under a covered patio', false)],
  ['Decks', 'Composite and wood decks built for the climate.', '/services/deck-builders',
    foto('/images/images/deck-9/custom-deck-builders-contractors-north-south-florida-09.jpg', 1250, 698, 'Wood deck with a timber pergola along the back of a white house')],
  ['Screen enclosures', 'Pool cages and patio enclosures.', '/services/pool-screen-enclosures',
    foto('/images/images/pool-screen-3/pool-screen-enclosure-builders-florida-03.jpg', 1250, 698, 'Screen enclosure over a pool and spa with a view of a lake and fountain')],
  ['Louvered roofs', 'Motorized louvered roof systems for shade on demand.', '/services/louvered-roofs',
    // E12: la de antes era un techo de lamas sin muebles junto a una pista de tenis; esta es del banco (bi-1281).
    foto('/images/banco/louvered/white-louvered-roof-patio-dining-yellow-house-florida-01.webp', 1600, 900, 'White louvered roof with open blades over a patio dining set and potted plants beside a yellow house.', false)],
];

// A que ancho se pinta la foto en `.mm-franja-lista`: tres columnas desde 992, dos desde 768, una por debajo.
const TAMANOS_FOTO = '(min-width: 992px) 33vw, (min-width: 768px) 50vw, 100vw';

/** El FAQ. Ninguna respuesta menciona una cifra, un plazo ni un tiempo de aprobacion. */
const FAQ = [
  [
    'Do I need financing approved before I can get a price?',
    'No. We design the project and give you a written scope with a fixed price first. You review financing with a real number in hand instead of an estimate.',
  ],
  [
    'Who actually provides the financing?',
    'A third-party lending partner, Acorn Finance. Mr & Mrs Outdoor Living builds your project; the lender reviews your application and sets the terms. We are not a lender and we do not decide approvals.',
  ],
  [
    'Which projects can I finance?',
    'Any project we build — pools and spas, pergolas, outdoor kitchens, decks, screen enclosures, louvered roofs, and full outdoor living builds.',
  ],
  [
    'Does financing change my project price?',
    'No. The price in your written scope is the price. How you choose to pay for the project does not change what we quoted.',
  ],
  [
    'Can I get an estimate if I am not financing?',
    'Yes. Most of our clients start with the design and the estimate. Financing is optional and it is a separate decision.',
  ],
];

const SEO = {
  meta: {
    'og:title': 'Financing Your Outdoor Project | Mr & Mrs Outdoor Living',
    'og:description': 'Get your design and a fixed project price first, then review financing options for your Florida pool, pergola, or outdoor living build.',
    'og:type': 'website',
  },
  jsonLd: [
    {
      '@context': 'https://schema.org',
      '@type': 'FAQPage',
      mainEntity: FAQ.map(([pregunta, respuesta]) => ({
        '@type': 'Question',
        name: pregunta,
        acceptedAnswer: { '@type': 'Answer', text: respuesta },
      })),
    },
  ],
};
---

<Base
  titulo="Financing Your Outdoor Project | Mr & Mrs Outdoor Living"
  descripcion="Get your design and a fixed project price first, then review financing options for your Florida pool, pergola, or outdoor living build with a licensed contractor."
  ruta="/financing"
  seo={SEO}
>
  {/* UN `<main>`, QUE NINGUNA OTRA PAGINA DEL SITIO TIENE.
      accesslint da `landmarks/landmark-main` en las 116 y `landmarks/region` en cada seccion
      suelta: sin landmark principal, un lector de pantalla no ofrece «saltar al contenido» y
      hay que recorrer el nav entero en cada pagina. Se arregla AQUI y no en `Base.astro`
      porque envolver el slot cambiaria la estructura de las 115 derivadas, y esas estan bajo
      contrato de paridad: mover un nodo en las 115 no es un arreglo de accesibilidad, es un
      rediseño encubierto que ademas habria que re-baselinizar entero.
      Verificado antes de ponerlo: `webflow.css` NO tiene ni una regla sobre el elemento
      `main` —lo que parecia serlo era la cola de `.w-hidden-main{display:none!important}`—,
      asi que no hereda display ni margenes de nadie y no mueve un pixel.
      D-198: lleva el `id` al que apunta «Skip to content» del nav, como el `<main>` de Base. */}
  <main id="contenido">
  {/* ASTRO-4 lote C (sin lamina propia: hero D y piezas aprobadas del sistema).
      QUE CAMBIA DE COMPOSICION: las tarjetas con icono, caja y sombra pasan a las piezas del
      sistema. La pagina defiende una sola idea —la financiacion es el tercer paso, no el primero—
      y la ensena en el proceso numerado con ese paso marcado; lo financiable son seis fichas de
      obra enteras pulsables; «quien construye» es el unico bloque navy; resenas en lista, FAQ en
      `<details>` con su tarjeta de accion y la banda final con Acorn. Mismos textos, mismo orden. */}
  <section class="mm-hero-d">
    <div class="mm-hero-d-caja">
      <div class="mm-sec-cab">
        <h1 class="mm-h1">Financing your outdoor project</h1>
        <div class="mm-sec-lado"><p class="mm-p">Design your project and settle the price first. Then review financing options with our lending partner, working from a fixed number instead of a rough estimate.</p></div>
      </div>
    </div>
  </section>

  <section class="mm-proc mm-proc--sin">
    <div class="mm-sec-cab">
      <div class="mm-sec-tit">
        <p class="mm-etiqueta">The order matters</p>
        <h2 class="mm-h2">Where financing fits in your build</h2>
      </div>
      <div class="mm-sec-lado"><p class="mm-p">Financing is the third step, not the first. You settle the design and the price before it ever comes up, so you know exactly what you are financing.</p></div>
    </div>
    <ol class="mm-pasos">
      {PASOS.map((p) => (
        <li class:list={['mm-paso', p.clave && 'mm-paso--activo']}>
          <span class="mm-paso-n">{p.n}</span>
          <h3 class="mm-paso-t">{p.titulo}</h3>
          <p>{p.texto}</p>
        </li>
      ))}
    </ol>
  </section>

  <section class="mm-franja">
    <div class="mm-sec-cab">
      <h2 class="mm-h2">What you can finance</h2>
      <div class="mm-sec-lado"><p class="mm-p">Anything we build, from a single structure to a full outdoor living project.</p></div>
    </div>
    <ul class="mm-franja-lista" role="list">
      {SERVICIOS.map(([nombre, texto, href, f]) => (
        <li>
          <a class="mm-ficha mm-ficha--indice" href={href}>
            <span class="mm-ficha-foto"><img src={f.src} srcset={f.srcset} sizes={TAMANOS_FOTO} width={f.ancho} height={f.alto} alt={f.alt} loading="lazy" decoding="async" /></span>
            <span class="mm-ficha-cuerpo">
              <h3 class="mm-ficha-t">{nombre}</h3>
              <span class="mm-ficha-p">{texto}</span>
              <span class="mm-flecha">See {nombre.toLowerCase()}<Fragment set:html={FLECHA} /></span>
            </span>
          </a>
        </li>
      ))}
    </ul>
  </section>

  <section class="mm-franja mm-franja--navy">
    <div class="mm-sec-cab">
      <h2 class="mm-h2">Why it matters who builds it</h2>
      <div class="mm-sec-lado"><p class="mm-p">Financing pays for the project. It does not protect it. That part is on the contractor you hire.</p></div>
    </div>
    <ul class="mm-franja-lista mm-franja-lista--filas" role="list">
      <li class="mm-franja-item">
        <h3 class="mm-conf-t">Licensed and insured</h3>
        <p class="mm-conf-p">We are a licensed Florida contractor. Your project is pulled under our license, with the insurance that goes with it.</p>
      </li>
      <li class="mm-franja-item">
        <h3 class="mm-conf-t">Engineered and permitted</h3>
        <p class="mm-conf-p">Structures are engineered and permitted for Florida wind and soil conditions before anything gets built.</p>
      </li>
      <li class="mm-franja-item">
        <h3 class="mm-conf-t">One contract, one point of contact</h3>
        <p class="mm-conf-p">Design, permitting, and construction run through us. You are not coordinating separate trades against a payment schedule.</p>
      </li>
    </ul>
  </section>

  <section class="mm-res">
    <div class="mm-sec-cab">
      <div class="mm-sec-acc"><a class="mm-flecha" href={RESENAS.enlacePerfil} target="_blank" rel="noopener noreferrer">See all reviews<Fragment set:html={FLECHA} /></a></div>
    </div>
    <div class="mm-res-cuerpo">
      <div class="mm-res-col">
        <ResenasGoogle />
        <div class="mm-datos mm-datos--tel">{TELEFONOS.items.map((t) => <a class="mm-dato" href={`tel:${t.tel}`}><span class="mm-dato-val">{t.visible}</span></a>)}</div>
      </div>
      <figure class="mm-res-medio"><img src={FOTOS[0].src} alt={FOTOS[0].alt} width={FOTOS[0].ancho} height={FOTOS[0].alto} sizes="(min-width: 992px) 33vw, 100vw" loading="lazy" decoding="async" /></figure>
    </div>
  </section>

  <section class="mm-faq">
    <div class="mm-sec-cab">
      <h2 class="mm-h2">Financing <span class="mm-rot">FAQs</span></h2>
      <div class="mm-sec-lado"><p class="mm-p">Common questions from Florida homeowners about paying for an outdoor living project over time.</p></div>
    </div>
    <div class="mm-faq-cuerpo">
      <div class="mm-faq-lista">
        {FAQ.map(([pregunta, respuesta]) => (
          <details class="mm-faq-item">
            <summary><h3>{pregunta}</h3><Fragment set:html={ABRE} /></summary>
            <div class="mm-faq-r"><p>{respuesta}</p></div>
          </details>
        ))}
      </div>
      <div class="mm-faq-lado">
        <figure class="mm-lam-medio mm-faq-medio"><img class="mm-lam-foto" src={FOTOS[1].src} alt={FOTOS[1].alt} width={FOTOS[1].ancho} height={FOTOS[1].alto} sizes="(min-width: 992px) 42vw, 100vw" loading="lazy" decoding="async" /></figure>
        <div class="mm-faq-accion">
          <a class="mm-btn" href="/request-estimated">Get a Free Estimate</a>
          {/* D-256 (25-oct-2026, T-138): segundo enlace entrante a la version desnuda del estimador. */}
          <a class="mm-flecha" href="/pool-investment-estimator">See the Pool Investment Estimator<Fragment set:html={FLECHA} /></a>
          <div class="mm-datos mm-datos--tel">{TELEFONOS.items.map((t) => <a class="mm-dato" href={`tel:${t.tel}`}><span class="mm-dato-val">{t.visible}</span></a>)}</div>
        </div>
      </div>
    </div>
  </section>

  <section class="mm-cierre mm-cierre--sola mm-cierre--alta">
    <div class="mm-cierre-caja">
      <div class="mm-cierre-txt">
        <h2 class="mm-h2">Review your financing options</h2>
        <p class="mm-p">Already have your scope and price? Review options with our lending partner. Still deciding what to build? Start with the design and the estimate.</p>
        <a class="mm-btn mm-min" href={ACORN} target="_blank" rel="noopener">Review options with Acorn Finance</a>
        <p class="mm-cierre-nota">Financing is provided by Acorn Finance, a third-party lending partner. Approval, terms, and servicing are determined by the lender. Mr &amp; Mrs Outdoor Living is not a lender. <a href="/request-estimated">Get a free estimate</a>{' '}if you would rather start with the design.</p>
        <div class="mm-datos mm-datos--tel">{TELEFONOS.items.map((t) => <a class="mm-dato" href={`tel:${t.tel}`}><span class="mm-dato-val">{t.visible}</span></a>)}</div>
      </div>
      <figure class="mm-cierre-medio"><img src={FOTOS[2].src} alt={FOTOS[2].alt} width={FOTOS[2].ancho} height={FOTOS[2].alto} sizes="(min-width: 992px) 42vw, 100vw" loading="lazy" decoding="async" /></figure>
    </div>
  </section>
  </main>
</Base>
