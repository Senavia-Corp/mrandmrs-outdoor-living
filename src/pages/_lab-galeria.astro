const BANDAS = [
  { id: 'hoy', clase: '',      titulo: 'HOY',            pie: '.gallery-picture{height:250px} sobre columnas 1fr — la relacion la decide el ancho de la ventana: 0,907 a 768 px y 1,692 a 479.' },
  { id: 'a',   clase: 'lab-a', titulo: 'A · PLIEGO',     pie: 'Relacion fija 3:2 (1,500) · medida 1600 · hueco 48 · radio 8 · sin marco. Recorte medio 14,6 % sobre las 129 fotos medidas.' },
  { id: 'b',   clase: 'lab-b', titulo: 'B · LAMINA',     pie: 'Relacion fija 7:5 (1,400) · medida 1600 · hueco 24 · esquinas rectas · filete de 1 px. Recorte medio 16,6 %.' },
