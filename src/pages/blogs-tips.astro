---
/**
 * /blogs-tips — LA BIBLIOTECA EDITORIAL.
 *
 * ESCRITO A MANO desde BLOG-SANITY. Antes lo generaba `scripts/build-paginas.mjs` desde
 * `_source/vivo/blogs-tips.html` con las 10 tarjetas HORNEADAS en el HTML. La ruta esta ahora en
 * `NO_REGENERAR`, o `npm run paginas` borraria esto.
 *
 * ─────────────────────────────────────────────────────────────────────────────
 * TODAS LAS TARJETAS SE PINTAN EN EL SERVIDOR. EL JS SOLO ESCONDE
 *
 * No hay indice JSON embebido y no hay peticion en el navegador. Los articulos salen los N en
 * el HTML y el filtro los oculta con `hidden`. Tres motivos, en orden de peso:
 *
 *   1. SEO. Los N enlaces estan en el HTML para el rastreador, tenga JS o no. Un indice que se
 *      pinta con JS es un indice que Google puede no ver.
 *   2. Sin JS, la pagina sigue siendo una biblioteca completa: se degrada a la rejilla de
 *      siempre. Lo que se pierde es el filtro, no el contenido.
 *   3. Un JSON con los campos de tarjeta de 100 articulos son ~770 KB — los `srcset` solos pesan
 *      ~300 caracteres cada uno. Duplicar eso al lado del HTML que ya los lleva es pagar dos
 *      veces por lo mismo.
 *
 * El texto por el que se busca va en `data-busca`, ya en minusculas, para no recalcularlo en
 * cada pulsacion.
 *
 * ─────────────────────────────────────────────────────────────────────────────
 * SIN QUERY PARAMS Y SIN RUTAS NUEVAS, Y NO ES PEREZA
 *
 * El filtro no toca la URL. Asi no hay `?category=` que desindexar ni canonicas que declarar, y
 * «Load more» no crea una sola URL. Cada URL nueva en este repo cuesta CUATRO declaraciones
 * enumeradas -`rutas-propias.mjs`, `contratos.json`, `ADICIONES` y `PAGINAS_ESPERADAS`- mas 4
 * capturas aprobadas. Una paginacion por rutas habria costado eso por pagina.
 *
 * ─────────────────────────────────────────────────────────────────────────────
 * EL `data-w-id` SE CONSERVA, Y ES EL MISMO EN TODAS
 *
 * Webflow ponia UN solo `data-w-id` (`fcac010e-…`) en los 10 items de la lista, no diez. Se
 * sigue emitiendo el mismo en todas: quitarlo dejaria su clave huerfana en `reveals.json` y
 * `check:ix2` las tiene clavadas en 14, que es justo el tope. Medido.
 */
import Base from '../layouts/Base.astro';
import { traeBlog, ordenaIndice, tituloTarjeta } from '../lib/blog-datos.mjs';

const RUTA = '/blogs-tips';
const REVEAL = 'fcac010e-d972-8847-d717-c8f4bdcd6aaa';
/** Cuantas se ven antes de pulsar «Load more». 1 destacada + 9 = 10, como hoy. */
const LOTE = 9;

const posts = ordenaIndice(await traeBlog());

/* Las categorias que DE VERDAD tienen articulos, en el orden declarado en Sanity. Un chip que
 * no filtra nada es un chip que miente, asi que las vacias no salen. */
const categorias = [...new Map(posts.filter((p) => p.categoria?.slug)
  .map((p) => [p.categoria.slug, p.categoria])).values()]
  .sort((a, b) => (a.orden ?? 999) - (b.orden ?? 999));

const destacado = posts[0];
const resto = posts.slice(1);

/* El texto por el que se busca: titulo visible, H1, entradilla, categoria y tags. En minusculas
 * y sin acentos combinados, para que la comparacion en el navegador sea un `includes` y ya. */
const textoDeBusqueda = (p) => [tituloTarjeta(p), p.title, p.summary, p.categoria?.name,
  ...(p.tags ?? [])].filter(Boolean).join(' ')
  .toLowerCase().normalize('NFD').replace(/[̀-ͯ]/g, '');

const SEO = {
  meta: {
    'og:title': 'Luxury Pool Construction Guides & Design-Build Insights | Florida',
    'og:description': 'Expert insights on luxury pool construction and outdoor living design-build projects in Florida, written for homeowners planning high-end custom builds.',
    'twitter:title': 'Luxury Pool Construction Guides & Design-Build Insights | Florida',
    'twitter:description': 'Expert insights on luxury pool construction and outdoor living design-build projects in Florida, written for homeowners planning high-end custom builds.',
    'og:type': 'website',
    'twitter:card': 'summary_large_image',
  },
  jsonLd: [{
    '@context': 'https://schema.org',
    '@type': 'CollectionPage',
    about: {
      '@type': 'Organization',
      areaServed: { '@type': 'State', name: 'Florida' },
      description: 'Luxury outdoor living builders in Florida, specializing in custom pools, pergolas, patios, and high-end exterior construction.',
      logo: { '@type': 'ImageObject', url: '/images/site/logo-mr-mr.svg' },
      name: 'Mr. and Mrs. Outdoor Living',
    },
    description: 'Explore expert insights, project tips, and industry updates on pool construction and outdoor living across Florida, written to help property owners and professionals make informed decisions.',
    /* `hasPart` se DERIVA de los articulos que se pintan, no de una lista aparte: el dato
     * estructurado y lo visible no pueden decir cosas distintas. */
    hasPart: posts.map((p) => ({
      '@type': 'BlogPosting',
      description: p.summary,
      headline: p.title,
      image: p.portada.src,
      inLanguage: 'en',
      url: `/blogs/${p.slug}`,
    })),
    inLanguage: 'en',
    name: 'Blog & Tips',
    url: RUTA,
  }],
};
---
<Base titulo="Luxury Pool Construction Guides & Design-Build Insights | Florida" descripcion="Expert insights on luxury pool construction and outdoor living design-build projects in Florida, written for homeowners planning high-end custom builds." ruta={RUTA} seo={SEO} jsonLdCrudo={[]}>
  <section class="hero-section"><div class="w-layout-blockcontainer container w-container"><div data-w-id="da22a66a-ad39-0d6d-2fa2-62cb4e178480" class="header-hero-page"><h1 class="heading-hero-page">Blog &amp; Tips</h1><div class="text-block-4">Explore expert insights, project tips, and industry updates on pool construction and outdoor living across Florida, written to help property owners and professionals make informed decisions.</div></div></div></section>

  <section class="articles-section">
    <div class="w-layout-blockcontainer container-blog w-container">

      <div class="mm-filtro" data-filtro>
        <div class="mm-filtro__linea">
          <input
            type="search"
            class="mm-filtro__campo"
            data-busca
            placeholder="Search articles"
            aria-label="Search articles"
            autocomplete="off"
            spellcheck="false"
          />
          <p class="mm-filtro__cuenta" data-cuenta aria-live="polite">{posts.length} articles</p>
        </div>
        <div class="mm-filtro__chips" role="group" aria-label="Filter by category">
          <button type="button" class="mm-chip" data-cat="" aria-pressed="true">All</button>
          {categorias.map((c) => (
            <button type="button" class="mm-chip" data-cat={c.slug} aria-pressed="false">{c.name}</button>
          ))}
        </div>
      </div>

      <div class="cms-blogs w-dyn-list">
        <div role="list" class="blogs-list w-dyn-items">
          {posts.map((p, i) => (
            <div
              data-w-id={REVEAL}
              role="listitem"
              class="item-blogs w-dyn-item"
              data-cat={p.categoria?.slug ?? ''}
              data-busca={textoDeBusqueda(p)}
              data-orden={i}
            >
              <div class="card">
                <div class="image-card">
                  <img
                    class="img-blog"
                    src={p.portada.src}
                    srcset={p.portada.srcset}
                    sizes={p.portada.sizes}
                    alt={p.portada.alt}
                    width={p.portada.ancho}
                    height={p.portada.alto}
                    loading={i === 0 ? 'eager' : 'lazy'}
                    decoding="async"
                  />
                </div>
                <div class="content-card">
                  {p.categoria?.name && <p class="mm-cat">{p.categoria.name}</p>}
                  <h4>{tituloTarjeta(p)}</h4>
                  <p class="paragraph-mini">{p.summary}</p>
                  <div class="wrapper-buttons">
                    <a
                      href={`/blogs/${p.slug}`}
                      class="button-styles w-button"
                      aria-label={`Read More: ${tituloTarjeta(p)}`}
                    >Read More</a>
                  </div>
                </div>
              </div>
            </div>
          ))}
        </div>
      </div>

      <p class="mm-vacio" data-vacio hidden>No articles match that search.</p>

      <div class="mm-mas" data-envoltorio-mas>
        <button type="button" class="mm-mas__boton" data-mas>Load more</button>
      </div>

    </div>
  </section>

  <section class="cta-footer"><div class="w-layout-blockcontainer container w-container"><div class="wrapper-cta-footer"><div data-w-id="1751d21a-c7f6-4875-4d5c-669cd0d5b935" class="wrapper-vertical-text"><h2>Request a Design-Build Project Evaluation</h2><div class="text-block-3">Share your property details, project scope, and investment range. Our licensed design-build pool builders will review your request and confirm alignment before next steps.</div><div class="wrapper-buttons-center"><a href="/request-estimated" class="button button-styles w-button">Get a Free Estimate</a></div></div></div></div></section>
</Base>

<script define:vars={{ LOTE }}>
  /**
   * EL FILTRO DEL INDICE. Patron de la casa: un solo `<script define:vars>`, IIFE con
   * `'use strict'`, sin `type="module"` y sin `is:inline` (ver `Interacciones.astro:177`).
   *
   * No toca la URL, no pide nada a la red y no reordena el DOM: solo pone y quita `hidden`.
   * Reordenar moveria el foco del teclado y romperia la animacion de entrada.
   */
  (function () {
    'use strict';
    const raiz = document.querySelector('[data-filtro]');
    if (!raiz) return;

    const campo = raiz.querySelector('[data-busca]');
    const cuenta = raiz.querySelector('[data-cuenta]');
    const chips = [...raiz.querySelectorAll('[data-cat]')];
    const tarjetas = [...document.querySelectorAll('.blogs-list .item-blogs')];
    const vacio = document.querySelector('[data-vacio]');
    const envoltorioMas = document.querySelector('[data-envoltorio-mas]');
    const botonMas = document.querySelector('[data-mas]');

    let categoria = '';
    let visibles = LOTE + 1;   // la destacada mas el primer lote

    const normaliza = (s) => s.toLowerCase().normalize('NFD').replace(/[̀-ͯ]/g, '');

    function pinta() {
      const q = normaliza(campo.value.trim());
      let casan = 0;
      let pintadas = 0;

      for (const t of tarjetas) {
        const okCat = !categoria || t.dataset.cat === categoria;
        const okQ = !q || t.dataset.busca.includes(q);
        const casa = okCat && okQ;
        if (casa) casan++;
        /* Se esconde con `hidden` y no con una clase: sin CSS la pagina sigue funcionando. */
        t.hidden = !casa || pintadas >= visibles;
        if (casa && pintadas < visibles) pintadas++;
      }

      cuenta.textContent = casan === 1 ? '1 article' : casan + ' articles';
      vacio.hidden = casan !== 0;
      envoltorioMas.hidden = casan <= pintadas;
    }

    /* Al cambiar de filtro se vuelve al primer lote: quedarse en «ver 40» tras pulsar una
     * categoria con 3 articulos deja al usuario mirando una rejilla que no ha pedido. */
    function reinicia() { visibles = LOTE + 1; pinta(); }

    campo.addEventListener('input', reinicia);
    campo.addEventListener('search', reinicia);

    for (const chip of chips) {
      chip.addEventListener('click', () => {
        categoria = chip.dataset.cat;
        for (const c of chips) c.setAttribute('aria-pressed', String(c === chip));
        reinicia();
      });
    }

    botonMas.addEventListener('click', () => {
      visibles += LOTE;
      pinta();
      /* El foco va a la primera tarjeta nueva: si se queda en el boton, quien navega con
       * teclado no sabe que ha pasado nada. */
      const nueva = tarjetas.find((t) => !t.hidden && Number(t.dataset.orden) >= visibles - LOTE);
      const enlace = nueva && nueva.querySelector('a');
      if (enlace) enlace.focus({ preventScroll: true });
    });

    pinta();
  }());
</script>

<style>
  /**
   * LA BARRA DE FILTRO, LOS CHIPS Y «LOAD MORE».
   *
   * VA AQUI Y NO EN `src/styles/blog-indice.css` A PROPOSITO. Estos controles existen en UNA
   * ruta; una hoja de `src/styles/` viaja a las 122. Lo dice la cabecera de `check-tokens.mjs`
   * al cuantificar lo que R21 no gasto: «una seccion nueva que nazca como componente no toca
   * este presupuesto… Astro solo envia ese CSS a la ruta que monta el componente». El
   * presupuesto estaba en 92,9 KB de 94 —1,1 KB libres— y esto no cabia ni debia caber.
   *
   * SE APLICA LA MISMA DISCIPLINA AUNQUE AQUI NO LA MIRE NADIE: cero `!important`, cero
   * `@layer`, ningun literal de color (solo `var(--mm-*)`), `min-width` 480/768/992 y nada de
   * `opacity:0` sin encendedor. Y como «no la mira nadie» es justo como se pierde una regla,
   * este encargo EXTIENDE `check:tokens` para que tambien lea los `<style>` de los `.astro`.
   *
   * CONTRASTES, MEDIDOS (no «se ve bien»):
   *   chip en reposo      navy #001c63 sobre blanco ............ 15,60:1   (texto, >=4,5)
   *   chip elegido        blanco sobre navy .................... 15,60:1   (texto, >=4,5)
   *   borde del chip      #8794b6 sobre blanco .................. 3,03:1   (control, >=3)
   *   recuento y pista    #767676 sobre blanco ................... 4,54:1  (texto, >=4,5)
   *   categoria en tarjeta #596b9a sobre blanco .................. 5,26:1  (texto, >=4,5)
   *   anillo de foco      navy sobre blanco ..................... 15,60:1  (>=3 por los dos lados:
   *                       el `outline-offset` deja blanco a ambos lados del anillo)
   *
   * EL ORO NO APARECE. Da 1,86:1 sobre blanco y no puede marcar estado. El chip elegido se
   * llena de NAVY. El oro se queda donde ya estaba y donde funciona: el «Read More» de la
   * tarjeta, navy sobre oro, 8,40:1.
   *
   * «LOAD MORE» ES SECUNDARIO Y POR ESO VA EN CONTORNO, no en relleno: en una vista con 10
   * «Read More» dorados, un onceavo boton dorado compite con el CTA de cada articulo.
   */

  /* ── 1 · LA BANDA ─────────────────────────────────────────────────────────
   * Filete arriba y abajo para que buscador y chips se lean como UN instrumento y no como dos
   * widgets apilados. El filete usa `--mm-borde` (1,27:1): es decorativo, no identifica ningun
   * control, asi que 1.4.11 no le aplica — mismo criterio ya declarado para el borde de la
   * tarjeta en `blog-indice.css`.
   * ------------------------------------------------------------------------ */
  .mm-filtro {
    display: grid;
    gap: var(--mm-e-16);
    margin-bottom: var(--mm-e-32);
    padding-block: var(--mm-e-24);
    border-block: 1px solid var(--mm-borde);
  }

  .mm-filtro__linea {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--mm-e-16);
  }

  /* ── 2 · EL BUSCADOR ──────────────────────────────────────────────────────
   * `flex: 1 1 16rem` con `min-width: 0`: sin el `min-width`, un campo flex no baja de su
   * tamano intrinseco y desborda la columna a 375 px.
   * ------------------------------------------------------------------------ */
  .mm-filtro__campo {
    flex: 1 1 16rem;
    min-width: 0;
    min-height: 44px;
    padding-inline: var(--mm-e-16);
    border: 1px solid var(--mm-borde-control);
    border-radius: var(--mm-r-8);
    background-color: var(--mm-superficie);
    color: var(--mm-tinta);
    font-family: var(--mm-fuente);
    font-size: var(--mm-paso-campo);
  }

  .mm-filtro__campo::placeholder { color: var(--mm-gris-aa); }

  .mm-filtro__cuenta {
    margin: 0;
    color: var(--mm-gris-aa);
    font-size: var(--mm-paso-0);
  }

  /* ── 3 · LOS CHIPS ────────────────────────────────────────────────────────
   * Por debajo de 768 ruedan en horizontal; a partir de ahi envuelven. Es `min-width`, nunca
   * `max-width`: mezclarlo con los `max-width` de Webflow es lo que prohibe 00-PRINCIPIOS §5.
   *
   * 44 px con la receta que ya funciona (`min-height` + `inline-flex` + centrado,
   * `intro.css:161-166`), nunca `height` fija ni `aspect-ratio` con la altura declarada.
   * ------------------------------------------------------------------------ */
  .mm-filtro__chips {
    display: flex;
    gap: var(--mm-e-8);
    overflow-x: auto;
    padding-bottom: var(--mm-e-4);
    scrollbar-width: none;
  }

  .mm-chip {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 44px;
    padding-inline: var(--mm-e-16);
    border: 1px solid var(--mm-borde-control);
    border-radius: var(--mm-r-pastilla);
    background-color: var(--mm-superficie);
    color: var(--mm-tinta);
    font-family: var(--mm-fuente);
    font-size: var(--mm-paso-0);
    font-weight: var(--mm-peso-medio);
    white-space: nowrap;
    cursor: pointer;
  }

  .mm-chip[aria-pressed='true'] {
    border-color: var(--mm-tinta);
    background-color: var(--mm-tinta);
    color: var(--mm-tinta-inversa);
  }

  /* ── 4 · FOCO ─────────────────────────────────────────────────────────────
   * `propio.css:59-66` solo cubre `.button-styles`. Estos controles son nuevos y necesitan el
   * suyo, con los tokens del sistema. El `outline-offset` deja blanco a los dos lados del
   * anillo, asi que el navy da 15,60:1 contra AMBOS vecinos — tambien sobre el chip relleno.
   * ------------------------------------------------------------------------ */
  .mm-filtro__campo:focus-visible,
  .mm-chip:focus-visible,
  .mm-mas__boton:focus-visible {
    outline: var(--mm-foco-grosor) solid var(--mm-foco);
    outline-offset: var(--mm-foco-aire);
  }

  /* ── 5 · LA CATEGORIA EN LA TARJETA ───────────────────────────────────────
   * Segundo eje de lectura de la rejilla: con ~100 articulos el titulo solo no basta para
   * saber de que va. `.content-card` ya es columna con `gap`, asi que no lleva margen propio.
   * ------------------------------------------------------------------------ */
  .mm-cat {
    margin: 0;
    color: var(--mm-tinta-suave);
    font-size: var(--mm-paso-0);
    font-weight: var(--mm-peso-medio);
  }

  /* ── 6 · VACIO Y «LOAD MORE» ──────────────────────────────────────────────
   * `[hidden]` necesita el `display:none` explicito: la regla del navegador la gana cualquier
   * `display` declarado, y `.mm-mas` es flex.
   * ------------------------------------------------------------------------ */
  .mm-vacio {
    margin-block: var(--mm-e-48);
    color: var(--mm-tinta-cuerpo);
    text-align: center;
  }

  .mm-mas {
    display: flex;
    justify-content: center;
    margin-top: var(--mm-e-32);
  }

  .mm-mas__boton {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding-inline: var(--mm-e-32);
    border: 1px solid var(--mm-tinta);
    border-radius: var(--mm-r-pastilla);
    background-color: var(--mm-superficie);
    color: var(--mm-tinta);
    font-family: var(--mm-fuente);
    font-size: var(--mm-paso-0);
    font-weight: var(--mm-peso-medio);
    cursor: pointer;
  }

  .mm-vacio[hidden],
  .mm-mas[hidden] { display: none; }

  /* ── 7 · ESTADOS ──────────────────────────────────────────────────────────
   * Con guarda de movimiento reducido, como el resto de la capa.
   * ------------------------------------------------------------------------ */
  @media (prefers-reduced-motion: no-preference) {
    .mm-chip,
    .mm-mas__boton { transition: background-color .18s ease, color .18s ease, border-color .18s ease; }
  }

  .mm-chip:hover { border-color: var(--mm-tinta); }

  .mm-chip[aria-pressed='true']:hover { background-color: var(--mm-navy-hondo); }

  .mm-mas__boton:hover {
    background-color: var(--mm-tinta);
    color: var(--mm-tinta-inversa);
  }

  @media (min-width: 768px) {
    .mm-filtro__chips {
      flex-wrap: wrap;
      overflow-x: visible;
    }
  }
</style>
