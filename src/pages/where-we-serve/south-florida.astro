// ASTRO-4 lote C (12-oct-2026). Esta ruta sigue en NO_REGENERAR de scripts/build-paginas.mjs: se
// mantiene A MANO. Era la home antigua en pequeno —hero de cristal, pestanas de servicios, banda
// de paneles, banda de accion a media pagina y tres carruseles—; ahora usa las piezas del sistema:
// hero partido con foto de obra, la presentacion con los condados en indice, los servicios en
// indice, la galeria compacta, el 3D en el unico bloque navy, y obras, resenas y articulos en lista.
// Mismos textos y mismos enlaces; lo que cambia de sitio lo declara `check-texto.mjs` (T-99).
import path from 'node:path';
import sharp from 'sharp';
import Base from '../../layouts/Base.astro';
import ServiciosIndice from '../../components/widgets/ServiciosIndice.astro';
import ResenasGoogle from '../../components/widgets/ResenasGoogle.astro';
import FeedInstagram from '../../components/widgets/FeedInstagram.astro';
import CarruselBlog from '../../components/widgets/CarruselBlog.astro';
import CarruselProyectos from '../../components/widgets/CarruselProyectos.astro';
import { bandaCompactaHtml, TITULO_BANDA, TEXTO_BANDA } from '../../lib/galeria-categorias.mjs';
import TELEFONOS from '../../data/telefonos.json';
import RESENAS from '../../data/resenas.json';
import HEROES from '../../data/heroes-ciudad.json';
import BANCO from '../../data/banco-imagenes.json';
import { logoLigero, ALTO_LOGO } from '../../lib/logo-ligero.mjs';
import { franjaLogos } from '../../lib/logos-franja.mjs';
import { ID_NEGOCIO } from '../../lib/negocio.mjs';

const telefonos = TELEFONOS.items;
const ACCION = "Get a Free Estimate";
const FLECHA = '<svg aria-hidden="true" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"></path><path d="m13 6 6 6-6 6"></path></svg>';
const VIDEO_3D = "<div data-poster-url=\"/images/site/bg-video-3d-poster.0000000.jpg\" data-video-urls=\"/videos/bg-video-3d-mp4.mp4,/videos/bg-video-3d-webm.webm\" data-autoplay=\"true\" data-loop=\"true\" data-wf-ignore=\"true\" class=\"background-video-3d w-background-video w-background-video-atom\"><video id=\"530cbcaa-1f3f-21e1-a774-0f91a89c10ec-video\" autoplay=\"\" loop=\"\" style=\"background-image:url(/images/site/bg-video-3d-poster.0000000.jpg)\" muted=\"\" playsinline=\"\" data-wf-ignore=\"true\" data-object-fit=\"cover\"><source src=\"/videos/bg-video-3d-mp4.mp4\" data-wf-ignore=\"true\"><source src=\"/videos/bg-video-3d-webm.webm\" data-wf-ignore=\"true\"></video><div aria-live=\"polite\"><button type=\"button\" data-w-bg-video-control=\"true\" aria-controls=\"530cbcaa-1f3f-21e1-a774-0f91a89c10ec-video\" class=\"w-backgroundvideo-backgroundvideoplaypausebutton w-background-video--control\"><span><img src=\"/images/site/pause.svg\" loading=\"lazy\" alt=\"Pause video\"></span><span hidden=\"\"><img loading=\"lazy\" alt=\"Play video\" src=\"/images/site/play-24.svg\"></span></button></div></div>";
const CONDADOS = [{"href": "/services/pool-builders/broward-county-fl", "nombre": "Broward County"}, {"href": "/services/pool-builders/palm-beach-county-fl", "nombre": "Palm Beach County"}];
const SRC_LOGOS = ["/images/logos/delta/delta-removebg-preview.png", "/images/logos/biggreen/bge-logo-lineup-removebg-preview.png", "/images/logos/alfresco/alfresco-logo-removebg-preview.png", "/images/logos/sunbrella/530-5307608-awning-vector-colorful-sunbrella-logo-transparent-hd-png-removebg-preview.png", "/images/logos/zodiac/zodiac-new.png", "/images/logos/sgm/sgm-pool-logo-e1585262761892.jpg", "/images/logos/npt/medium-tveat8emx4.png", "/images/logos/pelican-reef/logo-pelican-reef-800x800tiny.png", "/images/logos/jandy/jandy-logo.png", "/images/logos/irrigreen/irrigreen-logo-black-web.png", "/images/logos/milestone-p8m6r/image.png", "/images/logos/gemstone/gemstonelights-newlogo.png", "/images/logos/coyote/coyote-logo-glow.png", "/images/logos/alumawood/alumawood.png"];
const LOGOS = await Promise.all(SRC_LOGOS.map(async (src) => {
  const m = await sharp(path.join(process.cwd(), 'public', src)).metadata();
  const l = logoLigero(src, { w: m.width, h: m.height });
  return l.h === ALTO_LOGO ? l : { ...l, src };
}));
/* Las tres fotos salen de la bolsa de heroes de piscina nueva: obra real, terminada y con alt. */
const deBolsa = (k: number) => {
  const e = (BANCO as any[]).find((x) => x.id === HEROES.bolsas['pool-builders'][k]);
  if (!e || e.procedencia !== 'obra_real' || !e.alt) throw new Error(`/where-we-serve/south-florida: la foto ${k} de la bolsa no es obra real con alt`);
  return e;
};
const FOTO_HERO = deBolsa(5);
const FOTO_RES = deBolsa(3);
const FOTO_CIERRE = deBolsa(8);
const SEO = {"meta":{"og:title":"Luxury Pool Builders in South Florida | Design-Build Contractors","og:description":"Licensed luxury pool builders in South Florida specializing in custom inground pools and outdoor living design-build projects engineered for coastal conditions and long-term durability.","og:image":"/images/where-we-serves/custom-pool-builders-north-florida/south-florida-custom-pool-builders-modern-backyard-design.avif","twitter:title":"Luxury Pool Builders in South Florida | Design-Build Contractors","twitter:description":"Licensed luxury pool builders in South Florida specializing in custom inground pools and outdoor living design-build projects engineered for coastal conditions and long-term durability.","twitter:image":"/images/where-we-serves/custom-pool-builders-north-florida/south-florida-custom-pool-builders-modern-backyard-design.avif","og:type":"website","twitter:card":"summary_large_image"},"jsonLd":[{"@context":"https://schema.org","@type":"WebPage","dateModified":"2026-02-10T20:30:02.708Z","datePublished":"2026-02-10T20:30:59.845Z","description":"Licensed luxury pool builders in South Florida specializing in custom inground pools and outdoor living design-build projects, engineered, permitted, and built for high-end residential properties.","hasPart":[{"@type":"WebPageElement","description":"At Mr &amp; Mrs Outdoor Living, we serve South Florida homeowners seeking a fully managed, design-build pool construction process. Our team integrates custom pool design, structural engineering, permitting, and construction management under one accountable contractor. From concept development and 3D pool design through final construction, every project is executed with precision planning, climate-adapted materials, and strict code compliance—delivering refined outdoor environments built for longevity, performance, and architectural cohesion.","image":[{"@type":"ImageObject","caption":"Luxury custom pool design in South Florida with modern geometric layout, premium stone decking, and resort-style backyard built by expert pool builders.","url":"/images/where-we-serves/custom-pool-builders-north-florida/south-florida-custom-pool-builders-modern-backyard-design.avif"},{"@type":"ImageObject","caption":"Modern luxury custom pool in South Florida featuring integrated spa, clean architectural lines, and high-end outdoor living design for upscale homes.","url":"/images/countries/custom-pool-builders-alachua-county-fl/luxury-custom-pool-design-south-florida-outdoor-living.avif"},{"@type":"ImageObject","caption":"Resort-style custom pool in South Florida with expansive patio, integrated spa, and luxury outdoor living space designed for estate homes.","url":"/images/countries/custom-pool-builders-alachua-county-fl/south-florida-custom-pool-builders-resort-style-backyar.avif"}],"name":"Your Design-Build Pool &amp; Outdoor Living Specialists in South Florida"},{"@type":"WebPageElement","description":"Enhance your pool with architecturally integrated features engineered for performance, comfort, and visual impact.","name":"Luxury Pool Features &amp; Integrated Upgrades"},{"@type":"WebPageElement","description":"Every project includes realistic 3D pool design renderings, allowing you to review layout, features, and materials before permitting and construction begin.","name":"See Your Pool Before It’s Built"},{"@type":"WebPageElement","description":"Explore completed South Florida projects featuring custom inground pools and refined outdoor living spaces built through our fully managed design-build process.","name":"Featured Luxury Pool Projects Across South Florida"},{"@type":"WebPageElement","description":"South Florida homeowners praise our craftsmanship, communication, and luxury outdoor living results.","name":"What Homeowners Across South Florida Are Saying"},{"@type":"WebPageElement","description":"Explore expert tips, pool trends, and outdoor living ideas tailored to South Florida homes.","name":"Luxury Pool &amp; Outdoor Living Insights for South Florida"}],"image":{"@type":"ImageObject","caption":"Aerial drone view of a luxury custom pool and outdoor living project in South Florida, showcasing modern pool design by expert custom pool builders.","url":"/images/where-we-serves/custom-pool-builders-south-florida/custom-inground-pool-builders-remodeling-florida.avif"},"inLanguage":"en","mainEntity":{"@id":"https://mrandmrsoutdoorliving.com/#organization","@type":"LocalBusiness","areaServed":{"@type":"Place","name":"South Florida"},"description":"Licensed luxury pool builders in South Florida specializing in custom inground pools and outdoor living design-build projects, engineered, permitted, and built for high-end residential properties.","name":"Mr & Mrs Outdoor Living","url":"https://mrandmrsoutdoorliving.com/"},"name":"Luxury Pool Builders in South Florida","url":"/where-we-serve/south-florida"}]};
// PANELES-GALERIA: la parte 1 del JSON-LD describia la banda vieja («Luxury Pool Features & Integrated Upgrades»), que ya
// no se ve. Describe la que se ve, con las mismas constantes que la pintan. Si el origen moviera
// esa parte de sitio, se para el build en vez de pisar otra en silencio.
if (SEO.jsonLd[0].hasPart[1].name !== 'Luxury Pool Features &amp; Integrated Upgrades') throw new Error('south-florida: hasPart[1] ya no es la banda');
Object.assign(SEO.jsonLd[0].hasPart[1], { name: TITULO_BANDA, description: TEXTO_BANDA });
// D-172: el WebPage del origen anidaba en `mainEntity` un SEGUNDO LocalBusiness (`#organization`, dominio sin www, sin
// direccion ni telefono) para la misma empresa. Dos entidades que se contradicen confunden la senal local: pasa a ser
// la referencia al unico negocio de la casa, el `#negocio` que `Base.astro` pone en todas las paginas.
if (SEO.jsonLd[0].mainEntity?.['@id'] !== 'https://mrandmrsoutdoorliving.com/#organization') throw new Error('south-florida: mainEntity ya no es el LocalBusiness del origen');
SEO.jsonLd[0].mainEntity = { '@id': ID_NEGOCIO };
const LD_CRUDO = [];
---
<Base titulo="Luxury Pool Builders in South Florida | Design-Build Contractors" descripcion="Licensed luxury pool builders in South Florida specializing in custom inground pools and outdoor living design-build projects engineered for coastal conditions and long-term durability." ruta="/where-we-serve/south-florida" seo={SEO} jsonLdCrudo={LD_CRUDO}>
  <section class="mm-hero-a">
    <div class="mm-hero-a-txt">
      <h1 class="mm-h1">Luxury Pool Builders in South Florida</h1>
      <h2 class="mm-hero-a-sub">Custom Inground Pools &amp; Outdoor Living Design-Build</h2>
      <p class="mm-p">Licensed luxury pool builders in South Florida specializing in custom inground pools and outdoor living design-build projects, engineered, permitted, and built for high-end residential properties.</p>
      <div class="mm-hero-a-acc">
        <a class="mm-btn" href="/request-estimated">{ACCION}</a>
        <a class="mm-btn mm-btn--linea" href="/gallery">Project Gallery</a>
      </div>
    </div>
    <figure class="mm-hero-a-medio"><img src={FOTO_HERO.src} alt={FOTO_HERO.alt} width={FOTO_HERO.ancho} height={FOTO_HERO.alto} sizes="(min-width: 992px) 50vw, 100vw" loading="eager" fetchpriority="high" decoding="async" /></figure>
    {/* E7 (D-166): la franja de logos desfila. Marcado y duracion, en `logos-franja.mjs`. */}
    <Fragment set:html={franjaLogos("Trusted by Florida's finest homeowners", LOGOS)} />
  </section>

  <section class="mm-franja mm-franja--blanca">
    <div class="mm-sec-cab">
      <h2 class="mm-h2">Your Design-Build Pool &amp; Outdoor Living Specialists in South Florida</h2>
      <div class="mm-sec-lado"><p class="mm-p">At Mr &amp; Mrs Outdoor Living, we serve South Florida homeowners seeking a fully managed, design-build pool construction process. Our team integrates custom pool design, structural engineering, permitting, and construction management under one accountable contractor. From concept development and 3D pool design through final construction, every project is executed with precision planning, climate-adapted materials, and strict code compliance—delivering refined outdoor environments built for longevity, performance, and architectural cohesion.</p></div>
    </div>
    <div class="mm-zp-condados">
      <ul class="mm-indice" role="list">
        {CONDADOS.map((c) => <li><a class="mm-linea" href={c.href}><span class="mm-linea-t">{c.nombre}</span><Fragment set:html={FLECHA} /></a></li>)}
      </ul>
      <a class="mm-flecha" href="/about">More About Us<Fragment set:html={FLECHA} /></a>
    </div>
  </section>

  <ServiciosIndice />

  <Fragment set:html={bandaCompactaHtml(ACCION, '/request-estimated')} />

  <section class="mm-3d">
    <div class="mm-sec-cab">
      <h2 class="mm-h2">See Your Pool Before It’s Built</h2>
      <div class="mm-sec-lado">
        <p class="mm-p">Every project includes realistic 3D pool design renderings, allowing you to review layout, features, and materials before permitting and construction begin.</p>
        <div class="mm-sec-acc"><a class="mm-btn mm-btn--linea mm-btn--linea-inv" href="/request-estimated">{ACCION}</a></div>
      </div>
    </div>
    <figure class="mm-3d-medio"><Fragment set:html={VIDEO_3D} /></figure>
  </section>

  <CarruselProyectos />

  <section class="mm-res">
    <div class="mm-sec-cab">
      <div class="mm-sec-tit"><p class="mm-etiqueta">TESTIMONIALS</p><h2 class="mm-h2">What Our <span class="mm-rot">Clients</span> Say About Mr &amp; Mrs Outdoor Living</h2></div>
      <div class="mm-sec-lado">
        <p class="mm-p">Homeowners across North &amp; South Florida trust our custom pool builders for exceptional pool construction, remodeling, and outdoor living projects.</p>
        <div class="mm-sec-acc">
          <a class="mm-btn mm-btn--linea" href="/request-estimated">{ACCION}</a>
          <a class="mm-flecha" href={RESENAS.enlacePerfil} target="_blank" rel="noopener noreferrer">See all reviews<Fragment set:html={FLECHA} /></a>
        </div>
      </div>
    </div>
    <div class="mm-res-cuerpo">
      <div class="mm-res-col">
        <ResenasGoogle />
        <div class="mm-datos mm-datos--tel">{telefonos.map((t) => <a class="mm-dato" href={`tel:${t.tel}`}><span class="mm-dato-rot">{t.zona}</span><span class="mm-dato-val">{t.visible}</span></a>)}</div>
      </div>
      <figure class="mm-res-medio"><img src={FOTO_RES.src} alt={FOTO_RES.alt} width={FOTO_RES.ancho} height={FOTO_RES.alto} sizes="(min-width: 992px) 33vw, 100vw" loading="lazy" decoding="async" /></figure>
    </div>
  </section>

  <CarruselBlog />
  <section class="social-media">
    <FeedInstagram />
  </section>

  <section class="mm-cierre mm-cierre--sola mm-cierre--alta">
    <div class="mm-cierre-caja">
      <div class="mm-cierre-txt">
        <h2 class="mm-h2">Request a <span class="mm-nb">Design-Build</span> Project Evaluation</h2>
        <p class="mm-p">Share your property details, project scope, and investment range. Our licensed design-build pool builders will review your request and confirm alignment before next steps.</p>
        <a class="mm-btn" href="/request-estimated">Get a Free Estimate</a>
        <div class="mm-datos mm-datos--tel">{telefonos.map((t) => <a class="mm-dato" href={`tel:${t.tel}`}><span class="mm-dato-rot">{t.zona}</span><span class="mm-dato-val">{t.visible}</span></a>)}</div>
      </div>
      <figure class="mm-cierre-medio"><img src={FOTO_CIERRE.src} alt={FOTO_CIERRE.alt} width={FOTO_CIERRE.ancho} height={FOTO_CIERRE.alto} sizes="(min-width: 992px) 42vw, 100vw" loading="lazy" decoding="async" /></figure>
    </div>
  </section>
</Base>
