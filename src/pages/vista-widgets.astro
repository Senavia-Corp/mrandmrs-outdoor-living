---
/**
 * VISTA DE DISEÑO de los 3 widgets nativos. Para verla: `npm run vista`.
 *
 * ⚠️ ESTA PÁGINA SE BORRA ANTES DE LA FASE 6. Es una ruta que el sitio de origen no tiene,
 * y la puerta `check:rutas` («ninguna ruta extra existe») la va a cazar. Está apuntada
 * también en la bitácora, en «Abierto».
 *
 * Los datos de aquí son de EJEMPLO Y SE NOTA. No hay ni una reseña ni una publicación
 * inventada que pueda pasar por real: el texto dice literalmente que es un marcador de
 * posición. Los ficheros que se publican (src/data/*.json) siguen vacíos.
 */
import Base from '../layouts/Base.astro';
import ClickToCall from '../components/widgets/ClickToCall.astro';
import ResenasGoogle from '../components/widgets/ResenasGoogle.astro';
import FeedInstagram from '../components/widgets/FeedInstagram.astro';

const largo = 'Texto de ejemplo, más largo, para ver cómo se comporta la tarjeta cuando la reseña ocupa varias líneas y hay que recortarla a seis. Se sustituye por la reseña real al conectar el perfil de Google del cliente.';
const resenasDemo = {
  fuente: 'ejemplo',
  enlacePerfil: 'https://maps.google.com/?cid=13592496939047920063',
  actualizado: '2026-08-27',
  valoracion: 4.9,
  total: 87,
  items: [
    { autor: 'Ejemplo 1', estrellas: 5, texto: 'Texto de ejemplo corto.', fecha: '2026-07-02' },
    { autor: 'Ejemplo 2', estrellas: 5, texto: largo, fecha: '2026-06-18' },
    { autor: 'Ejemplo 3', estrellas: 4, texto: 'Texto de ejemplo de longitud media, para contrastar con los otros dos.', fecha: '2026-05-30' },
  ],
};

const fotos = ['about2.webp', 'adobe-express-file-1.webp', 'adobe-express-file-2.webp',
  'adobe-express-file-3.webp', 'adobe-express-file-4.webp', 'adobe-express-file-5.webp'];
const igDemo = {
  fuente: 'https://www.instagram.com/mrandmrsoutdoorliving/',
  usuario: 'mrandmrsoutdoorliving',
  actualizado: null,
  items: fotos.map((f, i) => ({
    id: String(i), imagen: `/images/site/${f}`, alt: '',
    enlace: 'https://www.instagram.com/mrandmrsoutdoorliving/',
  })),
};
---
<Base titulo="Vista de diseño — widgets nativos">
  <div class="vista">
    <header class="vista__cab">
      <h1>Widgets nativos</h1>
      <p>Sustituyen a los 3 de Elfsight. Datos de ejemplo; los ficheros que se publican están vacíos.</p>
    </header>

    <section class="vista__bloque">
      <h2>1 · Reseñas de Google <small>— en <code>section.testimonial-section</code> de la home</small></h2>
      {/* Se reproduce el fondo real de la sección para juzgar el contraste de verdad */}
      <div class="testimonial-section">
        <div class="container">
          <div class="header-reviews">
            <div class="label">TESTIMONIALS</div>
            <h2 class="white">What Our Clients Say About Mr &amp; Mrs Outdoor Living</h2>
          </div>
          <ResenasGoogle datosDemo={resenasDemo} />
        </div>
      </div>
    </section>

    <section class="vista__bloque">
      <h2>2 · Feed de Instagram <small>— es la <code>section.social-media</code> entera</small></h2>
      <div class="social-media">
        <FeedInstagram datosDemo={igDemo} />
      </div>
    </section>

    <section class="vista__bloque">
      <h2>3 · Click-to-call <small>— flotante, sobre todas las páginas ↘</small></h2>
      <p class="vista__nota">
        Abajo a la derecha. Dos números porque el negocio tiene dos, etiquetados como en
        <code>/contact-us</code>: North Florida y South Florida.
      </p>
    </section>
  </div>
  <ClickToCall />
</Base>

<style is:global>
  .vista { max-width: 1250px; margin-inline: auto; padding: 2rem 1rem 8rem }
  .vista__cab h1 { font-family: Montserrat, sans-serif; margin: 0 0 .25rem }
  .vista__cab p { margin: 0 0 2rem; opacity: .7 }
  .vista__bloque { margin-bottom: 3rem }
  .vista__bloque > h2 { font-size: 20px; font-family: Montserrat, sans-serif; margin: 0 0 .75rem }
  .vista__bloque > h2 small { font-weight: 400; opacity: .6; font-size: 15px }
  .vista__nota { opacity: .8 }
  .vista .social-media { padding: 2rem 0 }
  .vista code { background: #ececec; padding: .1em .35em; border-radius: 4px; font-size: .9em }
</style>
