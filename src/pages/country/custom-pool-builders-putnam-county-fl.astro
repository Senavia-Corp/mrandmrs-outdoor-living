1080.png 1080w, /images/site/coyote-logo-glow-p-1600.png 1600w, /images/site/coyote-logo-glow-p-2000.png 2000w, /images/site/coyote-logo-glow-p-2600.png 2600w, /images/logos/coyote/coyote-logo-glow.png 2637w\" class=\"fs-marquee-logoscms_logo\"></div><div fs-marquee-element=\"item\" role=\"listitem\" class=\"fs-marquee-logoscms_item w-dyn-item\"><img loading=\"lazy\" src=\"/images/logos/alumawood/alumawood.png\" alt=\"\" sizes=\"(max-width: 767px) 100vw, (max-width: 991px) 727px, 940px\" srcset=\"/images/site/alumawood-p-500.png 500w, /images/site/alumawood-p-800.png 800w, /images/site/alumawood-p-1080.png 1080w, /images/site/alumawood-p-1600.png 1600w, /images/site/alumawood-p-2000.png 2000w, /images/site/alumawood-p-2600.png 2600w, /images/logos/alumawood/alumawood.png 2744w\" class=\"fs-marquee-logoscms_logo\"></div></div></div><div class=\"block-fade-in-2\"></div><div class=\"block-fade-in-1\"></div></div></div></div></section><section class=\"trusted-section\"><div class=\"w-layout-blockcontainer container w-container\"><div class=\"wrapper-trusted\"><div class=\"trusted-divider-left\"><div class=\"grid-wrapper\"><div class=\"grid-column column1\"><img alt=\"Custom pool project in Putnam County featuring natural stone finishes, landscaped surroundings, and a welcoming outdoor living layout.\" src=\"/images/countries/custom-pool-builders-alachua-county-fl/south-florida-custom-pool-builders-resort-style-backyar.avif\" loading=\"lazy\" class=\"image\"></div><div class=\"grid-column column2\"><div class=\"grid-row row1\"><img alt=\"Outdoor living space in Putnam County with custom pool and covered seating area designed for relaxed Florida living.\" src=\"/images/countries/custom-pool-builders-alachua-county-fl/luxury-custom-pool-design-south-florida-outdoor-living.avif\" loading=\"lazy\" class=\"image\"></div><div class=\"grid-row row2\"><img alt=\"Modern custom pool and spa in Putnam County designed for functional outdoor enjoyment and long-term durability.\" src=\"/images/where-we-serves/custom-pool-builders-north-florida/south-florida-custom-pool-builders-modern-backyard-design.avif\" loading=\"lazy\" class=\"image\"></div></div></div><div class=\"code-embed w-embed w-script\"><style>\n  /* Recomendado: que el wrapper no corte el contenido */\n  .grid-wrapper { overflow: visible; }\n\n  /* Asegura que las columnas se comporten como flex items */\n  .grid-wrapper { display: flex; }\n\n  /* Columna derecha debe ser contenedor vertical */\n  .grid-column.column2 {\n    display: flex;\n    flex-direction: column;\n  }\n\n  /* Filas se reparten por % dentro de la columna derecha */\n  .grid-row.row1, .grid-row.row2 {\n    width: 100%;\n  }\n</style>\n\n<script>\nwindow.addEventListener(\"load\", () => {\n  const wrapper = document.querySelector(\".grid-wrapper\");\n  if (!wrapper) return console.warn(\"No encontré .grid-wrapper\");\n\n  const col1 = wrapper.querySelector(\".grid-column.column1\");\n  const col2 = wrapper.querySelector(\".grid-column.column2\");\n  const row1 = wrapper.querySelector(\".grid-row.row1\");\n  const row2 = wrapper.querySelector(\".grid-row.row2\");\n\n  if (!col1 || !col2 || !row1 || !row2) {\n    console.warn(\"Faltan: .grid-column.column1 / .grid-column.column2 / .grid-row.row1 / .grid-row.row2\");\n    return;\n  }\n\n  // --- SETTINGS ---\n  const STEP_MS = 1100;  // duración de cada transición\n  const HOLD_MS = 200;   // pausa entre estados (0 si no quieres pausa)\n  const EASING = \"cubic-bezier(0.22, 1, 0.36, 1)\";\n\n  // Estados EXACTOS como los pediste\n  const states = [\n    // 0) Inicial\n    { c1: 50, c2: 50, r1: 50, r2: 50 },\n    // 1) Primera animación\n    { c1: 70, c2: 30, r1: 50, r2: 50 },\n    // 2) Segunda animación\n    { c1: 30, c2: 70, r1: 70, r2: 30 },\n    // 3) Tercera animación\n    { c1: 30, c2: 70, r1: 30, r2: 70 },\n    // 4) Cuarta animación (vuelve al inicial)\n    { c1: 50, c2: 50, r1: 50, r2: 50 }\n  ];\n\n  // Estado actual (para que la animación sea suave siempre)\n  let current = { c1: 50, c2: 50, r1: 50, r2: 50 };\n\n  // Control visible / loop\n  let running = false;\n  let stopRequested = false;\n\n  function applyInstant(s) {\n    // Columnas: flex-basis en %\n    col1.style.flex = `0 0 ${s.c1}%`;\n    col2.style.flex = `0 0 ${s.c2}%`;\n\n    // Filas: height en %\n    row1.style.height = `${s.r1}%`;\n    row2.style.height = `${s.r2}%`;\n\n    current = { ...s };\n  }\n\n  // Aplica el estado inicial (sin animación)\n  applyInstant(states[0]);\n\n  function animateTo(s) {\n    // Cancela animaciones previas\n    [col1, col2, row1, row2].forEach(el => {\n      if (el._anim) el._anim.cancel();\n    });\n\n    // Animar flex-basis (col1/col2) y height (row1/row2) con WAAPI\n    const a1 = col1.animate(\n      [{ flexBasis: `${current.c1}%` }, { flexBasis: `${s.c1}%` }],\n      { duration: STEP_MS, easing: EASING, fill: \"forwards\" }\n    );\n    const a2 = col2.animate(\n      [{ flexBasis: `${current.c2}%` }, { flexBasis: `${s.c2}%` }],\n      { duration: STEP_MS, easing: EASING, fill: \"forwards\" }\n    );\n    const a3 = row1.animate(\n      [{ height: `${current.r1}%` }, { height: `${s.r1}%` }],\n      { duration: STEP_MS, easing: EASING, fill: \"forwards\" }\n    );\n    const a4 = row2.animate(\n      [{ height: `${current.r2}%` }, { height: `${s.r2}%` }],\n      { duration: STEP_MS, easing: EASING, fill: \"forwards\" }\n    );\n\n    // Guardar refs para cancelar si hace falta\n    col1._anim = a1; col2._anim = a2; row1._anim = a3; row2._anim = a4;\n\n    // Cuando termina, fijamos estilos finales reales\n    return Promise.allSettled([a1.finished, a2.finished, a3.finished, a4.finished])\n      .then(() => applyInstant(s));\n  }\n\n  function sleep(ms) {\n    return new Promise(res => setTimeout(res, ms));\n  }\n\n  async function loop() {\n    if (running) return;\n    running = true;\n    stopRequested = false;\n\n    let i = 0;\n\n    while (!stopRequested) {\n      const next = states[(i + 1) % states.length];\n      await animateTo(next);\n      if (stopRequested) break;\n      if (HOLD_MS) await sleep(HOLD_MS);\n      i = (i + 1) % states.length;\n    }\n\n    running = false;\n  }\n\n  function stop() {\n    stopRequested = true;\n    // Cancela animaciones activas para que se “congele” donde va\n    [col1, col2, row1, row2].forEach(el => {\n      if (el._anim) el._anim.cancel();\n    });\n  }\n\n  // Solo corre mientras está visible en pantalla\n  const io = new IntersectionObserver((entries) => {\n    entries.forEach(entry => {\n      if (entry.isIntersecting) loop();\n      else stop();\n    });\n  }, { threshold: 0.25 });\n\n  io.observe(wrapper);\n});\n</script></div></div><div class=\"block-service-areas\"><div class=\"wrapper-vertical-text-copy\"><h2 class=\"white\">Custom Pools &amp; Outdoor Living in Putnam County</h2><p>Serving Palatka and surrounding areas, we design custom pools and outdoor spaces tailored to North Florida lifestyles, blending comfort, function, and lasting visual appeal.</p></div><div class=\"wrapper-cities-cms w-dyn-list\"><div role=\"list\" class=\"list-cities-cms w-dyn-items\"><div role=\"listitem\" class=\"item-cities-cms w-dyn-item\"><a href=\"/pool-builders/palatka-florida\" class=\"link-block-white w-inline-block\"><img src=\"/images/site/close-toggle.svg\" loading=\"lazy\" alt=\"\" class=\"icon thin\"><div>Palatka</div></a></div></div></div><div class=\"wrapper-buttons\"><a href=\"/about\" class=\"button button-styles w-button\">More About Us</a></div></div></div></div></section><section class=\"_3d-section\"><img src=\"/images/site/design2.webp\" loading=\"lazy\" sizes=\"(max-width: 1919px) 100vw, 1920px\" srcset=\"/images/site/design2-p-500.webp 500w, /images/site/design2-p-800.webp 800w, /images/site/design2-p-1080.webp 1080w, /images/site/design2-p-1600.webp 1600w, /images/site/design2.webp 1920w\" alt=\"\" class=\"design-bg\"><div class=\"w-layout-blockcontainer container w-container\"><div class=\"wrapper-video\"><div dat