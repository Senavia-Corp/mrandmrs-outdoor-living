---
/**
 * LAS FICHAS DE BLOG, SERVIDAS DESDE SANITY.
 *
 * Sustituye a los 10 `.astro` derivados que habia aqui, cuyo cuerpo entero era una constante
 * `T0` con el HTML horneado de Webflow. El precedente exacto es la Fase 6b con
 * `src/pages/services/pool-builders/[slug].astro`, que borro los 53 estaticos de ciudad por lo mismo.
 *
 * ─────────────────────────────────────────────────────────────────────────────
 * FALLA CERRADO, Y ES A PROPOSITO
 *
 * Sin datos no se construye media coleccion: N URLs que desaparecen en silencio son N errores
 * 404 con el despliegue en VERDE. La cache de escape (`MM_SANITY_CACHE=1`) existe para poder
 * construir sin red, pero se pide A MANO: si se activara sola, una caida de Sanity se serviria
 * como si fuera el CMS vivo y nadie se enteraria.
 *
 * ─────────────────────────────────────────────────────────────────────────────
 * QUE NO SALE DE SANITY, Y POR QUE
 *
 *   · El `<title>` de `/blogs/commercial-pool-construction-...` lo pisa
 *     `src/data/meta-propia.json`. NO es una segunda fuente de verdad: es la DECLARACION que
 *     `check-seo.mjs` deriva (`TITULO_DE_META`) para saber que ese titulo se aparta del
 *     baseline de Webflow a proposito. Quitar la entrada pondria la puerta roja.
 *   · El `BreadcrumbList` lo inyecta `Base.astro`, que ademas desduplica: emitir dos en la
 *     misma pagina es peor que no emitir ninguno.
 *
 * ─────────────────────────────────────────────────────────────────────────────
 * EL RAIL «MOST READ ARTICLES» SALE DE `relatedPosts`
 *
 * En los 10 heredados esa lista es, byte a byte, la que ya servia el sitio — incluidos los 7
 * articulos que se enlazan A SI MISMOS. No se arregla aqui: este fichero es una migracion de
 * render y tiene que poder demostrar que no cambia nada. El autoenlace es un defecto de
 * CONTENIDO y se arregla como contenido, declarado, en el paso editorial.
 */
import Base from '../../layouts/Base.astro';
import { aHtml } from '../../lib/portable-text.mjs';
import TELEFONOS from '../../data/telefonos.json';
import HEROES from '../../data/heroes-ciudad.json';
import BANCO from '../../data/banco-imagenes.json';
import SERVICIOS from '../../data/servicios-categoria.json';

export async function getStaticPaths() {
  /* El `fetch`, la guarda de fallo cerrado y la cache de escape viven en
   * `src/lib/blog-datos.mjs`, compartidos con `/blogs-tips`: dos copias de «que pasa si Sanity
   * no responde» divergen, y la que falle ABIERTA sera la que nadie mira. */
  const { traeBlog } = await import('../../lib/blog-datos.mjs');
  const docs = await traeBlog();
  /* `puesto`: el del articulo en la lista ordenada por slug. Reparte la foto de la banda de
   * cierre sin depender del orden en que Sanity devuelva los documentos. */
  const orden = docs.map((d) => d.slug).sort();
  return docs.map((doc) => ({ params: { slug: doc.slug }, props: { doc, puesto: orden.indexOf(doc.slug) } }));
}

const { doc, puesto } = Astro.props;
const ruta = `/blogs/${doc.slug}`;

/* Guardas de forma. Un articulo al que le falte esto no se pinta a medias: se para el build con
 * el slug puesto, que es lo que permite arreglarlo en Sanity en treinta segundos. */
for (const campo of ['title', 'summary', 'blog', 'portada', 'seo']) {
  if (!doc[campo]) throw new Error(`${ruta}: falta "${campo}" en Sanity`);
}
if (!doc.seo.title || !doc.seo.description) throw new Error(`${ruta}: seo incompleto en Sanity`);
if (!doc.portada.src || !doc.portada.alt) throw new Error(`${ruta}: la portada no tiene src o alt`);

const cuerpoBase = aHtml(doc.blog, ruta);

/**
 * ── LA FAQ Y LAS FUENTES ────────────────────────────────────────────────────────────────────
 *
 * Se CONCATENAN al richtext en vez de ir en una seccion propia, y son tres razones:
 *
 *   1. Heredan la tipografia del articulo. `lectura.css` ya fija la medida de 37em, el ritmo de
 *      h2/h3 y el interlineado dentro de `.w-richtext`; una seccion nueva pediria CSS nuevo para
 *      parecerse a lo que ya hay.
 *   2. NO se emite un solo `data-w-id`. Las fichas de servicio pintan su FAQ con dropdowns de
 *      Webflow, que llevan `data-w-id` y `data-delay`; `check:ix2` fija las huerfanas en 14 y
 *      emitir uno nuevo mueve ese contador. Aqui son encabezados y parrafos: cero JS, cero ids.
 *   3. Una respuesta plegada es una respuesta que Google ve y el lector no. En un articulo cuyo
 *      trabajo entero es responder, esconder las respuestas detras de un acordeon es al reves.
 *
 * Y de ahi sale gratis la disciplina que pide el esquema: el `FAQPage` se emite SOLO si hay
 * `faq`, y lo que emite es exactamente lo que esta pintado. No hay forma de que diverjan porque
 * salen del mismo array.
 *
 * En los 10 heredados `faq` y `fuentes` son `null`, asi que no se anade un byte a su HTML — que
 * es lo que permite seguir demostrando que la migracion de render no cambio nada.
 */
const esc = (x) => String(x ?? '')
  .replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
const escAttr = (x) => esc(x).replace(/"/g, '&quot;');

const faq = (doc.faq ?? []).filter((f) => f?.question?.trim() && f?.answer?.trim());
const fuentes = (doc.fuentes ?? []).filter((f) => f?.label?.trim() && f?.url?.trim());

const bloqueFaq = faq.length
  ? '<h2>Common questions</h2>'
    + faq.map((f) => `<h3>${esc(f.question)}</h3><p>${esc(f.answer)}</p>`).join('')
  : '';
const bloqueFuentes = fuentes.length
  ? '<h2>Sources</h2><ul role="list" class="mm-fuentes">'
    + fuentes.map((f) => `<li><a href="${escAttr(f.url)}" rel="nofollow noopener">${esc(f.label)}</a></li>`).join('')
    + '</ul>'
  : '';

const cuerpo = cuerpoBase + bloqueFaq + bloqueFuentes;

/**
 * EL RAIL, Y EL ENLACE A SI MISMO.
 *
 * 7 de los 10 heredados se enlazan a SI MISMOS en «Most Read Articles» (R22-BLOG-IMG lo dejo
 * abierto en su punto 5). Aqui se conserva tal cual —este fichero es una migracion de render y
 * tiene que poder demostrar que no cambia un byte—, incluido el par de atributos que Webflow le
 * ponia al enlace cuyo `href` es la pagina actual:
 *
 *     aria-current="page"   y   la clase `w--current`
 *
 * `w--current` resulta ser COSMETICAMENTE INERTE aqui: las 11 reglas que la usan en webflow.css
 * son de `.w-nav-link`, `.w-dropdown-link`, `.w-tab-link`, `.nav-link`, `.link-2`, `.link-3`,
 * `.tab-*`, `.navbar-logo` y `.item-submenu`, y ninguna casa con
 * `.button.button-styles.secundary.w-button`. O sea que no mueve un pixel. Se reproduce de todos
 * modos porque `aria-current="page"` SI dice algo —«este enlace es la pagina en la que estas»— y
 * perderlo en silencio seria una regresion de accesibilidad colada dentro de un refactor.
 *
 * Cuando el paso editorial quite los autoenlaces, esto dejara de dispararse solo.
 */
const relacionados = (doc.relacionados ?? [])
  .filter((r) => r?.slug && r?.portada)
  .map((r) => ({ ...r, esActual: r.slug === doc.slug }));

/**
 * ── LA PLANTILLA (ASTRO-4 lote A, laminas «Articulo» y «CuerpoArticulo») ─────────────────────
 *
 * QUE CONSIGUE: que el articulo se lea. Una columna de lectura de 720 px con la portada a su
 * tamano real (D-85: las 47 son de 800 px y no se amplian), y al lado una sola accion, quieta,
 * que acompana toda la lectura (D-84, D-97: sin oro, que el oro es el de la cabecera).
 *
 * QUE CAMBIA DE COMPOSICION: el hero oscuro con la foto de fondo pasa a hero C claro; el rail
 * «Most Read Articles», que competia con el texto desde la columna derecha, baja detras del
 * articulo como lista editorial (D-86); en su sitio queda la tarjeta de accion, pegada al
 * recorrer; y la banda de cierre gana foto de obra y los dos telefonos.
 *
 * EL TEXTO NO SE TOCA: titular, resumen, cuerpo, FAQ, fuentes, «Most Read Articles» con sus
 * tarjetas y la banda son los de siempre, en su orden. Lo nuevo es la tarjeta (T-49) y los
 * telefonos de la banda (T-56), y `check-texto.mjs` lo declara.
 *
 * LA TARJETA NO SALE POR DEBAJO DE 992 px, como en la lamina movil: ahi la accion es la barra
 * fija, y una tarjeta entre el cuerpo y los relacionados serian tres llamadas seguidas.
 */
const telefonos = TELEFONOS.items;
const FLECHA = '<svg aria-hidden="true" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"></path><path d="m13 6 6 6-6 6"></path></svg>';

/* LA FOTO DE LA BANDA sale de las bolsas de `heroes-ciudad.json`, que ya estan validadas para un
 * hero (obra real, terminada, con recorte 4:5 seguro): la del servicio del articulo y, si no
 * tiene, la de piscina nueva, que es de lo que habla la banda. Nunca una que el articulo ya
 * ensene en la portada o en el cuerpo (las del blog son `mm-bi-NNNN`, la `bi-NNNN` del banco). */
const nm = (x) => String(x ?? '').replace(/\s+/g, ' ').trim();
const fichaDe = (doc.servicios ?? []).map((sv) => SERVICIOS['/'].servicios.find((x) => nm(x.nombre) === nm(sv.name))?.enlace?.split('/').pop())
  .find((slug) => HEROES.bolsas[slug]?.length);
const yaVistas = new Set([...JSON.stringify(doc).matchAll(/mm-bi-(\d+)/g)].map((m) => `bi-${m[1]}`));
const bolsa = HEROES.bolsas[fichaDe ?? 'pool-builders'].filter((id) => !yaVistas.has(id));
const fotoBanda = BANCO.find((e) => e.id === bolsa[puesto % bolsa.length]);
if (!fotoBanda || fotoBanda.procedencia !== 'obra_real' || !(fotoBanda.recortes_seguros ?? []).includes('4:5') || !fotoBanda.alt) {
  throw new Error(`${ruta}: la foto de la banda (${bolsa[puesto % bolsa.length]}) no es obra real con recorte 4:5 y alt`);
}

/* El JSON-LD conserva la forma que ya servia —mismas claves, `description` del `summary` (no
 * de `seo.description`, que es la que va al og)— con DOS cambios de SEO-SAFE (1-oct-2026):
 *
 *   · las URLs son ABSOLUTAS (`url`, `image.url`, `publisher.logo.url`): el origen las
 *     publicaba relativas y un consumidor que lea el bloque fuera de la pagina (un agregador,
 *     un motor generativo) no tiene contra que resolverlas;
 *   · `mainEntityOfPage` y `publisher.url`, que atan el articulo a su pagina y al sitio.
 *
 * `check-seo.mjs` lo declara para los 10 heredados (bloque SEO-SAFE, derivado del cache); las
 * 37 propias no tienen baseline. `Astro.site` es el mismo host que gobierna la canonica. */
const ABS = (p) => new URL(p, Astro.site).href;
const SEO = {
  meta: {
    'og:title': doc.seo.title,
    'og:description': doc.seo.description,
    'og:image': doc.portada.src,
    'twitter:title': doc.seo.title,
    'twitter:description': doc.seo.description,
    'twitter:image': doc.portada.src,
    'og:type': 'website',
    'twitter:card': 'summary_large_image',
  },
  jsonLd: [{
    '@context': 'https://schema.org',
    '@type': 'BlogPosting',
    author: { '@type': 'Organization', name: 'Mr. and Mrs. Outdoor Living' },
    dateModified: doc.updatedAt ?? doc.publishedAt,
    datePublished: doc.publishedAt,
    description: doc.summary,
    headline: doc.title,
    image: { '@type': 'ImageObject', url: ABS(doc.portada.src) },
    inLanguage: 'en',
    mainEntityOfPage: { '@type': 'WebPage', '@id': ABS(ruta) },
    name: doc.title,
    publisher: {
      '@type': 'Organization',
      logo: { '@type': 'ImageObject', url: ABS('/images/site/logo-mr-mr.svg') },
      name: 'Mr. and Mrs. Outdoor Living',
      url: ABS('/'),
    },
    url: ABS(ruta),
  },
  /* El FAQPage va SOLO si hay FAQ pintada, y sale del mismo array que se pinto arriba. La
   * regla 14 de `check:ads` exige que el schema case 1:1 con lo visible; aqui no puede no
   * casar. `Base.astro` desduplica, asi que dos bloques en la misma pagina son seguros. */
  ...(faq.length ? [{
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faq.map((f) => ({
      '@type': 'Question',
      name: f.question,
      acceptedAnswer: { '@type': 'Answer', text: f.answer },
    })),
  }] : [])],
};
---
<Base titulo={doc.seo.title} descripcion={doc.seo.description} ruta={ruta} seo={SEO} jsonLdCrudo={[]}>
  <section class="mm-hero-c mm-hero-c--art">
    <div class="mm-hero-c-caja">
      <div class="mm-hero-c-txt"><h1 class="mm-h1">{doc.title}</h1><p class="mm-p">{doc.summary}</p></div>
      <figure class="mm-hero-c-medio"><img src={doc.portada.src} srcset={doc.portada.srcset} sizes="(min-width: 992px) 800px, 100vw" alt={doc.portada.alt} width={doc.portada.ancho} height={doc.portada.alto} loading="eager" fetchpriority="high" decoding="async" /></figure>
    </div>
  </section>

  <section class="mm-lect">
    <div class="mm-prosa" set:html={cuerpo} />
    <aside class="mm-lado">
      <span class="mm-dato-rot">Pool cost estimator</span>
      <a class="mm-btn mm-btn--navy" href="/request-estimated">Request a Design-Build Project Evaluation</a>
      <a class="mm-btn mm-btn--linea" href="/pool-cost-estimator">Try the pool cost estimator</a>
      <div class="mm-datos mm-datos--pila">{telefonos.map((t) => <a class="mm-dato" href={`tel:${t.tel}`}><span class="mm-dato-rot">{t.zona}</span><span class="mm-dato-val">{t.visible}</span></a>)}</div>
    </aside>
  </section>

  <section class="mm-rel">
    <div class="mm-rel-caja">
      <h2 class="mm-h2">Most Read <span class="mm-rot">Articles</span></h2>
      <ul class="mm-arts" role="list">
        {relacionados.map((r) => (
          <li>
            <a class="mm-art" href={`/blogs/${r.slug}`} aria-current={r.esActual ? 'page' : undefined}>
              <span class="mm-art-foto"><img src={r.portada.src} srcset={r.portada.srcset} sizes="(min-width: 768px) 280px, 100vw" alt="" width={r.portada.ancho} height={r.portada.alto} loading="lazy" decoding="async" /></span>
              <span class="mm-art-txt">
                <h3 class="mm-art-t">{r.title}</h3>
                <span class="mm-art-p">{r.summary}</span>
                <span class="mm-flecha">Read More<span class="mm-sr">: {r.title}</span><Fragment set:html={FLECHA} /></span>
              </span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="mm-cierre mm-cierre--sola mm-cierre--alta">
    <div class="mm-cierre-caja">
      <div class="mm-cierre-txt">
        <h2 class="mm-h2">Request a <span class="mm-nb">Design-Build</span> Project Evaluation</h2>
        <p class="mm-p">Share your property details, project scope, and investment range. Our licensed design-build pool builders will review your request and confirm alignment before next steps.</p>
        <a class="mm-btn" href="/request-estimated">Get a Free Estimate</a>
        <div class="mm-datos mm-datos--tel">{telefonos.map((t) => <a class="mm-dato" href={`tel:${t.tel}`}><span class="mm-dato-rot">{t.zona}</span><span class="mm-dato-val">{t.visible}</span></a>)}</div>
      </div>
      <figure class="mm-cierre-medio"><img src={fotoBanda.src} alt={fotoBanda.alt} width={fotoBanda.ancho} height={fotoBanda.alto} sizes="(min-width: 992px) 42vw, 100vw" loading="lazy" decoding="async" /></figure>
    </div>
  </section>
</Base>
